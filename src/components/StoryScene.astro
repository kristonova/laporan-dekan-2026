---
interface Props {
  id: string;
  number: string;
  question: string;
  deck: string;
  pillar?: string;
  tone?: "light" | "paper" | "navy";
  wide?: boolean;
  compact?: boolean;
}

const {
  id,
  number,
  question,
  deck,
  pillar,
  tone = "light",
  wide = false,
  compact = false,
} = Astro.props;
---

<section
  class:list={["story-scene", `story-scene--${tone}`, { "story-scene--wide": wide, "story-scene--compact": compact }]}
  {id}
  aria-labelledby={`${id}-title`}
  data-story-scene
>
  <div class="story-scene__inner">
    <header class="story-scene__header" data-reveal>
      <div class="story-scene__meta">
        <span>{number}</span>
        {pillar && <span>{pillar}</span>}
      </div>
      <h2 id={`${id}-title`}>{question}</h2>
      <p class="story-scene__deck">{deck}</p>
    </header>
    <div class="story-scene__content" data-reveal data-reveal-delay="80">
      <slot />
    </div>
  </div>
</section>

<style>
  .story-scene {
    padding: clamp(88px, 11vw, 152px) var(--page-gutter);
    scroll-margin-top: 76px;
  }
  .story-scene--light { background: var(--surface-page); color: var(--text-primary); }
  .story-scene--paper { background: var(--surface-subtle); color: var(--text-primary); }
  .story-scene--navy { background: var(--ugm-blue-deep); color: #fff; }
  .story-scene--compact { padding-block: clamp(72px, 8vw, 108px); }
  .story-scene__inner { width: min(100%, 1100px); margin-inline: auto; }
  .story-scene--wide .story-scene__inner { width: min(100%, var(--content-max)); }
  .story-scene__header { max-width: 840px; margin-block-end: clamp(42px, 6vw, 76px); }
  .story-scene__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-block-end: 18px;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .story-scene__meta span + span::before { content: ""; display: inline-block; width: 22px; height: 2px; margin-inline-end: 14px; vertical-align: middle; background: var(--ugm-gold); }
  .story-scene h2 {
    max-width: 820px;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(38px, 5.4vw, 68px);
    line-height: 1.03;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .story-scene__deck {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--text-secondary);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.55;
  }
  .story-scene--navy .story-scene__meta { color: rgba(255,255,255,.62); }
  .story-scene--navy .story-scene__deck { color: rgba(255,255,255,.76); }
  @media (max-width: 700px) {
    .story-scene { padding-block: 72px; }
    .story-scene__header { margin-block-end: 38px; }
  }
</style>
