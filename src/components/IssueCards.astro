---
interface Issue {
  value?: string;
  title: string;
  description: string;
  status?: string;
}
interface Props { issues: Issue[]; columns?: 2 | 3 | 4; }
const { issues, columns = 3 } = Astro.props;
---

<div class={`issue-grid issue-grid--${columns}`}>
  {issues.map((issue) => (
    <article class="issue-card">
      {issue.status && <p class="issue-card__status">{issue.status}</p>}
      {issue.value && <p class="issue-card__value">{issue.value}</p>}
      <h3>{issue.title}</h3>
      <p>{issue.description}</p>
    </article>
  ))}
</div>

<style>
  .issue-grid { display: grid; grid-template-columns: repeat(var(--issue-columns), minmax(0, 1fr)); gap: 16px; }
  .issue-grid--2 { --issue-columns: 2; }
  .issue-grid--3 { --issue-columns: 3; }
  .issue-grid--4 { --issue-columns: 4; }
  .issue-card { min-height: 245px; padding: clamp(24px, 3.5vw, 38px); border: 1px solid var(--border-default); border-top: 4px solid var(--status-missed); background: var(--surface-card); }
  .issue-card__status { margin: 0 0 20px; color: var(--status-missed); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .issue-card__value { margin: 0 0 14px; color: var(--status-missed); font-size: clamp(34px, 4vw, 54px); font-weight: 300; font-variant-numeric: tabular-nums; line-height: 1; }
  .issue-card h3 { color: var(--text-primary); font-family: var(--font-display); font-size: 24px; line-height: 1.15; }
  .issue-card > p:last-child { margin: 14px 0 0; color: var(--text-secondary); font-size: 14px; line-height: 1.55; }
  @media (max-width: 820px) { .issue-grid { grid-template-columns: 1fr; } .issue-card { min-height: 0; } }
</style>
