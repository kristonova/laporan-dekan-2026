---
/**
 * Satu slide bahan tayang Rapat Senat.
 *
 * Perbedaan pokok dari versi sebelumnya: slide tidak lagi menggambar ulang
 * datanya sendiri. Versi lama punya enam "mode" (stat, bars, status, flow, gap,
 * cards) yang masing-masing melukis batang dan angkanya sendiri dari larik
 * `items` - itulah sumber kesan monoton, dan sekaligus sumber risiko bahwa
 * angka di bahan tayang menyimpang dari angka di halaman laporan.
 *
 * Sekarang slide hanyalah bingkai. Grafiknya masuk lewat <slot> sebagai
 * komponen yang sama persis dengan yang dipakai halaman laporan, dengan data
 * dan properti yang sama. Bahan tayang dan laporan mustahil berselisih karena
 * keduanya merender komponen yang sama dari berkas turunan yang sama.
 *
 * Koreografi masuk ditulis tangan di sini lewat atribut data-anim; skrip deck
 * hanya melepasnya dengan satu kelas dan mengurus tanda-tanda di dalam grafik.
 * Lihat src/styles/deck-motion.css.
 */
import { withBase } from "../lib/paths";

interface Item {
  label: string;
  value: string;
  description?: string;
}

interface Photo {
  src: string;
  alt: string;
  /** Perlakuan visual foto, dipilih agar data tetap menjadi fokus utama. */
  mode: "background" | "portrait" | "inset" | "right-wash" | "left-wash" | "top-wash" | "bottom-wash" | "full-wash";
  /** Titik fokus CSS object-position untuk crop yang ringan. */
  position?: string;
  /** Foto beresolusi terbatas ditampilkan utuh, bukan dipotong agresif. */
  fit?: "cover" | "contain";
}

interface CollagePhoto {
  src: string;
  alt: string;
  /** Titik fokus masing-masing foto supaya subjek tetap terbaca dalam mosaik. */
  position?: string;
}

interface Props {
  number: string;
  /** Bingkai bawaan (chart) sampai penutup; menentukan tata letak dan warna. */
  layout?: "title" | "divider" | "chart" | "stat" | "cards" | "closing";
  kicker?: string;
  title: string;
  /** Satu kalimat yang menjadi klaim slide. Satu slide, satu klaim. */
  takeaway?: string;
  /** Angka utama pada kolom kiri slide chart, atau tokoh utama slide stat. */
  stat?: string;
  statLabel?: string;
  /** Baris kecil di bawah angka: pembanding, rentang, atau peringatan cakupan. */
  statNote?: string;
  items?: Item[];
  /** Kutipan penutup. */
  quote?: string;
  quoteBy?: string;
  /** Identitas penyaji pada slide judul. */
  presenter?: string;
  presenterRole?: string;
  period?: string;
  source?: string;
  note: string;
  dark?: boolean;
  /** Aksen pilar: mewarnai angka pilar dan rule pada slide pemisah. */
  accent?: "blue" | "orange" | "green" | "violet" | "teal";
  /** Dokumentasi visual pendukung, bukan bukti angka pada slide. */
  photo?: Photo;
  /** Mosaik kegiatan untuk pembuka; dipisah dari foto tunggal agar tidak menjadi potret tokoh. */
  coverCollage?: CollagePhoto[];
  /** Perlakuan khusus panggung visual untuk grafik yang memerlukan komposisi lebar. */
  stageVariant?: "map-wide";
}

const {
  number,
  layout = "chart",
  kicker,
  title,
  takeaway,
  stat,
  statLabel,
  statNote,
  items = [],
  quote,
  quoteBy,
  presenter,
  presenterRole,
  period,
  source,
  note,
  dark = layout === "title" || layout === "divider" || layout === "closing",
  accent = "blue",
  photo,
  coverCollage,
  stageVariant,
} = Astro.props;

const titleId = `slide-${number.replaceAll(".", "-")}-title`;
const lightLogoUrl = withBase("/brand/logo-horizontal-stackup.png");
const darkLogoUrl = withBase("/brand/logo-horizontal-white.png");
const motifUrl = withBase("/brand/supergraphic-lines.png");
const hasChrome = layout !== "title" && layout !== "divider" && layout !== "closing";
const coverPhotos = coverCollage?.slice(0, 4) ?? [];
const hasCoverCollage = coverPhotos.length > 0;
---

<section
  class:list={[
    "dslide",
    `dslide--${layout}`,
    photo ? `has-photo--${photo.mode}` : undefined,
    hasCoverCollage ? "has-cover-collage" : undefined,
    { "is-dark": dark, "has-photo": Boolean(photo) },
  ]}
  data-deck-slide
  data-slide-layout={layout}
  aria-labelledby={titleId}
>
  {
    photo && (
      <figure
        class:list={[
          "dslide__photo",
          `dslide__photo--${photo.mode}`,
          { "dslide__photo--contain": photo.fit === "contain" },
        ]}
        style={`--photo-position:${photo.position ?? "center"}`}
      >
        <img src={photo.src} alt={photo.alt} loading="eager" decoding="async" />
      </figure>
    )
  }
  {
    hasCoverCollage && (
      <div class="dslide__collage" role="group" aria-label="Dokumentasi kegiatan FMIPA">
        {coverPhotos.map((item) => (
          <figure style={`--photo-position:${item.position ?? "center"}`}>
            <img src={item.src} alt={item.alt} loading="eager" decoding="async" />
          </figure>
        ))}
      </div>
    )
  }
  {dark && <div class="dslide__motif" aria-hidden="true" style={`background-image:url(${JSON.stringify(motifUrl)})`}></div>}

  {
    hasChrome && (
      <header class="dslide__head">
        <div class="dslide__id">
          <p data-anim="turun">{kicker}</p>
          <span data-anim="turun" style="--tunda:60ms">{number}</span>
        </div>
        <img src={lightLogoUrl} width="200" height="57" alt="Universitas Gadjah Mada" data-anim="pudar" style="--tunda:60ms" />
      </header>
    )
  }

  {/* --- Slide judul ------------------------------------------------------ */}
  {
    layout === "title" && (
      <div class="dslide__body dslide__body--title">
        <img class="dslide__logo-tl" src={darkLogoUrl} width="240" height="68" alt="Universitas Gadjah Mada" data-anim="pudar" />
        <div>
          <p class="dslide__eyebrow" data-anim="turun" style="--tunda:120ms">{kicker}</p>
          <h1 id={titleId} data-anim="naik" style="--tunda:200ms">{title}</h1>
          <div class="dslide__rule" data-anim="lebar" style="--tunda:320ms" aria-hidden="true"></div>
          {takeaway && <p class="dslide__lede" data-anim="naik" style="--tunda:400ms">{takeaway}</p>}
          {presenter && (
            <div class="dslide__presenter" data-anim="naik" style="--tunda:480ms">
              <strong>{presenter}</strong>
              {presenterRole && <span>{presenterRole}</span>}
              {period && <span>{period}</span>}
            </div>
          )}
        </div>
      </div>
    )
  }

  {/* --- Slide pemisah pilar --------------------------------------------- */}
  {
    layout === "divider" && (
      <div class:list={["dslide__body", "dslide__body--divider", `accent-${accent}`]}>
        <p class="dslide__pillar-no" data-anim="kanan">{number}</p>
        <div>
          <p class="dslide__eyebrow" data-anim="turun" style="--tunda:80ms">{kicker}</p>
          <h2 id={titleId} data-anim="naik" style="--tunda:160ms">{title}</h2>
          <div class="dslide__rule" data-anim="lebar" style="--tunda:280ms" aria-hidden="true"></div>
          {takeaway && <p class="dslide__lede" data-anim="naik" style="--tunda:360ms">{takeaway}</p>}
        </div>
      </div>
    )
  }

  {/* --- Slide grafik: klaim di kiri, grafik asli di kanan ---------------- */}
  {
    layout === "chart" && (
      <div class="dslide__body dslide__body--chart">
        <div class="dslide__copy">
          <div class="dslide__rule" data-anim="lebar" style="--tunda:120ms" aria-hidden="true"></div>
          <h2 id={titleId} data-anim="naik" style="--tunda:180ms">{title}</h2>
          {stat && (
            <p class="dslide__stat" data-anim="naik" style="--tunda:260ms">
              <strong data-deck-count>{stat}</strong>
              {statLabel && <span>{statLabel}</span>}
            </p>
          )}
          {takeaway && <p class="dslide__takeaway" data-anim="naik" style="--tunda:320ms">{takeaway}</p>}
          {statNote && <p class="dslide__statnote" data-anim="pudar" style="--tunda:420ms">{statNote}</p>}
        </div>
        <div class:list={["dslide__stage", stageVariant ? `dslide__stage--${stageVariant}` : undefined]} data-deck-chart>
          <slot />
        </div>
      </div>
    )
  }

  {/* --- Slide angka tunggal ---------------------------------------------- */}
  {
    layout === "stat" && (
      <div class="dslide__body dslide__body--stat">
        <div class="dslide__copy">
          <div class="dslide__rule" data-anim="lebar" style="--tunda:120ms" aria-hidden="true"></div>
          <h2 id={titleId} data-anim="naik" style="--tunda:180ms">{title}</h2>
          {takeaway && <p class="dslide__takeaway" data-anim="naik" style="--tunda:260ms">{takeaway}</p>}
        </div>
        <div class="dslide__hero">
          <strong data-anim="naik" style="--tunda:340ms" data-deck-count>{stat}</strong>
          {statLabel && <span data-anim="naik" style="--tunda:440ms">{statLabel}</span>}
          {statNote && <em data-anim="pudar" style="--tunda:540ms">{statNote}</em>}
        </div>
      </div>
    )
  }

  {/* --- Slide kartu potret ----------------------------------------------- */}
  {
    layout === "cards" && (
      <div class="dslide__body dslide__body--cards">
        <div class="dslide__copy">
          <div class="dslide__rule" data-anim="lebar" style="--tunda:120ms" aria-hidden="true"></div>
          <h2 id={titleId} data-anim="naik" style="--tunda:180ms">{title}</h2>
          {takeaway && <p class="dslide__takeaway" data-anim="naik" style="--tunda:260ms">{takeaway}</p>}
        </div>
        <div class="dslide__cards">
          {items.map((item, index) => (
            <article data-anim="naik" style={`--tunda:${320 + index * 70}ms`}>
              <strong data-deck-count>{item.value}</strong>
              <h3>{item.label}</h3>
              {item.description && <p>{item.description}</p>}
            </article>
          ))}
        </div>
      </div>
    )
  }

  {/* --- Slide penutup ----------------------------------------------------- */}
  {
    layout === "closing" && (
      <div class="dslide__body dslide__body--closing">
        <img class="dslide__logo-tl" src={darkLogoUrl} width="240" height="68" alt="Universitas Gadjah Mada" data-anim="pudar" />
        <div>
          <p class="dslide__eyebrow" data-anim="turun" style="--tunda:120ms">{kicker}</p>
          <h2 id={titleId} data-anim="naik" style="--tunda:200ms">{title}</h2>
          <div class="dslide__rule" data-anim="lebar" style="--tunda:320ms" aria-hidden="true"></div>
          {quote && (
            <blockquote data-anim="naik" style="--tunda:400ms">
              <p>{quote}</p>
              {quoteBy && <cite>{quoteBy}</cite>}
            </blockquote>
          )}
          {takeaway && <p class="dslide__lede" data-anim="naik" style="--tunda:520ms">{takeaway}</p>}
        </div>
      </div>
    )
  }

  {
    hasChrome && (
      <footer class="dslide__foot" data-anim="pudar" style="--tunda:520ms">
        <span>{source ? `Sumber: ${source}` : ""}</span>
        <span>Laporan Dekan FMIPA UGM · 2021–2026</span>
      </footer>
    )
  }

  <aside class="dslide__notes" data-deck-notes aria-label="Catatan Presenter">
    <strong>Catatan Presenter</strong>
    <p>{note}</p>
  </aside>
</section>

<style>
  /* ---------------------------------------------------------------------
     Kerangka slide. Tinggi dikunci ke viewport supaya tidak pernah ada
     gulir di dalam slide: apa pun yang tidak muat harus dipangkas dari
     naskahnya, bukan digulir oleh penonton.
     --------------------------------------------------------------------- */
  .dslide {
    --pad-x: max(clamp(32px, 3.4vw, 60px), calc((100vw - 1920px) / 2 + 60px));
    --pad-y: clamp(22px, 3.1dvh, 34px);
    position: relative;
    block-size: 100dvh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: clamp(8px, 1.1dvh, 14px);
    padding: var(--pad-y) var(--pad-x) 20px;
    overflow: hidden;
    background: var(--surface-page);
    color: var(--text-primary);
  }

  .dslide.is-dark {
    background: var(--ugm-blue-deep);
    color: #fff;
  }

  /* Dokumentasi foto selalu menjadi konteks visual. Pada slide data, foto
     hadir sebagai bidang besar yang dilunakkan—bukan kartu ketiga—agar angka
     dan grafik tetap memperoleh panggung utama. */
  .dslide__photo {
    position: absolute;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .dslide__photo img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--photo-position, center);
  }
  .dslide__photo--contain img { object-fit: contain; }

  .dslide__photo--background {
    z-index: 0;
    inset: 0;
    background: var(--ugm-blue-deep);
  }
  .dslide__photo--background img {
    filter: blur(2.5px) brightness(.58) saturate(.72);
    transform: scale(1.045);
  }
  .dslide__photo--background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(11 31 46 / 94%) 0%, rgb(11 31 46 / 74%) 56%, rgb(11 31 46 / 58%) 100%);
  }

  .dslide__photo--portrait {
    z-index: 1;
    inset: clamp(34px, 7dvh, 76px) var(--pad-x) clamp(28px, 5dvh, 56px) auto;
    inline-size: min(30vw, 470px);
    aspect-ratio: 3 / 4;
    border: 1px solid rgb(255 255 255 / 24%);
    border-block-end: 4px solid var(--ugm-gold);
    background: #091926;
    box-shadow: 0 24px 56px rgb(0 0 0 / 28%);
  }
  .dslide--title.has-photo--portrait .dslide__body--title { max-inline-size: min(54ch, 58%); }

  .dslide__photo--inset {
    z-index: 1;
    inset: 50% var(--pad-x) auto auto;
    inline-size: min(27vw, 410px);
    aspect-ratio: 4 / 3;
    transform: translateY(-50%);
    border: 1px solid rgb(255 255 255 / 34%);
    border-inline-start: 4px solid var(--ugm-gold);
    background: rgb(8 26 39 / 82%);
    box-shadow: 0 18px 44px rgb(0 0 0 / 26%);
  }
  .dslide__photo--inset img { padding: 8px; }
  .dslide.has-photo--inset .dslide__body--divider { padding-inline-end: min(31vw, 470px); }

  /* Foto pada slide data tidak memakai aturan letak tunggal. Keempat varian
     ini memberi ritme yang berbeda antarslide, tetap dengan blur dan wash
     putih agar teks maupun grafik selalu terbaca lebih dahulu. */
  .dslide__photo--right-wash,
  .dslide__photo--left-wash,
  .dslide__photo--top-wash,
  .dslide__photo--bottom-wash,
  .dslide__photo--full-wash {
    z-index: 0;
    background: var(--surface-page, #fff);
  }
  .dslide__photo--right-wash img,
  .dslide__photo--left-wash img,
  .dslide__photo--top-wash img,
  .dslide__photo--bottom-wash img,
  .dslide__photo--full-wash img {
    filter: blur(1.6px) saturate(.70) brightness(1.08) contrast(.91);
    transform: scale(1.04);
  }
  .dslide__photo--right-wash::after,
  .dslide__photo--left-wash::after,
  .dslide__photo--top-wash::after,
  .dslide__photo--bottom-wash::after,
  .dslide__photo--full-wash::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .dslide__photo--right-wash {
    inset: 0 0 0 auto;
    inline-size: min(61vw, 1120px);
  }
  .dslide__photo--right-wash::after {
    background: linear-gradient(90deg, var(--surface-page, #fff) 0%, rgb(255 255 255 / 98%) 20%, rgb(255 255 255 / 86%) 47%, rgb(255 255 255 / 58%) 100%);
  }

  .dslide__photo--left-wash {
    inset: 0 auto 0 0;
    inline-size: min(58vw, 1060px);
  }
  .dslide__photo--left-wash::after {
    background: linear-gradient(90deg, rgb(255 255 255 / 64%) 0%, rgb(255 255 255 / 82%) 42%, rgb(255 255 255 / 98%) 78%, var(--surface-page, #fff) 100%);
  }

  .dslide__photo--top-wash {
    inset: 0 0 auto;
    block-size: min(46dvh, 470px);
  }
  .dslide__photo--top-wash::after {
    background: linear-gradient(180deg, rgb(255 255 255 / 46%) 0%, rgb(255 255 255 / 72%) 52%, var(--surface-page, #fff) 100%);
  }

  .dslide__photo--bottom-wash {
    inset: auto 0 0;
    block-size: min(52dvh, 560px);
  }
  .dslide__photo--bottom-wash::after {
    background: linear-gradient(180deg, var(--surface-page, #fff) 0%, rgb(255 255 255 / 82%) 29%, rgb(255 255 255 / 48%) 100%);
  }

  .dslide__photo--full-wash { inset: 0; }
  .dslide__photo--full-wash::after {
    background: linear-gradient(90deg, rgb(255 255 255 / 95%) 0%, rgb(255 255 255 / 82%) 48%, rgb(255 255 255 / 61%) 100%);
  }

  /* Band emas di tepi bawah. Aturan identitas: sudut tajam, tidak pernah
     membulat, tidak pernah memudar. */
  .dslide::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    block-size: 10px;
    background: var(--ugm-gold);
  }

  .dslide__motif {
    position: absolute;
    inset: -28% -14% auto auto;
    inline-size: min(60vw, 780px);
    aspect-ratio: 1;
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    opacity: .09;
    filter: brightness(0) invert(1);
  }

  /* --- Kepala dan kaki -------------------------------------------------- */

  .dslide__head {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .dslide__id { display: flex; align-items: baseline; gap: 16px; }
  .dslide__id p {
    color: var(--text-muted);
    font-size: clamp(15px, 1.85dvh, 18px);
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .dslide__id span { color: var(--ugm-gold); font-weight: 700; font-variant-numeric: tabular-nums; }
  .dslide__head img { inline-size: clamp(150px, 11vw, 200px); block-size: auto; }

  .dslide__foot {
    position: relative;
    z-index: 2;
    align-self: end;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--text-muted);
    font-size: clamp(14px, 1.65dvh, 16px);
  }
  .is-dark .dslide__foot { color: rgb(255 255 255 / 70%); }

  .dslide__body { position: relative; z-index: 2; min-block-size: 0; min-inline-size: 0; }

  .dslide__rule {
    inline-size: 82px;
    block-size: 3px;
    margin-block-end: clamp(16px, 2.6dvh, 26px);
    background: var(--ugm-gold);
  }

  .dslide__eyebrow {
    color: var(--ugm-gold);
    font-size: clamp(15px, 2dvh, 19px);
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  /* --- Slide judul ------------------------------------------------------- */

  .dslide--title,
  .dslide--closing { grid-template-rows: minmax(0, 1fr); }

  .dslide__body--title,
  .dslide__body--closing {
    display: grid;
    align-content: center;
    max-inline-size: 60ch;
  }
  .dslide__logo-tl {
    inline-size: clamp(180px, 13vw, 240px);
    block-size: auto;
    margin-block-end: clamp(30px, 5dvh, 62px);
  }
  .dslide__body--title h1 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(48px, min(5vw, 8.7dvh), 84px);
    line-height: 1.02;
    letter-spacing: -.03em;
  }
  .dslide__body--title .dslide__rule { margin-block: clamp(22px, 3.4dvh, 34px) 0; }
  .dslide__lede {
    max-inline-size: 52ch;
    margin-block-start: clamp(18px, 2.8dvh, 28px);
    color: rgb(255 255 255 / 78%);
    font-size: clamp(18px, min(1.7vw, 2.6dvh), 24px);
    line-height: 1.5;
  }
  .dslide__presenter {
    margin-block-start: clamp(28px, 4.4dvh, 48px);
    padding-inline-start: 20px;
    border-inline-start: 3px solid var(--ugm-gold);
    display: grid;
    gap: 4px;
  }
  .dslide__presenter strong { color: #fff; font-size: clamp(20px, 2.7dvh, 27px); }
  .dslide__presenter span { color: rgb(255 255 255 / 66%); font-size: clamp(16px, 2dvh, 19px); }

  /* Kolase pembuka memvisualkan empat ranah kegiatan, tanpa mengangkat
     satu tokoh sebagai pusat perhatian. Tata letak editorial yang tak simetris
     memberi bobot pada foto riset, lalu mengalir ke inovasi, pengabdian, dan
     luaran pendidikan. */
  .dslide__collage {
    position: absolute;
    z-index: 1;
    inset: 50% var(--pad-x) auto auto;
    inline-size: min(38vw, 640px);
    block-size: min(68dvh, 680px);
    display: grid;
    grid-template-columns: 1.14fr .86fr;
    grid-template-rows: 1fr 1fr .78fr;
    gap: 10px;
    padding: 10px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 22%);
    border-block-end: 4px solid var(--ugm-gold);
    background: rgb(255 255 255 / 8%);
    box-shadow: 0 24px 56px rgb(0 0 0 / 28%);
    transform: translateY(-50%);
  }
  .dslide__collage figure {
    min-inline-size: 0;
    margin: 0;
    overflow: hidden;
    background: #091926;
  }
  .dslide__collage figure:first-child { grid-row: span 2; }
  .dslide__collage figure:last-child { grid-column: span 2; }
  .dslide__collage img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--photo-position, center);
    filter: saturate(.82) contrast(.96);
  }
  .dslide--title.has-cover-collage .dslide__body--title { max-inline-size: min(49ch, 54%); }

  /* --- Slide pemisah pilar ---------------------------------------------- */

  .dslide--divider { grid-template-rows: minmax(0, 1fr); }
  .dslide__body--divider {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(32px, 5vw, 76px);
