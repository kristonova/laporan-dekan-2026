---
import { withBase } from "../lib/paths";

interface Item {
  label: string;
  value?: number;
  display?: string;
  max?: number;
  description?: string;
  status?: "good" | "near" | "behind" | "missed" | "neutral";
}
interface Props {
  number: string;
  kicker: string;
  title: string;
  takeaway: string;
  source: string;
  note: string;
  mode?: "stat" | "bars" | "status" | "flow" | "gap" | "cards";
  stat?: string;
  statLabel?: string;
  items?: Item[];
  dark?: boolean;
}
const {
  number, kicker, title, takeaway, source, note,
  mode = "stat", stat, statLabel, items = [], dark = false,
} = Astro.props;
const maxValue = Math.max(1, ...items.map((item) => item.max ?? item.value ?? 0));
const lightLogoUrl = withBase("/brand/logo-horizontal-stackup.png");
const darkLogoUrl = withBase("/brand/logo-horizontal-white.png");
const motifStyle = `background-image: url(${JSON.stringify(withBase("/brand/supergraphic-lines.png"))})`;
---

<section class:list={["presentation-slide", { "presentation-slide--dark": dark }]} data-presentation-slide aria-labelledby={`slide-${number.replaceAll(".", "-")}-title`}>
  <div class="presentation-slide__motif" aria-hidden="true" style={motifStyle}></div>
  <header class="presentation-slide__header">
    <div>
      <p>{kicker}</p>
      <span>{number}</span>
    </div>
    <img src={dark ? darkLogoUrl : lightLogoUrl} width="200" height="57" alt="Universitas Gadjah Mada" />
  </header>
  <div class="presentation-slide__body">
    <div class="presentation-slide__copy">
      <div class="presentation-slide__rule" aria-hidden="true"></div>
      <h2 id={`slide-${number.replaceAll(".", "-")}-title`}>{title}</h2>
      <p>{takeaway}</p>
    </div>

    <div class:list={["presentation-visual", `presentation-visual--${mode}`]}>
      {mode === "stat" && <><strong>{stat}</strong>{statLabel && <span>{statLabel}</span>}</>}
      {mode === "gap" && <><strong>?</strong><span>{statLabel ?? "Data belum tersedia"}</span></>}
      {(mode === "bars" || mode === "status") && (
        <div class="presentation-bars">
          {items.map((item) => (
            <div class={`presentation-bar presentation-bar--${item.status ?? "neutral"}`}>
              <div><span>{item.label}</span><strong>{item.display ?? item.value}</strong></div>
              <i><b style={`width:${Math.min(100, ((item.value ?? 0) / (item.max ?? maxValue)) * 100)}%`}></b></i>
              {item.description && <small>{item.description}</small>}
            </div>
          ))}
        </div>
      )}
      {mode === "flow" && (
        <div class="presentation-flow">
          {items.map((item, index) => <><div><strong>{item.display ?? item.value}</strong><span>{item.label}</span></div>{index < items.length - 1 && <i aria-hidden="true">→</i>}</>)}
        </div>
      )}
      {mode === "cards" && (
        <div class="presentation-cards">
          {items.map((item) => <article class={`is-${item.status ?? "neutral"}`}><strong>{item.display ?? item.value}</strong><h3>{item.label}</h3>{item.description && <p>{item.description}</p>}</article>)}
        </div>
      )}
    </div>
  </div>
  <footer class="presentation-slide__footer"><span>Sumber: {source}</span><span>Lima Tahun FMIPA · 2021–2026</span></footer>
  <aside class="presenter-notes" data-presenter-notes aria-label="Catatan presenter"><strong>Catatan presenter</strong><p>{note}</p></aside>
</section>

<style>
  .presentation-slide { min-height: 100svh; height: 100svh; position: relative; overflow: hidden; padding: 38px 54px 44px; background: var(--surface-page); color: var(--text-primary); }
  .presentation-slide--dark { background: var(--ugm-blue-deep); color: #fff; }
  .presentation-slide__header { height: 64px; position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: flex-start; }
  .presentation-slide__header > div { display: flex; align-items: baseline; gap: 16px; }
  .presentation-slide__header p { color: var(--text-muted); font-size: 16px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .presentation-slide--dark .presentation-slide__header p { color: rgba(255,255,255,.62); }
  .presentation-slide__header span { color: var(--ugm-gold); font-weight: 700; }
  .presentation-slide__header img { width: 200px; height: auto; }
  .presentation-slide__body { height: calc(100% - 112px); display: grid; grid-template-columns: minmax(360px, .88fr) minmax(500px, 1.12fr); gap: clamp(36px, 5vw, 76px); align-items: center; }
  .presentation-slide__rule { width: 82px; height: 3px; margin-block-end: 28px; background: var(--ugm-gold); }
  .presentation-slide h2 { max-width: 12ch; color: inherit; font-family: var(--font-display); font-size: clamp(44px, 4.6vw, 68px); line-height: 1; letter-spacing: -.03em; }
  .presentation-slide__copy > p { max-width: 48ch; margin-block-start: 24px; color: var(--text-secondary); font-size: clamp(17px, 1.55vw, 22px); line-height: 1.48; }
  .presentation-slide--dark .presentation-slide__copy > p { color: rgba(255,255,255,.75); }
  .presentation-visual { min-height: 430px; display: grid; align-content: center; }
  .presentation-visual--stat, .presentation-visual--gap { padding: 46px; border-inline-start: 4px solid var(--ugm-gold); }
  .presentation-visual--stat > strong, .presentation-visual--gap > strong { color: var(--ugm-blue); font-size: clamp(84px, 11vw, 156px); font-weight: 300; font-variant-numeric: tabular-nums; letter-spacing: -.06em; line-height: .85; }
  .presentation-slide--dark .presentation-visual--stat > strong, .presentation-slide--dark .presentation-visual--gap > strong { color: var(--ugm-gold); }
  .presentation-visual--stat > span, .presentation-visual--gap > span { max-width: 28ch; margin-block-start: 26px; color: var(--text-secondary); font-size: 24px; line-height: 1.25; }
  .presentation-slide--dark .presentation-visual--stat > span, .presentation-slide--dark .presentation-visual--gap > span { color: rgba(255,255,255,.76); }
  .presentation-bars { display: grid; gap: 20px; }
  .presentation-bar > div { display: flex; justify-content: space-between; gap: 20px; align-items: baseline; }
  .presentation-bar span { color: inherit; font-size: 17px; }.presentation-bar strong { color: var(--bar-color); font-size: 25px; font-weight: 700; font-variant-numeric: tabular-nums; }.presentation-bar > i { height: 13px; margin-block-start: 7px; display: block; background: var(--border-subtle); }.presentation-bar > i b { height: 100%; display: block; background: var(--bar-color); }.presentation-bar small { display: block; margin-block-start: 5px; color: var(--text-muted); }.presentation-bar--good { --bar-color: var(--status-achieved); }.presentation-bar--near { --bar-color: var(--status-info); }.presentation-bar--behind { --bar-color: var(--status-lagging); }.presentation-bar--missed { --bar-color: var(--status-missed); }.presentation-bar--neutral { --bar-color: var(--ugm-blue); }
  .presentation-slide--dark .presentation-bar--neutral { --bar-color: var(--ugm-gold); }.presentation-slide--dark .presentation-bar > i { background: rgba(255,255,255,.16); }
  .presentation-flow { display: grid; grid-template-columns: repeat(7, auto); align-items: center; gap: 12px; }
  .presentation-flow > div { min-width: 132px; min-height: 160px; padding: 22px; border: 1px solid var(--border-default); border-top: 4px solid var(--ugm-blue); background: var(--surface-card); display: flex; flex-direction: column; justify-content: center; }.presentation-flow strong { color: var(--ugm-blue); font-size: 31px; font-weight: 300; }.presentation-flow span { margin-block-start: 8px; color: var(--text-secondary); font-size: 13px; }.presentation-flow > i { color: var(--status-approaching); font-size: 24px; font-style: normal; }
  .presentation-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }.presentation-cards article { min-height: 170px; padding: 24px; border: 1px solid var(--border-default); border-top: 4px solid var(--card-color); background: var(--surface-card); color: var(--text-primary); }.presentation-cards article.is-good { --card-color: var(--status-achieved); }.presentation-cards article.is-near { --card-color: var(--status-info); }.presentation-cards article.is-behind { --card-color: var(--status-lagging); }.presentation-cards article.is-missed { --card-color: var(--status-missed); }.presentation-cards article.is-neutral { --card-color: var(--ugm-blue); }.presentation-cards strong { color: var(--card-color); font-size: 34px; font-weight: 300; }.presentation-cards h3 { margin-block-start: 8px; color: var(--text-primary); font-family: var(--font-ui); font-size: 17px; }.presentation-cards p { margin-block-start: 8px; color: var(--text-secondary); font-size: 13px; }
  .presentation-slide__footer { position: absolute; inset: auto 54px 18px; display: flex; justify-content: space-between; gap: 20px; color: var(--text-muted); font-size: 16px; letter-spacing: .02em; }.presentation-slide--dark .presentation-slide__footer { color: rgba(255,255,255,.7); }
  .presentation-slide::after { content: ""; position: absolute; inset: auto 0 0; height: 10px; background: var(--ugm-gold); }
  .presentation-slide__motif { display: none; position: absolute; inset: -30% -12% auto auto; width: min(62vw, 760px); aspect-ratio: 1; background-position: center; background-size: contain; background-repeat: no-repeat; opacity: .08; filter: brightness(0) invert(1); }.presentation-slide--dark .presentation-slide__motif { display: block; }
  .presenter-notes { display: none; position: absolute; z-index: 10; inset: auto 54px 46px auto; width: min(520px, calc(100% - 108px)); padding: 20px 24px; border: 2px solid var(--ugm-gold); background: #0B1F2E; color: #fff; box-shadow: 0 14px 40px rgb(0 0 0 / 28%); }.presenter-notes strong { color: var(--ugm-gold); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }.presenter-notes p { margin-block-start: 8px; color: #fff; font-size: 15px; }
  [data-notes-visible="true"] .presenter-notes { display: block; }
  @media(max-width:900px){.presentation-slide{height:auto;min-height:100svh;padding:28px 28px 54px}.presentation-slide__body{height:auto;grid-template-columns:1fr;align-content:center}.presentation-visual{min-height:260px}.presentation-flow{grid-template-columns:1fr}.presentation-flow>i{transform:rotate(90deg);justify-self:center}.presentation-slide__footer{inset-inline:28px;font-size:13px}.presentation-slide__header p{font-size:13px}.presentation-slide__header img{width:180px}}
</style>
