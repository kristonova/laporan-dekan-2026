---
/**
 * Satu slide bahan tayang Rapat Senat.
 *
 * Perbedaan pokok dari versi sebelumnya: slide tidak lagi menggambar ulang
 * datanya sendiri. Versi lama punya enam "mode" (stat, bars, status, flow, gap,
 * cards) yang masing-masing melukis batang dan angkanya sendiri dari larik
 * `items` - itulah sumber kesan monoton, dan sekaligus sumber risiko bahwa
 * angka di bahan tayang menyimpang dari angka di halaman laporan.
 *
 * Sekarang slide hanyalah bingkai. Grafiknya masuk lewat <slot> sebagai
 * komponen yang sama persis dengan yang dipakai halaman laporan, dengan data
 * dan properti yang sama. Bahan tayang dan laporan mustahil berselisih karena
 * keduanya merender komponen yang sama dari berkas turunan yang sama.
 *
 * Koreografi masuk ditulis tangan di sini lewat atribut data-anim; skrip deck
 * hanya melepasnya dengan satu kelas dan mengurus tanda-tanda di dalam grafik.
 * Lihat src/styles/deck-motion.css.
 */
import { withBase } from "../lib/paths";

interface Item {
  label: string;
  value: string;
  description?: string;
}

interface Props {
  number: string;
  /** Bingkai bawaan (chart) sampai penutup; menentukan tata letak dan warna. */
  layout?: "title" | "divider" | "chart" | "stat" | "cards" | "closing";
  kicker?: string;
  title: string;
  /** Satu kalimat yang menjadi klaim slide. Satu slide, satu klaim. */
  takeaway?: string;
  /** Angka utama pada kolom kiri slide chart, atau tokoh utama slide stat. */
  stat?: string;
  statLabel?: string;
  /** Baris kecil di bawah angka: pembanding, rentang, atau peringatan cakupan. */
  statNote?: string;
  items?: Item[];
  /** Kutipan penutup. */
  quote?: string;
  quoteBy?: string;
  /** Identitas penyaji pada slide judul. */
  presenter?: string;
  presenterRole?: string;
  period?: string;
  source?: string;
  note: string;
  dark?: boolean;
  /** Aksen pilar: mewarnai angka pilar dan rule pada slide pemisah. */
  accent?: "blue" | "orange" | "green" | "violet" | "teal";
}

const {
  number,
  layout = "chart",
  kicker,
  title,
  takeaway,
  stat,
  statLabel,
  statNote,
  items = [],
  quote,
  quoteBy,
  presenter,
  presenterRole,
  period,
  source,
  note,
  dark = layout === "title" || layout === "divider" || layout === "closing",
  accent = "blue",
} = Astro.props;

const titleId = `slide-${number.replaceAll(".", "-")}-title`;
const lightLogoUrl = withBase("/brand/logo-horizontal-stackup.png");
const darkLogoUrl = withBase("/brand/logo-horizontal-white.png");
const motifUrl = withBase("/brand/supergraphic-lines.png");
const hasChrome = layout !== "title" && layout !== "divider" && layout !== "closing";
---

<section
  class:list={["dslide", `dslide--${layout}`, { "is-dark": dark }]}
  data-deck-slide
  data-slide-layout={layout}
  aria-labelledby={titleId}
>
  {dark && <div class="dslide__motif" aria-hidden="true" style={`background-image:url(${JSON.stringify(motifUrl)})`}></div>}

  {
    hasChrome && (
      <header class="dslide__head">
        <div class="dslide__id">
          <p data-anim="turun">{kicker}</p>
          <span data-anim="turun" style="--tunda:60ms">{number}</span>
        </div>
        <img src={lightLogoUrl} width="200" height="57" alt="Universitas Gadjah Mada" data-anim="pudar" style="--tunda:60ms" />
      </header>
    )
  }

  {/* --- Slide judul ------------------------------------------------------ */}
  {
    layout === "title" && (
      <div class="dslide__body dslide__body--title">
        <img class="dslide__logo-tl" src={darkLogoUrl} width="240" height="68" alt="Universitas Gadjah Mada" data-anim="pudar" />
        <div>
          <p class="dslide__eyebrow" data-anim="turun" style="--tunda:120ms">{kicker}</p>
          <h1 id={titleId} data-anim="naik" style="--tunda:200ms">{title}</h1>
          <div class="dslide__rule" data-anim="lebar" style="--tunda:320ms" aria-hidden="true"></div>
          {takeaway && <p class="dslide__lede" data-anim="naik" style="--tunda:400ms">{takeaway}</p>}
          {presenter && (
            <div class="dslide__presenter" data-anim="naik" style="--tunda:480ms">
              <strong>{presenter}</strong>
              {presenterRole && <span>{presenterRole}</span>}
              {period && <span>{period}</span>}
            </div>
          )}
        </div>
      </div>
    )
  }

  {/* --- Slide pemisah pilar --------------------------------------------- */}
  {
    layout === "divider" && (
      <div class:list={["dslide__body", "dslide__body--divider", `accent-${accent}`]}>
        <p class="dslide__pillar-no" data-anim="kanan">{number}</p>
        <div>
          <p class="dslide__eyebrow" data-anim="turun" style="--tunda:80ms">{kicker}</p>
          <h2 id={titleId} data-anim="naik" style="--tunda:160ms">{title}</h2>
          <div class="dslide__rule" data-anim="lebar" style="--tunda:280ms" aria-hidden="true"></div>
          {takeaway && <p class="dslide__lede" data-anim="naik" style="--tunda:360ms">{takeaway}</p>}
        </div>
      </div>
    )
  }

  {/* --- Slide grafik: klaim di kiri, grafik asli di kanan ---------------- */}
  {
    layout === "chart" && (
      <div class="dslide__body dslide__body--chart">
        <div class="dslide__copy">
          <div class="dslide__rule" data-anim="lebar" style="--tunda:120ms" aria-hidden="true"></div>
          <h2 id={titleId} data-anim="naik" style="--tunda:180ms">{title}</h2>
          {stat && (
            <p class="dslide__stat" data-anim="naik" style="--tunda:260ms">
              <strong data-deck-count>{stat}</strong>
              {statLabel && <span>{statLabel}</span>}
            </p>
          )}
          {takeaway && <p class="dslide__takeaway" data-anim="naik" style="--tunda:320ms">{takeaway}</p>}
          {statNote && <p class="dslide__statnote" data-anim="pudar" style="--tunda:420ms">{statNote}</p>}
        </div>
        <div class="dslide__stage" data-deck-chart>
          <slot />
        </div>
      </div>
    )
  }

  {/* --- Slide angka tunggal ---------------------------------------------- */}
  {
    layout === "stat" && (
      <div class="dslide__body dslide__body--stat">
        <div class="dslide__copy">
          <div class="dslide__rule" data-anim="lebar" style="--tunda:120ms" aria-hidden="true"></div>
          <h2 id={titleId} data-anim="naik" style="--tunda:180ms">{title}</h2>
          {takeaway && <p class="dslide__takeaway" data-anim="naik" style="--tunda:260ms">{takeaway}</p>}
        </div>
        <div class="dslide__hero">
          <strong data-anim="naik" style="--tunda:340ms" data-deck-count>{stat}</strong>
          {statLabel && <span data-anim="naik" style="--tunda:440ms">{statLabel}</span>}
          {statNote && <em data-anim="pudar" style="--tunda:540ms">{statNote}</em>}
        </div>
      </div>
    )
  }

  {/* --- Slide kartu potret ----------------------------------------------- */}
  {
    layout === "cards" && (
      <div class="dslide__body dslide__body--cards">
        <div class="dslide__copy">
          <div class="dslide__rule" data-anim="lebar" style="--tunda:120ms" aria-hidden="true"></div>
          <h2 id={titleId} data-anim="naik" style="--tunda:180ms">{title}</h2>
          {takeaway && <p class="dslide__takeaway" data-anim="naik" style="--tunda:260ms">{takeaway}</p>}
        </div>
        <div class="dslide__cards">
          {items.map((item, index) => (
            <article data-anim="naik" style={`--tunda:${320 + index * 70}ms`}>
              <strong data-deck-count>{item.value}</strong>
              <h3>{item.label}</h3>
              {item.description && <p>{item.description}</p>}
            </article>
          ))}
        </div>
      </div>
    )
  }

  {/* --- Slide penutup ----------------------------------------------------- */}
  {
    layout === "closing" && (
      <div class="dslide__body dslide__body--closing">
        <img class="dslide__logo-tl" src={darkLogoUrl} width="240" height="68" alt="Universitas Gadjah Mada" data-anim="pudar" />
        <div>
          <p class="dslide__eyebrow" data-anim="turun" style="--tunda:120ms">{kicker}</p>
          <h2 id={titleId} data-anim="naik" style="--tunda:200ms">{title}</h2>
          <div class="dslide__rule" data-anim="lebar" style="--tunda:320ms" aria-hidden="true"></div>
          {quote && (
            <blockquote data-anim="naik" style="--tunda:400ms">
              <p>{quote}</p>
              {quoteBy && <cite>{quoteBy}</cite>}
            </blockquote>
          )}
          {takeaway && <p class="dslide__lede" data-anim="naik" style="--tunda:520ms">{takeaway}</p>}
        </div>
      </div>
    )
  }

  {
    hasChrome && (
      <footer class="dslide__foot" data-anim="pudar" style="--tunda:520ms">
        <span>{source ? `Sumber: ${source}` : ""}</span>
        <span>Lima Tahun FMIPA · 2021–2026</span>
      </footer>
    )
  }

  <aside class="dslide__notes" data-deck-notes aria-label="Catatan presenter">
    <strong>Catatan presenter</strong>
    <p>{note}</p>
  </aside>
</section>

<style>
  /* ---------------------------------------------------------------------
     Kerangka slide. Tinggi dikunci ke viewport supaya tidak pernah ada
     gulir di dalam slide: apa pun yang tidak muat harus dipangkas dari
     naskahnya, bukan digulir oleh penonton.
     --------------------------------------------------------------------- */
  .dslide {
    --pad-x: max(clamp(32px, 3.4vw, 60px), calc((100vw - 1920px) / 2 + 60px));
    --pad-y: clamp(26px, 3.6dvh, 40px);
    position: relative;
    block-size: 100dvh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: clamp(10px, 1.4dvh, 18px);
    padding: var(--pad-y) var(--pad-x) 20px;
    overflow: hidden;
    background: var(--surface-page);
    color: var(--text-primary);
  }

  .dslide.is-dark {
    background: var(--ugm-blue-deep);
    color: #fff;
  }

  /* Band emas di tepi bawah. Aturan identitas: sudut tajam, tidak pernah
     membulat, tidak pernah memudar. */
  .dslide::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    block-size: 10px;
    background: var(--ugm-gold);
  }

  .dslide__motif {
    position: absolute;
    inset: -28% -14% auto auto;
    inline-size: min(60vw, 780px);
    aspect-ratio: 1;
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    opacity: .09;
    filter: brightness(0) invert(1);
  }

  /* --- Kepala dan kaki -------------------------------------------------- */

  .dslide__head {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .dslide__id { display: flex; align-items: baseline; gap: 16px; }
  .dslide__id p {
    color: var(--text-muted);
    font-size: clamp(13px, 1.7dvh, 16px);
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .dslide__id span { color: var(--ugm-gold); font-weight: 700; font-variant-numeric: tabular-nums; }
  .dslide__head img { inline-size: clamp(150px, 11vw, 200px); block-size: auto; }

  .dslide__foot {
    position: relative;
    z-index: 2;
    align-self: end;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--text-muted);
    font-size: clamp(12px, 1.5dvh, 15px);
  }
  .is-dark .dslide__foot { color: rgb(255 255 255 / 70%); }

  .dslide__body { position: relative; z-index: 2; min-block-size: 0; min-inline-size: 0; }

  .dslide__rule {
    inline-size: 82px;
    block-size: 3px;
    margin-block-end: clamp(16px, 2.6dvh, 26px);
    background: var(--ugm-gold);
  }

  .dslide__eyebrow {
    color: var(--ugm-gold);
    font-size: clamp(13px, 1.8dvh, 17px);
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  /* --- Slide judul ------------------------------------------------------- */

  .dslide--title,
  .dslide--closing { grid-template-rows: minmax(0, 1fr); }

  .dslide__body--title,
  .dslide__body--closing {
    display: grid;
    align-content: center;
    max-inline-size: 60ch;
  }
  .dslide__logo-tl {
    inline-size: clamp(180px, 13vw, 240px);
    block-size: auto;
    margin-block-end: clamp(30px, 5dvh, 62px);
  }
  .dslide__body--title h1 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(42px, min(4.6vw, 8dvh), 74px);
    line-height: 1.02;
    letter-spacing: -.03em;
  }
  .dslide__body--title .dslide__rule { margin-block: clamp(22px, 3.4dvh, 34px) 0; }
  .dslide__lede {
    max-inline-size: 52ch;
    margin-block-start: clamp(18px, 2.8dvh, 28px);
    color: rgb(255 255 255 / 78%);
    font-size: clamp(16px, min(1.5vw, 2.3dvh), 21px);
    line-height: 1.5;
  }
  .dslide__presenter {
    margin-block-start: clamp(28px, 4.4dvh, 48px);
    padding-inline-start: 20px;
    border-inline-start: 3px solid var(--ugm-gold);
    display: grid;
    gap: 4px;
  }
  .dslide__presenter strong { color: #fff; font-size: clamp(18px, 2.4dvh, 24px); }
  .dslide__presenter span { color: rgb(255 255 255 / 66%); font-size: clamp(14px, 1.8dvh, 17px); }

  /* --- Slide pemisah pilar ---------------------------------------------- */

  .dslide--divider { grid-template-rows: minmax(0, 1fr); }
  .dslide__body--divider {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(32px, 5vw, 76px);
    align-content: center;
    align-items: center;
  }
  .dslide__pillar-no {
    color: var(--pillar-color, var(--ugm-gold));
    font-family: var(--font-display);
    font-size: clamp(120px, min(15vw, 30dvh), 260px);
    font-weight: 300;
    line-height: .8;
    letter-spacing: -.06em;
    opacity: .9;
  }
  .dslide__body--divider h2 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(38px, min(4vw, 7dvh), 62px);
    line-height: 1.04;
    letter-spacing: -.02em;
    max-inline-size: 18ch;
  }
  .dslide__body--divider .dslide__rule {
    margin-block: clamp(18px, 2.8dvh, 28px) 0;
    background: var(--pillar-color, var(--ugm-gold));
  }
  .accent-blue   { --pillar-color: #4aa3e8; }
  .accent-orange { --pillar-color: #f08a52; }
  .accent-green  { --pillar-color: #3fc794; }
  .accent-violet { --pillar-color: #9b8ce8; }
  .accent-teal   { --pillar-color: #46c9c0; }

  /* --- Slide grafik ------------------------------------------------------ */

  .dslide__body--chart {
    display: grid;
    grid-template-columns: minmax(300px, .82fr) minmax(0, 1.18fr);
    gap: clamp(30px, 3.6vw, 64px);
    align-items: center;
  }
  .dslide__copy { min-inline-size: 0; align-self: center; }
  .dslide__body--chart h2,
  .dslide__body--stat h2,
  .dslide__body--cards h2 {
    max-inline-size: 15ch;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(32px, min(3.3vw, 5.6dvh), 52px);
    line-height: 1.06;
    letter-spacing: -.025em;
  }
  .dslide__takeaway {
    max-inline-size: 44ch;
    margin-block-start: clamp(14px, 2.2dvh, 22px);
    color: var(--text-secondary);
    font-size: clamp(15px, min(1.35vw, 2.1dvh), 19px);
    line-height: 1.5;
  }
  .is-dark .dslide__takeaway { color: rgb(255 255 255 / 76%); }

  .dslide__stat {
    margin-block-start: clamp(16px, 2.4dvh, 26px);
    padding-inline-start: 20px;
    border-inline-start: 4px solid var(--ugm-gold);
  }
  .dslide__stat strong {
    display: block;
    color: var(--ugm-blue);
    font-size: clamp(40px, min(4vw, 7dvh), 68px);
    font-weight: 300;
    line-height: .95;
    letter-spacing: -.045em;
    font-variant-numeric: tabular-nums;
  }
  .is-dark .dslide__stat strong { color: var(--ugm-gold); }
  .dslide__stat span {
    display: block;
    margin-block-start: 8px;
    color: var(--text-secondary);
    font-size: clamp(14px, 1.9dvh, 18px);
    line-height: 1.35;
  }
  .dslide__statnote {
    margin-block-start: clamp(12px, 1.8dvh, 18px);
    color: var(--text-muted);
    font-size: clamp(12px, 1.6dvh, 15px);
    line-height: 1.4;
  }
  .is-dark .dslide__statnote { color: rgb(255 255 255 / 58%); }

  /* Panggung grafik. Grafik masuk sebagai komponen apa adanya; yang diatur di
     sini hanya ruangnya, dan chrome ChartFrame yang mubazir di layar lebar
     (sumber, unduh CSV, tabel) disembunyikan karena sumbernya sudah tercetak
     di kaki slide dan tabelnya tidak dapat dibaca dari kursi belakang. */
  .dslide__stage {
    min-inline-size: 0;
    min-block-size: 0;
    block-size: 100%;
    display: grid;
    align-content: center;
  }
  .dslide__stage :global(.chart-frame) { margin: 0; }
  .dslide__stage :global(.chart-frame__footer),
  .dslide__stage :global(.chart-frame__note),
  .dslide__stage :global(.chart-frame__actions),
  .dslide__stage :global(.chart-frame__table-wrap) { display: none !important; }
  /* Gulir mendatar milik ChartFrame dimatikan: di layar proyeksi tidak ada
     yang bisa menggulir, jadi grafik harus muat seluruhnya atau tidak sama
     sekali. */
  .dslide__stage :global(.chart-frame__plot) { overflow: visible; }

  /* Hanya SVG grafik utama yang dibatasi tingginya - bukan SVG kecil di dalam
     legenda dan petak kunci, yang ukurannya sudah ditentukan komponennya. */
  .dslide__stage :global(.chart-frame__plot-inner > svg) {
    max-block-size: min(62dvh, 100%);
  }

  /* Tipografi DI DALAM SVG sengaja tidak disentuh. Ukurannya dipatok dalam
     satuan viewBox, jadi ia ikut membesar bersama grafiknya; itulah sebabnya
     tiap grafik di halaman ini dipanggil dengan properti `width` yang lebih
     kecil daripada bawaannya. viewBox yang lebih sempit direntang ke lebar
     panggung yang sama, dan seluruh label ikut terangkat proporsional tanpa
     satu baris pun berubah di komponennya.

     Yang TIDAK ikut terangkat adalah chrome HTML di sekitar peta - daftar
     peringkat, penghitung, dan tombol angkatan - karena ukurannya dalam rem,
     relatif terhadap akar dokumen, bukan terhadap viewBox. Hanya bagian itu
     yang dinaikkan di bawah ini. Selektornya sengaja tiga tingkat agar menang
     atas gaya berlingkup komponen tanpa perlu !important. */

  .dslide .dslide__stage :global(.world-map__count strong) { font-size: 2.9rem; }
  .dslide .dslide__stage :global(.world-map__count span) { font-size: 1rem; }
  .dslide .dslide__stage :global(.world-map__rank li) { font-size: 1.05rem; gap: .7rem; }
  .dslide .dslide__stage :global(.world-map__rest),
  .dslide .dslide__stage :global(.world-map__unmapped) { font-size: .95rem; }
  .dslide .dslide__stage :global(.world-map__legend) { font-size: .95rem; }

  .dslide .dslide__stage :global(.choropleth__tabs button) { min-block-size: 44px; font-size: 1.02rem; }
  .dslide .dslide__stage :global(.choropleth__counter) { font-size: 1.1rem; }
  .dslide .dslide__stage :global(.choropleth__counter output) { font-size: 1.9rem; }
  .dslide .dslide__stage :global(.choropleth__legend) { font-size: 1rem; }

  .dslide .dslide__stage :global(.point-map__counter) { font-size: 1.1rem; }
  .dslide .dslide__stage :global(.point-map__counter output) { font-size: 1.9rem; }
  .dslide .dslide__stage :global(.point-map__controls button) { min-block-size: 44px; font-size: 1rem; }

  /* Atribusi peta diulang di kaki slide, jadi barisnya dihapus dari panggung
     agar tidak memakan tinggi yang dibutuhkan petanya. */
  .dslide .dslide__stage :global(.point-map__attribution),
  .dslide .dslide__stage :global(.world-map__attribution) { display: none; }

  /* --- Slide angka tunggal ---------------------------------------------- */

  .dslide__body--stat {
    display: grid;
    grid-template-columns: minmax(300px, .9fr) minmax(0, 1.1fr);
    gap: clamp(30px, 4vw, 72px);
    align-items: center;
  }
  .dslide__hero {
    padding-inline-start: clamp(24px, 3vw, 48px);
    border-inline-start: 4px solid var(--ugm-gold);
  }
  .dslide__hero strong {
    display: block;
    color: var(--ugm-blue);
    font-size: clamp(72px, min(9.5vw, 15dvh), 160px);
    font-weight: 300;
    line-height: .85;
    letter-spacing: -.06em;
    font-variant-numeric: tabular-nums;
  }
  .is-dark .dslide__hero strong { color: var(--ugm-gold); }
  .dslide__hero span {
    display: block;
    max-inline-size: 26ch;
    margin-block-start: clamp(18px, 2.6dvh, 28px);
    color: var(--text-secondary);
    font-size: clamp(17px, 2.4dvh, 24px);
    line-height: 1.3;
  }
  .is-dark .dslide__hero span { color: rgb(255 255 255 / 78%); }
  .dslide__hero em {
    display: block;
    margin-block-start: 14px;
    color: var(--text-muted);
    font-size: clamp(12px, 1.6dvh, 15px);
    font-style: normal;
  }
  .is-dark .dslide__hero em { color: rgb(255 255 255 / 56%); }

  /* --- Slide kartu ------------------------------------------------------- */

