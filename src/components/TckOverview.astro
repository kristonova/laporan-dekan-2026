---
import { withBase } from "../lib/paths";

interface Row {
  no: string;
  pilar: string;
  indikator: string;
  satuan: string;
  target_tw3: number;
  target_tw4: number;
  capaian_tw3: number | null;
  kuartal_dinilai: "tw1" | "tw2" | "tw3";
  capaian_dinilai: number;
  target_dinilai: number;
  rasio_kuartal: number;
  rasio_thd_target_tahunan: number;
  status_kuartal: "tercapai" | "mendekati" | "tertinggal" | "meleset";
  status_thd_tahunan: string;
  unit_mismatch?: boolean;
  anomali?: string;
  tag?: string;
  arah?: "naik" | "turun";
}
interface Props {
  rows: Row[];
  budgetPercent?: number;
  csvHref?: string;
  snapshotLabel: string;
}
const { rows, budgetPercent = 25.84, csvHref = withBase("/data/tck_2026_indikator.csv"), snapshotLabel } = Astro.props;
const resolvedCsvHref = withBase(csvHref);
const pillarOrder = ["Reputasi", "Kontribusi", "Employability", "Kesejahteraan"];
const tags = ["IKU", "QS", "THE", "SDGs", "GREEN METRIC"];
const statusIcon = { tercapai: "✓", mendekati: "≈", tertinggal: "!", meleset: "×" };
const format = (value: number) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: 2 }).format(value);
const visualRatio = (row: Row, annual = false) => {
  const target = annual ? row.target_tw4 : row.target_dinilai;
  const actual = row.capaian_dinilai;
  if (row.arah === "turun") return actual <= 0 ? 250 : (target / actual) * 100;
  return target <= 0 ? 0 : (actual / target) * 100;
};
const markerRatio = (row: Row) => {
  if (row.arah === "turun") return row.target_tw4 <= 0 ? 100 : (row.target_tw3 / row.target_tw4) * 100;
  return row.target_tw3 <= 0 ? 100 : (row.target_tw4 / row.target_tw3) * 100;
};
const pctPosition = (ratio: number) => Math.min(100, Math.max(0, ratio / 2));
const achieved = rows.filter((row) => row.status_kuartal === "tercapai").length;
const annual = rows.filter((row) => row.status_thd_tahunan === "tercapai").length;
const behind = rows.filter((row) => row.status_kuartal === "tertinggal" || row.status_kuartal === "meleset").length;
const flagged = rows.filter((row) => row.anomali);
const quarterLabel = (row: Row) => row.kuartal_dinilai.toUpperCase().replace("TW", "TW");
---

<div class="tck" data-tck-overview>
  <div class="tck__summary" aria-label="Ringkasan Capaian TCK 2026">
    <div><strong>{rows.length}</strong><span>indikator TCK</span></div>
    <div><strong>{achieved}</strong><span>memenuhi target TW3</span></div>
    <div><strong>{annual}</strong><span>melampaui target tahunan</span></div>
    <div class="is-behind"><strong>{behind}</strong><span>perlu akselerasi</span></div>
  </div>

  <div class="tck__context">
    <p><strong>Triwulan III Masih Berjalan:</strong> Posisi data ditarik per {snapshotLabel} (periode TW3 berakhir 30 September).</p>
    <p><strong>Realisasi Anggaran:</strong> {format(budgetPercent)}% terserap. Sesuai siklus keuangan universitas, penyerapan anggaran terkonsentrasi pada Triwulan IV.</p>
  </div>

  <div class="tck__controls" data-tck-controls hidden>
    <span>Filter Tag</span>
    <button type="button" data-tck-filter="all" aria-pressed="true">Semua</button>
    {tags.map((tag) => <button type="button" data-tck-filter={tag} aria-pressed="false">{tag}</button>)}
  </div>

  <div class="tck__axis" aria-hidden="true"><span>0</span><span>Target TW3 · 100%</span><span>200%+</span></div>

  <div class="tck__groups">
    {pillarOrder.map((pillar) => {
      const pillarRows = rows.filter((row) => row.pilar === pillar);
      return (
        <section class="tck__group" data-tck-group={pillar} aria-labelledby={`tck-${pillar.toLowerCase()}-title`}>
          <header>
            <h3 id={`tck-${pillar.toLowerCase()}-title`}>{pillar}</h3>
            <span>{pillarRows.filter((row) => row.status_kuartal === "tercapai").length}/{pillarRows.length} tercapai</span>
          </header>
          <ol>
            {pillarRows.map((row) => {
              const ratio = visualRatio(row);
              const annualRatio = visualRatio(row, true);
              const marker = markerRatio(row);
              const rowTags = row.tag?.split("·").map((tag) => tag.trim()).filter(Boolean) ?? [];
              return (
                <li class={`tck-row tck-row--${row.status_kuartal}`} data-tags={rowTags.join("|")}>
                  <div class="tck-row__label">
                    <span class="tck-row__number">{row.no}</span>
                    <span>{row.indikator}</span>
                    {rowTags.length > 0 && <small>{rowTags.join(" · ")}</small>}
                  </div>
                  <div class="tck-row__bullet">
                    <div class="tck-row__scale">
                      <i class="tck-row__bar" style={`--bar:${pctPosition(ratio)}%`}></i>
                      <i class="tck-row__tw3" title="Target triwulan III"></i>
                      <i class="tck-row__annual" style={`--annual:${pctPosition(marker)}%`} title="Target tahunan"></i>
                      {ratio > 200 && <span class="tck-row__overflow" aria-label="Melampaui 200 persen">›</span>}
                    </div>
                    <div class="tck-row__value">
                      <span class="tck-row__status" aria-hidden="true">{statusIcon[row.status_kuartal]}</span>
                      <strong>{format(row.capaian_dinilai)}</strong>
                      <small>{row.satuan} · {format(ratio)}% {quarterLabel(row)} · {format(annualRatio)}% tahunan</small>
                      {row.kuartal_dinilai !== "tw3" && <small class="tck-row__note">Dinilai pada {quarterLabel(row)}: capaian TW3 tercatat tanpa penyebut persentase.</small>}
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })}
  </div>

  <div class="tck__legend" aria-label="Legenda status dan target">
    <span class="is-achieved">✓ Tercapai</span>
    <span class="is-approaching">≈ Mendekati</span>
    <span class="is-lagging">! Perlu Akselerasi</span>
    <span class="is-missed">× Belum Tercapai</span>
    <span><i class="legend-marker legend-marker--tw3"></i> Target TW3</span>
    <span><i class="legend-marker legend-marker--annual"></i> Target tahunan</span>
  </div>

  <details class="tck__table">
    <summary>Tampilkan tabel lengkap 42 indikator</summary>
    <div tabindex="0">
      <table>
        <caption>Posisi indikator TCK 2026 per {snapshotLabel}</caption>
        <thead><tr><th>No.</th><th>Indikator</th><th>Pilar</th><th>Kuartal dinilai</th><th>Target</th><th>Capaian</th><th>Target tahunan</th><th>Status</th></tr></thead>
        <tbody>
          {rows.map((row) => <tr><th scope="row">{row.no}</th><td>{row.indikator}</td><td>{row.pilar}</td><td>{quarterLabel(row)}</td><td>{format(row.target_dinilai)}</td><td>{format(row.capaian_dinilai)}</td><td>{format(row.target_tw4)}</td><td>{row.status_kuartal}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>
  {flagged.length > 0 && (
    <details class="tck__table tck__anomali">
      <summary>Catatan kualitas data pada {flagged.length} indikator</summary>
      <div tabindex="0">
        <table>
          <caption>Penyimpangan yang ditemukan pada berkas sumber TCK 2026</caption>
          <thead><tr><th>No.</th><th>Indikator</th><th>Catatan</th></tr></thead>
          <tbody>{flagged.map((row) => <tr><th scope="row">{row.no}</th><td>{row.indikator}</td><td>{row.anomali}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
  )}
  <footer class="tck__footer">
    <span>Sumber: SIMASTER UGM · Sinkronisasi {snapshotLabel}</span>
    <a href={resolvedCsvHref} download>Unduh CSV</a>
  </footer>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-tck-overview]").forEach((root) => {
    const controls = root.querySelector<HTMLElement>("[data-tck-controls]");
    if (!controls) return;
    controls.hidden = false;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>("button[data-tck-filter]")];
    buttons.forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.tckFilter ?? "all";
      buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      root.querySelectorAll<HTMLElement>(".tck-row").forEach((row) => {
        const matches = filter === "all" || (row.dataset.tags ?? "").split("|").includes(filter);
        row.hidden = !matches;
      });
      root.querySelectorAll<HTMLElement>("[data-tck-group]").forEach((group) => {
        group.hidden = !group.querySelector(".tck-row:not([hidden])");
      });
    }));
  });
</script>

<style>
  .tck { font-variant-numeric: tabular-nums; }
  .tck__summary { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border-subtle); background: var(--surface-card); }
  .tck__summary > div { min-height: 142px; padding: 24px; display: flex; flex-direction: column; justify-content: center; }
  .tck__summary > div + div { border-inline-start: 1px solid var(--border-subtle); }
  .tck__summary strong { color: var(--ugm-blue); font-size: clamp(38px, 5vw, 60px); font-weight: 300; line-height: 1; }
  .tck__summary span { margin-block-start: 9px; color: var(--text-secondary); font-size: 13px; line-height: 1.3; }
  .tck__summary .is-behind strong { color: var(--status-missed); }
  .tck__context { margin-block: 18px 28px; padding: 16px 20px; border-inline-start: 3px solid var(--ugm-gold); background: var(--surface-tint-warm); display: flex; justify-content: space-between; gap: 24px; }
  .tck__context p { max-width: 58ch; margin: 0; color: var(--text-secondary); font-size: 13px; }
  .tck__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-block: 28px; }
  .tck__controls > span { margin-inline-end: 6px; color: var(--text-muted); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .tck__controls button { min-height: 44px; padding: 8px 14px; border: 1px solid var(--border-default); border-radius: 4px; background: var(--surface-card); color: var(--text-primary); font-size: 13px; font-weight: 700; }
  .tck__controls button[aria-pressed="true"] { border-color: var(--ugm-blue); background: var(--ugm-blue); color: #fff; }
  .tck__axis { margin-inline-start: min(44%, 430px); display: flex; justify-content: space-between; color: var(--text-muted); font-size: 11px; }
  .tck__groups { margin-block-start: 10px; border-block-start: 1px solid var(--border-subtle); }
  .tck__group { padding-block: 28px; border-block-end: 1px solid var(--border-subtle); }
  .tck__group > header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-block-end: 12px; }
  .tck__group h3 { color: var(--text-primary); font-family: var(--font-ui); font-size: 18px; }
  .tck__group > header span { color: var(--text-muted); font-size: 12px; }
  .tck__group ol { padding: 0; margin: 0; list-style: none; }
  .tck-row { display: grid; grid-template-columns: minmax(250px, 42%) 1fr; gap: 26px; align-items: center; min-height: 76px; padding-block: 10px; }
  .tck-row + .tck-row { border-block-start: 1px solid color-mix(in srgb, var(--border-subtle) 68%, transparent); }
  .tck-row__label { position: relative; padding-inline-start: 42px; display: flex; flex-direction: column; color: var(--text-secondary); font-size: 13px; line-height: 1.35; }
  .tck-row__number { position: absolute; inset-inline-start: 0; inset-block-start: 0; color: var(--text-primary); font-weight: 700; }
  .tck-row__label small { margin-block-start: 5px; color: var(--text-muted); font-size: 10px; letter-spacing: .08em; }
  .tck-row__bullet { display: grid; grid-template-columns: minmax(160px, 1fr) 210px; gap: 16px; align-items: center; }
  .tck-row__scale { height: 14px; position: relative; background: repeating-linear-gradient(135deg, var(--surface-2) 0 5px, var(--border-subtle) 5px 6px); }
  .tck-row__scale::after { content: ""; position: absolute; inset: 0 50% 0 auto; border-inline-start: 1px solid var(--grid-line); }
  .tck-row__bar { position: absolute; inset: 2px auto 2px 0; width: var(--bar); max-width: 100%; background: var(--row-color); border-radius: 0 4px 4px 0; }
  .tck-row__tw3, .tck-row__annual { position: absolute; inset-block: -5px; width: 2px; }
  .tck-row__tw3 { inset-inline-start: 50%; background: var(--text-primary); }
  .tck-row__annual { inset-inline-start: var(--annual); border-inline-start: 2px dashed var(--text-muted); }
  .tck-row__overflow { position: absolute; inset-inline-end: -12px; inset-block-start: -10px; color: var(--row-color); font-size: 24px; font-weight: 700; }
  .tck-row__value { display: grid; grid-template-columns: 22px minmax(0, 1fr); align-items: center; gap: 0 7px; }
  .tck-row__value > :not(.tck-row__status) { grid-column: 2; }
  .tck-row__status { grid-column: 1; grid-row: 1 / span 3; width: 20px; height: 20px; display: grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; color: var(--row-color); font-size: 11px; font-weight: 700; }
  .tck-row__value strong { color: var(--text-primary); font-size: 14px; }
  .tck-row__value small { color: var(--text-muted); font-size: 10px; line-height: 1.25; }
  .tck-row--tercapai { --row-color: var(--status-achieved); }
  .tck-row--mendekati { --row-color: var(--status-info); }
  .tck-row--tertinggal { --row-color: var(--status-lagging); }
  .tck-row--meleset { --row-color: var(--status-missed); }
  .tck__legend { display: flex; flex-wrap: wrap; gap: 12px 20px; margin-block-start: 24px; color: var(--text-secondary); font-size: 12px; }
  .tck__legend .is-achieved { color: var(--status-achieved); }.tck__legend .is-approaching { color: var(--status-info); }.tck__legend .is-lagging { color: var(--status-lagging); }.tck__legend .is-missed { color: var(--status-missed); }
  .legend-marker { display: inline-block; width: 2px; height: 14px; margin-inline-end: 6px; vertical-align: middle; background: var(--text-primary); }
  .legend-marker--annual { border-inline-start: 2px dashed var(--text-muted); background: none; }
  .tck__table { margin-block-start: 28px; border-block: 1px solid var(--border-subtle); }
  .tck__table summary { padding-block: 14px; color: var(--text-primary); font-size: 13px; font-weight: 700; }
  .tck__table > div { max-height: 70vh; overflow: auto; }
  .tck__table table { min-width: 900px; font-size: 12px; }
  .tck-row__note { display: block; margin-block-start: 4px; color: var(--status-lagging); font-size: 10px; line-height: 1.35; }
  .tck__footer { margin-block-start: 16px; display: flex; justify-content: space-between; gap: 20px; color: var(--text-muted); font-size: 12px; }
  .tck__footer a { font-weight: 700; }
  @media (max-width: 820px) {
    .tck__summary { grid-template-columns: repeat(2, 1fr); }
    .tck__summary > div:nth-child(3) { border-inline-start: 0; border-block-start: 1px solid var(--border-subtle); }
    .tck__summary > div:nth-child(4) { border-block-start: 1px solid var(--border-subtle); }
    .tck__context { flex-direction: column; }
    .tck__axis { display: none; }
    .tck-row { grid-template-columns: 1fr; gap: 10px; padding-block: 16px; }
    .tck-row__bullet { grid-template-columns: 1fr 190px; }
  }
  @media (max-width: 520px) {
    .tck__summary { grid-template-columns: 1fr; }
    .tck__summary > div + div { border-inline-start: 0; border-block-start: 1px solid var(--border-subtle); }
    .tck-row__bullet { grid-template-columns: 1fr; }
    .tck-row__value { grid-template-columns: 22px minmax(0, 1fr); }
    .tck__footer { flex-direction: column; }
  }
</style>
