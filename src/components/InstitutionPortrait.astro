---
interface Props {
  lecturers: number;
  academicStaff: number;
  departmentsCount: number;
  studyProgrammes: number;
  laboratories: number;
  departmentCounts: Record<string, number>;
}

const {
  lecturers,
  academicStaff,
  departmentsCount,
  studyProgrammes,
  laboratories,
  departmentCounts,
} = Astro.props;
const departments = [
  { name: "Fisika", sourceName: "Fisika", className: "fisika" },
  { name: "Ilmu Komputer & Elektronika", sourceName: "Ilmu Komputer dan Elektronika", className: "ike" },
  { name: "Kimia", sourceName: "Kimia", className: "kimia" },
  { name: "Matematika", sourceName: "Matematika", className: "matematika" },
];
const format = (value: number) => new Intl.NumberFormat("id-ID").format(value);
const countOf = (department: (typeof departments)[number]) => departmentCounts[department.sourceName] ?? 0;
/* Every dot carries the name and count of the group it belongs to, so pointing
   at any one of them answers the question the matrix raises. The dots are not
   tab stops: 367 of them would bury the rest of the page, so the legend chips
   below carry the keyboard path and the click target instead. */
const lecturerDots = departments.flatMap((department) =>
  Array.from({ length: countOf(department) }, () => ({
    className: department.className,
    tip: `${department.name} · ${format(countOf(department))} dosen`,
  })),
);
const staffTip = `Tenaga kependidikan · ${format(academicStaff)} orang`;
const legendEntries = [
  ...departments.map((department) => ({ key: department.className, label: department.name, count: countOf(department) })),
  { key: "staff", label: "Tenaga kependidikan", count: academicStaff },
];
---

<div class="portrait" data-portrait>
  <div class="portrait__people" aria-label={`${lecturers} dosen dan ${academicStaff} tenaga kependidikan`}>
    <div class="portrait__group">
      <strong>{lecturers}</strong><span>dosen</span>
      <div
        class="portrait__dots"
        data-portrait-dots
        role="img"
        aria-label={`Sebaran ${format(lecturers)} dosen menurut departemen: ${departments.map((department) => `${department.name} ${format(countOf(department))}`).join(", ")}`}
      >
        {lecturerDots.map((dot) => <i class={`dot dot--${dot.className}`} data-dept={dot.className} data-portrait-tip={dot.tip}></i>)}
      </div>
    </div>
    <div class="portrait__plus" aria-hidden="true">+</div>
    <div class="portrait__group portrait__group--staff">
      <strong>{academicStaff}</strong><span>tenaga kependidikan</span>
      <div class="portrait__dots" data-portrait-dots role="img" aria-label={staffTip}>
        {Array.from({ length: academicStaff }, () => <i class="dot dot--staff" data-dept="staff" data-portrait-tip={staffTip}></i>)}
      </div>
    </div>
  </div>
  <div class="portrait__structure">
    <div><strong>{departmentsCount}</strong><span>departemen</span></div>
    <div><strong>{studyProgrammes}</strong><span>program studi</span><small>8 Sarjana · 5 Magister · 4 Doktor</small></div>
    <div><strong>{laboratories}</strong><span>laboratorium</span></div>
  </div>
  <ul class="portrait__legend" aria-label="Departemen">
    {legendEntries.map((entry) => (
      <li>
        <button type="button" data-dept-toggle={entry.key} aria-pressed="false">
          <i class={`dot dot--${entry.key}`} aria-hidden="true"></i>{entry.label} · {format(entry.count)}
        </button>
      </li>
    ))}
  </ul>
  <p class="portrait__hint" data-portrait-hint hidden>Arahkan kursor ke titik untuk melihat kelompoknya, atau pilih satu kelompok di atas untuk menyorotnya.</p>
</div>

<style>
  .portrait { display: grid; gap: 36px; }
  /* One column: the two groups read in sequence at full width, so their dot
     matrices share a scale instead of being drawn at two different densities
     in two columns of unequal width. */
  .portrait__people {
    display: grid;
    gap: 32px;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
  }
  .portrait__group { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 8px 14px; }
  .portrait__group strong { color: var(--ugm-blue); font-size: clamp(48px, 7vw, 82px); font-weight: 300; line-height: 1; }
  .portrait__group span { color: var(--text-secondary); font-size: 16px; }
  .portrait__dots { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(34, 1fr); gap: 5px; margin-block-start: 14px; }
  .portrait__plus { justify-self: start; color: var(--ugm-gold-dark); font-size: 40px; font-weight: 300; line-height: 1; }
  .dot { display: inline-block; width: 9px; aspect-ratio: 1; border-radius: 50%; box-shadow: 0 0 0 1px var(--surface-card); }
  .dot--fisika { background: var(--dept-fisika); }
  .dot--ike { background: var(--dept-ike); }
  .dot--kimia { background: var(--dept-kimia); }
  .dot--matematika { background: var(--dept-matematika); }
  .dot--staff { background: var(--dept-unmapped); }
  .portrait__structure { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--border-subtle); }
  .portrait__structure > div { min-height: 150px; padding: 28px; display: flex; flex-direction: column; justify-content: center; }
  .portrait__structure > div + div { border-inline-start: 1px solid var(--border-subtle); }
  .portrait__structure strong { color: var(--ugm-blue); font-family: var(--font-display); font-size: 52px; line-height: 1; }
  .portrait__structure span { margin-block-start: 8px; font-weight: 700; }
  .portrait__structure small { margin-block-start: 6px; color: var(--text-muted); }
  .portrait__legend { display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 0; list-style: none; font-size: 13px; }
  .portrait__legend li { margin: 0; }
  .portrait__legend button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 6px 13px;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--surface-card);
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
  }
  .portrait__legend button:hover { border-color: var(--ugm-blue); color: var(--text-primary); }
  .portrait__legend button[aria-pressed="true"] { border-color: var(--ugm-blue); background: var(--surface-tint); color: var(--text-primary); font-weight: 700; }
  .portrait__legend button:focus-visible { outline: 3px solid var(--focus-color); outline-offset: 2px; }
  .portrait__hint { margin: 0; color: var(--text-muted); font-size: 12px; }

  /* Highlighting is a dim, not a colour change: the department colours are the
     one thing on this graphic that must never move. */
  .portrait[data-active-dept] .portrait__dots i { opacity: .14; }
  .portrait[data-active-dept="fisika"] .portrait__dots i[data-dept="fisika"],
  .portrait[data-active-dept="ike"] .portrait__dots i[data-dept="ike"],
  .portrait[data-active-dept="kimia"] .portrait__dots i[data-dept="kimia"],
  .portrait[data-active-dept="matematika"] .portrait__dots i[data-dept="matematika"],
  .portrait[data-active-dept="staff"] .portrait__dots i[data-dept="staff"] { opacity: 1; }
  .portrait.is-interactive .portrait__dots i { cursor: pointer; transition: opacity var(--duration-base, 180ms) var(--ease-standard, cubic-bezier(.2,0,.2,1)); }
  .portrait.is-interactive .portrait__dots i:hover { box-shadow: 0 0 0 2px var(--surface-card), 0 0 0 3.5px var(--text-primary); }
  @media (prefers-reduced-motion: reduce) { .portrait.is-interactive .portrait__dots i { transition: none; } }
  @media (max-width: 900px) {
    .portrait__dots { grid-template-columns: repeat(24, 1fr); }
  }
  @media (max-width: 700px) {
    .portrait__plus { display: none; }
    .portrait__dots { grid-template-columns: repeat(18, 1fr); gap: 4px; }
    .portrait__structure { grid-template-columns: 1fr; }
    .portrait__structure > div + div { border-inline-start: 0; border-block-start: 1px solid var(--border-subtle); }
  }
</style>
