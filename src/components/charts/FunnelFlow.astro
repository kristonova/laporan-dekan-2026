---
import ChartFrame from './ChartFrame.astro';
import type { ChartChromeProps } from './_types';
import { formatNumber } from './_utils';
interface Stage extends Record<string, unknown> {
  label: string; value: number; valueLabel?: string; annotation?: string; dropLabel?: string;
}
interface Props extends Omit<ChartChromeProps<Stage>, 'tableRows'> {
  stages: Stage[]; valueLabel?: string; valueFormatter?: (value: number) => string; note?: string;
}
const { stages, valueLabel = 'peserta', valueFormatter = (v: number) => formatNumber(v, 0), note, ...chrome } = Astro.props;
const base = stages[0]?.value ?? 0;
const rows = stages.map((stage, index) => ({ ...stage,
  share: base ? stage.value / base * 100 : 0,
  lost: index ? stages[index - 1].value - stage.value : 0,
  previous: index ? stages[index - 1].label.toLowerCase() : '',
  lostShare: index && stages[index - 1].value ? (stages[index - 1].value - stage.value) / stages[index - 1].value * 100 : 0,
}));
---
<ChartFrame {...chrome} tableRows={rows.map(r => ({ tahap: r.label, jumlah: r.value, persen_awal: Number(r.share.toFixed(1)), keterangan: r.annotation, tidak_berlanjut: r.lost }))}
  tableColumns={[{ key: 'tahap', label: 'Tahap' }, { key: 'jumlah', label: 'Jumlah' }, { key: 'persen_awal', label: '% dari tahap awal' }, { key: 'keterangan', label: 'Rasio tahap' }, { key: 'tidak_berlanjut', label: 'Tidak berlanjut dari tahap sebelumnya' }]} note={note}>
  <div class="stage-chart">
    <p class="stage-scale">Panjang batang = jumlah {valueLabel} <span>Skala bersama · {valueFormatter(base)} = 100%</span></p>
    <ol>
      {rows.map((row, index) => <li>
        <div class="stage-label"><span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h4>{row.label}</h4><strong>{row.valueLabel ?? valueFormatter(row.value)}</strong></div></div>
        <div class="stage-measure">
          <div class="stage-track" role="img" aria-label={`${row.label}: ${valueFormatter(row.value)} ${valueLabel}, ${formatNumber(row.share, 1)} persen dari tahap awal`}><span style={`width:${row.share}%`} /></div>
          {index > 0 && <p class="stage-loss"><strong>−{valueFormatter(row.lost)}</strong> {row.dropLabel ?? 'tidak berlanjut'} <span>({formatNumber(row.lostShare, 1)}% dari {row.previous})</span></p>}
        </div>
        <p class="stage-ratio">{row.annotation}</p>
      </li>)}
    </ol>
  </div>
</ChartFrame>
<style>
  .stage-chart { --stage-accent: var(--text-link); }
  .stage-chart { padding-block: 12px; }
  .stage-scale { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 0 0 20px; font-size: 13px; color: var(--text-secondary); }
  .stage-scale span { color: var(--text-muted); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 205px minmax(0, 1fr) 180px; gap: 28px; align-items: start; padding: 28px 0; border-top: 1px solid var(--border-subtle); }
  .stage-label { display: flex; gap: 14px; align-items: start; }
  .stage-number { color: var(--text-muted); font-size: 12px; padding-top: 4px; }
  h4 { font: 600 15px/1.4 var(--font-ui); margin: 0 0 5px; color: var(--text-primary); }
  .stage-label strong { font: 700 28px/1.2 var(--font-ui); color: var(--stage-accent); font-variant-numeric: tabular-nums; }
  .stage-track { height: 28px; background: var(--surface-2); border-radius: 3px; overflow: hidden; margin-top: 7px; }
  .stage-track > span { display: block; height: 100%; background: var(--stage-accent); border-radius: 3px; }
  .stage-loss { font-size: 13px; line-height: 1.6; color: var(--text-secondary); margin: 12px 0 0; }
  .stage-loss strong { font-variant-numeric: tabular-nums; color: var(--text-primary); }
  .stage-loss span { color: var(--text-muted); }
  .stage-ratio { margin: 7px 0 0; font-size: 14px; line-height: 1.5; text-align: right; color: var(--text-secondary); }
  @media(max-width: 767px) {
    li { grid-template-columns: 1fr auto; gap: 14px; padding: 22px 0; }
    .stage-measure { grid-column: 1/-1; grid-row: 2; }
    .stage-ratio { max-width: 150px; }
    .stage-label strong { font-size: 25px; }
    .stage-track { margin: 0; }
  }
</style>
