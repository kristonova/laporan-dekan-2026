---
import ChartFrame from "./ChartFrame.astro";
import type { ChartChromeProps } from "./_types";
import { finite, formatNumber, slugify } from "./_utils";

/**
 * A selection funnel drawn as flow rather than as three bars.
 *
 * Width carries the count, on one scale for every stage, so the shape is
 * area-true: the shoulders that taper away between two stages are exactly the
 * people who did not carry through, and they are shaded and counted instead of
 * being left as empty background. Nobody leaves the chart unaccounted for.
 *
 * The two percentages on this chart have different denominators, which is the
 * easiest mistake to make when reading a funnel, so every annotation names its
 * own denominator rather than saying "percent" and hoping.
 */
interface FunnelStage extends Record<string, unknown> {
  label: string;
  value: number;
  valueLabel?: string;
  /** Named denominator, e.g. "8,5% dari peminat". */
  annotation?: string;
  /** What the people lost before this stage are called. */
  dropLabel?: string;
}

interface Props extends Omit<ChartChromeProps<FunnelStage>, "tableRows" | "tableColumns"> {
  stages: FunnelStage[];
  width?: number;
  bandHeight?: number;
  taperHeight?: number;
  valueLabel?: string;
  valueFormatter?: (value: number) => string;
  note?: string;
}

const {
  stages,
  width = 960,
  bandHeight = 46,
  taperHeight = 76,
  valueLabel = "calon mahasiswa",
  valueFormatter = (value: number) => formatNumber(value, 0),
  note,
  title,
  deck,
  id = slugify(title),
  source,
  extracted,
  csvHref,
  tableCaption,
  class: className,
  hideHeader,
} = Astro.props;

const margin = { top: 48, right: 236, bottom: 34, left: 176 };
const stageCount = Math.max(1, stages.length);
const funnelWidth = width - margin.left - margin.right;
const centre = margin.left + funnelWidth / 2;
const top = Math.max(1, finite(stages[0]?.value));
/* One scale for every stage. A per-stage scale would make the last two bands
   look equal, which is precisely the claim the data does not support. */
const bandWidth = (value: number) => Math.max(3, (Math.max(0, finite(value)) / top) * funnelWidth);
const height = margin.top + stageCount * bandHeight + (stageCount - 1) * taperHeight + margin.bottom;

const bands = stages.map((stage, index) => {
  const value = finite(stage.value);
  const w = bandWidth(value);
  const y = margin.top + index * (bandHeight + taperHeight);
  return {
    ...stage,
    index,
    value,
    w,
    y,
    x: centre - w / 2,
    text: stage.valueLabel ?? valueFormatter(value),
  };
});

/* One taper per transition. The ribbon is the whole flow leaving the stage
   above; the rectangle drawn over it is the part that carries through, so what
   stays visible of the ribbon is the loss, at its true width. */
const tapers = bands.slice(1).map((band) => {
  const parent = bands[band.index - 1];
  const bandTop = parent.y + bandHeight;
  const bandBottom = band.y;
  const bend = taperHeight * 0.42;
  const lost = Math.max(0, parent.value - band.value);
  const share = parent.value > 0 ? (band.value / parent.value) * 100 : 0;
  return {
    index: band.index,
    lost,
    share,
    lostShare: 100 - share,
    dropLabel: band.dropLabel ?? "tidak berlanjut",
    ribbon: [
      `M ${parent.x.toFixed(1)} ${bandTop}`,
      `L ${(parent.x + parent.w).toFixed(1)} ${bandTop}`,
      `C ${(parent.x + parent.w).toFixed(1)} ${(bandTop + bend).toFixed(1)}`,
      `${(band.x + band.w).toFixed(1)} ${(bandBottom - bend).toFixed(1)}`,
      `${(band.x + band.w).toFixed(1)} ${bandBottom}`,
      `L ${band.x.toFixed(1)} ${bandBottom}`,
      `C ${band.x.toFixed(1)} ${(bandBottom - bend).toFixed(1)}`,
      `${parent.x.toFixed(1)} ${(bandTop + bend).toFixed(1)}`,
      `${parent.x.toFixed(1)} ${bandTop}`,
      "Z",
    ].join(" "),
    carry: { x: band.x, y: bandTop, w: band.w, h: bandBottom - bandTop },
    labelX: centre + parent.w / 2 + 12,
    labelY: bandTop + taperHeight / 2,
    parentLabel: parent.label,
  };
});

const tableRows = [
  ...bands.map((band) => ({
    Tahap: band.label,
    Jumlah: band.text,
    Keterangan: band.annotation ?? "—",
  })),
  ...tapers.map((taper) => ({
    Tahap: `${taper.dropLabel} (setelah ${taper.parentLabel})`,
    Jumlah: valueFormatter(taper.lost),
    Keterangan: `${formatNumber(taper.lostShare, 1)}% dari ${taper.parentLabel.toLowerCase()}`,
  })),
];
---

<ChartFrame
  {id}
  {title}
  {deck}
  {source}
  {extracted}
  {csvHref}
  {tableCaption}
  {tableRows}
  tableColumns={[
    { key: "Tahap", label: "Tahap" },
    { key: "Jumlah", label: `Jumlah ${valueLabel}`, align: "end" },
    { key: "Keterangan", label: "Keterangan" },
  ]}
  class={className}
  {hideHeader}
  minPlotWidth={720}
  {note}
>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-svg-title ${id}-svg-desc`}>
    <title id={`${id}-svg-title`}>{title}</title>
    <desc id={`${id}-svg-desc`}>
      Corong {stageCount} tahap. Lebar tiap pita sebanding dengan jumlah {valueLabel} pada satu skala yang sama,
      dan bagian yang menyempit di antara dua tahap adalah jumlah yang tidak berlanjut. Seluruh angka tersedia
      pada tabel di bawah grafik.
    </desc>
    <defs>
      <pattern id={`${id}-drop`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="7" height="7" fill="var(--surface-2, #eef1f3)" />
        <line x1="0" y1="0" x2="0" y2="7" stroke="var(--rule-strong, #aeb8be)" stroke-width="1.2" />
      </pattern>
    </defs>

    <text class="unit-key" x={margin.left} y="18">lebar pita = {valueLabel}</text>

    {tapers.map((taper) => (
      <g class="taper" tabindex="0" data-tooltip={`${taper.dropLabel}: ${valueFormatter(taper.lost)} ${valueLabel} (${formatNumber(taper.lostShare, 1)}% dari ${taper.parentLabel.toLowerCase()})`} aria-label={`${taper.dropLabel}: ${valueFormatter(taper.lost)} ${valueLabel}`}>
        <path class="taper-drop" d={taper.ribbon} fill={`url(#${id}-drop)`} />
        <rect class="taper-carry" x={taper.carry.x} y={taper.carry.y} width={taper.carry.w} height={taper.carry.h} />
        <text class="drop-label" x={taper.labelX} y={taper.labelY}>
          <tspan class="drop-value">{valueFormatter(taper.lost)}</tspan>
          <tspan class="drop-name" x={taper.labelX} dy="15">{taper.dropLabel}</tspan>
          <tspan class="drop-share" x={taper.labelX} dy="14">{formatNumber(taper.lostShare, 1)}% dari {taper.parentLabel.toLowerCase()}</tspan>
        </text>
      </g>
    ))}

    {bands.map((band) => (
      <g class="band" tabindex="0" data-tooltip={`${band.label}: ${band.text} ${valueLabel}${band.annotation ? `. ${band.annotation}` : ""}`} aria-label={`${band.label}: ${band.text} ${valueLabel}`}>
        <rect x={band.x} y={band.y} width={band.w} height={bandHeight} rx="3" />
        <text class="band-label" x={margin.left - 22} y={band.y + bandHeight / 2 - 3} text-anchor="end">
          <tspan class="band-name" x={margin.left - 22}>{band.label}</tspan>
          <tspan class="band-value" x={margin.left - 22} dy="19">{band.text}</tspan>
        </text>
        {band.annotation && (
          <text class="band-annotation" x={width - 8} y={band.y + bandHeight / 2 + 4} text-anchor="end">{band.annotation}</text>
        )}
      </g>
    ))}
  </svg>
</ChartFrame>

<style>
  svg {
    color: var(--ink, #2b2d2f);
    font-family: var(--font-sans, "Open Sans", system-ui, sans-serif);
    font-variant-numeric: tabular-nums;
  }

  .unit-key {
    fill: var(--ink-muted, #646a70);
    font-size: 11px;
  }

  .taper-drop {
    stroke: var(--rule, #d9dde0);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Opaque, or the hatch of the loss ribbon underneath shows through and the
     carried channel reads as half lost. */
  .taper-carry {
    fill: var(--chart-primary, #01416b);
  }

  .band rect {
    fill: var(--chart-primary, #01416b);
    transition: opacity var(--duration-base, 180ms) var(--ease-standard, cubic-bezier(0.2, 0, 0.2, 1));
  }

  .band text,
  .taper text {
    pointer-events: none;
  }

  .band-name {
    fill: currentColor;
    font-size: 13px;
    font-weight: 800;
  }

  .band-value {
    fill: var(--chart-primary, #01416b);
    font-size: 17px;
    font-weight: 700;
  }

  .band-annotation {
    fill: var(--ink-muted, #646a70);
    font-size: 11.5px;
  }

  .drop-value {
    fill: var(--ink, #2b2d2f);
    font-size: 13px;
    font-weight: 800;
  }

  .drop-name {
    fill: var(--ink, #2b2d2f);
    font-size: 11.5px;
    font-weight: 700;
  }

  .drop-share {
    fill: var(--ink-muted, #646a70);
    font-size: 11px;
  }

  .band:hover rect,
  .band:focus rect {
    opacity: 0.78;
  }

  .band:focus-visible,
  .taper:focus-visible {
    outline: none;
  }

  .band:focus-visible rect,
  .taper:focus-visible .taper-drop {
    stroke: var(--focus, #1c75bc);
    stroke-width: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .band rect { transition: none; }
  }
</style>
