---
import type { ChartChromeProps, TableColumn } from "./_types";
import { getValue, slugify, stringifyCell } from "./_utils";
import { withBase } from "../../lib/paths";

type Row = Record<string, unknown>;
type Props = ChartChromeProps<Row> & {
  minPlotWidth?: number;
  note?: string;
};

const {
  id = slugify(Astro.props.title),
  title,
  deck,
  source,
  extracted,
  csvHref,
  tableCaption = `Data untuk grafik: ${title}`,
  tableRows = [],
  tableColumns,
  class: className,
  hideHeader = false,
  minPlotWidth,
  note,
} = Astro.props;

const columns: TableColumn<Row>[] =
  tableColumns?.length
    ? tableColumns
    : Object.keys(tableRows[0] ?? {}).map((key) => ({ key, label: key }));

const hasFooter = Boolean(source || extracted || csvHref || tableRows.length);
const resolvedCsvHref = csvHref ? withBase(csvHref) : undefined;
---

<figure class:list={["chart-frame", className]} id={id} aria-labelledby={`${id}-title`}>
  {
    hideHeader ? (
      <span class="sr-only" id={`${id}-title`}>{title}</span>
    ) : (
      <header class="chart-frame__header">
        <h3 id={`${id}-title`}>{title}</h3>
        {deck && <p class="chart-frame__deck">{deck}</p>}
      </header>
    )
  }

  <div
    class="chart-frame__plot"
    style={minPlotWidth ? `--chart-min-width:${minPlotWidth}px` : undefined}
    tabindex={minPlotWidth ? "0" : undefined}
    aria-label={minPlotWidth ? `Grafik ${title}. Geser secara horizontal untuk melihat seluruh grafik.` : undefined}
  >
    <div class="chart-frame__plot-inner">
      <slot />
    </div>
  </div>

  {note && <p class="chart-frame__note">{note}</p>}

  {
    hasFooter && (
      <figcaption class="chart-frame__footer">
        <p class="chart-frame__provenance">
          {source && <span>Sumber: {source}</span>}
          {extracted && <span>Ekstraksi: {extracted}</span>}
        </p>
        <div class="chart-frame__actions">
          {tableRows.length > 0 && (
            <details class="chart-frame__table-wrap">
              <summary>Tabel</summary>
              <div class="chart-frame__table-scroll" tabindex="0">
                <table>
                  <caption>{tableCaption}</caption>
                  <thead>
                    <tr>
                      {columns.map((column) => (
                        <th scope="col" class:list={[column.align && `is-${column.align}`]}>{column.label}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {tableRows.map((row) => (
                      <tr>
                        {columns.map((column, index) => {
                          const value = getValue(row, String(column.key));
                          const isYear = /^(year|tahun)$/i.test(String(column.key));
                          const rendered = column.format
                            ? column.format(value, row)
                            : isYear && (typeof value === "number" || typeof value === "string")
                              ? String(value)
                              : stringifyCell(value);
                          return index === 0 ? (
                            <th scope="row" class:list={[column.align && `is-${column.align}`]}>{rendered}</th>
                          ) : (
                            <td class:list={[column.align && `is-${column.align}`]}>{rendered}</td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
          {resolvedCsvHref && <a href={resolvedCsvHref} download>Unduh CSV</a>}
        </div>
      </figcaption>
    )
  }
</figure>

<style>
  .chart-frame {
    --chart-ink: var(--ink, #332c2b);
    --chart-muted: var(--ink-muted, #5e6469);
    --chart-rule: var(--rule, #d9dde0);
    --chart-surface: var(--surface, #ffffff);
    margin: 0;
    color: var(--chart-ink);
    font-family: var(--font-sans, "Open Sans", system-ui, sans-serif);
    position: relative;
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .chart-frame__header {
    max-inline-size: 68rem;
    margin-block-end: clamp(1rem, 2.5vw, 1.75rem);
  }

  h3 {
    margin: 0;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .chart-frame__deck {
    max-inline-size: 68ch;
    margin: 0.65rem 0 0;
    color: var(--chart-muted);
    font-size: clamp(0.98rem, 1.5vw, 1.15rem);
    line-height: 1.55;
  }

  .chart-frame__plot {
    inline-size: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .chart-frame__plot:focus-visible,
  .chart-frame__table-scroll:focus-visible,
  summary:focus-visible,
  a:focus-visible {
    outline: 3px solid var(--focus, #fed400);
    outline-offset: 3px;
  }

  .chart-frame__plot-inner {
    min-inline-size: max(100%, var(--chart-min-width, 0px));
  }

  .chart-frame__plot-inner > :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .chart-frame__note {
    max-inline-size: 76ch;
    margin: 0.8rem 0 0;
    padding-inline-start: 0.8rem;
    border-inline-start: 3px solid var(--attention, #fed400);
    color: var(--chart-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .chart-frame__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--chart-rule);
    color: var(--chart-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .chart-frame__provenance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
    margin: 0;
  }

  .chart-frame__actions {
    display: flex;
    flex: none;
    align-items: flex-start;
    gap: 0.85rem;
  }

  summary,
  a {
    color: var(--link, #004a74);
    font-weight: 700;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .chart-frame__table-wrap[open] {
    position: absolute;
    z-index: 20;
    inset-inline: max(1rem, calc((100vw - min(76rem, 100%)) / 2));
    margin-block-start: 2rem;
    padding: 1rem;
    border: 1px solid var(--chart-rule);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--chart-surface);
    box-shadow: var(--shadow-lg, 0 18px 45px rgb(11 31 46 / 18%));
  }

  .chart-frame__table-wrap[open] summary {
    margin-block-end: 0.75rem;
  }

  .chart-frame__table-scroll {
    max-block-size: min(62vh, 34rem);
    overflow: auto;
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
    color: var(--chart-ink);
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
  }

  caption {
    padding-block-end: 0.75rem;
    font-weight: 700;
    text-align: start;
  }

  th,
  td {
    padding: 0.55rem 0.65rem;
    border-block-end: 1px solid var(--chart-rule);
    text-align: start;
    vertical-align: top;
  }

  thead th {
    position: sticky;
    z-index: 1;
    inset-block-start: 0;
    background: var(--chart-surface);
  }

  .is-end {
    text-align: end;
  }

  .is-center {
    text-align: center;
  }

  @media (max-width: 47.99rem) {
    .chart-frame__footer {
      display: grid;
    }

    .chart-frame__actions {
      justify-content: space-between;
    }

    .chart-frame__plot-inner {
      min-inline-size: var(--chart-min-width, 100%);
    }

    .chart-frame__table-wrap[open] {
      position: fixed;
      inset: 0.75rem;
      max-block-size: calc(100dvh - 1.5rem);
      overflow: auto;
    }
  }

  @media print {
    .chart-frame__actions {
      display: none;
    }

    .chart-frame__plot {
      overflow: visible;
    }
  }
</style>
