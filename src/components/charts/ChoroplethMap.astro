---
import ChartFrame from "./ChartFrame.astro";
import type { ChartChromeProps } from "./_types";
import { finite, formatNumber, scaleLinear, slugify } from "./_utils";
import indonesiaProvincesRaw from "../../data/geo/indonesia-provinces.json";
import { withBase } from "../../lib/paths";

type Position = [number, number];
type PolygonCoordinates = Position[][];
interface ProvinceFeature {
  type: "Feature";
  properties: { code: string; name: string; level: string };
  geometry: {
    type: "Polygon" | "MultiPolygon";
    coordinates: PolygonCoordinates | PolygonCoordinates[];
  };
}

export interface ProvinceValue extends Record<string, unknown> {
  /** BPS province code, matching `indonesia-provinces.json`. */
  code: string;
  name: string;
  /** `null` means either no record or a count withheld for being too small. */
  value: number | null;
  withheld?: boolean;
}

interface Props extends Omit<ChartChromeProps<ProvinceValue>, "tableRows" | "tableColumns"> {
  data: ProvinceValue[];
  /** One tab per cohort, drawn into the same map rather than beside it. */
  panels?: { label: string; data: ProvinceValue[] }[];
  /** Label for the tab that shows `data`, the pooled figure. */
  allLabel?: string;
  width?: number;
  height?: number;
  bounds?: { minLat: number; maxLat: number; minLng: number; maxLng: number };
  valueLabel?: string;
  /** Number of colour classes. Five is the practical ceiling for a printed map. */
  bins?: number;
  labelCount?: number;
  note?: string;
}

const {
  data,
  panels = [],
  allLabel = "Semua angkatan",
  width = 960,
  height = 430,
  bounds = { minLat: -11, maxLat: 6.5, minLng: 94.5, maxLng: 141.5 },
  valueLabel = "mahasiswa",
  bins = 5,
  labelCount = 5,
  note,
  title,
  deck,
  id = slugify(title),
  source,
  extracted,
  csvHref,
  tableCaption,
  class: className,
  hideHeader,
} = Astro.props;

const margin = { top: 14, right: 24, bottom: 30, left: 24 };
const projectX = (lng: number) => scaleLinear(lng, bounds.minLng, bounds.maxLng, margin.left, width - margin.right);
const projectY = (lat: number) => scaleLinear(lat, bounds.maxLat, bounds.minLat, margin.top, height - margin.bottom);

const provinceFeatures = (indonesiaProvincesRaw as unknown as { features: ProvinceFeature[] }).features;
const indonesiaGeoJsonUrl = withBase("/data/indonesia-provinces.geojson");

const ringPath = (ring: Position[]) => ring.length
  ? `${ring.map(([lng, lat], index) => `${index === 0 ? "M" : "L"}${projectX(lng).toFixed(2)} ${projectY(lat).toFixed(2)}`).join(" ")} Z`
  : "";
const provincePath = (feature: ProvinceFeature) => {
  const polygons = feature.geometry.type === "Polygon"
    ? [feature.geometry.coordinates as PolygonCoordinates]
    : feature.geometry.coordinates as PolygonCoordinates[];
  return polygons.flatMap((polygon) => polygon.map(ringPath)).join(" ");
};
const paths = new Map(provinceFeatures.map((feature) => [feature.properties.code, provincePath(feature)]));

/* Bin thresholds come from quantiles of the pooled values, and every tab reuses
   them. Reclassifying per cohort would make the same shade mean a different
   number on the next tab, which is exactly the comparison a reader makes when
   clicking between years. */
const present = data.filter((row) => row.value !== null && Number.isFinite(Number(row.value)));
const sorted = present.map((row) => finite(row.value)).sort((a, b) => a - b);
const classCount = Math.max(2, Math.min(bins, sorted.length || 2));
const thresholds = Array.from({ length: classCount - 1 }, (_, index) => {
  const position = ((index + 1) / classCount) * (sorted.length - 1);
  const low = Math.floor(position);
  const high = Math.ceil(position);
  return sorted[low] + (sorted[high] - sorted[low]) * (position - low);
});
const rampSteps = ["100", "250", "400", "550", "700"];
const rampFallback = ["#cde2fb", "#86b6ef", "#3987e5", "#1c5cab", "#0d366b"];
const rampOffset = rampSteps.length - classCount;
const binColor = (index: number) => {
  const step = rampOffset + index;
  return `var(--seq-${rampSteps[step]}, ${rampFallback[step]})`;
};
const binOf = (value: number) => {
  let index = 0;
  while (index < thresholds.length && value > thresholds[index]) index += 1;
  return index;
};

const byCode = (rows: ProvinceValue[]) => new Map(rows.map((row) => [String(row.code), row]));
const withheldCount = data.filter((row) => row.withheld).length;
const maxValue = sorted.at(-1) ?? 0;

/* Every tab, pooled first. The pooled tab is what renders without JavaScript. */
const tabs = [
  { key: "semua", label: allLabel, scope: "semua angkatan", data },
  ...panels.map((panel) => ({ key: slugify(panel.label), label: panel.label, scope: `angkatan ${panel.label}`, data: panel.data })),
];
const tabLookup = tabs.map((tab) => byCode(tab.data));

const fillFor = (row: ProvinceValue | undefined) =>
  row && row.value !== null ? binColor(binOf(finite(row.value))) : `url(#${id}-nodata)`;
const describe = (feature: ProvinceFeature, row: ProvinceValue | undefined) => {
  if (!row) return `${feature.properties.name}: tidak ada ${valueLabel} tercatat`;
  if (row.value === null) {
    return `${feature.properties.name}: ${row.withheld ? `kurang dari 3 ${valueLabel}, angka disamarkan` : "tidak tercatat"}`;
  }
  return `${feature.properties.name}: ${formatNumber(finite(row.value))} ${valueLabel}`;
};

const provinces = provinceFeatures.map((feature) => {
  const rows = tabLookup.map((lookup) => lookup.get(feature.properties.code));
  return {
    code: feature.properties.code,
    name: feature.properties.name,
    path: paths.get(feature.properties.code) ?? "",
    fills: rows.map((row) => fillFor(row)),
    readings: rows.map((row) => describe(feature, row)),
  };
});

/* Anchor each label on its own polygon's bounding-box centre: the report has no
   centroid table keyed by BPS code, and a bounding-box centre is close enough
   for a label that also names nothing but a number. */
const anchors = new Map(provinceFeatures.map((feature) => {
  const positions = (feature.geometry.type === "Polygon"
    ? [feature.geometry.coordinates as PolygonCoordinates]
    : feature.geometry.coordinates as PolygonCoordinates[]
  ).flat(2) as Position[];
  const lngs = positions.map(([lng]) => lng);
  const lats = positions.map(([, lat]) => lat);
  return [feature.properties.code, {
    x: projectX((Math.min(...lngs) + Math.max(...lngs)) / 2),
    y: projectY((Math.min(...lats) + Math.max(...lats)) / 2),
  }];
}));

/* Only the largest few provinces are labelled on any one tab, but the tab
   switch has to be able to reach any of them, so the union is rendered once and
   each tab blanks the ones it does not name. */
const topPerTab = tabs.map((tab) => new Set(
  [...tab.data]
    .filter((row) => row.value !== null)
    .sort((a, b) => finite(b.value) - finite(a.value))
    .slice(0, labelCount)
    .map((row) => String(row.code)),
));
const labelCodes = [...new Set(topPerTab.flatMap((set) => [...set]))];
const labels = labelCodes.map((code) => ({
  code,
  anchor: anchors.get(code) ?? { x: 0, y: 0 },
  values: tabs.map((_tab, index) => {
    if (!topPerTab[index].has(code)) return "";
    const row = tabLookup[index].get(code);
    return row && row.value !== null ? formatNumber(finite(row.value)) : "";
  }),
}));

/* A province whose count was withheld for being under three still has students
   in it, so it counts towards the reach even though it adds nothing to the
   total. Counting only the printable cells would understate every cohort. */
const tabTotals = tabs.map((tab) => {
  const counted = tab.data.filter((row) => row.value !== null);
  const reached = tab.data.filter((row) => row.value !== null || row.withheld);
  return {
    total: `${formatNumber(counted.reduce((sum, row) => sum + finite(row.value), 0))} ${valueLabel}`,
    scope: `tersebar di ${formatNumber(reached.length)} provinsi · ${tab.scope}`,
  };
});

const legendItems = Array.from({ length: classCount }, (_, index) => {
  const low = index === 0 ? sorted[0] ?? 0 : Math.floor(thresholds[index - 1]) + 1;
  const high = index === classCount - 1 ? maxValue : Math.floor(thresholds[index]);
  return {
    color: binColor(index),
    label: low >= high ? formatNumber(low) : `${formatNumber(low)}–${formatNumber(high)}`,
  };
});

const scaleNote = tabs.length > 1
  ? `Skala warna dihitung sekali dari gabungan ${allLabel.toLowerCase()} dan dipakai pada seluruh tab, sehingga satu warna berarti jumlah yang sama di tahun mana pun.`
  : undefined;
const frameNote = [note, scaleNote].filter(Boolean).join(" ") || undefined;

const tableRows: ProvinceValue[] = [...data]
  .sort((a, b) => finite(b.value) - finite(a.value) || a.name.localeCompare(b.name, "id"))
  .map((row) => ({
    ...row,
    tampil: row.value === null ? (row.withheld ? "disamarkan (<3)" : "tidak tercatat") : formatNumber(finite(row.value)),
  }));
---

<ChartFrame
  {id}
  {title}
  {deck}
  {source}
  {extracted}
  {csvHref}
  {tableCaption}
  tableRows={tableRows}
  tableColumns={[
    { key: "name", label: "Provinsi" },
    { key: "code", label: "Kode BPS" },
    { key: "tampil", label: `Jumlah ${valueLabel}`, align: "end" },
  ]}
  class={className}
  {hideHeader}
  note={frameNote}
>
  <div class="choropleth" data-choropleth data-default-panel="semua">
    <div
      class="choropleth__tabs"
      data-choropleth-controls
      data-totals={tabTotals.map((row) => row.total).join("|")}
      data-scopes={tabTotals.map((row) => row.scope).join("|")}
      role="group"
      aria-label="Pilih angkatan"
      hidden
    >
      {tabs.map((tab, index) => (
        <button type="button" data-choropleth-panel={tab.key} aria-pressed={index === 0 ? "true" : "false"}>{tab.label}</button>
      ))}
    </div>

    <p class="choropleth__counter">
      <output data-choropleth-total>{tabTotals[0].total}</output>
      <span data-choropleth-scope>{tabTotals[0].scope}</span>
    </p>

    <svg class="choropleth__main" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-svg-title ${id}-svg-desc`}>
      <title id={`${id}-svg-title`}>{title}</title>
      <desc id={`${id}-svg-desc`}>
        Peta koroplet 38 provinsi Indonesia. Warna yang lebih pekat berarti lebih banyak {valueLabel};
        provinsi berarsir tidak memiliki catatan atau angkanya disamarkan karena kurang dari tiga orang.
        Seluruh angka tersedia pada tabel di bawah peta.
      </desc>
      <defs>
        <pattern id={`${id}-nodata`} width="6" height="6" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
          <rect width="6" height="6" fill="var(--surface-subtle, #f0f3f4)" />
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--rule-strong, #aeb8be)" stroke-width="1.5" />
        </pattern>
      </defs>
      <g class="provinces">
        {provinces.map((province) => (
          <path
            data-province={province.code}
            data-fills={province.fills.join("|")}
            data-readings={province.readings.join("|")}
            data-tooltip={province.readings[0]}
            d={province.path}
            fill={province.fills[0]}
            fill-rule="evenodd"
            tabindex="0"
            role="img"
            aria-label={province.readings[0]}
          >
            <title>{province.readings[0]}</title>
          </path>
        ))}
      </g>
      <g class="choropleth__labels" aria-hidden="true">
        {labels.map((label) => (
          <text
            class="choropleth__value"
            data-province-label={label.code}
            data-values={label.values.join("|")}
            x={label.anchor.x}
            y={label.anchor.y}
            text-anchor="middle"
            style={label.values[0] ? undefined : "display:none"}
          >{label.values[0]}</text>
        ))}
      </g>
    </svg>

    <div class="choropleth__legend" role="img" aria-label={`Skala warna: ${legendItems.map((item) => item.label).join(", ")} ${valueLabel}`}>
      <span class="choropleth__legend-title">{valueLabel}</span>
      <ul>
        {legendItems.map((item) => (
          <li><i style={`background:${item.color}`} aria-hidden="true"></i>{item.label}</li>
        ))}
        <li><i class="choropleth__legend-nodata" aria-hidden="true"></i>tidak ada / disamarkan</li>
      </ul>
    </div>

    <p class="choropleth__attribution">
      {withheldCount > 0 && <>Sebanyak {formatNumber(withheldCount)} sel provinsi memuat kurang dari tiga orang dan angkanya disamarkan. </>}
      Batas provinsi: Peta Nusa / Laravel Nusa, Kepmendagri 2025, lisensi MIT.{" "}
      <a href={indonesiaGeoJsonUrl} download>Unduh GeoJSON</a>
    </p>
  </div>
</ChartFrame>

<style>
  .choropleth {
    color: var(--ink, #2b2d2f);
    font-family: var(--font-sans, "Open Sans", system-ui, sans-serif);
    font-variant-numeric: tabular-nums;
  }

  .choropleth__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-end: 0.85rem;
  }

  .choropleth__tabs button {
    min-block-size: 34px;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule, #d9dde0);
    border-radius: 999px;
    background: var(--surface, #fff);
    color: var(--ink-muted, #60676c);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .choropleth__tabs button:hover {
    border-color: var(--chart-primary, #01416b);
    color: var(--ink, #2b2d2f);
  }

  .choropleth__tabs button[aria-pressed="true"] {
    border-color: var(--chart-primary, #01416b);
    background: var(--chart-primary, #01416b);
    color: #fff;
    font-weight: 700;
  }

  .choropleth__tabs button:focus-visible {
    outline: 3px solid var(--focus, #1c75bc);
    outline-offset: 2px;
  }

  .choropleth__counter {
    margin: 0 0 0.35rem;
    color: var(--ink-muted, #60676c);
    font-size: 0.85rem;
  }

  .choropleth__counter output {
    margin-inline-end: 0.4rem;
    color: var(--ink, #2b2d2f);
    font-size: 1.35rem;
    font-weight: 850;
  }

  .choropleth__main {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .provinces path {
    stroke: var(--surface, #fff);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .choropleth__main .provinces path:hover,
  .choropleth__main .provinces path:focus-visible {
    stroke: var(--ink, #2b2d2f);
    stroke-width: 1.6;
    outline: none;
  }

  /* The value sits on whichever bin colour happens to be underneath, so it is
     painted with a surface-coloured stroke behind the ink. One element, so the
     tab switch can rewrite it with a single textContent assignment. */
  .choropleth__value {
    fill: var(--ink, #2b2d2f);
    font-size: var(--chart-label-font-size, 12px);
    font-weight: 800;
    paint-order: stroke;
    stroke: var(--surface, #fff);
    stroke-width: 3.5;
    stroke-linejoin: round;
  }

  .choropleth__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin-block-start: 0.35rem;
    font-size: 0.8rem;
  }

  .choropleth__legend-title {
    color: var(--ink-muted, #60676c);
    font-weight: 700;
    text-transform: lowercase;
  }

  .choropleth__legend ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .choropleth__legend li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .choropleth__legend i {
    inline-size: 18px;
    block-size: 12px;
    border: 1px solid var(--rule-strong, #aeb8be);
  }

  .choropleth__legend-nodata {
    background: repeating-linear-gradient(
      45deg,
      var(--surface-subtle, #f0f3f4) 0 2px,
      var(--rule-strong, #aeb8be) 2px 3px
    );
  }

  .choropleth__attribution {
    margin: 0.7rem 0 0;
    color: var(--ink-muted, #60676c);
    font-size: 0.72rem;
  }

  @media (max-width: 45rem) {
    .choropleth__labels { display: none; }
  }
</style>
