---
import ChartFrame from "./ChartFrame.astro";
import type { ChartChromeProps, ChartSeries } from "./_types";
import { SERIES_COLORS, finite, flowLegend, formatCompact, niceMax, scaleLinear, slugify, textLines, ticks } from "./_utils";

type Row = Record<string, unknown>;
interface Props extends Omit<ChartChromeProps<Row>, "tableRows" | "tableColumns"> {
  data: Row[];
  xKey: string;
  series: ChartSeries[];
  width?: number;
  height?: number;
  normalized?: boolean;
  yMax?: number;
  yLabel?: string;
  xFormatter?: (value: unknown) => string;
  valueFormatter?: (value: number) => string;
  provisionalX?: string | number;
  provisionalLabel?: string;
  /**
   * Categories where one or more series have not been recorded yet. The bar is
   * capped with a hatched block and a legend key, so a short bar reads as
   * "still being collected" rather than as a fall. No quantity is implied: the
   * cap has a fixed height because the missing figure is unknown.
   */
  gaps?: (string | number)[];
  gapLabel?: string;
  note?: string;
}

const {
  data,
  xKey,
  series,
  width = 960,
  height = 540,
  normalized = false,
  yMax,
  yLabel,
  xFormatter = (value) => String(value ?? ""),
  valueFormatter = formatCompact,
  provisionalX,
  provisionalLabel = "Data berjalan",
  gaps = [],
  gapLabel = "Belum tercatat",
  note,
  title,
  deck,
  id = slugify(title),
  source,
  extracted,
  csvHref,
  tableCaption,
  class: className,
  hideHeader,
} = Astro.props;

/* Horizontal geometry is fixed; the band below the axis is not. It has to hold
   however many lines the category labels wrap to and however many rows the
   legend flows into, so it is measured rather than assumed. */
const marginX = { right: 26, left: 72 };
const marginTop = 32;
const plotWidth = width - marginX.left - marginX.right;
const slotWidth = plotWidth / Math.max(1, data.length);
const barWidth = Math.min(78, slotWidth * 0.68);

const patterns = ["solid", "diagonal", "dots", "cross"] as const;
const preparedSeries = series.map((item, index) => ({
  ...item,
  color: item.color ?? SERIES_COLORS[index % SERIES_COLORS.length],
  pattern: item.pattern ?? patterns[index % patterns.length],
}));

const provisionalIndex = data.findIndex((row) => String(row[xKey]) === String(provisionalX));
const gapKeys = new Set(gaps.map((value) => String(value)));
const hasGaps = gapKeys.size > 0;
const gapCapHeight = 26;

const legendEntries = [
  ...preparedSeries.map((item, index) => ({ label: item.label, fill: `url(#${id}-series-${index})`, dashed: false })),
  ...(hasGaps ? [{ label: gapLabel, fill: `url(#${id}-gap)`, dashed: true }] : []),
];
/* Flow, not equal columns: a long series name would otherwise run straight
   through its neighbour as soon as one label is wider than its share. */
const legend = flowLegend(legendEntries.map((item) => item.label), plotWidth, { fontSize: 12, keyWidth: 25, gap: 26, rowHeight: 24 });

/* Categories can be programme names ("Elektronika dan Instrumentasi"), so each
   label wraps to its own slot instead of running into the next one. */
const xLabelBudget = Math.max(8, Math.floor(slotWidth / 6.9));
const xLabels = data.map((row) => textLines(xFormatter(row[xKey]), xLabelBudget, 2));
const xLabelRows = Math.max(1, ...xLabels.map((lines) => lines.length));

const axisGap = 25;
const provisionalGap = provisionalIndex >= 0 ? 18 : 0;
const legendGap = 22;
const marginBottom = axisGap + xLabelRows * 14 + provisionalGap + legendGap + legend.rows * legend.rowHeight;
const margin = { top: marginTop, right: marginX.right, bottom: marginBottom, left: marginX.left };
const stageHeight = Math.max(height, margin.top + 260 + margin.bottom);
const plotHeight = stageHeight - margin.top - margin.bottom;
const legendTop = margin.top + plotHeight + axisGap + xLabelRows * 14 + provisionalGap + legendGap - 14;

const totals = data.map((row) => series.reduce((sum, item) => sum + Math.max(0, finite(row[item.key])), 0));
const domainMax = normalized ? 100 : yMax ?? niceMax(Math.max(1, ...totals));
const y = (value: number) => margin.top + plotHeight - scaleLinear(value, 0, domainMax, 0, plotHeight);
const yTicks = ticks(0, domainMax, 4);

const tableColumns = [
  { key: xKey, label: xKey, format: (value: unknown) => xFormatter(value) },
  ...series.map((item) => ({
    key: item.key,
    label: item.label,
    align: "end" as const,
    format: (value: unknown) => Number.isFinite(Number(value)) ? valueFormatter(Number(value)) : "—",
  })),
];
---

<ChartFrame
  {id}
  {title}
  {deck}
  {source}
  {extracted}
  {csvHref}
  {tableCaption}
  tableRows={data}
  {tableColumns}
  class={className}
  {hideHeader}
  minPlotWidth={600}
  {note}
>
  <svg viewBox={`0 0 ${width} ${stageHeight}`} role="img" aria-labelledby={`${id}-svg-title ${id}-svg-desc`}>
    <title id={`${id}-svg-title`}>{title}</title>
    <desc id={`${id}-svg-desc`}>
      Grafik batang bertumpuk untuk {data.length} kategori dan {series.length} seri. Pola permukaan membedakan seri selain warna.
    </desc>
    <defs>
      {preparedSeries.map((item, index) => (
        <pattern id={`${id}-series-${index}`} width="9" height="9" patternUnits="userSpaceOnUse">
          <rect width="9" height="9" fill={item.color} />
          {item.pattern === "diagonal" && <path d="M -2 2 L 2 -2 M 0 9 L 9 0 M 7 11 L 11 7" stroke="#fff" stroke-width="1.4" opacity="0.5" />}
          {item.pattern === "dots" && <circle cx="3" cy="3" r="1.2" fill="#fff" opacity="0.58" />}
          {item.pattern === "cross" && <path d="M 1 4.5 H 8 M 4.5 1 V 8" stroke="#fff" stroke-width="1.1" opacity="0.48" />}
        </pattern>
      ))}
      <pattern id={`${id}-provisional`} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="var(--ink, #2b2d2f)" stroke-width="2" opacity="0.22" />
      </pattern>
      <pattern id={`${id}-gap`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="7" height="7" fill="var(--surface, #fff)" />
        <line x1="0" y1="0" x2="0" y2="7" stroke="var(--ink-muted, #656b70)" stroke-width="2" opacity="0.42" />
      </pattern>
    </defs>

    <g class="grid" aria-hidden="true">
      {yTicks.map((tick) => (
        <g>
          <line x1={margin.left} x2={margin.left + plotWidth} y1={y(tick)} y2={y(tick)} />
          <text x={margin.left - 11} y={y(tick) + 4} text-anchor="end">{normalized ? `${Math.round(tick)}%` : valueFormatter(tick)}</text>
        </g>
      ))}
      {yLabel && <text class="axis-label" x={margin.left} y="14">{yLabel}</text>}
    </g>

    {data.map((row, rowIndex) => {
      const total = totals[rowIndex];
      let cumulative = 0;
      const centerX = margin.left + slotWidth * rowIndex + slotWidth / 2;
      return (
        <g class="stack">
          {preparedSeries.map((item, seriesIndex) => {
            const rawValue = Math.max(0, finite(row[item.key]));
            const value = normalized ? (total === 0 ? 0 : (rawValue / total) * 100) : rawValue;
            const segmentTop = cumulative + value;
            const segmentY = y(segmentTop);
            const segmentHeight = Math.max(0, y(cumulative) - segmentY - (seriesIndex === 0 ? 0 : 2));
            cumulative = segmentTop;
            const tooltip = `${xFormatter(row[xKey])}, ${item.label}: ${valueFormatter(rawValue)}${normalized ? ` (${formatCompact(value)}%)` : ""}`;
            return value > 0 ? (
              <rect
                class="segment"
                x={centerX - barWidth / 2}
                y={segmentY}
                width={barWidth}
                height={segmentHeight}
                rx="2"
                fill={`url(#${id}-series-${seriesIndex})`}
                tabindex="0"
                data-tooltip={tooltip}
                aria-label={tooltip}
              />
            ) : null;
          })}
          {gapKeys.has(String(row[xKey])) && (
            <g class="gap-cap">
              <rect
                x={centerX - barWidth / 2}
                y={y(total) - gapCapHeight}
                width={barWidth}
                height={gapCapHeight}
                fill={`url(#${id}-gap)`}
                tabindex="0"
                data-tooltip={`${xFormatter(row[xKey])}: ${gapLabel}. Sebagian seri belum tersedia pada berkas sumber.`}
                aria-label={`${xFormatter(row[xKey])}: ${gapLabel}. Sebagian seri belum tersedia pada berkas sumber.`}
              />
              <line
                x1={centerX - barWidth / 2}
                x2={centerX + barWidth / 2}
                y1={y(total) - gapCapHeight}
                y2={y(total) - gapCapHeight}
                aria-hidden="true"
              />
            </g>
          )}
          {rowIndex === provisionalIndex && (
            <rect
              class="provisional-overlay"
              x={centerX - barWidth / 2 - 4}
              y={margin.top}
              width={barWidth + 8}
              height={plotHeight}
              fill={`url(#${id}-provisional)`}
              aria-hidden="true"
            />
          )}
          <text class="x-label" x={centerX} y={margin.top + plotHeight + 25} text-anchor="middle">
            {xLabels[rowIndex].map((line, lineIndex) => (
              <tspan x={centerX} dy={lineIndex === 0 ? 0 : 14}>{line}</tspan>
            ))}
          </text>
          {rowIndex === provisionalIndex && <text class="provisional-label" x={centerX} y={margin.top + plotHeight + 29 + xLabelRows * 14} text-anchor="middle">{provisionalLabel}</text>}
        </g>
      );
    })}

    <g class="legend" transform={`translate(${margin.left}, ${legendTop})`} aria-label="Legenda">
      {legendEntries.map((item, index) => (
        <g transform={`translate(${legend.positions[index].x}, ${legend.positions[index].y})`}>
          <rect class:list={["legend-key", item.dashed && "is-gap"]} width="18" height="18" rx="2" fill={item.fill} />
          <text x="25" y="13">{item.label}</text>
        </g>
      ))}
    </g>
  </svg>
</ChartFrame>

<style>
  svg {
    color: var(--ink, #2b2d2f);
    font-family: var(--font-sans, "Open Sans", system-ui, sans-serif);
    font-variant-numeric: tabular-nums;
  }

  .grid line {
    stroke: var(--rule-light, #e4e7e9);
  }

  .grid text,
  .x-label,
  .provisional-label {
    fill: var(--ink-muted, #656b70);
    font-size: var(--chart-axis-font-size, 12px);
  }

  .grid .axis-label {
    fill: currentColor;
    font-size: var(--chart-label-font-size, 12px);
    font-weight: 700;
  }

  .provisional-label {
    font-size: var(--chart-small-font-size, 10px);
    font-weight: 700;
  }

  .segment {
    stroke: var(--surface, #fff);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: opacity var(--duration-base, 180ms) var(--ease-standard, cubic-bezier(0.2, 0, 0.2, 1));
  }

  /* A dashed open edge: the bar is not finished, not merely short. */
  .gap-cap rect {
    stroke: var(--ink-muted, #656b70);
    stroke-width: 1;
    stroke-dasharray: 3 2;
    vector-effect: non-scaling-stroke;
  }

  .gap-cap line {
    stroke: var(--ink-muted, #656b70);
    stroke-width: 2;
    stroke-dasharray: 5 3;
    vector-effect: non-scaling-stroke;
  }

  .gap-cap rect:focus-visible {
    outline: 3px solid var(--focus, #1c75bc);
    outline-offset: 2px;
  }

  .legend-key.is-gap {
    stroke: var(--ink-muted, #656b70);
    stroke-width: 1;
    stroke-dasharray: 3 2;
    vector-effect: non-scaling-stroke;
  }

  .segment:hover,
  .segment:focus {
    opacity: 0.76;
  }

  .segment:focus-visible {
    outline: none;
    stroke: var(--focus, #1c75bc);
    stroke-width: 3;
  }

  .provisional-overlay {
    pointer-events: none;
  }

  .legend text {
    fill: currentColor;
    font-size: var(--chart-small-font-size, 11px);
    font-weight: 650;
  }

  @media (prefers-reduced-motion: reduce) {
    .segment { transition: none; }
  }
</style>
