---
import ChartFrame from "./ChartFrame.astro";
import type { ChartChromeProps } from "./_types";
import { SERIES_COLORS, finite, formatNumber, scaleLinear, slugify, spreadLabels, textLines, ticks } from "./_utils";

interface SlopeDatum extends Record<string, unknown> {
  label: string;
  start: number;
  end: number;
  color?: string;
  startLabel?: string;
  endLabel?: string;
  note?: string;
}

interface Props extends Omit<ChartChromeProps<SlopeDatum>, "tableRows" | "tableColumns"> {
  data: SlopeDatum[];
  startTitle: string;
  endTitle: string;
  width?: number;
  height?: number;
  domain?: [number, number];
  valueFormatter?: (value: number) => string;
  yLabel?: string;
}

const {
  data,
  startTitle,
  endTitle,
  width = 1040,
  height = 520,
  domain,
  valueFormatter = (value) => formatNumber(value, 1),
  yLabel,
  title,
  deck,
  id = slugify(title),
  source,
  extracted,
  csvHref,
  tableCaption,
  class: className,
  hideHeader,
} = Astro.props;

/* Programme names run long ("Elektronika dan Instrumentasi"), so each label is
   drawn on two lines — name, then value — and the gutters are sized for the
   wrapped name rather than for one long run of text that would clip. */
const margin = { top: 76, right: 250, bottom: 42, left: 250 };
const labelGutter = 26;
const labelWrap = 22;
const plotHeight = height - margin.top - margin.bottom;
const allValues = data.flatMap((row) => [finite(row.start), finite(row.end)]);
const range = Math.max(...allValues) - Math.min(...allValues);
const padding = range === 0 ? Math.max(1, Math.abs(allValues[0] ?? 1) * 0.1) : range * 0.1;
const [minValue, maxValue] = domain ?? [Math.min(...allValues) - padding, Math.max(...allValues) + padding];
const y = (value: number) => margin.top + plotHeight - scaleLinear(value, minValue, maxValue, 0, plotHeight);
const leftX = margin.left;
const rightX = width - margin.right;

/* Two-line labels need a taller stride than the old single-line 21px. */
const wrapped = data.map((row) => textLines(row.label, labelWrap, 2));
const labelStride = 15 + Math.max(...wrapped.map((lines) => lines.length)) * 14;
const leftLabels = spreadLabels(data.map((row, index) => ({ index, y: y(row.start) })), margin.top, margin.top + plotHeight, labelStride);
const rightLabels = spreadLabels(data.map((row, index) => ({ index, y: y(row.end) })), margin.top, margin.top + plotHeight, labelStride);
const gridTicks = ticks(minValue, maxValue, 4);
const tableRows = data.map((row) => ({
  Kelompok: row.label,
  [startTitle]: row.startLabel ?? valueFormatter(row.start),
  [endTitle]: row.endLabel ?? valueFormatter(row.end),
  Perubahan: valueFormatter(row.end - row.start),
  Catatan: row.note ?? "—",
}));
---

<ChartFrame
  {id}
  {title}
  {deck}
  {source}
  {extracted}
  {csvHref}
  {tableCaption}
  tableRows={tableRows}
  tableColumns={[
    { key: "Kelompok", label: "Kelompok" },
    { key: startTitle, label: startTitle, align: "end" },
    { key: endTitle, label: endTitle, align: "end" },
    { key: "Perubahan", label: "Perubahan", align: "end" },
    { key: "Catatan", label: "Catatan" },
  ]}
  class={className}
  {hideHeader}
  minPlotWidth={760}
>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-svg-title ${id}-svg-desc`}>
    <title id={`${id}-svg-title`}>{title}</title>
    <desc id={`${id}-svg-desc`}>Grafik kemiringan membandingkan {startTitle} dan {endTitle} untuk {data.length} kelompok.</desc>

    <g class="grid" aria-hidden="true">
      {gridTicks.map((tick) => <line x1={leftX} x2={rightX} y1={y(tick)} y2={y(tick)} />)}
      {yLabel && <text x={leftX} y="16">{yLabel}</text>}
    </g>
    <g class="headers" aria-hidden="true">
      <text x={leftX} y="40" text-anchor="middle">{startTitle}</text>
      <text x={rightX} y="40" text-anchor="middle">{endTitle}</text>
    </g>

    {data.map((row, index) => {
      const startY = y(row.start);
      const endY = y(row.end);
      const leftLabelY = leftLabels.get(index) ?? startY;
      const rightLabelY = rightLabels.get(index) ?? endY;
      const color = row.color ?? SERIES_COLORS[index % SERIES_COLORS.length];
      const nameLines = wrapped[index];
      const delta = row.end - row.start;
      const direction = delta > 0 ? "naik" : delta < 0 ? "turun" : "tetap";
      const tooltip = `${row.label}: ${row.startLabel ?? valueFormatter(row.start)} menjadi ${row.endLabel ?? valueFormatter(row.end)}; ${direction} ${valueFormatter(Math.abs(delta))}.${row.note ? ` ${row.note}` : ""}`;
      return (
        <g class="slope" tabindex="0" data-tooltip={tooltip} aria-label={tooltip}>
          <line class="connector" x1={leftX} x2={rightX} y1={startY} y2={endY} stroke={color} />
          <circle cx={leftX} cy={startY} r="5" fill={color} />
          <circle cx={rightX} cy={endY} r="5" fill={color} />
          {Math.abs(leftLabelY - startY) > 2 && <line class="leader" x1={leftX - 8} x2={leftX - labelGutter + 6} y1={startY} y2={leftLabelY} />}
          {Math.abs(rightLabelY - endY) > 2 && <line class="leader" x1={rightX + 8} x2={rightX + labelGutter - 6} y1={endY} y2={rightLabelY} />}
          <text class="left-label" x={leftX - labelGutter} y={leftLabelY + 4 - nameLines.length * 7.25} text-anchor="end">
            {nameLines.map((line, lineIndex) => (
              <tspan class="series-name" x={leftX - labelGutter} dy={lineIndex === 0 ? 0 : 14}>{line}</tspan>
            ))}
            <tspan class="series-value" x={leftX - labelGutter} dy="15">{row.startLabel ?? valueFormatter(row.start)}</tspan>
          </text>
          <text class="right-label" x={rightX + labelGutter} y={rightLabelY + 4 - nameLines.length * 7.25}>
            {nameLines.map((line, lineIndex) => (
              <tspan class="series-name" x={rightX + labelGutter} dy={lineIndex === 0 ? 0 : 14}>{line}</tspan>
            ))}
            <tspan class="series-value" x={rightX + labelGutter} dy="15">{row.endLabel ?? valueFormatter(row.end)}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
</ChartFrame>

<style>
  svg {
    color: var(--ink, #2b2d2f);
    font-family: var(--font-sans, "Open Sans", system-ui, sans-serif);
    font-variant-numeric: tabular-nums;
  }

  .grid line {
    stroke: var(--rule-light, #e5e8ea);
  }

  .grid text {
    fill: var(--ink-muted, #656b70);
    font-size: 11px;
    font-weight: 700;
  }

  .headers text {
    fill: currentColor;
    font-size: 14px;
    font-weight: 800;
  }

  .connector {
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transition: opacity var(--duration-base, 180ms) var(--ease-standard, cubic-bezier(0.2, 0, 0.2, 1));
  }

  .slope circle {
    stroke: var(--surface, #fff);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .slope text {
    fill: currentColor;
    font-size: 11px;
  }

  .series-name {
    font-weight: 800;
  }

  .series-value {
    fill: var(--ink-muted, #656b70);
    font-weight: 600;
  }

  .leader {
    stroke: var(--ink-muted, #656b70);
    stroke-width: 1;
  }

  .slope:focus-visible {
    outline: none;
  }

  .slope:hover .connector,
  .slope:focus .connector {
    stroke-width: 5;
  }

  .slope:focus-visible circle {
    stroke: var(--focus, #1c75bc);
    stroke-width: 4;
  }

  @media (prefers-reduced-motion: reduce) {
    .connector { transition: none; }
  }
</style>
