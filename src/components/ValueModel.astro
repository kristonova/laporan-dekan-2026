---
interface Props {
  metrics: {
    funding_rp: number;
    research_n: number;
    outreach_n: number;
    publications_n: number;
    citations_n: number;
    mappable_outreach_n: number;
  };
}
const { metrics } = Astro.props;
const format = (value: number, digits = 0) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);
const fundingLabel = `Rp${format(metrics.funding_rp / 1_000_000_000, 2)} M`;
---

<nav class="value-model" aria-label="Model nilai FMIPA">
  <a class="value-node value-node--input" href="#dana-riset">
    <span>Masukan</span>
    <strong>{fundingLabel}</strong>
    <small>dana riset 2021–2025</small>
  </a>
  <span class="value-arrow" aria-hidden="true">→</span>
  <div class="value-stage">
    <span>Kegiatan</span>
    <div>
      <a href="#dana-riset"><strong>{format(metrics.research_n)}</strong><small>judul riset</small></a>
      <a href="#jangkauan"><strong>{format(metrics.outreach_n)}</strong><small>kegiatan pengabdian</small></a>
    </div>
  </div>
  <span class="value-arrow" aria-hidden="true">→</span>
  <a class="value-node" href="#publikasi-departemen">
    <span>Luaran</span>
    <strong>{format(metrics.publications_n)}</strong>
    <small>publikasi 2021–2025</small>
  </a>
  <span class="value-arrow" aria-hidden="true">→</span>
  <div class="value-stage value-stage--impact">
    <span>Dampak terukur</span>
    <div>
      <a href="#jangkauan-riset"><strong>{format(metrics.citations_n)}</strong><small>sitasi lima tahun</small></a>
      <a href="#jangkauan"><strong>{format(metrics.mappable_outreach_n)}</strong><small>kegiatan dapat dipetakan</small></a>
    </div>
  </div>
</nav>

<style>
  .value-model {
    display: grid;
    grid-template-columns: 1fr auto 1.35fr auto 1fr auto 1.35fr;
    align-items: stretch;
    gap: 14px;
  }
  .value-node, .value-stage {
    min-width: 0;
    min-height: 210px;
    padding: 26px;
    border: 1px solid var(--border-default);
    border-top: 4px solid var(--ugm-blue);
    background: var(--surface-card);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-decoration: none;
  }
  .value-node:hover { background: var(--surface-tint); color: var(--text-primary); }
  .value-node--input { background: var(--ugm-blue); color: #fff; border-color: var(--ugm-blue); }
  .value-node--input:hover { background: var(--ugm-blue-strong); color: #fff; }
  .value-node span, .value-stage > span {
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .value-node--input span { color: var(--ugm-gold); }
  .value-node strong { margin-block-start: 20px; font-size: clamp(30px, 3vw, 44px); font-weight: 300; line-height: 1; }
  .value-node small { margin-block-start: 8px; color: var(--text-muted); }
  .value-node--input small { color: rgba(255,255,255,.7); }
  .value-stage { gap: 18px; }
  .value-stage > div { display: grid; gap: 12px; }
  .value-stage a { padding-block-start: 12px; border-block-start: 1px solid var(--border-subtle); display: flex; flex-direction: column; color: var(--text-primary); text-decoration: none; }
  .value-stage a:hover strong { color: var(--ugm-blue); }
  .value-stage strong { font-size: 26px; font-weight: 400; }
  .value-stage small { color: var(--text-muted); }
  .value-arrow { align-self: center; color: var(--status-approaching); font-size: 28px; }
  @media (max-width: 980px) {
    .value-model { grid-template-columns: 1fr; }
    .value-node, .value-stage { min-height: 0; }
    .value-arrow { transform: rotate(90deg); justify-self: center; }
  }
</style>
