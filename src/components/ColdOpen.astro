---
import { withBase } from "../lib/paths";

interface Props {
  total?: number;
  recent?: number;
  startYear?: number;
  endYear?: number;
}
const { total = 70_905, recent = 46_930, startYear = 1987, endYear = 2025 } = Astro.props;
const format = (value: number, digits = 0) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);
const totalLabel = format(total);
const shareLabel = `${format((recent / total) * 100, 1)}%`;
const supergraphicStyle = `background-image: url(${JSON.stringify(withBase("/brand/supergraphic-lines.png"))})`;
---

<section class="cold-open" aria-labelledby="cold-open-title">
  <div class="cold-open__supergraphic" aria-hidden="true" style={supergraphicStyle}></div>
  <div class="cold-open__content">
    <p class="cold-open__eyebrow">Lima Tahun FMIPA · 2021–2026</p>
    <p class="cold-open__number" data-count-to={total} aria-label={`${totalLabel} total sitasi`}>{totalLabel}</p>
    <h1 id="cold-open-title">total sitasi publikasi ilmiah FMIPA.</h1>
    <p class="cold-open__statement"><mark>{shareLabel}</mark> tercipta dalam lima tahun terakhir (2021–2026).</p>
    <p class="cold-open__context">Berdasarkan basis data {startYear}–{endYear}. Satu indikator tidak merangkum segalanya, namun menegaskan akselerasi dampak riset akademik yang luar biasa.</p>
    <a class="cold-open__continue" href="#posisi">Eksplorasi Laporan Lengkap <span aria-hidden="true">↓</span></a>
  </div>
  <div class="cold-open__band" aria-hidden="true"></div>
</section>

<style>
  .cold-open {
    min-height: calc(100svh - 72px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    padding: clamp(64px, 10vw, 128px) var(--page-gutter);
    background: #0B1F2E;
    color: #fff;
  }
  .cold-open__content { width: min(100%, var(--content-max)); min-width: 0; margin-inline: auto; position: relative; z-index: 1; }
  .cold-open__eyebrow {
    margin: 0 0 28px;
    color: var(--ugm-gold);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .cold-open__number {
    margin: 0;
    color: var(--ugm-gold);
    font-family: var(--font-ui);
    font-size: clamp(72px, 15vw, 176px);
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    line-height: .82;
    letter-spacing: -.065em;
  }
  .cold-open h1 {
    margin: 24px 0 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 70px);
    font-weight: 400;
    line-height: 1;
  }
  .cold-open__statement {
    margin: 28px 0 0;
    color: rgba(255,255,255,.9);
    font-size: clamp(22px, 3.2vw, 42px);
    line-height: 1.25;
  }
  .cold-open__statement mark { padding: 0 .14em; background: var(--ugm-gold); color: #0B1F2E; }
  .cold-open__context { width: 100%; max-width: 520px; margin: 24px 0 0; overflow-wrap: anywhere; color: rgba(255,255,255,.62); font-size: 16px; }
  .cold-open__continue {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-block-start: 56px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .cold-open__continue span { color: var(--ugm-gold); font-size: 20px; }
  .cold-open__supergraphic {
    position: absolute;
    z-index: -1;
    inset: -8% -15% auto auto;
    width: min(76vw, 980px);
    aspect-ratio: 1;
    background-position: center;
    background-size: contain;
    background-repeat: no-repeat;
    filter: brightness(0) invert(1);
    opacity: .1;
  }
  .cold-open__band { position: absolute; inset: auto 0 0; height: 14px; background: var(--ugm-gold); }
</style>
