---
interface Datum { year: number; amount: number; }
interface Props { data: Datum[]; }
const { data } = Astro.props;
const sorted = [...data].sort((a,b) => a.year - b.year);
const width = 1040, height = 420;
const margin = { top: 52, right: 40, bottom: 64, left: 76 };
const plotW = width - margin.left - margin.right, plotH = height - margin.top - margin.bottom;
const barW = Math.min(78, (plotW / Math.max(sorted.length, 1)) * .58);
const x = (index:number) => margin.left + (index + .5) * (plotW / sorted.length) - barW/2;
const y = (value:number, max:number) => margin.top + plotH - (value/max)*plotH;
const format = (value:number) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: 2 }).format(value);
const early = sorted.filter((row) => row.year <= 2021);
---

<div class="funding-shift" data-funding-shift data-stage="full">
  <div class="funding-shift__graphic">
    <div class="funding-shift__stage funding-shift__stage--early" data-funding-graphic="early">
      <p><strong>Skala awal</strong><span>Maksimum Rp4 miliar</span></p>
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Dana riset 2019 sampai 2021 pada skala maksimum empat miliar rupiah">
        {[0,1,2,3,4].map((tick) => <g><line x1={margin.left} x2={width-margin.right} y1={y(tick,4)} y2={y(tick,4)} /><text x={margin.left-12} y={y(tick,4)+4} text-anchor="end">{tick}</text></g>)}
        {early.map((row,index) => <g><rect x={margin.left+(index+.5)*(plotW/early.length)-barW/2} y={y(row.amount,4)} width={barW} height={margin.top+plotH-y(row.amount,4)} rx="4" /><text class="value" x={margin.left+(index+.5)*(plotW/early.length)} y={y(row.amount,4)-12} text-anchor="middle">{format(row.amount)}</text><text x={margin.left+(index+.5)*(plotW/early.length)} y={height-28} text-anchor="middle">{row.year}</text></g>)}
      </svg>
    </div>
    <div class="funding-shift__stage funding-shift__stage--full" data-funding-graphic="full">
      <p><strong>Skala lima tahun</strong><span>Maksimum Rp80 miliar</span></p>
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Dana riset 2019 sampai 2025 pada skala maksimum delapan puluh miliar rupiah">
        <defs><pattern id="funding-running-pattern" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="8" height="8" fill="var(--ugm-blue)" /><line x1="0" y1="0" x2="0" y2="8" stroke="#fff" stroke-width="2" opacity=".45" /></pattern></defs>
        {[0,20,40,60,80].map((tick) => <g><line x1={margin.left} x2={width-margin.right} y1={y(tick,80)} y2={y(tick,80)} /><text x={margin.left-12} y={y(tick,80)+4} text-anchor="end">{tick}</text></g>)}
        {sorted.map((row,index) => <g class:list={{ "is-current": row.year === 2025 }}><rect x={x(index)} y={y(row.amount,80)} width={barW} height={margin.top+plotH-y(row.amount,80)} rx="4" /><text class="value" x={x(index)+barW/2} y={y(row.amount,80)-12} text-anchor="middle">{format(row.amount)}</text><text x={x(index)+barW/2} y={height-28} text-anchor="middle">{row.year}</text></g>)}
      </svg>
    </div>
  </div>
  <div class="funding-shift__steps">
    <article data-funding-step="early"><span>Periode 2019–2021</span><h3>Perolehan awal berada di kisaran Rp4 miliar.</h3><p>Dana riset bergerak stabil dari Rp2,78 miliar menjadi Rp3,30 miliar, membentuk fondasi awal kapasitas riset fakultas.</p></article>
    <article data-funding-step="full"><span>Periode 2021–2024</span><h3>Lompatan signifikan hingga lebih dari dua puluh kali lipat.</h3><p>Pada 2024, perolehan dana riset menembus Rp74,91 miliar—menjadi puncak perolehan tertinggi sepanjang sejarah fakultas.</p></article>
    <article data-funding-step="full"><span>Tinjauan Keberlanjutan</span><h3>Konsolidasi capaian pendanaan pada 2025.</h3><p>Perolehan sebesar Rp69,51 miliar pada 2025 tetap berada jauh di atas skala awal periode, menegaskan kesinambungan kapasitas riset multi-sumber yang terbangun.</p></article>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-funding-shift]").forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-funding-step]")];
    /* Reduced motion gets the end state outright (PRD 9.5): no sticky swap. */
    if (!("IntersectionObserver" in window)) return;
    if (matchMedia("(max-width: 767px)").matches) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a,b) => b.intersectionRatio-a.intersectionRatio)[0];
      if (visible) root.dataset.stage = (visible.target as HTMLElement).dataset.fundingStep ?? "full";
    }, { rootMargin: "-64% 0px -2%", threshold: [0,.25,.5,.75,1] });
    steps.forEach((step) => observer.observe(step));
  });
</script>

<style>
  /* One column. The axis still widens as the reader scrolls — that mechanic is
     the point of the scene — but the chart is stuck to the top of the viewport
     at full width and the steps pass underneath it, instead of the two sharing
     a row and each getting half the space. */
  .funding-shift { display: grid; gap: 0; }
  .funding-shift__graphic { position: sticky; z-index: var(--z-sticky); top: calc(var(--header-height) + 12px); aspect-ratio: 1040 / 490; min-block-size: 20rem; max-block-size: 64vh; border: 1px solid var(--border-subtle); background: var(--surface-card); }
  .funding-shift__stage { position: absolute; inset: 0; padding: 24px; transition: opacity var(--duration-story) var(--ease-story); }.funding-shift__stage > p { display: flex; justify-content: space-between; color: var(--text-muted); font-size: 12px; }.funding-shift__stage strong { color: var(--text-primary); }.funding-shift__stage svg { width: 100%; height: auto; margin-block-start: 8px; }.funding-shift__stage line { stroke: var(--grid-line); stroke-width: 1; }.funding-shift__stage text { fill: var(--text-muted); font: 12px var(--font-ui); }.funding-shift__stage text.value { fill: var(--text-primary); font-weight: 700; }.funding-shift__stage rect { fill: var(--ugm-blue); }.funding-shift__stage .is-current rect { fill: url(#funding-running-pattern); opacity: .85; }
  .funding-shift[data-stage="early"] .funding-shift__stage--full { opacity: 0; pointer-events: none; }.funding-shift[data-stage="full"] .funding-shift__stage--early { opacity: 0; pointer-events: none; }
  .funding-shift__steps { display: grid; gap: 44vh; padding-block: 26vh 24vh; }.funding-shift__steps article { max-width: 62ch; padding: 28px; border: 1px solid var(--border-default); border-block-start: 4px solid var(--ugm-gold); background: var(--surface-card); box-shadow: var(--shadow-md); }.funding-shift__steps span { color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }.funding-shift__steps h3 { margin-block-start: 12px; color: var(--text-primary); font-size: 23px; }.funding-shift__steps p { margin-block-start: 12px; color: var(--text-secondary); font-size: 14px; }
  @media(max-width:767px){.funding-shift__graphic{position:relative;top:auto;aspect-ratio:auto;min-block-size:0;max-block-size:none;border:0;background:transparent}.funding-shift__stage{position:relative;padding:18px;border:1px solid var(--border-subtle);background:var(--surface-card);opacity:1!important}.funding-shift__stage--early{display:none}.funding-shift__steps{gap:14px;padding:0}.funding-shift__steps article:first-child{display:none}}
  @media(prefers-reduced-motion:reduce){.funding-shift__stage{transition:none}.funding-shift__graphic{position:relative;top:auto;max-block-size:none}.funding-shift__steps{gap:var(--flow-block);padding-block:var(--flow-chart) 0}}
</style>
