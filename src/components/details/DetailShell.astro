---
interface Props { label: string; }
const { label } = Astro.props;
---
<div class="detail-viz" aria-label={label}><slot /></div>
<script>
  document.querySelectorAll<HTMLElement>('[data-detail-switch]').forEach(root => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-detail-choice]');
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      root.querySelectorAll<HTMLElement>('[data-detail-panel]').forEach(panel => {
        panel.hidden = panel.dataset.detailPanel !== button.dataset.detailChoice;
      });
    }));
  });
</script>
<style is:global>
  .detail-viz { --detail-accent: var(--text-heading); color: var(--text-primary); }
  .detail-viz [hidden] { display: none !important; }
  .detail-viz .detail-controls { display:flex; flex-wrap:wrap; align-items:end; gap:14px 24px; margin-bottom:28px; }
  .detail-viz .detail-choices { display:flex; flex-wrap:wrap; gap:6px; padding:5px; border:1px solid var(--border-subtle); border-radius:7px; width:fit-content; background:var(--surface-card); }
  .detail-viz .detail-choices button { cursor:pointer; border:0; border-radius:4px; padding:11px 19px; background:transparent; color:var(--text-secondary); font:600 13px var(--font-ui); min-height:44px; }
  .detail-viz .detail-choices button[aria-pressed="true"] { background:var(--ugm-blue); color:var(--text-on-dark); }
  .detail-viz :is(button,input,select,summary):focus-visible { outline:3px solid var(--ugm-gold); outline-offset:3px; }
  .detail-viz label { display:grid; gap:7px; color:var(--text-secondary); font:600 12px var(--font-ui); }
  .detail-viz :is(select,input) { width:100%; min-width:0; max-width:100%; min-height:46px; border:1px solid var(--border-default); border-radius:4px; padding:10px 14px; background:var(--surface-card); color:var(--text-primary); font:14px var(--font-ui); }
  .detail-viz .detail-kicker { margin:0 0 12px; font:700 11px/1.5 var(--font-ui); letter-spacing:.13em; text-transform:uppercase; color:var(--text-secondary); }
  .detail-viz .detail-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; padding:25px 0; border-block:1px solid var(--border-subtle); margin-bottom:26px; }
  .detail-viz .detail-metrics > div { display:flex; flex-direction:column; gap:7px; }
  .detail-viz .detail-metrics strong { font:650 clamp(28px,3vw,42px)/1.1 var(--font-display); letter-spacing:-.035em; color:var(--detail-accent); font-variant-numeric:tabular-nums; }
  .detail-viz .detail-metrics span { font:13px/1.5 var(--font-ui); color:var(--text-secondary); }
  .detail-viz .detail-grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:clamp(24px,4vw,64px); }
  .detail-viz .detail-grid > * { min-width:0; }
  .detail-viz h4 { margin:0 0 16px; font:600 18px/1.4 var(--font-ui); color:var(--text-heading); }
  .detail-viz .detail-note { margin:20px 0; font:13px/1.75 var(--font-ui); color:var(--text-secondary); max-width:90ch; }
  .detail-viz .detail-callout { background:var(--surface-tint); border-left:3px solid var(--ugm-blue); padding:16px 20px; }
  .detail-viz .detail-scroll { overflow:auto; max-width:100%; }
  .detail-viz table { width:100%; border-collapse:collapse; font:13px/1.5 var(--font-ui); }
  .detail-viz :is(th,td) { text-align:left; padding:13px 12px; border-bottom:1px solid var(--border-subtle); }
  .detail-viz th { color:var(--text-heading); font-weight:600; }
  .detail-viz thead th { font-size:11px; color:var(--text-secondary); }
  .detail-viz .detail-ribbon { display:flex; height:13px; gap:3px; margin:20px 0 12px; overflow:hidden; border-radius:2px; }
  .detail-viz .detail-ribbon > span { background:var(--detail-color,var(--chart-primary)); }
  .detail-viz .detail-legend { display:flex; flex-wrap:wrap; gap:10px 24px; font:12px/1.6 var(--font-ui); color:var(--text-secondary); margin:0 0 26px; }
  .detail-viz .detail-legend i { display:inline-block; width:9px; height:9px; background:var(--detail-color,var(--chart-primary)); margin-right:7px; }
  @media(max-width:700px) { .detail-viz .detail-grid { grid-template-columns:1fr; gap:32px; } .detail-viz .detail-metrics { gap:16px; } .detail-viz .detail-metrics strong { font-size:28px; } .detail-viz .detail-controls > label { width:100%; } .detail-viz .detail-choices button { padding:10px 14px; } }
  @media print { .detail-viz [data-detail-panel][hidden] { display:block !important; margin-top:30px; } .detail-viz .detail-controls { display:none; } }
</style>
