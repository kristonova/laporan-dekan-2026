---
interface Pillar {
  number: string;
  title: string;
  href: string;
}

interface Props { pillars: Pillar[]; }
const { pillars } = Astro.props;
const sections = [
  { href: "#konten-utama", title: "Pembuka & Posisi 2026", caption: "Orientasi", number: "", symbol: "↑" },
  ...pillars.map((pillar) => ({
    ...pillar,
    caption: `Pilar ${pillar.number.padStart(2, "0")} / ${String(pillars.length).padStart(2, "0")}`,
    symbol: pillar.number.padStart(2, "0"),
  })),
  { href: "#yang-diserahkan", title: "Estafet Kepemimpinan", caption: "Penutup", number: "", symbol: "↓" },
];
---

<nav class="pillar-nav" data-pillar-nav aria-label="Navigasi bagian laporan" hidden>
  <button class="pillar-nav__toggle" type="button" aria-expanded="false" aria-controls="pillar-navigation-list" data-pillar-toggle>
    <span class="pillar-nav__badge" data-pillar-badge aria-hidden="true">↑</span>
    <span class="pillar-nav__current">
      <span class="pillar-nav__caption" data-pillar-caption>Orientasi</span>
      <span class="pillar-nav__current-title" data-pillar-title>Pembuka &amp; Posisi 2026</span>
    </span>
    <span class="pillar-nav__toggle-label">Jelajahi</span>
    <svg class="pillar-nav__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 10 4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>

  <div class="pillar-nav__panel" id="pillar-navigation-list" data-pillar-panel>
    <p class="pillar-nav__heading">Jelajahi laporan</p>
    <div class="pillar-nav__timeline">
      <span class="pillar-nav__track" aria-hidden="true"><span data-pillar-progress></span></span>
      <ol class="pillar-nav__list">
      {sections.map((section, index) => (
        <li class:list={["pillar-nav__item", { "pillar-nav__item--bookend": !section.number }]}>
          <a
            class="pillar-nav__link"
            href={section.href}
            aria-label={`${section.caption}: ${section.title}`}
            aria-current={index === 0 ? "location" : undefined}
            data-pillar-link
            data-title={section.title}
            data-caption={section.caption}
            data-symbol={section.symbol}
          >
            <span class="pillar-nav__label">
              <span class="pillar-nav__caption">{section.caption}</span>
              <span class="pillar-nav__name">{section.title}</span>
            </span>
            <span class="pillar-nav__marker" aria-hidden="true">{section.symbol}</span>
          </a>
        </li>
      ))}
      </ol>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-pillar-nav]");
  const main = document.getElementById("konten-utama");

  if (nav && main) {
    const toggle = nav.querySelector<HTMLButtonElement>("[data-pillar-toggle]")!;
    const panel = nav.querySelector<HTMLElement>("[data-pillar-panel]")!;
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-pillar-link]"));
    const targets = links.map((link) => document.getElementById(link.hash.slice(1))!);
    const badge = nav.querySelector<HTMLElement>("[data-pillar-badge]")!;
    const caption = nav.querySelector<HTMLElement>("[data-pillar-caption]")!;
    const title = nav.querySelector<HTMLElement>("[data-pillar-title]")!;
    const progress = nav.querySelector<HTMLElement>("[data-pillar-progress]")!;
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const desktop = window.matchMedia("(min-width: 1280px) and (min-height: 600px)");
    let offsets: number[] = [];
    let headerHeight = 0;
    let active = -1;
    let pendingFrame = 0;
    let needsMeasure = true;

    function setOpen(open: boolean, restoreFocus = false) {
      nav!.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      panel.inert = !desktop.matches && !open;
      if (restoreFocus) toggle.focus({ preventScroll: true });
    }

    function update() {
      pendingFrame = 0;
      if (needsMeasure) {
        // Cache only section boundaries; long charts do not add scroll work.
        offsets = targets.map((target) => target.getBoundingClientRect().top + window.scrollY);
        headerHeight = header?.getBoundingClientRect().height ?? 0;
        needsMeasure = false;
      }
      const readingLine = window.scrollY + headerHeight + Math.min(160, window.innerHeight * 0.2);
      let index = 0;
      for (let i = 1; i < offsets.length; i++) {
        if (offsets[i] <= readingLine) index = i;
      }
      if (index !== active) {
        active = index;
        links.forEach((link, i) => {
          if (i === index) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
          link.dataset.passed = String(i < index);
        });
        badge.textContent = links[index].dataset.symbol!;
        caption.textContent = links[index].dataset.caption!;
        title.textContent = links[index].dataset.title!;
      }
      const next = offsets[index + 1];
      const fraction = next ? Math.min(1, Math.max(0, (readingLine - offsets[index]) / (next - offsets[index]))) : 0;
      progress.style.transform = `scaleY(${(index + fraction) / (links.length - 1)})`;
    }

    function schedule(measure = false) {
      needsMeasure ||= measure;
      if (!pendingFrame) pendingFrame = window.requestAnimationFrame(update);
    }

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    nav.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        if (!desktop.matches && toggle.getAttribute("aria-expanded") === "true") {
          setOpen(false, true);
        } else {
          nav.dataset.dismissed = "true";
        }
      }
    });
    nav.addEventListener("pointerleave", () => delete nav.dataset.dismissed);
    nav.addEventListener("focusin", () => delete nav.dataset.dismissed);
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });
    document.addEventListener("focusin", (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });
    links.forEach((link, index) => link.addEventListener("click", (event) => {
      // Keep native anchors, URL history, and modified clicks intact.
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
      setOpen(false);
      const target = targets[index];
      if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    }));
    desktop.addEventListener("change", () => {
      const focused = document.activeElement;
      if (desktop.matches && focused === toggle) links[Math.max(active, 0)].focus({ preventScroll: true });
      setOpen(false, !desktop.matches && panel.contains(focused));
      schedule(true);
    });
    window.addEventListener("scroll", () => schedule(), { passive: true });
    window.addEventListener("resize", () => schedule(true), { passive: true });
    window.addEventListener("pageshow", () => schedule(true));
    window.addEventListener("hashchange", () => schedule(true));
    // Re-measure after font loads, expanded data tables, or chart filters.
    const observer = new ResizeObserver(() => schedule(true));
    observer.observe(main);
    if (header) observer.observe(header);
    document.fonts.ready.then(() => schedule(true));
    document.body.classList.add("has-pillar-navigation");
    nav.hidden = false;
    setOpen(false);
    update();
  }
</script>

<style>
  .pillar-nav {
    --nav-ink: var(--text-heading);
    position: fixed;
    z-index: 45;
    inset: auto 12px max(12px, env(safe-area-inset-bottom));
    color: var(--text-primary);
    font-family: var(--font-ui);
  }
  .pillar-nav[hidden] { display: none; }
  .pillar-nav__toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 68px;
    padding: 12px 16px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    background: var(--surface-card);
    box-shadow: 0 4px 24px rgb(11 31 46 / 12%);
    text-align: start;
  }
  .pillar-nav__badge {
    display: grid;
    place-items: center;
    flex: 0 0 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ugm-blue);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .pillar-nav__current { flex: 1; min-width: 0; }
  .pillar-nav__caption {
    display: block;
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .pillar-nav__current-title { display: block; margin-top: 2px; font-size: 13px; font-weight: 700; line-height: 1.35; }
  .pillar-nav__toggle-label { font-size: 11px; color: var(--text-secondary); }
  .pillar-nav__chevron { flex-shrink: 0; transition: transform var(--duration-base) var(--ease-standard); }
  .pillar-nav[data-open="true"] .pillar-nav__chevron { transform: rotate(180deg); }
  .pillar-nav__panel {
    display: none;
    position: absolute;
    inset: auto 0 calc(100% + 8px);
    max-height: calc(100dvh - 180px - env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px 12px 12px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    background: var(--surface-card);
    box-shadow: 0 4px 24px rgb(11 31 46 / 10%);
  }
  .pillar-nav[data-open="true"] .pillar-nav__panel { display: block; }
  .pillar-nav__heading { margin: 0 10px 10px; color: var(--text-secondary); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .pillar-nav__timeline { position: relative; }
  .pillar-nav__list { margin: 0; padding: 0; list-style: none; }
  .pillar-nav__track { position: absolute; inset: 29px 21px 29px auto; width: 1px; background: var(--border-default); pointer-events: none; }
  .pillar-nav__track > span { display: block; width: 100%; height: 100%; background: var(--nav-ink); transform: scaleY(0); transform-origin: top; }
  .pillar-nav__link { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 58px; padding-inline: 10px 0; border-radius: 5px; color: var(--text-primary); text-decoration: none; }
  .pillar-nav__label { display: block; padding: 6px 10px; border: 1px solid transparent; border-radius: 5px; }
  .pillar-nav__name { display: block; font-size: 13px; font-weight: 700; line-height: 1.35; }
  .pillar-nav__marker { display: grid; place-items: center; flex: 0 0 28px; height: 28px; margin-inline: 8px; border: 1px solid var(--border-default); border-radius: 50%; background: var(--surface-card); color: var(--text-secondary); font-size: 10px; font-weight: 700; font-variant-numeric: tabular-nums; transition: transform var(--duration-base) var(--ease-standard), background-color var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard); }
  .pillar-nav__link[data-passed="true"] .pillar-nav__marker { border-color: var(--nav-ink); color: var(--nav-ink); }
  .pillar-nav__link[aria-current="location"] .pillar-nav__marker { background: var(--ugm-blue); border-color: var(--ugm-blue); color: #fff; box-shadow: 0 0 0 3px var(--surface-card), 0 0 0 4px var(--ugm-gold); }
  .pillar-nav__link[aria-current="location"] .pillar-nav__label { background: var(--surface-tint); color: var(--nav-ink); }
  .pillar-nav__link:is(:hover, :focus-visible) .pillar-nav__marker { transform: scale(1.18); border-color: var(--nav-ink); }
  .pillar-nav__link:is(:hover, :focus-visible) .pillar-nav__label { background: var(--surface-tint); color: var(--nav-ink); }

  @media (max-width: 420px) { .pillar-nav__toggle-label { display: none; } }
  @media (min-width: 700px) and (max-width: 1279px), (min-width: 700px) and (max-height: 599px) {
    .pillar-nav { width: 440px; inset-inline: auto 20px; }
  }
  @media (min-width: 1280px) and (min-height: 600px) {
    .pillar-nav { inset: 50% 20px auto auto; width: 196px; transform: translateY(-50%); }
    .pillar-nav__toggle { display: none; }
    .pillar-nav__panel { display: block; position: static; max-height: none; overflow: visible; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    .pillar-nav__heading { width: fit-content; margin: 0 0 18px auto; padding: 5px 8px; border-radius: 3px; background: var(--surface-card); font-size: 9px; }
    .pillar-nav__link { height: 64px; padding: 0; gap: 0; }
    .pillar-nav__track { inset-block: 32px; }
    .pillar-nav__label { flex: 1; text-align: end; background: var(--surface-card); opacity: 0; transform: translateX(6px) scale(.96); transform-origin: right center; transition: opacity var(--duration-base) var(--ease-standard), transform var(--duration-base) var(--ease-standard); }
    .pillar-nav__name { font-size: 12px; }
    .pillar-nav__caption { margin-bottom: 3px; font-size: 9px; }
    .pillar-nav__marker { flex-basis: 26px; height: 26px; margin-inline: 9px; }
    .pillar-nav__item--bookend .pillar-nav__marker { font-size: 11px; border-color: transparent; }
    .pillar-nav__link[aria-current="location"] .pillar-nav__label,
    .pillar-nav:not([data-dismissed="true"]) .pillar-nav__link:is(:hover, :focus-visible) .pillar-nav__label { opacity: 1; transform: translateX(0) scale(1); border-color: var(--border-subtle); }
    .pillar-nav:not([data-dismissed="true"]) .pillar-nav__link:is(:hover, :focus-visible) .pillar-nav__label { transform: translateX(-3px) scale(1.03); }
    /* Reserve a reading gutter so the rail never covers charts or their controls. */
    :global(.has-pillar-navigation #konten-utama > section) { padding-inline-end: max(var(--page-gutter), 238px); }
  }
  @media (max-width: 1279px), (max-height: 599px) {
    :global(.has-pillar-navigation) { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
    :global(.has-pillar-navigation :is(a, button, summary, select, [tabindex])) { scroll-margin-block-end: 108px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-nav *, .pillar-nav *::before, .pillar-nav *::after { transition: none !important; }
  }
  @media (forced-colors: active) {
    .pillar-nav__track, .pillar-nav__track > span { background: CanvasText; }
    .pillar-nav__link[aria-current="location"] .pillar-nav__marker { outline: 2px solid Highlight; outline-offset: 3px; }
    .pillar-nav__link[aria-current="location"] .pillar-nav__label { border: 1px solid Highlight; }
  }
  @media print {
    .pillar-nav { display: none !important; }
    :global(.has-pillar-navigation) { padding-bottom: 0; }
    :global(.has-pillar-navigation #konten-utama > section) { padding-inline-end: var(--page-gutter); }
  }
</style>
