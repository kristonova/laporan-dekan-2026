---
import BaseLayout from "../layouts/BaseLayout.astro";
import ColdOpen from "../components/ColdOpen.astro";
import ChapterIntro from "../components/ChapterIntro.astro";
import StoryScene from "../components/StoryScene.astro";
import PillarHeader from "../components/PillarHeader.astro";
import InstitutionPortrait from "../components/InstitutionPortrait.astro";
import ValueModel from "../components/ValueModel.astro";
import TckOverview from "../components/TckOverview.astro";
import ChartFrame from "../components/ChartFrame.astro";
import Insight from "../components/Insight.astro";
import DataGap from "../components/DataGap.astro";
import IssueCards from "../components/IssueCards.astro";
import PillarSummary from "../components/PillarSummary.astro";
import WorldCollaboration from "../components/WorldCollaboration.astro";
import FundingShift from "../components/FundingShift.astro";
import {
  BulletChart,
  DotMatrix,
  HorizontalBarChart,
  LineAreaChart,
  PointMap,
  SDGGrid,
  SlopeChart,
  StackedBarChart,
  TopicBubbles,
} from "../components/charts";
import { chapters, scenes } from "../i18n/id";
import { centroidForProvince } from "../lib/province-centroids";
import { withBase } from "../lib/paths";

import citationsRaw from "../data/derived/citations_by_year.json";
import publicationsRaw from "../data/derived/publications_by_year_dept.json";
import topicsRaw from "../data/derived/topics.json";
import countriesRaw from "../data/derived/collab_countries.json";
import lecturersRaw from "../data/derived/lecturers_positions.json";
import sintaRaw from "../data/derived/sinta_by_dept.json";
import fundingRaw from "../data/derived/funding_by_year.json";
import outreachRaw from "../data/derived/outreach_points.json";
import sdgRaw from "../data/derived/sdg_matrix.json";
import journalsRaw from "../data/derived/journals.json";
import studentResearchRaw from "../data/derived/student_research_by_year.json";
import tckRaw from "../data/derived/tck_2026_joined.json";
import budgetRaw from "../data/derived/tck_2026_anggaran.json";
import institutionRaw from "../data/derived/institution_snapshot.json";
import valueModelRaw from "../data/derived/value_model.json";

const citations: any[] = (citationsRaw as any[]).filter((row) => row.year >= 2019 && row.year <= 2025);
const citationTotal = (citationsRaw as any[]).reduce((sum, row) => sum + row.citations, 0);
const citationRecent = (citationsRaw as any[]).filter((row) => row.year >= 2021 && row.year <= 2025).reduce((sum, row) => sum + row.citations, 0);
const citationStart = Math.min(...(citationsRaw as any[]).map((row) => row.year));
const citationEnd = Math.max(...(citationsRaw as any[]).map((row) => row.year));
const tck: any[] = tckRaw as any[];
const tckByNo = new Map(tck.map((row) => [String(row.no), row]));
const getTckRow = (no: string) => {
  const row = tckByNo.get(no);
  if (!row) throw new Error(`Indikator TCK ${no} tidak ditemukan`);
  return row;
};
const format = (value: number, digits = 0) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);
const dataUrl = (file: string) => withBase(`/data/${file}`);

const publicationYears = [2020, 2021, 2022, 2023, 2024, 2025];
const departmentKey: Record<string, string> = {
  "Fisika": "fisika",
  "Ilmu Komputer dan Elektronika": "ike",
  "Kimia": "kimia",
  "Matematika": "matematika",
  "Belum terpetakan": "unmapped",
};
const publications: any[] = publicationYears.map((year) => {
  const row: Record<string, any> = { year };
  Object.values(departmentKey).forEach((key) => { row[key] = 0; });
  (publicationsRaw as any[]).filter((item) => item.year === year).forEach((item) => { row[departmentKey[item.department] ?? "unmapped"] += item.count; });
  return row;
});
const publicationSeries = [
  { key: "fisika", label: "Fisika", color: "#2a78d6", pattern: "solid" },
  { key: "ike", label: "Ilmu Komputer & Elektronika", color: "#eb6834", pattern: "diagonal" },
  { key: "kimia", label: "Kimia", color: "#1baf7a", pattern: "dots" },
  { key: "matematika", label: "Matematika", color: "#4a3aa7", pattern: "cross" },
  { key: "unmapped", label: "Belum terpetakan", color: "#73716c", pattern: "diagonal" },
] as any;

const deptColors: Record<string, string> = { Fisika: "#2a78d6", "Ilmu Komputer dan Elektronika": "#eb6834", Kimia: "#1baf7a", Matematika: "#4a3aa7", "Belum terpetakan": "#73716c" };
const topicNodes: any[] = (topicsRaw as any[]).map((row) => ({ label: row.cluster, value: row.n, group: row.dept, color: deptColors[row.dept] ?? "#73716c", detail: row.topic }));

const countryNames: Record<string, string> = { Japan: "Jepang", "South Korea": "Korea Selatan", Germany: "Jerman", "United States": "Amerika Serikat", Singapore: "Singapura", China: "Tiongkok", Netherlands: "Belanda", "United Kingdom": "Britania Raya" };
const countries: any[] = (countriesRaw as any[]).slice(0, 9).map((row) => ({ country: countryNames[row.country] ?? row.country, iso3: row.iso3, n: row.n }));

const positionsOrder = ["Asisten Ahli", "Lektor", "Lektor Kepala", "Guru Besar", "Belum terisi"];
const positionCounts = new Map<string, number>();
(lecturersRaw as any[]).forEach((row) => positionCounts.set(row.position, (positionCounts.get(row.position) ?? 0) + row.n));
const lecturerGroups: any[] = positionsOrder.map((position, index) => ({ label: position, count: positionCounts.get(position) ?? 0, color: ["#86b6ef", "#2a78d6", "#1c5cab", "#0d366b", "#73716c"][index] }));
const departmentCounts: Record<string, number> = {};
(lecturersRaw as any[]).forEach((row) => { departmentCounts[row.department] = (departmentCounts[row.department] ?? 0) + row.n; });
const sinta: any[] = (sintaRaw as any[]).map((row) => ({ label: row.dept ?? row.department, value: row.median, valueLabel: format(row.median), color: deptColors[row.dept ?? row.department], annotation: `${format(row.n)} dosen · total ${format(row.total)}` }));

const funding: any[] = (fundingRaw as any[]).filter((row) => row.type === "Total" && row.year >= 2019 && row.year <= 2025).map((row) => ({ year: row.year, amount: row.amount / 1_000_000_000 }));

const outreachMap = new Map<string, any>();
const outreachUnmapped = new Map<number, number>();
for (const row of outreachRaw as any[]) {
  if (!row.year || row.year < 2021 || row.year > 2025) continue;
  const centroid = centroidForProvince(row.province);
  if (!centroid || row.location_status !== "recorded") {
    outreachUnmapped.set(row.year, (outreachUnmapped.get(row.year) ?? 0) + row.n);
    continue;
  }
  const key = `${row.year}|${row.province}`;
  const current = outreachMap.get(key) ?? { year: row.year, label: row.province, lat: centroid[0], lng: centroid[1], value: 0, detail: "Centroid provinsi pada batas GeoJSON" };
  current.value += row.n;
  outreachMap.set(key, current);
}
const outreachPoints: any[] = [
  ...outreachMap.values(),
  ...[...outreachUnmapped].map(([year, value]) => ({ year, label: "Lokasi belum dapat dipetakan", lat: Number.NaN, lng: Number.NaN, value, detail: "Lokasi kosong, daring, lintas provinsi, atau di luar Indonesia" })),
];
const outreachPeriodUnmapped = [...outreachUnmapped.values()].reduce((sum, value) => sum + value, 0);
const outreachArchiveMissing = (outreachRaw as any[]).filter((row) => row.location_status === "missing").reduce((sum, row) => sum + row.n, 0);

const sdgItems: any[] = (sdgRaw as any[]).map((row) => ({ sdg: row.sdg, label: row.label, values: { research: row.research_n, publication: row.publication_n }, note: row.research_n === 0 ? "Belum tercatat pada data riset" : undefined }));

const journalName: Record<string, string> = {
  "Indonesian Journal of Chemistry (IJC)": "Indonesian Journal of Chemistry",
  "Indonesian Journal of Computing and Cybernetics Systems (IJCCS)": "IJCCS",
  "Indonesian Journal of Electronics and Instrumentation Systems (IJEIS)": "IJEIS",
  "Jurnal Matematika Thales (JMT)": "Jurnal Matematika Thales",
};
const journalTotals = new Map<string, number>();
(journalsRaw as any[]).forEach((row) => journalTotals.set(row.journal, (journalTotals.get(row.journal) ?? 0) + row.n));
const journals: any[] = [...journalTotals].filter(([name]) => name !== "Belum terklasifikasi").map(([name, value]) => ({ label: journalName[name] ?? name, value, valueLabel: format(value) }));

const studentResearch: any[] = (studentResearchRaw as any[]).map((row) => ({ label: String(row.year), value: row.n, valueLabel: format(row.n), color: "#004A74" }));

function bullet(no: string, label?: string): any {
  const row = getTckRow(no);
  return {
    label: label ?? row.indikator,
    actual: row.capaian_tw3,
    target: row.target_tw3,
    annualTarget: row.target_tw4,
    actualLabel: `${format(row.capaian_tw3, 2)} ${row.satuan}`,
    status: row.status_tw3,
    group: row.pilar,
    direction: row.arah === "turun" ? "down" : "up",
    provisional: true,
    note: row.tag,
  };
}
const studentReadiness = [bullet("8a", "MBKM minimal 10 SKS"), bullet("9", "Mahasiswa berprestasi"), bullet("10", "Fast track, RPL, dan PMDSU"), bullet("5b", "Mahasiswa aktif di LinkedIn")];
const internationalStudents = [bullet("4a", "Mahasiswa asing kredit"), bullet("4b", "Mahasiswa asing non-kredit")];
const graduation: any[] = [
  ["8b1", "Sarjana"], ["8b2", "Magister"], ["8b3", "Doktor"],
].map(([no, label]) => { const row = getTckRow(no); return { label, start: row.capaian_tw1, end: row.capaian_tw3, startLabel: `${format(row.capaian_tw1, 2)}%`, endLabel: `${format(row.capaian_tw3, 2)}%`, note: no === "8b1" ? "Wisuda periode Agustus" : undefined }; });
const career = [bullet("24", "Dosen berkualifikasi S3"), bullet("30", "Guru Besar"), bullet("25", "Dosen bersertifikat kompetensi"), bullet("23", "Dosen dengan rekognisi internasional")];

const pillarSummary = [
  { number: "1", title: "Reputasi Akademik", status: "Pilar terkuat kedua", achieved: 7, total: 10, takeaway: "Jangkauan riset tumbuh; jejaring dan pemerataan produktivitas masih menjadi pekerjaan.", href: "#reputasi", color: "blue" },
  { number: "2", title: "Kontribusi terhadap Bangsa", status: "Lintasan paling berat", achieved: 3, total: 10, takeaway: "Produksi tumbuh lebih cepat daripada penyaluran ilmu dan pendanaan keluar kampus.", href: "#kontribusi", color: "orange" },
  { number: "3", title: "Employability", status: "Baseline baru tersedia", achieved: 5, total: 11, takeaway: "Bekal mahasiswa terukur; rincian perjalanan lulusan masih belum dapat dijawab.", href: "#employability", color: "green" },
  { number: "4", title: "Kesejahteraan", status: "Proporsi capaian terbaik", achieved: 9, total: 11, takeaway: "Karier dan inklusi kuat; keselamatan serta anomali bangunan hijau tetap terbuka.", href: "#kesejahteraan", color: "violet" },
] as any;
---

<BaseLayout>
  <main id="konten-utama">
    <ColdOpen total={citationTotal} recent={citationRecent} startYear={citationStart} endYear={citationEnd} />

    <ChapterIntro id="posisi" number={chapters.position.number} title={chapters.position.title} description={chapters.position.description} />

    <StoryScene id="fmipa-hari-ini" number="1.1" question={scenes["1.1"].question} deck={scenes["1.1"].deck} wide>
      <ChartFrame source="Data kepegawaian dan unit FMIPA" updated="snapshot 2025–2026" downloadHref={dataUrl("institution_snapshot.json")} downloadName="institution_snapshot.json" note="Empat departemen akademik yang dipakai dalam cerita: Fisika, Ilmu Komputer dan Elektronika, Kimia, dan Matematika.">
        <InstitutionPortrait lecturers={institutionRaw.lecturers} academicStaff={institutionRaw.academic_staff} departmentsCount={institutionRaw.departments} studyProgrammes={institutionRaw.study_programmes} laboratories={institutionRaw.laboratories} {departmentCounts} />
        <table slot="table"><caption>Struktur FMIPA</caption><tbody><tr><th scope="row">Dosen</th><td>{institutionRaw.lecturers}</td></tr><tr><th scope="row">Tenaga kependidikan</th><td>{institutionRaw.academic_staff}</td></tr><tr><th scope="row">Departemen akademik</th><td>{institutionRaw.departments}</td></tr><tr><th scope="row">Program studi</th><td>{institutionRaw.study_programmes}</td></tr><tr><th scope="row">Laboratorium</th><td>{institutionRaw.laboratories}</td></tr></tbody></table>
      </ChartFrame>
    </StoryScene>

    <StoryScene id="target-2026" number="1.2" question={scenes["1.2"].question} deck={scenes["1.2"].deck} tone="paper" wide>
      <TckOverview rows={tck as any} budgetPercent={(budgetRaw as any).realisasi_persen} />
      <Insight tone="critical" label="Jarak terbesar"><p>Creative funding baru <strong>Rp3,75 miliar</strong> dari target TW3 Rp33 miliar. Capaian yang melampaui target dan yang tertinggal dibaca pada bidang yang sama.</p></Insight>
    </StoryScene>

    <StoryScene id="model-nilai" number="1.3" question={scenes["1.3"].question} deck={scenes["1.3"].deck} wide>
      <ChartFrame source="Agregat CSV historis FMIPA" updated="periode 2021–2025" downloadHref={dataUrl("value_model.json")} downloadName="value_model.json" note="Besaran di empat tahap memakai unit yang berbeda. Panah menunjukkan hubungan naratif, bukan proporsi finansial Sankey yang dapat dijumlahkan.">
        <ValueModel metrics={valueModelRaw.metrics} />
        <table slot="table"><caption>Model nilai FMIPA 2021–2025</caption><thead><tr><th>Tahap</th><th>Ukuran</th><th>Nilai</th></tr></thead><tbody><tr><th scope="row">Masukan</th><td>Dana riset</td><td>Rp{format(valueModelRaw.metrics.funding_rp / 1_000_000_000, 2)} miliar</td></tr><tr><th scope="row">Kegiatan</th><td>Riset</td><td>{format(valueModelRaw.metrics.research_n)}</td></tr><tr><th scope="row">Kegiatan</th><td>Pengabdian</td><td>{format(valueModelRaw.metrics.outreach_n)}</td></tr><tr><th scope="row">Luaran</th><td>Publikasi</td><td>{format(valueModelRaw.metrics.publications_n)}</td></tr><tr><th scope="row">Dampak</th><td>Sitasi</td><td>{format(valueModelRaw.metrics.citations_n)}</td></tr><tr><th scope="row">Dampak</th><td>Pengabdian dapat dipetakan</td><td>{format(valueModelRaw.metrics.mappable_outreach_n)}</td></tr></tbody></table>
      </ChartFrame>
    </StoryScene>

    <ChapterIntro id="empat-pilar" number={chapters.journey.number} title={chapters.journey.title} description={chapters.journey.description}>
      <p class="chapter-bridge">Lima tahun lalu, angkanya tidak seperti ini.</p>
    </ChapterIntro>

    <PillarHeader id="reputasi" number="1" title="Reputasi Akademik" evidence="data kuat" color="blue" summary="Jangkauan pengetahuan tumbuh cepat. Pilar ini menilai bukan hanya berapa banyak yang dipublikasikan, tetapi seberapa jauh ia dibaca, dengan siapa ia dikerjakan, dan siapa yang menghasilkannya." />

    <StoryScene id="jangkauan-riset" number="2.1" pillar="Reputasi Akademik" question={scenes["2.1"].question} deck={scenes["2.1"].deck}>
      <LineAreaChart data={citations} xKey="year" series={[{ key: "citations", label: "Sitasi", color: "#004A74" }]} title={scenes["2.1"].question} hideHeader area yLabel="Sitasi per tahun" provisionalX={2025} provisionalLabel="Indeksasi berjalan" source="CSV sitasi FMIPA" extracted="19 Agustus 2026" csvHref={dataUrl("citations_by_year.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="info"><p>Angka 2025 belum final. Arsiran menandai jeda indeksasi Scopus, bukan vonis penurunan kinerja.</p></Insight>
    </StoryScene>

    <StoryScene id="publikasi-departemen" number="2.2" pillar="Reputasi Akademik" question={scenes["2.2"].question} deck={scenes["2.2"].deck} tone="paper" wide>
      <StackedBarChart data={publications} xKey="year" series={publicationSeries} title={scenes["2.2"].question} hideHeader yLabel="Publikasi" provisionalX={2025} provisionalLabel="Indeksasi berjalan" source="SciVal / Scopus" extracted="19 Agustus 2026" csvHref={dataUrl("publications_by_year_dept.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="attention"><p>Pada sumber mentah, <strong>1.044 dari 2.726 publikasi</strong> tidak memiliki departemen. Pipeline memetakan ulang lewat ID Scopus penulis; sisa yang belum dapat dipastikan tetap tampil abu-abu.</p></Insight>
    </StoryScene>

    <StoryScene id="topik-riset" number="2.3" pillar="Reputasi Akademik" question={scenes["2.3"].question} deck={scenes["2.3"].deck} wide>
      <TopicBubbles nodes={topicNodes} title={scenes["2.3"].question} hideHeader maxNodes={110} labelCount={5} valueLabel="publikasi" source="SciVal topic clusters" extracted="19 Agustus 2026" csvHref={dataUrl("topics.csv")} />
    </StoryScene>

    <StoryScene id="kolaborasi" number="2.4" pillar="Reputasi Akademik" question={scenes["2.4"].question} deck={scenes["2.4"].deck} tone="paper" wide>
      <ChartFrame source="SciVal / Scopus · batas Natural Earth 1:110m" updated="2020–2025" downloadHref={dataUrl("collab_countries.csv")} downloadName="collab_countries.csv" note={`Garis menampilkan sembilan mitra terbesar dari ${(countriesRaw as any[]).length} negara internasional yang tercatat. Posisi adalah ibu kota/centroid negara untuk konteks, bukan lokasi penulis individual. Batas negara memakai GeoJSON Natural Earth skala 1:110 juta (WGS 84, public domain).`}>
        <WorldCollaboration countries={countries} total={(countriesRaw as any[]).length} />
        <table slot="table"><caption>Negara mitra teratas</caption><thead><tr><th>Negara</th><th>Publikasi</th></tr></thead><tbody>{countries.map((row) => <tr><th scope="row">{row.country}</th><td>{format(row.n)}</td></tr>)}</tbody></table>
      </ChartFrame>
    </StoryScene>

    <StoryScene id="orang-riset" number="2.5" pillar="Reputasi Akademik" question={scenes["2.5"].question} deck={scenes["2.5"].deck}>
      <DotMatrix groups={lecturerGroups} title={scenes["2.5"].question} hideHeader columns={20} unitValue={1} unitLabel="dosen" source="Data kepegawaian FMIPA" extracted="snapshot 2025" csvHref={dataUrl("lecturers_positions.csv")} />
      <Insight tone="info"><p>Snapshot kepegawaian mencatat <strong>42 Guru Besar</strong>. TCK 2026 mencatat 54 karena jendela pembaruan dan definisinya berbeda; kedua angka dilabeli menurut sumbernya.</p></Insight>
    </StoryScene>

    <StoryScene id="reputasi-belum" number="2.6" pillar="Reputasi Akademik" question={scenes["2.6"].question} deck={scenes["2.6"].deck} tone="paper">
      <HorizontalBarChart data={sinta} title={scenes["2.6"].question} hideHeader sort="descending" axisLabel="Median skor SINTA" source="SINTA" extracted="snapshot 3 Desember 2025" csvHref={dataUrl("sinta_by_dept.csv")} valueFormatter={(value:number) => format(value)} />
      <IssueCards columns={2} issues={[{ value: "63 / 108", title: "Publikasi mahasiswa doktoral", description: "Masih 58% dari target TW3.", status: "Tertinggal" }, { value: "23 / 30", title: "Mitra riset internasional", description: "Masih 77% dari target TW3.", status: "Tertinggal" }]} />
    </StoryScene>

    <PillarHeader id="kontribusi" number="2" title="Kontribusi terhadap Bangsa" evidence="data kuat" color="orange" summary="Pertumbuhan sumber daya menjadi berarti ketika pengetahuan bergerak keluar kampus—melalui riset, pengabdian, tujuan pembangunan, jurnal, dan kerja sama yang menghasilkan nilai bersama." />

    <StoryScene id="dana-riset" number="3.1" pillar="Kontribusi terhadap Bangsa" question={scenes["3.1"].question} deck={scenes["3.1"].deck} wide>
      <ChartFrame source="CSV riset FMIPA" updated="2019–2025" downloadHref={dataUrl("funding_by_year.csv")} downloadName="funding_by_year.csv" note="Tahun 2025 diberi arsiran sebagai tahun data berjalan. Dana riset adalah nilai proposal, bukan realisasi anggaran fakultas.">
        <FundingShift data={funding} />
        <table slot="table"><caption>Dana riset per tahun</caption><thead><tr><th>Tahun</th><th>Rp miliar</th></tr></thead><tbody>{funding.map((row) => <tr><th scope="row">{row.year}</th><td>{format(row.amount, 2)}</td></tr>)}</tbody></table>
      </ChartFrame>
    </StoryScene>

    <StoryScene id="jangkauan" number="3.2" pillar="Kontribusi terhadap Bangsa" question={scenes["3.2"].question} deck={scenes["3.2"].deck} tone="paper" wide>
      <PointMap points={outreachPoints} title={scenes["3.2"].question} hideHeader accumulate showSmallMultiples pointLabel="kegiatan dapat dipetakan" source="Surat Tugas, SIMPEL, dan hibah FMIPA" extracted="2021–2025" csvHref={dataUrl("outreach_points.csv")} />
      <Insight tone="attention"><p>Centroid provinsi dipakai sebagai skema karena sumber tidak memuat koordinat kabupaten. Dalam periode 2021–2025, <strong>{format(outreachPeriodUnmapped)} dari 1.481 kegiatan</strong> tidak dapat dipetakan. Di seluruh arsip, {format(outreachArchiveMissing)} dari 1.610 catatan sama sekali tidak memiliki label lokasi.</p></Insight>
    </StoryScene>

    <StoryScene id="sdg" number="3.3" pillar="Kontribusi terhadap Bangsa" question={scenes["3.3"].question} deck={scenes["3.3"].deck}>
      <SDGGrid items={sdgItems} modes={[{ key: "research", label: "Riset" }, { key: "publication", label: "Publikasi" }]} defaultMode="research" valueLabel="rekaman" title={scenes["3.3"].question} hideHeader source="CSV riset FMIPA + SciVal" extracted="19 Agustus 2026" csvHref={dataUrl("sdg_matrix.csv")} />
    </StoryScene>

    <StoryScene id="diseminasi" number="3.4" pillar="Kontribusi terhadap Bangsa" question={scenes["3.4"].question} deck={scenes["3.4"].deck} tone="paper">
      <HorizontalBarChart data={journals} title={scenes["3.4"].question} hideHeader sort="descending" axisLabel="Artikel" source="Data jurnal internal FMIPA" csvHref={dataUrl("journals.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="attention"><p>Data paparan media hanya memuat 115 rekaman dan baru dimulai pada 2023. Karena itu, ia belum dipaksa menjadi tren lima tahun.</p></Insight>
    </StoryScene>

    <StoryScene id="kontribusi-belum" number="3.5" pillar="Kontribusi terhadap Bangsa" question={scenes["3.5"].question} deck={scenes["3.5"].deck}>
      <IssueCards issues={[{ value: "11%", title: "Creative funding", description: "Rp3,75 miliar dari target TW3 Rp33 miliar.", status: "Meleset" }, { value: "22 / 53", title: "MOOC publik", description: "Tidak bergerak sejak triwulan pertama.", status: "Meleset" }, { value: "48 / 120", title: "Luaran ber-SDG", description: "Penyaluran ke luar kampus belum mengikuti laju produksi.", status: "Meleset" }]} />
      <Insight tone="critical"><p>FMIPA memproduksi, tetapi belum menyalurkan dengan kecepatan yang sama. Ini adalah pilar dengan indikator tertinggal terbanyak pada TCK 2026.</p></Insight>
    </StoryScene>

    <PillarHeader id="employability" number="3" title="Employability" evidence="data cukup" color="green" summary="Risiko data terbesar kini berkurang: angka agregat resmi sudah tersedia. Yang belum ada adalah detail perjalanan lulusan—sektor, wilayah, dan masa tunggu—yang mengubah angka menjadi keputusan." />

    <StoryScene id="tujuan-lulusan" number="4.1" pillar="Employability" question={scenes["4.1"].question} deck={scenes["4.1"].deck} tone="paper">
      <DataGap title="Sektor dan wilayah lulusan" knownValue="133 lulusan tercatat bekerja, melanjutkan studi, atau berwirausaha" description="Angka TCK adalah agregat fakultas. Tanpa tracer study tingkat program studi, aliran prodi → sektor → wilayah tidak dapat dibangun secara bertanggung jawab." owner="DPKM / CDC UGM" />
    </StoryScene>

    <StoryScene id="masa-tunggu" number="4.2" pillar="Employability" question={scenes["4.2"].question} deck={scenes["4.2"].deck}>
      <DataGap title="Distribusi masa tunggu per program studi" description="Rata-rata saja tidak cukup. Scene ini membutuhkan distribusi atau histogram agar lulusan yang menunggu jauh lebih lama tidak hilang di balik satu angka." owner="DPKM / CDC UGM" tone="hold" />
    </StoryScene>

    <StoryScene id="bekal-mahasiswa" number="4.3" pillar="Employability" question={scenes["4.3"].question} deck={scenes["4.3"].deck} tone="paper" wide>
      <BulletChart data={studentReadiness} title={scenes["4.3"].question} hideHeader maxPercent={200} source="SIMASTER TCK 2026" extracted="19 Agustus 2026" csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="positive"><p>MBKM mencapai 538 mahasiswa—melewati target tahunan 510. Namun angka ini praktis tidak bergerak sejak TW1, sehingga ritme pencatatannya perlu diperiksa.</p></Insight>
    </StoryScene>

    <StoryScene id="mahasiswa-asing" number="4.4" pillar="Employability" question={scenes["4.4"].question} deck={scenes["4.4"].deck}>
      <BulletChart data={internationalStudents} title={scenes["4.4"].question} hideHeader maxPercent={140} source="SIMASTER TCK #4a–4b" extracted="19 Agustus 2026" csvHref={dataUrl("tck_2026_indikator.csv")} />
    </StoryScene>

    <StoryScene id="kelulusan" number="4.5" pillar="Employability" question={scenes["4.5"].question} deck={scenes["4.5"].deck} tone="paper">
      <SlopeChart data={graduation} startTitle="TW1" endTitle="TW3" domain={[0, 55]} valueFormatter={(value:number) => `${format(value, 2)}%`} yLabel="Persentase lulus tepat waktu" title={scenes["4.5"].question} hideHeader source="SIMASTER TCK #8b1–8b3" extracted="19 Agustus 2026" csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="info"><p>Lonjakan Sarjana terutama mencerminkan wisuda periode Agustus. Grafik ini tidak menyiratkan bahwa proses belajar berubah mendadak dalam satu triwulan.</p></Insight>
    </StoryScene>

    <StoryScene id="riset-mahasiswa" number="4.3′" pillar="Employability" question={scenes["4.3p"].question} deck={scenes["4.3p"].deck}>
      <HorizontalBarChart data={studentResearch} title={scenes["4.3p"].question} hideHeader sort="none" axisLabel="Judul riset" source="CSV riset FMIPA · tag TCK" csvHref={dataUrl("student_research_by_year.csv")} valueFormatter={(value:number) => format(value)} />
    </StoryScene>

    <PillarHeader id="kesejahteraan" number="4" title="Kesejahteraan" evidence="data cukup" color="violet" summary="Karier, rekognisi, dan fasilitas inklusif memiliki pijakan angka yang jelas. Tetapi ruang yang sejahtera juga harus aman—dan aspek itu tidak lagi tercakup dalam TCK 2026." />

    <StoryScene id="karier" number="5.1" pillar="Kesejahteraan" question={scenes["5.1"].question} deck={scenes["5.1"].deck} tone="paper" wide>
      <BulletChart data={career} title={scenes["5.1"].question} hideHeader maxPercent={200} source="SIMASTER TCK 2026" extracted="19 Agustus 2026" csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="attention"><p>Dosen bersertifikat kompetensi melonjak dari 11 pada TW2 menjadi 116 pada TW3. Lonjakan sepuluh kali lebih mungkin mencerminkan pencatatan susulan dan perlu dijelaskan, bukan sekadar dirayakan.</p></Insight>
    </StoryScene>

    <StoryScene id="inklusif" number="5.2" pillar="Kesejahteraan" question={scenes["5.2"].question} deck={scenes["5.2"].deck}>
      <DotMatrix groups={[{ label: "Fasilitas tersedia", count: 23, color: "#4a3aa7", description: "Target tahunan: 20 unit" }]} columns={10} unitValue={1} unitLabel="unit" title={scenes["5.2"].question} hideHeader source="SIMASTER TCK #31" extracted="19 Agustus 2026" csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="critical" label="Angka ditahan"><p>Indikator #32—kenaikan nilai hijau bangunan—menunjukkan 13,1 → 25,55 → 0 dan belum konsisten dengan status SIMASTER. Angka itu tidak ditayangkan sebelum dikonfirmasi.</p></Insight>
    </StoryScene>

    <StoryScene id="keselamatan" number="5.3" pillar="Kesejahteraan" question={scenes["5.3"].question} deck={scenes["5.3"].deck} tone="paper">
      <DataGap title="Kecelakaan kerja, kekerasan, dan kesehatan" description="Indikator ini ada dalam TCK 2023, tetapi hilang dari TCK 2026. Ketiadaan indikator bukan bukti nol kasus dan tidak boleh disajikan sebagai capaian." owner="Satgas PPKS dan HSE" tone="hold" />
    </StoryScene>

    <ChapterIntro id="yang-diserahkan" number={chapters.handover.number} title={chapters.handover.title} description={chapters.handover.description} />

    <StoryScene id="belum-selesai" number="6.1" question={scenes["6.1"].question} deck={scenes["6.1"].deck} wide>
      <IssueCards issues={[{ value: "14 / 42", title: "Indikator TCK tertinggal", description: "Tujuh tertinggal dan tujuh meleset dari target TW3.", status: "Akuntabilitas" }, { value: "11%", title: "Creative funding", description: "Jarak terbesar terhadap lintasan target triwulanan.", status: "Pendanaan" }, { value: "2 gap", title: "Tracer dan keselamatan", description: "Dua keluarga data belum cukup untuk menjawab pertanyaan publik.", status: "Ketersediaan data" }, { value: "−7,2%", title: "Dana riset melandai", description: "Rp74,91 miliar pada 2024 menjadi Rp69,51 miliar pada 2025.", status: "Keberlanjutan" }]} columns={4} />
    </StoryScene>

    <StoryScene id="titik-awal" number="6.2" question={scenes["6.2"].question} deck={scenes["6.2"].deck} tone="paper" wide>
      <PillarSummary pillars={pillarSummary} />
      <div class="handover-cta">
        <div><p class="eyebrow">Seluruh angka satu klik jauhnya</p><h3>Mulai dari data yang sudah dapat diuji.</h3><p>Halaman metodologi memuat dataset turunan, definisi, konflik angka, aturan pembersihan, dan daftar data yang masih dibutuhkan.</p></div>
        <a href={withBase("/data")}>Buka Data &amp; Metodologi →</a>
      </div>
    </StoryScene>
  </main>
  <script>
    import "../scripts/charts";
  </script>
</BaseLayout>

