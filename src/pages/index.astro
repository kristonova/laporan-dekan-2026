  "Tidak aktif": ACCENT.crimson,
  Lainnya: ACCENT.slate,
};
const outcomeSeries = outcomeOrder.map((status) => ({ key: status, label: status, color: outcomeColor[status] ?? ACCENT.slate }));
const outcomeMix = studentYears.map((year) => {
  const row: Record<string, number | string> = { year };
  outcomeOrder.forEach((status) => {
    row[status] = studentOutcomeRows.find((item) => item.angkatan === year && item.status === status)?.n ?? 0;
  });
  return row;
});
const cohortFirst = (status: string) =>
  studentOutcomeRows.find((row) => row.angkatan === studentYears[0] && row.status === status)?.n ?? 0;
/* Withdrawal counts are not comparable across cohorts — a 2026 intake has had
   months to withdraw, a 2021 intake five years — so the peak is named rather
   than a trend claimed. */
const withdrawalRates = studentYearRows.map((row) => ({
  year: row.angkatan,
  n: studentOutcomeRows.find((item) => item.angkatan === row.angkatan && item.status === "Mengundurkan diri")?.n ?? 0,
  share: ((studentOutcomeRows.find((item) => item.angkatan === row.angkatan && item.status === "Mengundurkan diri")?.n ?? 0) / row.total) * 100,
}));
const withdrawalPeak = [...withdrawalRates].sort((a, b) => b.share - a.share)[0];

const ipkYears = studentIpk.tahun as number[];
const ipkStart = ipkYears[0];
const ipkEnd = ipkYears[ipkYears.length - 1];
const sceneValues: SceneValues = {
  lecturers: institutionRaw.lecturers,
  academicStaff: institutionRaw.academic_staff,
  studyProgrammes: institutionRaw.study_programmes,
  laboratories: institutionRaw.laboratories,
  activeStudents: activeStudentTotal,
  tckTotal: tck.length,
  tckAchieved,
  tckBehind,
  contributionAchieved: pillarStats.Kontribusi.achieved,
  contributionTotal: pillarStats.Kontribusi.total,
  welfareAchieved: pillarStats.Kesejahteraan.achieved,
  welfareTotal: pillarStats.Kesejahteraan.total,
  partnershipTotal: partnershipCoverage.total,
  partnershipInternational: partnershipCoverage.internasional,
  partnershipCountries: partnershipInternationalCountries,
  admissionsApplicants: admissionsClose?.peminat ?? 0,
  admissionsApplicantsFirst: admissionsOpen?.peminat ?? 0,
  admissionsSeats: admissionsClose?.diterima ?? 0,
  admissionsRegistered: admissionsClose?.registrasi ?? 0,
  admissionsTightnessFirst: tightnessOpen,
  admissionsTightnessLast: tightnessClose,
  admissionsYieldFirst: yieldOpen,
  admissionsYieldLast: yieldClose,
  admissionsFirstYear: admissionFirst,
  admissionsLastYear: admissionLast,
  graduatesLatest: graduateLatest?.lulusan ?? 0,
  achievementsTotal: achievementTotal,
  achievementsInternational: achievementInternational,
  tracerRespondents: tracerSummary.responden,
  tracerWithinSixMonths: tracerSummary.dalam_6_bulan,
  tracerTopSector: tracerTopSector,
  tracerBeforeGraduation: tracerSummary.bekerja_sebelum_lulus,
  foreignCredit: getTckRow("4a").capaian_dinilai,
  foreignNonCredit: getTckRow("4b").capaian_dinilai,
  disabilityFacilities: getTckRow("31").capaian_dinilai,
  disabilityTarget: getTckRow("31").target_tw4,
  posbinduVisits: hpu.kunjungan,
  posbinduSessions: hpu.sesi.length,
  posbinduRegistered: hpu.peserta_terdaftar,
  posbinduLecturers: hpu.kunjungan_per_kriteria.find((row: any) => row.kriteria === "Dosen")?.n ?? 0,
  posbinduStaff: hpu.kunjungan_per_kriteria.find((row: any) => row.kriteria === "Tendik")?.n ?? 0,
  posbinduTopRisk: riskTop?.indikator ?? "—",
  posbinduTopRiskShare: Math.round((riskTop?.porsi_berisiko ?? 0) * 100),
  posbinduFirstYear: hpuFirstYear,
  posbinduLastYear: hpuLastYear,
  posbinduYearVisits: hpuStaff.kunjungan,
  posbinduTensionFirst: hpuShare(hpuTension, hpuFirstYear) ?? 0,
  posbinduTensionLast: hpuShare(hpuTension, hpuLastYear) ?? 0,
  studentsTotal: origins.total,
  studentsMasters: origins.per_jenjang.S2,
  studentsDoctoral: origins.per_jenjang.S3,
  studentsAllNonDegree: origins.per_jenjang.NONDEGREE,
  studentsMasterOrigins: masterOrigin.institusi_unik,
  studentsDoctorOrigins: doctorOrigin.institusi_unik,
  studentsUndergraduate: origins.per_jenjang.S1,
  studentsProgrammes: students.prodi_n,
  studentsFirstYear: students.tahun_awal,
  studentsLastYear: students.tahun_akhir,
  studentsNonDegreeFirst: studentFirst.non_gelar,
  studentsNonDegreeLast: studentLast.non_gelar,
  studentsWomenShareFirst: students.porsi_perempuan_awal,
  studentsWomenShareLast: students.porsi_perempuan_akhir,
  studentsWomenTopProgramme: genderTop.prodi,
  studentsWomenTopShare: genderTop.share,
  studentsWomenLowProgramme: genderLow.prodi,
  studentsWomenLowShare: genderLow.share,
  studentsProvincesFirst: students.provinsi_awal,
  studentsProvincesLast: students.provinsi_akhir,
  studentsOutsideJavaPeak: students.porsi_luar_jawa_puncak,
  studentsOutsideJavaPeakYear: students.tahun_luar_jawa_puncak,
  studentsOutsideJavaLast: students.porsi_luar_jawa_akhir,
  studentsTopPathway: pathwayTop.name,
  studentsTopPathwayShare: (pathwayTop.total / students.total) * 100,
  studentsIup: Math.round(studentYearRows.reduce((sum, row) => sum + row.iup, 0) / studentYearRows.length),
  studentsGuardianTop: guardianTopRow?.pekerjaan_wali ?? "—",
  studentsGuardianTopShare: ((guardianTopRow?.n ?? 0) / students.total) * 100,
  studentsGuardianUnreported: studentBackground.wali_tidak_dilaporkan,
  studentsSchoolDiyShare: studentBackground.sekolah_porsi_diy,
  studentsSchoolUnique: schoolOrigin.institusi_unik,
  studentsCohortGraduated: cohortFirst("Lulus"),
  studentsCohortWithdrew: cohortFirst("Mengundurkan diri"),
  publicationsMappedShare: publicationMappedShare,
  publicationsUnmapped: publicationUnmapped,
  publicationsFirstYear: publicationFirstYear,
  publicationsLastYear: publicationLastYear,
  topicClusters: (topicsRaw as any[]).length,
  collabCountries: (countriesRaw as any[]).length,
  collabFirstYear: collabFrom.year,
  collabFirstShare: collabFrom.share,
  collabLastYear: collabTo.year,
  collabLastShare: collabTo.share,
  researchAreas: (researchQualityRaw as any[]).length,
  researchAreasAtWorld: researchQualityAbove,
  researchLeadArea: researchLead.label,
  researchLeadFwci: researchLead.value,
  openAccessFirstYear: collabFrom.year,
  openAccessFirstShare: openAccessOpenShare(collabFrom.year),
  openAccessLastYear: collabTo.year,
  openAccessLastShare: openAccessOpenShare(collabTo.year),
  openAccessGreenLatest: openAccessGreenLatest,
  format,
};
const deck = (key: keyof typeof scenes) => deckOf(key, sceneValues);

const pillarSummary = [
  { number: "1", title: "Reputasi Akademik", status: "Capaian Sangat Baik", achieved: pillarStats.Reputasi.achieved, total: pillarStats.Reputasi.total, takeaway: "Lompatan sitasi dan publikasi internasional melesat tajam, diiringi penguatan riset lintas departemen serta perluasan jejaring global.", href: "#reputasi", color: "blue" },
  { number: "2", title: "Kontribusi terhadap Bangsa", status: "Fokus Akselerasi", achieved: pillarStats.Kontribusi.achieved, total: pillarStats.Kontribusi.total, takeaway: "Dana riset dan kerja sama melonjak pesat; percepatan hilirisasi inovasi serta dokumentasi dampak SDGs menjadi agenda prioritas.", href: "#kontribusi", color: "orange" },
  { number: "3", title: "Employability & Lulusan", status: "Capaian Positif", achieved: pillarStats.Employability.achieved, total: pillarStats.Employability.total, takeaway: "Waktu tunggu kerja lulusan singkat dan terserap luas di berbagai industri; partisipasi MBKM melampaui target tahunan.", href: "#employability", color: "green" },
  { number: "4", title: "Tata Kelola & Kesejahteraan", status: "Tingkat Ketercapaian Terbaik", achieved: pillarStats.Kesejahteraan.achieved, total: pillarStats.Kesejahteraan.total, takeaway: "Pembinaan jenjang Guru Besar dan fasilitas kampus inklusif berjalan progresif, ditopang pemantauan kesehatan sivitas secara teratur.", href: "#kesejahteraan", color: "violet" },
  /* Not scored by the performance contract: this pillar describes who the
     faculty teaches, so its card carries a headcount instead of an indicator
     ratio. */
  { number: "5", title: "Mahasiswa & Akses Pendidikan", status: "Gambaran Komprehensif", metric: format(origins.total), metricLabel: `rekaman · S1, S2, S3 & non-gelar`, takeaway: `Cakupan meluas ke ${format(origins.per_jenjang.S2)} rekaman magister dan ${format(origins.per_jenjang.S3)} doktor, disertai jejaring sekolah serta universitas asal.`, href: "#mahasiswa", color: "teal" },
] as any;
---

<BaseLayout>
  <main id="konten-utama">
    <ColdOpen
      publications={valueModelRaw.metrics.publications_n}
      citations={valueModelRaw.metrics.citations_n}
      outreach={valueModelRaw.metrics.outreach_n}
      citationsAllTime={citationTotal}
      period={valueModelRaw.period}
      archiveStart={citationStart}
      archiveEnd={citationEnd}
    />

    <ChapterIntro id="posisi" number={chapters.position.number} title={chapters.position.title} description={chapters.position.description} />

    <StoryScene id="fmipa-hari-ini" number="1.1" question={scenes["1.1"].question} deck={deck("1.1")} wide>
      <ChartFrame source="Data kepegawaian, unit, dan registrasi mahasiswa FMIPA UGM" updated={`snapshot ${snapshot.label}`} downloadHref={dataUrl("institution_snapshot.json")} downloadName="institution_snapshot.json" note="Empat departemen akademik: Fisika, Ilmu Komputer dan Elektronika, Kimia, serta Matematika.">
        <InstitutionPortrait lecturers={institutionRaw.lecturers} academicStaff={institutionRaw.academic_staff} departmentsCount={institutionRaw.departments} studyProgrammes={institutionRaw.study_programmes} laboratories={institutionRaw.laboratories} {departmentCounts} />
        <table slot="table"><caption>Komposisi dan Struktur Organisasi FMIPA UGM</caption><tbody><tr><th scope="row">Dosen</th><td>{institutionRaw.lecturers}</td></tr><tr><th scope="row">Tenaga kependidikan</th><td>{institutionRaw.academic_staff}</td></tr><tr><th scope="row">Departemen akademik</th><td>{institutionRaw.departments}</td></tr><tr><th scope="row">Program studi</th><td>{institutionRaw.study_programmes}</td></tr><tr><th scope="row">Laboratorium</th><td>{institutionRaw.laboratories}</td></tr><tr><th scope="row">Mahasiswa sarjana aktif</th><td>{activeStudentTotal}</td></tr></tbody></table>
      </ChartFrame>
      <Insight tone="info"><p>Sebanyak <strong>{format(activeStudentTotal)} mahasiswa sarjana</strong> aktif terdaftar dalam sembilan angkatan. Dari {format(accreditation.prodi_nasional)} program studi terakreditasi nasional, <strong>{format(accreditation.prodi_unggul)} program studi berpredikat Unggul/A</strong> dan {format(accreditation.prodi_internasional)} telah terakreditasi internasional.</p></Insight>
    </StoryScene>

    <StoryScene id="target-2026" number="1.2" question={scenes["1.2"].question} deck={deck("1.2")} tone="paper" wide>
      <SceneBlock title="Posisi 42 Indikator Perjanjian Kinerja" lede="Status capaian dievaluasi berdasarkan target triwulan berjalan menuju penutupan tahun anggaran 2026.">
        <TckOverview rows={tck as any} budgetPercent={(budgetRaw as any).realisasi_persen} snapshotLabel={snapshot.label} />
      </SceneBlock>
      <SceneBlock title="Porsi Kontribusi Empat Departemen pada Indikator Utama" lede="Membandingkan proporsi kontribusi relatif tiap departemen untuk menyetarakan indikator dengan satuan ukuran yang beragam.">
        <StackedBarChart data={tckByDept} xKey="indikator" series={deptSeries} normalized title="Porsi Kontribusi Departemen pada Sepuluh Indikator Terbesar" hideHeader yLabel="Porsi capaian" source="TCK 2026 · rincian per departemen" extracted={snapshot.label} csvHref={dataUrl("tck_2026_by_dept.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="info"><p>Sebanyak 30 dari {format(tck.length)} indikator menyajikan rincian per departemen. Perbandingan disajikan dalam persentase relatif karena masing-masing indikator memiliki satuan ukuran yang berbeda. Indikator dana <em>creative funding</em> tidak disertakan pada perbandingan ini karena pencatatan administratifnya terpusat pada satu departemen pengelola dan belum membagi porsi riil antardepartemen.</p></Insight>
      <Insight tone="critical" label="Sorotan Kinerja"><p>Data dalam laporan ini bersumber langsung dari dokumen resmi TCK 2026 yang terverifikasi. Sebanyak <strong>{format(tckFlagged)} indikator</strong> memiliki catatan teknis—misalnya empat indikator kelulusan yang pada laporan Triwulan III baru memuat jumlah orang tanpa angka penyebut populasi, sehingga evaluasinya merujuk pada capaian Triwulan II yang sudah lengkap dan sahih.</p></Insight>
    </StoryScene>

    <StoryScene id="model-nilai" number="1.3" question={scenes["1.3"].question} deck={deck("1.3")} wide>
      <ChartFrame source="Agregat data historis FMIPA UGM" updated="periode 2021–2025" downloadHref={dataUrl("value_model.json")} downloadName="value_model.json" note="Nilai pada tiap tahapan menggunakan satuan yang relevan. Menggambarkan alur transformasi sumber daya menjadi dampak tridharma yang nyata.">
        <ValueModel metrics={valueModelRaw.metrics} />
        <table slot="table"><caption>Alur Transformasi Nilai Tridharma FMIPA 2021–2025</caption><thead><tr><th>Tahap</th><th>Ukuran</th><th>Nilai</th></tr></thead><tbody><tr><th scope="row">Masukan (Input)</th><td>Dana riset</td><td>Rp{format(valueModelRaw.metrics.funding_rp / 1_000_000_000, 2)} miliar</td></tr><tr><th scope="row">Aktivitas</th><td>Judul riset</td><td>{format(valueModelRaw.metrics.research_n)}</td></tr><tr><th scope="row">Aktivitas</th><td>Kegiatan PkM</td><td>{format(valueModelRaw.metrics.outreach_n)}</td></tr><tr><th scope="row">Luaran</th><td>Publikasi ilmiah</td><td>{format(valueModelRaw.metrics.publications_n)}</td></tr><tr><th scope="row">Dampak</th><td>Total sitasi</td><td>{format(valueModelRaw.metrics.citations_n)}</td></tr><tr><th scope="row">Dampak</th><td>Kegiatan PkM terpetakan</td><td>{format(valueModelRaw.metrics.mappable_outreach_n)}</td></tr></tbody></table>
      </ChartFrame>
    </StoryScene>

    <ChapterIntro id="empat-pilar" number={chapters.journey.number} title={chapters.journey.title} description={chapters.journey.description}>
      <p class="chapter-bridge">Lima tahun ikhtiar, terangkum dalam jejak data yang nyata.</p>
    </ChapterIntro>

    <PillarHeader id="reputasi" number="1" title="Reputasi Akademik" evidence="Data Terverifikasi" color="blue" summary="Rekognisi keilmuan sivitas melesat di kancah global. Pilar ini merangkum lonjakan sitasi, sebaran publikasi antardepartemen, jejaring riset internasional, hingga kematangan jenjang kepakaran dosen." />

    <StoryScene id="jangkauan-riset" number="2.1" pillar="Reputasi Akademik" question={scenes["2.1"].question} deck={deck("2.1")}>
      <LineAreaChart data={citations} xKey="year" series={[{ key: "citations", label: "Sitasi", color: UGM_BLUE }]} title={scenes["2.1"].question} hideHeader area yLabel="Sitasi per tahun" provisionalX={2025} provisionalLabel="Indeksasi berjalan" source="CSV sitasi FMIPA" extracted={snapshot.p2m} csvHref={dataUrl("citations_by_year.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="info"><p>Catatan: Angka sitasi tahun 2025 masih bersifat dinamis dan akan terus bertambah seiring pemutakhiran berkala di pangkalan data Scopus.</p></Insight>
    </StoryScene>

    <StoryScene id="publikasi-departemen" number="2.2" pillar="Reputasi Akademik" question={scenes["2.2"].question} deck={deck("2.2")} tone="paper" wide>
      <StackedBarChart data={publications} xKey="year" series={publicationSeries} title={scenes["2.2"].question} hideHeader yLabel="Publikasi" provisionalX={2026} provisionalLabel="Indeksasi berjalan" source="SciVal / Scopus" extracted={snapshot.scival} csvHref={dataUrl("publications_by_year_dept.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="attention"><p>Sebanyak <strong>{format(publicationMappedShare, 1)}% artikel ilmiah ({publicationFirstYear}–{publicationLastYear})</strong> berhasil dipetakan ke departemen masing-masing: sebagian besar melalui penetapan departemen pada basis data fakultas, sisanya melalui identifikasi ID Scopus para penulis. Sebanyak {format(publicationUnmapped)} artikel selebihnya terus ditelusuri untuk melengkapi gambaran utuh produktivitas fakultas.</p></Insight>
    </StoryScene>

    <StoryScene id="mutu-sitasi" number="2.2p" pillar="Reputasi Akademik" question={scenes["2.2p"].question} deck={deck("2.2p")} wide>
      <HorizontalBarChart data={researchQuality} title={scenes["2.2p"].question} hideHeader axisLabel="Field-Weighted Citation Impact (FWCI)" target={1} targetLabel="Rata-rata dunia" source="SciVal / Scopus · klasifikasi ASJC" extracted={snapshot.scival} csvHref={dataUrl("research_quality.csv")} valueFormatter={fwciFormat} />
      <Insight tone="info"><p>FWCI membandingkan sitasi sebuah artikel dengan rata-rata dunia untuk bidang dan tahun yang sama, sehingga angka 1,00 berarti setara rata-rata global. Dari {format((researchQualityRaw as any[]).length)} bidang ilmu yang tercatat, <strong>{format(researchQualityAbove)} bidang</strong> berada pada atau di atas rata-rata dunia. Satu artikel dapat tercatat pada beberapa bidang sekaligus, sehingga jumlah publikasi antarbidang tidak dapat dijumlahkan.</p></Insight>
    </StoryScene>

    <StoryScene id="topik-riset" number="2.3" pillar="Reputasi Akademik" question={scenes["2.3"].question} deck={deck("2.3")} wide>
      <Treemap data={topicNodes} title={scenes["2.3"].question} hideHeader maxNodes={110} height={640} valueLabel="publikasi" categoryLabel="Topik" source="SciVal topic clusters" extracted={snapshot.scival} csvHref={dataUrl("topics.csv")} note="Setiap kotak mewakili satu klaster topik riset SciVal; luas kotak sebanding dengan jumlah publikasi, dan warna menunjukkan departemen pengampu. Angka prominensi menunjukkan posisi persentil klaster tersebut secara global: makin tinggi, makin cepat topik itu bergerak di dunia." />
    </StoryScene>

    <StoryScene id="kolaborasi" number="2.4" pillar="Reputasi Akademik" question={scenes["2.4"].question} deck={deck("2.4")} tone="paper" wide>
      <ChartFrame source="SciVal / Scopus · batas Natural Earth 1:110m" updated={`${publicationFirstYear}–${publicationLastYear}`} downloadHref={dataUrl("collab_countries.csv")} downloadName="collab_countries.csv" note={`Menampilkan sembilan negara mitra kolaborasi terbesar dari total ${(countriesRaw as any[]).length} negara yang tercatat dalam publikasi bersama peneliti FMIPA UGM.`}>
        <WorldCollaboration countries={countries} total={(countriesRaw as any[]).length} from={collabFrom} to={collabTo} />
        <table slot="table"><caption>Daftar Negara Mitra Kolaborasi Riset Utama</caption><thead><tr><th>Negara</th><th>Jumlah Publikasi Bersama</th></tr></thead><tbody>{countries.map((row) => <tr><th scope="row">{row.country}</th><td>{format(row.n)}</td></tr>)}</tbody></table>
      </ChartFrame>
    </StoryScene>

    <StoryScene id="akses-terbuka" number="2.4p" pillar="Reputasi Akademik" question={scenes["2.4p"].question} deck={deck("2.4p")} wide>
      <StackedBarChart data={openAccess} xKey="year" series={openAccessSeries} normalized title={scenes["2.4p"].question} hideHeader yLabel="Proporsi publikasi" provisionalX={2026} provisionalLabel="Indeksasi berjalan" source="SciVal / Scopus" extracted={snapshot.scival} csvHref={dataUrl("open_access.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="attention"><p>Porsi publikasi yang dapat diakses bebas bergerak di kisaran separuh keluaran fakultas: {format(openAccessOpenShare(2021), 1)}% pada 2021 dan {format(openAccessOpenShare(2025), 1)}% pada 2025. Jalur <em>gold</em> mendominasi, sedangkan jalur <em>green</em> berupa salinan di repositori masih sangat sedikit — ruang perbaikan yang berada langsung di tangan fakultas.</p></Insight>
    </StoryScene>

    <StoryScene id="orang-riset" number="2.5" pillar="Reputasi Akademik" question={scenes["2.5"].question} deck={deck("2.5")}>
      <DotMatrix groups={lecturerGroups} title={scenes["2.5"].question} hideHeader columns={20} unitValue={1} unitLabel="dosen" source="Data kepegawaian FMIPA" extracted="snapshot 2025" csvHref={dataUrl("lecturers_positions.csv")} />
      <Insight tone="info"><p>Basis data kepegawaian fakultas mencatat <strong>{format(professorCount)} Guru Besar</strong> aktif, sedangkan sistem SIMASTER universitas mencatat {format(getTckRow("30").capaian_dinilai)} Guru Besar merujuk SK penetapan terbaru. Selisih angka ini wajar terjadi karena perbedaan jeda waktu pemutakhiran data antarkedua sistem.</p></Insight>
    </StoryScene>

    <StoryScene id="reputasi-belum" number="2.6" pillar="Reputasi Akademik" question={scenes["2.6"].question} deck={deck("2.6")} tone="paper">
      <HorizontalBarChart data={sinta} title={scenes["2.6"].question} hideHeader sort="descending" axisLabel="Median skor SINTA" source="SINTA" extracted="snapshot 3 Desember 2025" csvHref={dataUrl("sinta_by_dept.csv")} valueFormatter={(value:number) => format(value)} />
      <IssueCards columns={2} issues={reputationIssues} />
    </StoryScene>

    <PillarHeader id="kontribusi" number="2" title="Kontribusi terhadap Bangsa" evidence="Data Terverifikasi" color="orange" summary="Kiprah nyata sivitas bagi kemajuan bangsa: lonjakan perolehan dana riset, pengabdian masyarakat di berbagai penjuru nusantara, kontribusi terhadap agenda pembangunan berkelanjutan (SDGs), serta kemitraan strategis yang kian kokoh." />

    <StoryScene id="dana-riset" number="3.1" pillar="Kontribusi terhadap Bangsa" question={scenes["3.1"].question} deck={deck("3.1")} wide>
      <ChartFrame source="Data riset FMIPA UGM" updated="2019–2025" downloadHref={dataUrl("funding_by_year.csv")} downloadName="funding_by_year.csv" note="Tahun 2025 merupakan tahun berjalan. Nilai pendanaan mencerminkan total perolehan proposal riset dari berbagai sumber pendanaan (multi-sumber).">
        <FundingShift data={funding} />
        <table slot="table"><caption>Perolehan Dana Riset per Tahun</caption><thead><tr><th>Tahun</th><th>Nilai (Rp Miliar)</th></tr></thead><tbody>{funding.map((row) => <tr><th scope="row">{row.year}</th><td>{format(row.amount, 2)}</td></tr>)}</tbody></table>
      </ChartFrame>
    </StoryScene>

    <StoryScene id="jangkauan" number="3.2" pillar="Kontribusi terhadap Bangsa" question={scenes["3.2"].question} deck={deck("3.2")} tone="paper" wide>
      <PointMap points={outreachPoints} title={scenes["3.2"].question} hideHeader accumulate showSmallMultiples pointLabel="kegiatan terpetakan" source="Surat Tugas, SIMPEL, dan hibah FMIPA" extracted="2021–2025" csvHref={dataUrl("outreach_points.csv")} />
      <Insight tone="attention"><p>Peta kegiatan Pengabdian kepada Masyarakat (PkM) dihimpun dari surat tugas resmi dan sistem pelaporan fakultas. Sepanjang kurun 2021–2025, sebanyak <strong>{format(outreachMapped)} dari {format(outreachTotal)} kegiatan</strong> telah terpetakan lokasinya secara presisi di berbagai provinsi di seluruh nusantara.</p></Insight>
    </StoryScene>

    <StoryScene id="sdg" number="3.3" pillar="Kontribusi terhadap Bangsa" question={scenes["3.3"].question} deck={deck("3.3")}>
      <SDGGrid items={sdgItems} modes={[{ key: "research", label: "Riset" }, { key: "publication", label: "Publikasi" }]} defaultMode="research" valueLabel="rekaman" title={scenes["3.3"].question} hideHeader source="CSV riset FMIPA + SciVal" extracted={snapshot.scival} csvHref={dataUrl("sdg_matrix.csv")} />
    </StoryScene>

    <StoryScene id="diseminasi" number="3.4" pillar="Kontribusi terhadap Bangsa" question={scenes["3.4"].question} deck={deck("3.4")} tone="paper">
      <HorizontalBarChart data={journals} title={scenes["3.4"].question} hideHeader sort="descending" axisLabel="Artikel" source="Data jurnal internal FMIPA" csvHref={dataUrl("journals.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="attention"><p>Pemberitaan media massa mulai dihimpun secara terstruktur sejak 2023, merekam 115 liputan publik mengenai capaian inovasi, riset, dan sumbangsih sivitas akademika FMIPA di tengah masyarakat.</p></Insight>
    </StoryScene>

    <StoryScene id="kemitraan" number="3.5" pillar="Kontribusi terhadap Bangsa" question={scenes["3.5"].question} deck={deck("3.5")} wide>
      <SceneBlock title="Dokumen Kerja Sama yang Disepakati per Tahun" lede="Dihitung berdasarkan jumlah naskah perjanjian kerja sama resmi (satu institusi mitra dapat memiliki lebih dari satu naskah kerja sama).">
        <StackedBarChart data={partnerships} xKey="year" series={partnershipSeries} title="Dokumen Kerja Sama yang Ditandatangani per Tahun" hideHeader yLabel="Dokumen kerja sama" source="LENTERA UGM" extracted={snapshot.lentera} csvHref={dataUrl("partnerships_by_year.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Sebaran Negara Mitra Luar Negeri" lede={`Memetakan seluruh ${format(partnershipCountries.length)} negara mitra internasional. Ukuran dan warna lingkaran mencerminkan jumlah dokumen kerja sama yang disepakati.`}>
        <WorldMap data={partnershipCountries} title="Sebaran Negara Mitra Luar Negeri" hideHeader valueLabel="dokumen kerja sama" topCount={10} source="LENTERA UGM · batas Natural Earth 1:110m" extracted={snapshot.lentera} csvHref={dataUrl("partnership_points.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Ragam Jenis Mitra">
        <HorizontalBarChart data={partnershipKinds} title="Ragam Jenis Mitra" hideHeader sort="descending" axisLabel="Dokumen kerja sama" source="LENTERA UGM" extracted={snapshot.lentera} csvHref={dataUrl("partnership_points.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Sebaran Provinsi Mitra Dalam Negeri">
        <PointMap points={partnershipPoints} title="Sebaran Provinsi Mitra Dalam Negeri" hideHeader accumulate showSmallMultiples pointLabel="dokumen kerja sama" source="LENTERA UGM · batas Peta Nusa" extracted={snapshot.lentera} csvHref={dataUrl("partnership_points.csv")} />
      </SceneBlock>
      <Insight tone="positive"><p>Kemitraan strategis tumbuh signifikan dari {format(partnerships[0]?.domestik + partnerships[0]?.internasional)} naskah kerja sama pada {partnerships[0]?.year} menjadi <strong>{format(partnerships[partnerships.length - 1]?.domestik + partnerships[partnerships.length - 1]?.internasional)} dokumen pada {partnerships[partnerships.length - 1]?.year}</strong>. Dari keseluruhan {format(partnershipCoverage.total)} dokumen kemitraan, sebanyak {format(partnershipCoverage.terpetakan)} dokumen telah terpetakan lokasinya di dalam negeri, {format(partnershipCoverage.internasional)} dokumen merupakan kemitraan internasional, dan {format(partnershipCoverage.lokasi_kosong)} dokumen dalam proses verifikasi alamat mitra.</p></Insight>
    </StoryScene>

    <StoryScene id="kontribusi-belum" number="3.6" pillar="Kontribusi terhadap Bangsa" question={scenes["3.6"].question} deck={deck("3.6")}>
      <IssueCards issues={contributionIssues} />
      <Insight tone="critical"><p>Produktivitas riset sivitas melaju kencang dan perolehan pendanaan kreatif (<em>creative funding</em>) mencapai Rp{format(getTckRow("1c").capaian_dinilai, 2)} miliar, melampaui target Triwulan III (Rp{format(getTckRow("1c").target_dinilai, 2)} miliar). Fokus percepatan kini diarahkan pada hilirisasi hasil riset ke masyarakat dan dunia usaha, serta pengayaan publikasi kegiatan tridharma berbasis SDGs.</p></Insight>
    </StoryScene>

    <PillarHeader id="employability" number="3" title="Employability & Lulusan" evidence="Data Terverifikasi" color="green" summary="Daya saing lulusan di dunia profesional: keluwesan menembus beragam sektor industri, masa tunggu kerja yang singkat, selektivitas penerimaan mahasiswa baru, serta torehan prestasi mahasiswa di panggung nasional dan internasional." />

    <StoryScene id="tujuan-lulusan" number="4.1" pillar="Employability" question={scenes["4.1"].question} deck={deck("4.1")} tone="paper" wide>
      <Treemap data={tracerSectors} title={scenes["4.1"].question} hideHeader height={470} valueLabel="responden lulusan" categoryLabel="Sektor" source={`Tracer study FMIPA UGM · angkatan ${tracerSummary.tahun.join(" dan ")}`} extracted="unduhan 29 Juli 2025" csvHref={dataUrl("tracer_sectors.csv")} valueFormatter={(value:number) => format(value)} note="Luas tiap petak sebanding dengan jumlah responden pada sektor tersebut. Kategori 'Belum bekerja' dan 'Lainnya' diberi warna netral karena keduanya bukan sektor industri." />
      <Insight tone="positive"><p>Sektor <strong>{tracerTopSector}</strong> menjadi bidang karier utama yang ditekuni lulusan, disusul industri jasa keuangan/perbankan serta institusi pendidikan dan riset. Temuan ini membuktikan keluwesan daya adaptasi lulusan sains dan matematika di beragam sektor industri modern.</p></Insight>
    </StoryScene>

    <StoryScene id="masa-tunggu" number="4.2" pillar="Employability" question={scenes["4.2"].question} deck={deck("4.2")} wide>
      <StackedBarChart data={waiting} xKey="prodi" series={waitingSeries} normalized title={scenes["4.2"].question} hideHeader yLabel="Proporsi responden" source="Tracer study FMIPA UGM" extracted="unduhan 29 Juli 2025" csvHref={dataUrl("tracer_waiting_time.csv")} valueFormatter={(value:number) => format(value)} />
      <Insight tone="positive"><p>Masa tunggu lulusan terbukti sangat singkat dengan median <strong>{format(tracerSummary.median_bulan, 1)} bulan</strong> (rata-rata {format(tracerSummary.rerata_bulan, 2)} bulan). Menariknya, sebanyak {format(tracerSummary.bekerja_sebelum_lulus)} responden bahkan telah resmi diterima bekerja sebelum seremoni wisuda dilaksanakan.</p></Insight>
    </StoryScene>

    <StoryScene id="bekal-mahasiswa" number="4.3" pillar="Employability" question={scenes["4.3"].question} deck={deck("4.3")} tone="paper" wide>
      <BulletChart data={studentReadiness} title={scenes["4.3"].question} hideHeader maxPercent={200} source="TCK 2026 FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="positive"><p>Antusiasme mahasiswa mengikuti program Merdeka Belajar Kampus Merdeka (MBKM) mencapai {format(getTckRow("8a").capaian_dinilai)} orang, melampaui target tahunan fakultas sebesar {format(getTckRow("8a").target_tw4)} mahasiswa.</p></Insight>
    </StoryScene>

    <StoryScene id="mahasiswa-asing" number="4.4" pillar="Employability" question={scenes["4.4"].question} deck={deck("4.4")} wide>
      <SceneBlock title="Mahasiswa Asing yang Masuk ke FMIPA">
        <BulletChart data={internationalStudents} title="Mahasiswa Asing yang Masuk ke FMIPA" hideHeader maxPercent={140} source="TCK 2026 #4a–4b" extracted={snapshot.label} csvHref={dataUrl("tck_2026_indikator.csv")} />
      </SceneBlock>
      <SceneBlock title="Mobilitas Keluar: Negara Tujuan Mahasiswa FMIPA" lede="Merekam keikutsertaan mahasiswa dalam berbagai program mobilitas akademik internasional.">
        <WorldMap data={exchangeCountries} unmapped={{ label: "Negara belum tercatat", value: exchangeUnrecorded }} title="Mobilitas Keluar: Negara Tujuan Mahasiswa FMIPA" hideHeader valueLabel="rekaman mobilitas" topCount={10} source="Data mobilitas mahasiswa FMIPA UGM · batas Natural Earth 1:110m" extracted={snapshot.label} csvHref={dataUrl("exchange_students.json")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="info"><p>Internasionalisasi pendidikan terjalin dua arah secara berimbang: fakultas menyambut {format(getTckRow("4a").capaian_dinilai + getTckRow("4b").capaian_dinilai)} mahasiswa asing, sementara <strong>{format(exchange.total)} mahasiswa FMIPA</strong> menimba pengalaman internasional melalui pertukaran pelajar, program gelar ganda (<em>dual degree</em>), dan magang riset di {format(exchange.universitas)} perguruan tinggi di {format(exchange.negara - 1)} negara.</p></Insight>
    </StoryScene>

    <StoryScene id="kelulusan" number="4.5" pillar="Employability" question={scenes["4.5"].question} deck={deck("4.5")} tone="paper">
      <BulletChart data={graduation} title={scenes["4.5"].question} hideHeader maxPercent={200} source="TCK 2026 #8b1–8b3" extracted={snapshot.label} csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="attention" label="Catatan Metodologi"><p>Dalam dokumen resmi sumber, capaian Triwulan III baru memuat jumlah orang tanpa angka pembanding total mahasiswa. Demi menjaga akurasi evaluasi kinerja, persentase kelulusan tepat waktu merujuk pada data Triwulan II yang lengkap dan terverifikasi secara metodologis.</p></Insight>
    </StoryScene>

    <StoryScene id="riset-mahasiswa" number="4.3′" pillar="Employability" question={scenes["4.3p"].question} deck={deck("4.3p")}>
      <HorizontalBarChart data={studentResearch} title={scenes["4.3p"].question} hideHeader sort="none" axisLabel="Judul riset" source="CSV riset FMIPA · tag TCK" csvHref={dataUrl("student_research_by_year.csv")} valueFormatter={(value:number) => format(value)} />
    </StoryScene>

    <StoryScene id="selektivitas" number="4.6" pillar="Employability" question={scenes["4.6"].question} deck={deck("4.6")} tone="paper" wide>
      <SceneBlock title={`Corong Seleksi Sarjana ${admissionLast}`} lede="Diagram memperlihatkan alur seleksi dari peminat, calon mahasiswa yang diterima, hingga yang resmi melakukan daftar ulang. Persentase penerimaan dihitung dari total pendaftar, sedangkan rasio daftar ulang dihitung dari calon mahasiswa yang lolos seleksi.">
        <FunnelFlow stages={admissionFunnel} title={`Corong Seleksi Sarjana ${admissionLast}`} hideHeader valueLabel="calon mahasiswa" source="Data akademik FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("admissions_by_year.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Tingkat Keketatan Seleksi per Tahun" lede="Rasio keketatan menunjukkan perbandingan jumlah peminat yang bersaing memperebutkan satu kursi daya tampung.">
        <LineAreaChart data={tightness} xKey="year" series={[{ key: "rasio", label: "Peminat per kursi", color: ACCENT.navy }]} title="Keketatan Seleksi per Tahun" hideHeader yLabel="Peminat per satu kursi" showMarkers source="Data akademik FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("admissions_by_year.csv")} valueFormatter={(value:number) => format(value, 1)} />
      </SceneBlock>
      <SceneBlock title="Tren Keketatan per Program Studi" lede={`Mengamati dinamika persaingan masuk di tiap program studi selama ${format(admissionYears.length)} tahun terakhir. Skala disesuaikan secara proporsional agar tren perubahan tiap prodi terbaca jelas.`}>
        <TrendRows data={selectivityRows} periods={admissionYears} title="Lintasan Keketatan per Program Studi" hideHeader axisLabel="Peminat per satu kursi" valueFormatter={(value:number) => format(value, 1)} detail={[{ label: "Peminat", values: selectivityRows.map((row) => row.applicants) }, { label: "Diterima", values: selectivityRows.map((row) => row.seats) }]} source="Data akademik FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("admissions_by_year.csv")} />
      </SceneBlock>
      <Insight tone="attention" label="Catatan Analisis"><p>Dinamika rasio keketatan merupakan kombinasi antara perubahan minat pendaftar dan penyesuaian kuota daya tampung. Di <strong>{selectivitySteepest?.label}</strong>, rasio keketatan bergeser dari 1 : {format(selectivitySteepest?.values[0] ?? 0, 1)} menjadi 1 : {format(selectivitySteepest?.values.at(-1) ?? 0, 1)} seiring bertambahnya kuota dari {format(selectivitySteepest?.seats[0] ?? 0)} menjadi {format(selectivitySteepest?.seats.at(-1) ?? 0)} kursi dan pendaftar dari {format(selectivitySteepest?.applicants[0] ?? 0)} menjadi {format(selectivitySteepest?.applicants.at(-1) ?? 0)} orang. Sementara itu, lonjakan keketatan terjadi pada <strong>{selectivityRising?.label}</strong> dari 1 : {format(selectivityRising?.values[0] ?? 0, 1)} menjadi 1 : {format(selectivityRising?.values.at(-1) ?? 0, 1)} berkat kenaikan pendaftar dari {format(selectivityRising?.applicants[0] ?? 0)} menjadi {format(selectivityRising?.applicants.at(-1) ?? 0)} orang. Untuk mendukung kelancaran studi, sebanyak {format(scholarships.total)} mahasiswa aktif menerima manfaat beasiswa melalui {format(scholarships.skema)} skema pendanaan yang tersedia.</p></Insight>
    </StoryScene>

    <StoryScene id="profil-lulusan" number="4.7" pillar="Employability" question={scenes["4.7"].question} deck={deck("4.7")} wide>
      <SceneBlock title="Jumlah Lulusan per Jenjang dan Tahun Akademik">
        <StackedBarChart data={graduates} xKey="year" series={graduateSeries} gaps={graduateGapYears} gapLabel="Magister & Doktor belum tercatat" note={graduateGapNote} title="Jumlah Lulusan per Jenjang dan Tahun Akademik" hideHeader yLabel="Lulusan" source="Data akademik FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("graduates_profile.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Prestasi Mahasiswa menurut Tingkat Kompetisi">
        <StackedBarChart data={achievements} xKey="year" series={achievementSeries} title="Prestasi Mahasiswa menurut Tingkat Kompetisi" hideHeader yLabel="Prestasi" source="Data kemahasiswaan FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("student_achievements.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="positive"><p>Departemen {achievementByDept[0]?.dept} menyumbang prestasi terbanyak ({format(achievementByDept[0]?.n)} gelar sejak 2022), disusul Departemen {achievementByDept[1]?.dept} ({format(achievementByDept[1]?.n)} gelar). Proporsi prestasi di kancah internasional melonjak hingga <strong>{format((achievements[achievements.length - 1].internasional / (achievements[achievements.length - 1].nasional + achievements[achievements.length - 1].internasional)) * 100, 1)}%</strong> pada {achievements[achievements.length - 1].year}.</p></Insight>
    </StoryScene>

    <PillarHeader id="kesejahteraan" number="4" title="Tata Kelola & Kesejahteraan" evidence="Data Terverifikasi" color="violet" summary="Menopang ekosistem akademik yang bermartabat: percepatan jenjang karier dosen, penyediaan fasilitas kampus ramah disabilitas, dan kepedulian berkelanjutan terhadap kesehatan fisik serta ruang aman sivitas." />

    <StoryScene id="karier" number="5.1" pillar="Kesejahteraan" question={scenes["5.1"].question} deck={deck("5.1")} tone="paper" wide>
      <BulletChart data={career} title={scenes["5.1"].question} hideHeader maxPercent={200} source="TCK 2026 FMIPA UGM" extracted={snapshot.label} csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="attention"><p>Sebanyak {format(getTckRow("23").capaian_dinilai)} dosen telah meraih rekognisi kepakaran internasional dari target Triwulan III ({format(getTckRow("23").target_dinilai)} orang). Di samping itu, program sertifikasi kompetensi dan profesi dosen telah diikuti oleh {format(getTckRow("25").capaian_dinilai)} orang dan terus diakselerasi menuju target akhir tahun ({format(getTckRow("25").target_dinilai)} orang).</p></Insight>
    </StoryScene>

    <StoryScene id="inklusif" number="5.2" pillar="Kesejahteraan" question={scenes["5.2"].question} deck={deck("5.2")}>
      <DotMatrix groups={[{ label: "Fasilitas tersedia", count: getTckRow("31").capaian_dinilai, color: DEPT.matematika, description: `Target tahunan: ${format(getTckRow("31").target_tw4)} unit` }]} columns={10} unitValue={1} unitLabel="unit" title={scenes["5.2"].question} hideHeader source="TCK 2026 #31" extracted={snapshot.label} csvHref={dataUrl("tck_2026_indikator.csv")} />
      <Insight tone="critical" label="Verifikasi Data"><p>Capaian penerapan gedung ramah lingkungan (<em>green building</em>) tercatat sebesar <strong>{format(getTckRow("32").capaian_dinilai)}%</strong> pada dokumen sumber. Angka ini sedang dalam proses rekonsiliasi teknis bersama Direktorat Aset UGM untuk memastikan kesesuaian standar sertifikasi fisik di lapangan.</p></Insight>
    </StoryScene>

    <StoryScene id="kesehatan" number="5.3" pillar="Kesejahteraan" question={scenes["5.3"].question} deck={deck("5.3")} tone="paper" wide>
      <SceneBlock title={`Tren Risiko Kesehatan Dosen dan Tenaga Kependidikan (${hpuFirstYear}–${hpuLastYear})`} lede={`Membandingkan enam parameter kesehatan menggunakan ambang batas klinis terstandar yang seragam, sehingga tren lima tahun dapat dievaluasi secara konsisten dan setara.`}>
        <SmallMultiplesTrend panels={trendPanels} bands={trendBands} highlight="Berisiko" columns={3} provisionalYears={hpuImprecise} provisionalLabel="Presisi bulan, bukan sesi" valueSuffix="berisiko" title={`Tren Risiko Kesehatan Dosen dan Tenaga Kependidikan ${hpuFirstYear}–${hpuLastYear}`} hideHeader source="Posbindu Melati FMIPA · digitasi arsip analog, registri, dan rekap 2026" extracted={snapshot.label} csvHref={dataUrl("hpu_posbindu_tahunan.csv")} />
      </SceneBlock>
      <SceneBlock title="Cakupan Pemeriksaan Kesehatan per Tahun" lede={`Jumlah kunjungan pemeriksaan tahunan yang mencakup dosen, tenaga kependidikan, serta sivitas fakultas yang memanfaatkan layanan Posbindu.`}>
        <LineAreaChart data={hpuParticipation} xKey="year" series={[{ key: "semua", label: "Seluruh peserta", color: ACCENT.slate }, { key: "staf", label: "Dosen dan tendik", color: ACCENT.navy }]} title="Cakupan Layanan Posbindu per Tahun" hideHeader yLabel="Kunjungan pemeriksaan" showMarkers source="Posbindu Melati FMIPA" extracted={snapshot.label} csvHref={dataUrl("hpu_posbindu_tahunan.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Tingkat Kunjungan Ulang Peserta" lede="Menunjukkan konsistensi sivitas dalam memeriksakan kesehatan secara berkala—mengukur berapa banyak peserta yang kembali untuk pemeriksaan lanjutan, bukan sekadar kunjungan tunggal.">
        <FunnelFlow stages={hpuRetention} title="Kedatangan Ulang Peserta Posbindu" hideHeader valueLabel="peserta" note="Jumlah bersifat kumulatif: minimal 2 kunjungan juga mencakup peserta dengan 3 kunjungan atau lebih. Selisih menunjukkan belum ada kunjungan berikutnya dalam periode registri, bukan kepastian berhenti mengikuti layanan." source="Registri Posbindu Melati FMIPA" extracted={snapshot.label} csvHref={dataUrl("hpu_posbindu_tahunan.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="attention" label="Temuan Longitudinal"><p>Sepanjang kurun {hpuFirstYear}–{hpuLastYear}, <strong>{hpuTrendTop?.label.toLowerCase()}</strong> konsisten menjadi parameter dengan temuan berisiko terbanyak ({hpuTrendTopShare}% peserta). Hal penting yang perlu diwaspadai bersama adalah kenaikan risiko <strong>tekanan darah</strong> dari {hpuShare(hpuTension, hpuFirstYear)}% pada {hpuFirstYear} menjadi {hpuShare(hpuTension, hpuLastYear)}% pada {hpuLastYear}. Selain itu, dari {format(hpuStaff.diperiksa_lengkap)} kunjungan dengan data medis lengkap, tercatat <strong>{format(hpuMultiRisk)} kunjungan</strong> yang menunjukkan kondisi berisiko pada tiga indikator atau lebih sekaligus sehingga memerlukan intervensi pola hidup sehat bersama.</p></Insight>
      <SceneBlock title={`Profil Parameter Risiko Kesehatan ${hpuLastYear}`} lede="Enam parameter kesehatan diurutkan berdasarkan proporsi peserta yang memerlukan perhatian klinis pada tahun terakhir.">
        <RiskProfile data={riskProfile} bands={riskBands} title={`Profil Risiko Kesehatan Dosen dan Tenaga Kependidikan ${hpuLastYear}`} hideHeader highlight="Berisiko" highlightSuffix="berisiko" axisLabel="Porsi peserta yang diperiksa" source="Posbindu Melati FMIPA · Health Promoting University" extracted={snapshot.label} csvHref={dataUrl("hpu_posbindu.csv")} />
      </SceneBlock>
      <SceneBlock title="Sebaran Kehadiran Dosen dan Tenaga Kependidikan" lede={`Setiap titik mewakili satu kehadiran pemeriksaan dalam ${format(hpu.sesi.length)} sesi layanan Posbindu yang terselenggara sepanjang ${hpuLastYear}.`}>
        <DotMatrix groups={posbinduGroups} columns={26} unitValue={1} unitLabel="kunjungan" title="Komposisi Kunjungan Dosen dan Tenaga Kependidikan" hideHeader source="Posbindu Melati FMIPA" extracted={snapshot.label} csvHref={dataUrl("hpu_posbindu.csv")} />
      </SceneBlock>
      <Insight tone="attention" label="Cakupan dan Presisi Data"><p>Pada tahun {hpuLastYear}, tercatat <strong>{format(hpu.kunjungan)} pemeriksaan kesehatan dosen dan tenaga kependidikan</strong> yang terdistribusi dalam {format(hpu.sesi.length)} sesi layanan ({sessionLabel(posbinduFirst?.tanggal)} hingga {sessionLabel(posbinduLatest?.tanggal)}). Rekapitulasi ini berfokus pada pegawai tetap, sedangkan {posbinduExcluded} dicatat terpisah. Penyelarasan data historis dilakukan dengan cermat: data tahun {hpuImprecise.join(", ")} yang bersumber dari registri bulanan disajikan dengan penanda arsiran, sedangkan tahun {hpuMixed.join(", ")} menggabungkan catatan arsip harian dan registri bulanan yang telah direkonsiliasi agar tidak terjadi pencatatan ganda. Parameter lingkar perut dan asam urat dinilai berdasarkan ambang batas fisiologis gender masing-masing.</p></Insight>
      <Insight tone="info" label="Perlindungan Privasi Data"><p>Seluruh data kesehatan disajikan secara agregat dan sepenuhnya anonim untuk menjamin kerahasiaan rekam medis setiap individu sivitas. Informasi privat seperti identitas pribadi dan rekam perorangan tidak pernah dipublikasikan. Standar rujukan klinis dan metodologi pengelompokan risiko dapat dipelajari lebih lanjut pada halaman Data &amp; Metodologi.</p></Insight>
      <DataGap title="Integrasi Sistem Keselamatan Kerja (K3L) & Ruang Aman Kampus" description="Aktivitas pencegahan dan penanganan insiden K3L serta perlindungan ruang aman kampus terus berjalan aktif bersama Satgas PPKS dan Tim K3L Fakultas. Fakultas saat ini tengah mematangkan sistem pencatatan digital terpadu agar data capaian ini dapat terintegrasi penuh dalam pangkalan data institusi." owner="Satgas PPKS & Tim K3L FMIPA" tone="hold" />
    </StoryScene>

    <PillarHeader id="mahasiswa" number="5" title="Mahasiswa & Akses Pendidikan" evidence="Data Terverifikasi" color="teal" summary="Enam angkatan pada jenjang S1, S2, S3, dan non-gelar, dengan jejaring sekolah serta universitas asal. Analisis daerah, keluarga, gender, dan perjalanan studi berasal dari daftar mahasiswa S1 dan non-gelar yang memiliki variabel tersebut." />

    <StoryScene id="siapa-mahasiswa" number="6.1" pillar="Mahasiswa & Akses" question={scenes["6.1"].question} deck={deck("6.1")} wide>
      <SceneBlock title="Cakupan Mahasiswa S1, S2, S3, dan Non-gelar" lede={`Workbook per ${origins.tanggal} memuat ${format(origins.total)} rekaman angkatan 2021–2026. Angka menunjukkan cakupan rekaman per angkatan, bukan jumlah mahasiswa yang masih aktif atau orang unik lintas jenjang.`}>
        <StackedBarChart data={originMix} xKey="year" series={originSeries} title="Mahasiswa per Jenjang dan Angkatan" hideHeader yLabel="Rekaman mahasiswa" source="Data Asal Sekolah dan Asal Univ Fak MIPA 2021–2026" extracted={origins.tanggal} csvHref={dataUrl("students_origins_cohorts.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="info" label="Cakupan Sumber"><p>Sumber baru mencakup <strong>{format(origins.per_jenjang.S1)} S1, {format(origins.per_jenjang.S2)} S2, {format(origins.per_jenjang.S3)} S3, dan {format(origins.per_jenjang.NONDEGREE)} non-gelar</strong>. Profil daerah, gender, jalur masuk, keluarga, status studi, dan IPK tetap memakai daftar mahasiswa lama ({format(students.total)} rekaman S1 dan non-gelar), karena variabel tersebut tidak ada pada workbook baru. Grafik prodi di bawah memakai S1 dan non-gelar dari daftar mahasiswa, serta hanya S2/S3 dari workbook baru. Data yang mencakup jenjang sama tidak dijumlahkan antar-sumber.</p></Insight>
      <SceneBlock title="Komposisi Program Studi S1, S2, S3, dan Non-gelar" lede="Bandingkan jumlah dan proporsi per prodi pada tahun angkatan pilihan, dengan tren 2021–2026 di setiap baris. Filter menurut program studi, tahun angkatan, dan jenjang.">
        <ProgrammeTrends data={programmeTrends} totals={programmeTrendsMeta.per_angkatan_jenjang} />
      </SceneBlock>
      <SceneBlock title="Dinamika Program Reguler, IUP, dan Non-gelar" lede="Perkembangan jumlah mahasiswa per angkatan pada program sarjana reguler, International Undergraduate Program (IUP), serta program non-gelar.">
        <StackedBarChart data={trackMix} xKey="year" series={trackSeries} title="Jalur Studi: Reguler, IUP, dan Non-gelar" hideHeader yLabel="Mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_programme.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="info"><p>Pada daftar mahasiswa S1 dan non-gelar, enam angkatan memuat <strong>{format(students.total)} rekaman</strong>, dengan {format(students.sarjana)} orang menempuh studi sarjana reguler dan internasional. Sebaran minat antarbidang studi relatif berimbang, didukung penerimaan kelas internasional (IUP) yang stabil di angka sekitar {format(sceneValues.studentsIup)} mahasiswa per angkatan serta keikutsertaan {format(studentLast.non_gelar)} mahasiswa program non-gelar pada angkatan {students.tahun_akhir}.</p></Insight>
    </StoryScene>

    <StoryScene id="asal-mahasiswa" number="6.2" pillar="Mahasiswa & Akses" question={scenes["6.2"].question} deck={deck("6.2")} tone="paper" wide>
      <SceneBlock title="Peta Sebaran Asal Mahasiswa di Seluruh Indonesia" lede="Peta memperlihatkan sebaran asal daerah mahasiswa berdasarkan alamat KTP. Gunakan tombol pemilih angkatan untuk meninjau dinamika jangkauan geografis dari tahun ke tahun dengan skala warna yang konsisten.">
        <ChoroplethMap data={provinceMap} panels={provincePanels} title="Sebaran Provinsi Asal Mahasiswa" hideHeader valueLabel="mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_province.csv")} note={`Sebanyak ${format(studentAccess.luar_negeri)} mahasiswa beralamat di luar negeri dan ${format(studentAccess.provinsi_tanpa_data)} tidak memiliki catatan provinsi; keduanya tidak dapat diletakkan pada peta dan tidak dihitung sebagai "luar Jawa".`} />
      </SceneBlock>
      <SceneBlock title="Indikator Jangkauan Wilayah Nasional per Angkatan" lede={`Tren perkembangan empat indikator pemerataan akses geografis selama ${format(studentYears.length)} angkatan terakhir.`}>
        <TrendRows data={reachRows} periods={studentYears} title="Jangkauan Nasional per Angkatan" hideHeader axisLabel="Nilai per angkatan" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_province.csv")} valueFormatter={(value:number) => format(value, 1)} />
      </SceneBlock>
      <SceneBlock title="Sepuluh Kabupaten dan Kota Asal Terbanyak" lede={`Kabupaten dan kota dengan kontribusi mahasiswa terbesar dari total ${format(studentAccess.kabupaten_unik)} daerah yang tercatat sepanjang enam angkatan.`}>
        <HorizontalBarChart data={districtBars} title="Kabupaten dan Kota Asal Terbanyak" hideHeader sort="descending" axisLabel="Mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_province.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="positive"><p>Pemerataan akses pendidikan menunjukkan tren yang menggembirakan: asal daerah mahasiswa meluas dari <strong>{format(students.provinsi_awal)} provinsi</strong> pada angkatan {students.tahun_awal} menjadi {format(students.provinsi_akhir)} provinsi pada angkatan {students.tahun_akhir}. Kehadiran mahasiswa asal luar Jawa sempat menyentuh puncaknya sebesar {format(students.porsi_luar_jawa_puncak, 1)}% pada angkatan {students.tahun_luar_jawa_puncak}, dan berada di angka {format(students.porsi_luar_jawa_akhir, 1)}% pada angkatan {students.tahun_akhir}. Yang membanggakan, sebanyak {format(studentAccess.daerah_3t_total)} mahasiswa berasal dari daerah Terdepan, Terluar, dan Tertinggal (3T).</p></Insight>
    </StoryScene>

    <StoryScene id="gender-disiplin" number="6.3" pillar="Mahasiswa & Akses" question={scenes["6.3"].question} deck={deck("6.3")} wide>
      <SceneBlock title="Proporsi Mahasiswa Perempuan per Angkatan" lede="Perkembangan proporsi mahasiswa perempuan di tingkat fakultas dari tahun ke tahun.">
        <LineAreaChart data={genderTrend} xKey="year" series={[{ key: "porsi", label: "Porsi perempuan (%)", color: ACCENT.teal }]} title="Porsi Mahasiswa Perempuan per Angkatan" hideHeader yLabel="Persen mahasiswa perempuan" yDomain={[40, 55]} showMarkers source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_programme.csv")} valueFormatter={(value:number) => format(value, 1)} />
      </SceneBlock>
      <SceneBlock title="Keseimbangan Gender per Program Studi" lede="Perbandingan rasio gender lintas disiplin ilmu sepanjang enam angkatan, diurutkan dari proporsi perempuan tertinggi.">
        <StackedBarChart data={genderByProgramme} xKey="prodi" series={genderSeries} normalized title="Komposisi Gender per Program Studi" hideHeader yLabel="Proporsi mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_programme.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="attention" label="Catatan Analisis"><p>Di tingkat fakultas, proporsi gender berada dalam keseimbangan yang sehat, dengan persentase mahasiswa perempuan bergerak dinamis dari {format(students.porsi_perempuan_awal, 1)}% pada angkatan {students.tahun_awal} menjadi <strong>{format(students.porsi_perempuan_akhir, 1)}% pada angkatan {students.tahun_akhir}</strong>. Namun, bila dicermati per program studi, tampak minat yang bervariasi: Program Studi {genderTop.prodi} mencatat proporsi perempuan tertinggi ({format(genderTop.share, 1)}%), sementara Program Studi {genderLow.prodi} berada pada angka {format(genderLow.share, 1)}%.</p></Insight>
    </StoryScene>

    <StoryScene id="pintu-masuk" number="6.4" pillar="Mahasiswa & Akses" question={scenes["6.4"].question} deck={deck("6.4")} tone="paper" wide>
      <SceneBlock title="Komposisi Jalur Masuk per Angkatan" lede="Penyelarasan nomenklatur seleksi nasional (SNMPTN ke SNBP dan SBMPTN ke SNBT) untuk membandingkan kesinambungan alur masuk secara konsisten.">
        <StackedBarChart data={pathwayMix} xKey="year" series={pathwaySeries} normalized title="Komposisi Jalur Masuk per Angkatan" hideHeader yLabel="Proporsi mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_by_pathway.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="info"><p>Jalur seleksi mandiri <strong>{pathwayTop.name}</strong> menjadi pintu masuk terbesar dengan menyaring {format(pathwayTop.total)} mahasiswa ({format((pathwayTop.total / students.total) * 100, 1)}% dari total mahasiswa). Sementara itu, jalur seleksi nasional terpusat (SNBP dan SNBT) menyumbang {format(((pathwayTotals.find((row) => row.name === "Seleksi Nasional Prestasi")?.total ?? 0) + (pathwayTotals.find((row) => row.name === "Seleksi Nasional Tes")?.total ?? 0)) / students.total * 100, 1)}%, didampingi jalur afirmasi wilayah 3T dan Rekognisi Pembelajaran Lampau (RPL).</p></Insight>
    </StoryScene>

    <StoryScene id="latar-keluarga" number="6.5" pillar="Mahasiswa & Akses" question={scenes["6.5"].question} deck={deck("6.5")} wide>
      <SceneBlock title="Profil Latar Belakang Pekerjaan Orang Tua/Wali" lede="Standardisasi data pekerjaan orang tua/wali dari 175 variasi isian teks menjadi 11 rumpun profesi utama.">
        <HorizontalBarChart data={guardianBars} title="Pekerjaan Wali Mahasiswa" hideHeader sort="descending" axisLabel="Mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_background.json")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title="Dinamika Latar Profesi Orang Tua per Angkatan" lede="Perkembangan proporsi profesi orang tua/wali mahasiswa lintas angkatan (tidak menyertakan data yang tidak terisi).">
        <TrendRows data={guardianRows} periods={studentYears} title="Pergeseran Latar Pekerjaan Wali per Angkatan" hideHeader axisLabel="Mahasiswa per angkatan" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_background.json")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <DataGap
        label="Agenda Integrasi Data"
        title="Agenda Penyelarasan Data Sosial-Ekonomi Mahasiswa"
        description={`Sebanyak ${format(studentBackground.wali_tidak_dilaporkan)} dari ${format(students.total)} data mencantumkan keterangan umum atau tidak merinci pekerjaan orang tua/wali. Selain itu, basis data ini belum memadukan status perolehan beasiswa ke dalam profil perorangan. Grafik ini menyajikan keragaman latar profesi dan bukan indikator kemampuan ekonomi keluarga.`}
        owner="Bagian Akademik dan Kemahasiswaan FMIPA"
        knownValue={`${format(students.total - studentBackground.wali_tidak_dilaporkan)} data dengan pekerjaan wali terklasifikasi`}
      />
    </StoryScene>

    <StoryScene id="sekolah-keberagaman" number="6.6" pillar="Mahasiswa & Akses" question={scenes["6.6"].question} deck={deck("6.6")} tone="paper" wide>
      <SceneBlock title="Jejaring Sekolah dan Universitas Asal" lede={`Asal pendidikan tersedia untuk angkatan 2021–2026 pada sumber baru per ${origins.tanggal}. Pilih jenjang dan angkatan untuk menelusuri sekolah asal mahasiswa S1, universitas S1 mahasiswa S2, serta universitas S1/S2 mahasiswa S3.`}>
        <EducationOrigins data={origins} />
      </SceneBlock>
      <SceneBlock title="Komposisi Agama per Angkatan" lede="Proporsi dihitung dari total mahasiswa pada masing-masing angkatan.">
        <StackedBarChart data={religionMix} xKey="year" series={religionSeries} normalized title="Komposisi Agama per Angkatan" hideHeader yLabel="Proporsi mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_background.json")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <Insight tone="info" label="Cakupan yang Bertambah"><p>Sumber baru mencatat sekolah asal untuk <strong>{format(schoolOrigin.tercatat)} dari {format(schoolOrigin.total)} rekaman S1</strong> pada keenam angkatan, termasuk 2021–2022. Jejaring pascasarjana memuat {format(masterOrigin.institusi_unik)} nama universitas S1 asal mahasiswa magister dan {format(doctorOrigin.institusi_unik)} nama universitas S2 asal mahasiswa doktor. Sumber tidak memuat provinsi institusi, sehingga persebaran geografis sekolah tidak disimpulkan dari nama institusi.</p></Insight>
    </StoryScene>

    <StoryScene id="perjalanan-angkatan" number="6.7" pillar="Mahasiswa & Akses" question={scenes["6.7"].question} deck={deck("6.7")} wide>
      <SceneBlock title="Status Kelulusan dan Keaktifan Studi per Angkatan" lede="Angkatan 2021 telah menuntaskan batas masa studi sarjana reguler empat tahun, sedangkan angkatan-angkatan setelahnya masih aktif menyelesaikan kurikulum dan tugas akhir.">
        <StackedBarChart data={outcomeMix} xKey="year" series={outcomeSeries} normalized title="Status Akhir Mahasiswa per Angkatan" hideHeader yLabel="Proporsi mahasiswa" source="Daftar mahasiswa S1 & non-gelar FMIPA UGM 2021–2026" extracted={snapshot.label} csvHref={dataUrl("students_cohort_outcome.csv")} valueFormatter={(value:number) => format(value)} />
      </SceneBlock>
      <SceneBlock title={`Distribusi IPK per Program Studi (${ipkStart}–${ipkEnd})`} lede="Setiap titik mewakili IPK seorang mahasiswa S1, dengan warna berbeda untuk setiap angkatan. Lihat semua angkatan untuk membandingkan sebarannya, atau pilih satu angkatan untuk membandingkan antarprogram studi. Perbedaan antarangkatan juga mencerminkan semester dan penyelesaian tugas akhir, sehingga tidak dibaca sebagai tren penurunan mutu.">
        <IpkDistribution data={studentIpk} extracted={snapshot.label} />
      </SceneBlock>
      <Insight tone="positive"><p>Setelah kurun lima tahun, sebanyak <strong>{format(cohortFirst("Lulus"))} dari {format(studentFirst.total)} mahasiswa</strong> angkatan {students.tahun_awal} telah resmi lulus menyandang gelar sarjana, {format(cohortFirst("Masih aktif"))} mahasiswa sedang merampungkan tugas akhir, dan {format(cohortFirst("Mengundurkan diri"))} mahasiswa mengundurkan diri. Dinamika pengunduran diri tercatat paling tinggi pada angkatan <strong>{withdrawalPeak.year}</strong> ({format(withdrawalPeak.n)} mahasiswa atau {format(withdrawalPeak.share, 1)}%) yang bertepatan dengan masa transisi pembelajaran daring di era pandemi.</p></Insight>
      <DataGap
        label="Agenda Integrasi Data"
        title="Data Prestasi Akademik Mahasiswa Angkatan Baru"
        description={`Data IPK Kumulatif angkatan 2026 belum tercantum karena mahasiswa baru memulai perkuliahan semester awal saat pemutakhiran data berlangsung. Analisis capaian akademik mencakup lima angkatan aktif (${ipkStart}–${ipkEnd}).`}
        owner="Bagian Akademik FMIPA"
        knownValue={`${format((studentIpk.per_tahun as any[]).reduce((sum, row) => sum + row.tercatat, 0))} mahasiswa dengan IPK tercatat pada angkatan ${ipkStart}–${ipkEnd}`}
        tone="hold"
      />
    </StoryScene>

    <ChapterIntro id="yang-diserahkan" number={chapters.handover.number} title={chapters.handover.title} description={chapters.handover.description} />

    <StoryScene id="belum-selesai" number="7.1" question={scenes["7.1"].question} deck={deck("7.1")} wide>
      <IssueCards issues={[
        { value: `${format(tckBehind)} / ${format(tck.length)}`, title: "Akselerasi Target Kinerja", description: "Indikator yang diprioritaskan pemenuhannya menjelang penutupan tahun anggaran 2026.", status: "Akuntabilitas" },
        { value: format(tckFlagged), title: "Penyelarasan Metodologi", description: "Indikator dengan catatan teknis yang telah diverifikasi dan diselaraskan secara transparan.", status: "Tata Kelola Data" },
        { value: `${format(partnershipCoverage.lokasi_kosong)} naskah`, title: "Pemetaan Alamat Kemitraan", description: "Naskah kerja sama domestik yang sedang dilengkapi rincian geografis mitranya.", status: "Kelengkapan Data" },
        { value: `${format(fundingChange, 1)}%`, title: "Keberlanjutan Dana Riset", description: `Penyesuaian perolehan dari Rp${format(funding2024, 2)} miliar (2024) ke Rp${format(funding2025, 2)} miliar (2025) menuju kapasitas yang berkesinambungan.`, status: "Keberlanjutan" },
      ]} columns={4} />
    </StoryScene>

    <StoryScene id="titik-awal" number="7.2" question={scenes["7.2"].question} deck={deck("7.2")} tone="paper" wide>
      <PillarSummary pillars={pillarSummary} />
      <div class="handover-cta">
        <div><p class="eyebrow">Transparansi &amp; Akuntabilitas</p><h3>Pijakan data yang kokoh, terbuka, dan dapat dipertanggungjawabkan.</h3><p>Halaman Data &amp; Metodologi menyajikan seluruh dataset terbuka, glosarium indikator, penjelasan harmonisasi rekonsiliasi data antarsumber, serta agenda tata kelola data jangka panjang institusi.</p></div>
        <a href={withBase("/data")}>Jelajahi Data &amp; Metodologi →</a>
      </div>
    </StoryScene>
  </main>
  <script>
    import "../scripts/charts";
  </script>
</BaseLayout>

<style>
  .chapter-bridge { margin: 42px 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(24px, 3vw, 36px); font-style: italic; }
  .handover-cta { margin-block-start: var(--flow-chart); padding: clamp(28px, 4vw, 46px); border: 1px solid var(--border-default); border-top: 4px solid var(--ugm-gold); background: var(--ugm-blue-deep); color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .handover-cta .eyebrow { margin: 0 0 10px; color: var(--ugm-gold); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }.handover-cta h3 { color: #fff; font-size: 28px; }.handover-cta p:last-child { max-width: 640px; margin: 12px 0 0; color: rgba(255,255,255,.72); }.handover-cta > a { flex: none; min-height: 48px; padding: 12px 18px; border: 1px solid #fff; border-radius: 4px; color: #fff; font-weight: 700; text-decoration: none; }.handover-cta > a:hover { background: #fff; color: var(--ugm-blue-deep); }
  @media(max-width:760px){.handover-cta{align-items:flex-start;flex-direction:column}.handover-cta>a{width:100%;text-align:center}}
</style>
