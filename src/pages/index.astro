---
import BaseLayout from "../layouts/BaseLayout.astro";
import ColdOpen from "../components/ColdOpen.astro";
import ChapterIntro from "../components/ChapterIntro.astro";
import StoryScene from "../components/StoryScene.astro";
import PillarHeader from "../components/PillarHeader.astro";
import InstitutionPortrait from "../components/InstitutionPortrait.astro";
import ValueModel from "../components/ValueModel.astro";
import TckOverview from "../components/TckOverview.astro";
import ChartFrame from "../components/ChartFrame.astro";
import Insight from "../components/Insight.astro";
import DataGap from "../components/DataGap.astro";
import IssueCards from "../components/IssueCards.astro";
import PillarSummary from "../components/PillarSummary.astro";
import WorldCollaboration from "../components/WorldCollaboration.astro";
import EducationOrigins from "../components/EducationOrigins.astro";
import IpkDistribution from "../components/charts/IpkDistribution.astro";
import ProgrammeTrends from "../components/charts/ProgrammeTrends.astro";
import programmeTrends from "../data/derived/students_programme_trends.json";
import programmeTrendsMeta from "../data/derived/students_programme_trends_meta.json";
import origins from "../data/derived/students_origins.json";
import originsCohorts from "../data/derived/students_origins_cohorts.json";
import FundingShift from "../components/FundingShift.astro";
import SceneBlock from "../components/SceneBlock.astro";
import {
  BulletChart,
  ChoroplethMap,
  DotMatrix,
  FunnelFlow,
  HorizontalBarChart,
  LineAreaChart,
  PointMap,
  RiskProfile,
  SDGGrid,
  SmallMultiplesTrend,
  StackedBarChart,
  Treemap,
  TrendRows,
  WorldMap,
} from "../components/charts";
import { chapters, deckOf, scenes, type SceneValues } from "../i18n/id";
import { ACCENT, DEPT, SEQ, UGM_BLUE } from "../lib/palette";
import { centroidForProvince } from "../lib/province-centroids";
import { countryNameId } from "../lib/country-centroids";
import { withBase } from "../lib/paths";

import citationsRaw from "../data/derived/citations_by_year.json";
import publicationsRaw from "../data/derived/publications_by_year_dept.json";
import topicsRaw from "../data/derived/topics.json";
import countriesRaw from "../data/derived/collab_countries.json";
import collabShareRaw from "../data/derived/collab_share.json";
import researchQualityRaw from "../data/derived/research_quality.json";
import openAccessRaw from "../data/derived/open_access.json";
import lecturersRaw from "../data/derived/lecturers_positions.json";
import sintaRaw from "../data/derived/sinta_by_dept.json";
import fundingRaw from "../data/derived/funding_by_year.json";
import outreachRaw from "../data/derived/outreach_points.json";
import sdgRaw from "../data/derived/sdg_matrix.json";
import journalsRaw from "../data/derived/journals.json";
import studentResearchRaw from "../data/derived/student_research_by_year.json";
import tckRaw from "../data/derived/tck_2026_joined.json";
import budgetRaw from "../data/derived/tck_2026_anggaran.json";
import institutionRaw from "../data/derived/institution_snapshot.json";
import valueModelRaw from "../data/derived/value_model.json";
import snapshotRaw from "../data/derived/snapshot.json";
import tckByDeptRaw from "../data/derived/tck_2026_by_dept.json";
import partnershipsRaw from "../data/derived/partnerships_by_year.json";
import partnershipPartnersRaw from "../data/derived/partnership_partners.json";
import partnershipPointsRaw from "../data/derived/partnership_points.json";
import partnershipCoverageRaw from "../data/derived/partnership_coverage.json";
import admissionsRaw from "../data/derived/admissions_by_year.json";
import activeStudentsRaw from "../data/derived/active_students.json";
import graduatesRaw from "../data/derived/graduates_profile.json";
import achievementsRaw from "../data/derived/student_achievements.json";
import accreditationRaw from "../data/derived/accreditation.json";
import scholarshipsRaw from "../data/derived/scholarships.json";
import exchangeRaw from "../data/derived/exchange_students.json";
import tracerSectorsRaw from "../data/derived/tracer_sectors.json";
import tracerWaitingRaw from "../data/derived/tracer_waiting_time.json";
import tracerSummaryRaw from "../data/derived/tracer_summary.json";
import hpuRaw from "../data/derived/hpu_posbindu.json";
import hpuYearlyRaw from "../data/derived/hpu_posbindu_tahunan.json";
import studentSummaryRaw from "../data/derived/students_summary.json";
import studentProgrammeRaw from "../data/derived/students_by_programme.json";
import studentProvinceRaw from "../data/derived/students_by_province.json";
import studentPathwayRaw from "../data/derived/students_by_pathway.json";
import studentBackgroundRaw from "../data/derived/students_background.json";
import studentOutcomeRaw from "../data/derived/students_cohort_outcome.json";
import studentIpkRaw from "../data/derived/students_ipk.json";
import studentAccessRaw from "../data/derived/students_access.json";

const citations: any[] = (citationsRaw as any[]).filter((row) => row.year >= 2019 && row.year <= 2025);
const citationTotal = (citationsRaw as any[]).reduce((sum, row) => sum + row.citations, 0);
const citationStart = Math.min(...(citationsRaw as any[]).map((row) => row.year));
const citationEnd = Math.max(...(citationsRaw as any[]).map((row) => row.year));
const tck: any[] = tckRaw as any[];
const tckByNo = new Map(tck.map((row) => [String(row.no), row]));
const getTckRow = (no: string) => {
  const row = tckByNo.get(no);
  if (!row) throw new Error(`Indikator TCK ${no} tidak ditemukan`);
  return row;
};
const format = (value: number, digits = 0) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);
const dataUrl = (file: string) => withBase(`/data/${file}`);
const snapshot = snapshotRaw as { label: string; p2m: string; lentera: string; scival: string };

/* SciVal's 30 August 2026 snapshot closes 2025 and opens 2026, so the running
   year moves one step. The citation series above keeps 2025 as its running year:
   it comes from the P2M export, which stops there. */
const publicationYears = [2020, 2021, 2022, 2023, 2024, 2025, 2026];
const departmentKey: Record<string, string> = {
  "Fisika": "fisika",
  "Ilmu Komputer dan Elektronika": "ike",
  "Kimia": "kimia",
  "Matematika": "matematika",
  "Belum terpetakan": "unmapped",
};
const publications: any[] = publicationYears.map((year) => {
  const row: Record<string, any> = { year };
  Object.values(departmentKey).forEach((key) => { row[key] = 0; });
  (publicationsRaw as any[]).filter((item) => item.year === year).forEach((item) => { row[departmentKey[item.department] ?? "unmapped"] += item.count; });
  return row;
});
const publicationSeries = [
  { key: "fisika", label: "Fisika", color: DEPT.fisika, pattern: "solid" },
  { key: "ike", label: "Ilmu Komputer & Elektronika", color: DEPT.ike, pattern: "diagonal" },
  { key: "kimia", label: "Kimia", color: DEPT.kimia, pattern: "dots" },
  { key: "matematika", label: "Matematika", color: DEPT.matematika, pattern: "cross" },
  { key: "unmapped", label: "Belum terpetakan", color: DEPT.unmapped, pattern: "diagonal" },
] as any;

const deptColors: Record<string, string> = { Fisika: DEPT.fisika, "Ilmu Komputer dan Elektronika": DEPT.ike, Kimia: DEPT.kimia, Matematika: DEPT.matematika, "Belum terpetakan": DEPT.unmapped };

/* One colour per undergraduate programme, fixed for the whole page: a
   programme keeps the same colour in the cohort mix, the selectivity rows and
   the grade-point rows, so the reader learns it once. All eight are distinct —
   two pairs used to share a hue, which read as one series wherever they met. */
const programmeSeriesColor: Record<string, string> = {
  Kimia: DEPT.kimia,
  "Ilmu Komputer": DEPT.ike,
  "Elektronika dan Instrumentasi": ACCENT.amber,
  Fisika: DEPT.fisika,
  Geofisika: ACCENT.crimson,
  Matematika: DEPT.matematika,
  Statistika: ACCENT.navy,
  "Ilmu Aktuaria": SEQ[250],
};
const programmeColor = (prodi: string) => programmeSeriesColor[prodi] ?? ACCENT.slate;
const publicationTotal = (publicationsRaw as any[]).reduce((sum, row) => sum + row.count, 0);
const publicationUnmapped = (publicationsRaw as any[]).filter((row) => row.department === "Belum terpetakan").reduce((sum, row) => sum + row.count, 0);
const publicationMappedShare = ((publicationTotal - publicationUnmapped) / publicationTotal) * 100;
const publicationFirstYear = publicationYears[0];
const publicationLastYear = publicationYears[publicationYears.length - 1];

/* Prominence is SciVal's worldwide measure of how fast a topic is moving, on a
   0-100 percentile. Shown beside the topic name so a large tile that is going
   nowhere reads differently from a small one on a rising field. */
const topicNodes: any[] = (topicsRaw as any[]).map((row) => ({ label: row.cluster, value: row.n, group: row.dept, color: deptColors[row.dept] ?? DEPT.unmapped, detail: row.prominence === null ? row.topic : `${row.topic} · prominensi ${format(row.prominence, 1)}` }));

/* ASJC subject areas arrive in English from SciVal; the report is Indonesian.
   Unlisted names fall through unchanged, the same contract as countryNameId. */
const subjectAreaId: Record<string, string> = {
  "Engineering": "Teknik",
  "Computer Science": "Ilmu Komputer",
  "Physics and Astronomy": "Fisika dan Astronomi",
  "Materials Science": "Ilmu Material",
  "Chemistry": "Kimia",
  "Mathematics": "Matematika",
  "Environmental Science": "Ilmu Lingkungan",
  "Chemical Engineering": "Teknik Kimia",
  "Biochemistry, Genetics and Molecular Biology": "Biokimia, Genetika, dan Biologi Molekuler",
  "Energy": "Energi",
  "Earth and Planetary Sciences": "Ilmu Kebumian dan Keplanetan",
  "Decision Sciences": "Ilmu Keputusan",
  "Medicine": "Kedokteran",
  "Agricultural and Biological Sciences": "Ilmu Pertanian dan Biologi",
  "Pharmacology, Toxicology and Pharmaceutics": "Farmakologi, Toksikologi, dan Farmasi",
  "Multidisciplinary": "Multidisiplin",
  "Social Sciences": "Ilmu Sosial",
  "Business, Management and Accounting": "Bisnis, Manajemen, dan Akuntansi",
  "Economics, Econometrics and Finance": "Ekonomi, Ekonometrika, dan Keuangan",
  "Health Professions": "Profesi Kesehatan",
  "Immunology and Microbiology": "Imunologi dan Mikrobiologi",
  "Dentistry": "Kedokteran Gigi",
  "Arts and Humanities": "Seni dan Humaniora",
  "Neuroscience": "Neurosains",
  "Psychology": "Psikologi",
  "Veterinary": "Kedokteran Hewan",
  "Nursing": "Keperawatan",
};

/* Field-Weighted Citation Impact is already normalised against the world average
   for the same field and year, so 1,00 is the reference line and the bars are
   read against it rather than against each other. */
/* Two decimals always, unlike the prose formatter: every bar is read against
   the 1,00 reference line, so the decimals have to line up. */
const fwciFormat = (value: number) => new Intl.NumberFormat("id-ID", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);
/* Same reason for the citations-per-publication annotation: a column of
   "7,7 / 6,4 / 9" reads as a typo where "9,0" reads as a value. */
const oneDecimal = (value: number) => new Intl.NumberFormat("id-ID", { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(value);
const researchQuality: any[] = (researchQualityRaw as any[]).slice(0, 12).map((row) => ({
  label: subjectAreaId[row.subject_area] ?? row.subject_area,
  value: row.fwci,
  valueLabel: fwciFormat(row.fwci),
  color: row.fwci >= 1 ? UGM_BLUE : ACCENT.slate,
  annotation: `${format(row.output)} publikasi · ${format(row.citations)} sitasi · ${oneDecimal(row.cpp)} sitasi/publikasi`,
}));
const researchQualityAbove = (researchQualityRaw as any[]).filter((row) => row.fwci >= 1).length;
const researchLead = [...researchQuality].sort((a, b) => b.value - a.value)[0];

const openAccessRoutes = ["Gold", "Hybrid gold", "Bronze", "Green", "Tertutup"];
/* Route names are colour words, so the fills have to agree with them: a series
   labelled "Green" drawn in blue reads as a mistake. The three publisher-side
   routes take the warm ramp in order of how permanent the access is, the
   repository route takes the one green in the palette, and paywalled takes the
   same grey the report uses for "not mapped" everywhere else. Patterns carry
   the distinction where hue alone would not, so the warm three stay separable
   for a reader who cannot tell them apart by colour. */
const openAccessSeries = [
  { key: "Gold", label: "Gold", color: ACCENT.amber, pattern: "solid" },
  { key: "Hybrid gold", label: "Hybrid gold", color: ACCENT.orange, pattern: "dots" },
  { key: "Bronze", label: "Bronze", color: ACCENT.crimson, pattern: "cross" },
  { key: "Green", label: "Green", color: ACCENT.teal, pattern: "diagonal" },
  { key: "Tertutup", label: "Tertutup (berbayar)", color: DEPT.unmapped, pattern: "solid" },
] as any;
const openAccess: any[] = publicationYears.map((year) => {
  const row: Record<string, any> = { year };
  openAccessRoutes.forEach((route) => { row[route] = 0; });
  (openAccessRaw as any[]).filter((item) => item.year === year).forEach((item) => { row[item.route] += item.n; });
  return row;
});
const openAccessOpenShare = (year: number) => {
  const row = openAccess.find((item) => item.year === year);
  if (!row) return 0;
  const total = openAccessRoutes.reduce((sum, route) => sum + row[route], 0);
  return total ? ((total - row["Tertutup"]) / total) * 100 : 0;
};

const openAccessGreenLatest = (openAccessRaw as any[]).find((row) => row.year === 2025 && row.route === "Green")?.n ?? 0;

const collabShare: any[] = collabShareRaw as any[];
const collabFrom = collabShare.find((row) => row.year === 2021) ?? collabShare[0];
const collabTo = collabShare.find((row) => row.year === 2025) ?? collabShare[collabShare.length - 1];

const countries: any[] = (countriesRaw as any[]).slice(0, 9).map((row) => ({ country: countryNameId(row.country), iso3: row.iso3, n: row.n }));

const positionsOrder = ["Asisten Ahli", "Lektor", "Lektor Kepala", "Guru Besar", "Belum terisi"];
const positionCounts = new Map<string, number>();
(lecturersRaw as any[]).forEach((row) => positionCounts.set(row.position, (positionCounts.get(row.position) ?? 0) + row.n));
const lecturerGroups: any[] = positionsOrder.map((position, index) => ({ label: position, count: positionCounts.get(position) ?? 0, color: [SEQ[250], DEPT.fisika, SEQ[550], SEQ[700], DEPT.unmapped][index] }));
const departmentCounts: Record<string, number> = {};
(lecturersRaw as any[]).forEach((row) => { departmentCounts[row.department] = (departmentCounts[row.department] ?? 0) + row.n; });
const professorCount = positionCounts.get("Guru Besar") ?? 0;
const sinta: any[] = (sintaRaw as any[]).map((row) => ({ label: row.dept ?? row.department, value: row.median, valueLabel: format(row.median), color: deptColors[row.dept ?? row.department], annotation: `${format(row.n)} dosen · total ${format(row.total)}` }));

const funding: any[] = (fundingRaw as any[]).filter((row) => row.type === "Total" && row.year >= 2019 && row.year <= 2025).map((row) => ({ year: row.year, amount: row.amount / 1_000_000_000 }));
const funding2024 = funding.find((row) => row.year === 2024)?.amount ?? 0;
const funding2025 = funding.find((row) => row.year === 2025)?.amount ?? 0;
const fundingChange = funding2024 > 0 ? (funding2025 / funding2024 - 1) * 100 : 0;

const outreachMap = new Map<string, any>();
const outreachUnmapped = new Map<number, number>();
for (const row of outreachRaw as any[]) {
  if (!row.year || row.year < 2021 || row.year > 2025) continue;
  const centroid = centroidForProvince(row.province);
  if (!centroid || row.location_status !== "recorded") {
    outreachUnmapped.set(row.year, (outreachUnmapped.get(row.year) ?? 0) + row.n);
    continue;
  }
  const key = `${row.year}|${row.province}`;
  const current = outreachMap.get(key) ?? { year: row.year, label: row.province, lat: centroid[0], lng: centroid[1], value: 0, detail: "Centroid provinsi pada batas GeoJSON" };
  current.value += row.n;
  outreachMap.set(key, current);
}
const outreachPoints: any[] = [
  ...outreachMap.values(),
  ...[...outreachUnmapped].map(([year, value]) => ({ year, label: "Lokasi belum dapat dipetakan", lat: Number.NaN, lng: Number.NaN, value, detail: "Lokasi kosong, daring, lintas provinsi, atau di luar Indonesia" })),
];
const outreachMapped = [...outreachMap.values()].reduce((sum, row) => sum + row.value, 0);
const outreachTotal = outreachMapped + [...outreachUnmapped.values()].reduce((sum, value) => sum + value, 0);

const sdgItems: any[] = (sdgRaw as any[]).map((row) => ({ sdg: row.sdg, label: row.label, values: { research: row.research_n, publication: row.publication_n }, note: row.research_n === 0 ? "Belum tercatat pada data riset" : undefined }));

const journalName: Record<string, string> = {
  "Indonesian Journal of Chemistry (IJC)": "Indonesian Journal of Chemistry",
  "Indonesian Journal of Computing and Cybernetics Systems (IJCCS)": "IJCCS",
  "Indonesian Journal of Electronics and Instrumentation Systems (IJEIS)": "IJEIS",
  "Jurnal Matematika Thales (JMT)": "Jurnal Matematika Thales",
};
const journalTotals = new Map<string, number>();
(journalsRaw as any[]).forEach((row) => journalTotals.set(row.journal, (journalTotals.get(row.journal) ?? 0) + row.n));
const journals: any[] = [...journalTotals].filter(([name]) => name !== "Belum terklasifikasi").map(([name, value]) => ({ label: journalName[name] ?? name, value, valueLabel: format(value) }));

const studentResearch: any[] = (studentResearchRaw as any[]).map((row) => ({ label: String(row.year), value: row.n, valueLabel: format(row.n), color: UGM_BLUE }));

/* --- Kerja sama (LENTERA 2021–2026) --- */
const partnershipYears = [...new Set((partnershipsRaw as any[]).map((row) => row.tahun))].sort((a, b) => a - b);
const partnerships: any[] = partnershipYears.map((year) => {
  const rows = (partnershipsRaw as any[]).filter((row) => row.tahun === year);
  return {
    year,
    domestik: rows.filter((row) => row.lingkup === "Domestik").reduce((sum, row) => sum + row.n, 0),
    internasional: rows.filter((row) => row.lingkup === "Internasional").reduce((sum, row) => sum + row.n, 0),
  };
});
const partnershipSeries = [
  { key: "domestik", label: "Mitra dalam negeri", color: ACCENT.navy, pattern: "solid" },
  { key: "internasional", label: "Mitra luar negeri", color: ACCENT.orange, pattern: "diagonal" },
] as any;
const partnershipCountries: any[] = (partnershipPartnersRaw as any).negara
  .filter((row: any) => row.lingkup === "Internasional")
  .map((row: any) => ({ name: row.negara, iso3: row.iso3, value: row.n }));
const partnershipKinds: any[] = (partnershipPartnersRaw as any).jenis_mitra
  .slice(0, 6)
  .map((row: any) => ({ label: row.jenis_mitra, value: row.n, valueLabel: format(row.n), color: ACCENT.navy }));
const partnershipPoints: any[] = (partnershipPointsRaw as any[]).flatMap((row) => {
  const centroid = centroidForProvince(row.provinsi);
  if (!centroid) return [];
  return [{ year: row.tahun, label: row.provinsi, lat: centroid[0], lng: centroid[1], value: row.n, detail: "Centroid provinsi alamat mitra" }];
});
const partnershipCoverage = partnershipCoverageRaw as { total: number; terpetakan: number; internasional: number; lokasi_kosong: number };
const partnershipInternationalCountries = (partnershipPartnersRaw as any).negara.filter((row: any) => row.lingkup === "Internasional").length;

/* --- Akademik --- */
const admissionYears = [...new Set((admissionsRaw as any[]).map((row) => row.tahun))].sort((a, b) => a - b);
const admissions: any[] = admissionYears.map((year) => {
  const rows = (admissionsRaw as any[]).filter((row) => row.tahun === year);
  return {
    year,
    peminat: rows.reduce((sum, row) => sum + row.peminat, 0),
    diterima: rows.reduce((sum, row) => sum + row.diterima, 0),
    registrasi: rows.reduce((sum, row) => sum + row.registrasi, 0),
  };
});
const admissionFirst = admissionYears[0];
const admissionLast = admissionYears[admissionYears.length - 1];
const admissionsAt = (year: number) => admissions.find((row) => row.year === year);
const admissionsOpen = admissionsAt(admissionFirst);
const admissionsClose = admissionsAt(admissionLast);

/* Selection funnel for the latest year. The two percentages have different
   denominators, so each annotation names its own — reading both as "percent of
   applicants" is the easiest mistake to make with a funnel. `dropLabel` names
   the people who leave at each step, so the chart can draw them rather than
   leaving them as the empty space around the shape. */
const admissionFunnel: any[] = [
  { label: "Peminat", value: admissionsClose?.peminat ?? 0, valueLabel: format(admissionsClose?.peminat ?? 0), annotation: "seluruh pelamar" },
  { label: "Diterima", value: admissionsClose?.diterima ?? 0, valueLabel: format(admissionsClose?.diterima ?? 0), annotation: `${format(((admissionsClose?.diterima ?? 0) / (admissionsClose?.peminat || 1)) * 100, 1)}% dari peminat`, dropLabel: "tidak diterima" },
  { label: "Registrasi", value: admissionsClose?.registrasi ?? 0, valueLabel: format(admissionsClose?.registrasi ?? 0), annotation: `${format(((admissionsClose?.registrasi ?? 0) / (admissionsClose?.diterima || 1)) * 100, 1)}% dari yang diterima`, dropLabel: "diterima tetapi tidak registrasi" },
];

/* Selectivity is a ratio, so it needs its own chart: it cannot appear on a plot
   of absolute levels where applicants outweigh seats twelve to one. */
const tightness: any[] = admissions.map((row) => ({
  year: row.year,
  rasio: row.diterima > 0 ? row.peminat / row.diterima : 0,
}));
const tightnessOpen = tightness[0]?.rasio ?? 0;
const tightnessClose = tightness[tightness.length - 1]?.rasio ?? 0;
const yieldOpen = admissionsOpen?.diterima ? (admissionsOpen.registrasi / admissionsOpen.diterima) * 100 : 0;
const yieldClose = admissionsClose?.diterima ? (admissionsClose.registrasi / admissionsClose.diterima) * 100 : 0;

/* One row per programme, each carrying the whole five-year path. */
const selectivityRows: any[] = [...new Set((admissionsRaw as any[]).map((row) => row.prodi))]
  .map((prodi) => {
    const at = (year: number) => (admissionsRaw as any[]).find((row) => row.prodi === prodi && row.tahun === year);
    const ratioOf = (row: any) => (row && row.diterima > 0 ? row.peminat / row.diterima : null);
    const label = String(prodi).replace(/^S1\s+/i, "");
    return {
      label,
      color: programmeColor(label),
      values: admissionYears.map((year) => ratioOf(at(year))),
      applicants: admissionYears.map((year) => at(year)?.peminat ?? null),
      seats: admissionYears.map((year) => at(year)?.diterima ?? null),
    };
  })
  .filter((row) => row.values.some((value: number | null) => value !== null))
  .sort((a, b) => (b.values.at(-1) ?? 0) - (a.values.at(-1) ?? 0));

/* Named here so the closing insight states what actually moved, rather than
   repeating a claim that the five-year series no longer supports. */
const selectivityFalling = [...selectivityRows]
  .filter((row) => row.values[0] !== null && row.values.at(-1) !== null)
  .sort((a, b) => (a.values.at(-1)! - a.values[0]!) - (b.values.at(-1)! - b.values[0]!));
const selectivitySteepest = selectivityFalling[0];
const selectivityRising = selectivityFalling.at(-1);
/* Largest fall in demand itself, which is a different programme from the
   largest fall in the ratio — the ratio also moves when seats are added. */
const selectivityShrinking = [...selectivityRows]
  .filter((row) => row.applicants[0])
  .sort((a, b) => (a.applicants.at(-1)! / a.applicants[0]!) - (b.applicants.at(-1)! / b.applicants[0]!))[0];
const activeStudentTotal = (activeStudentsRaw as any[]).reduce((sum, row) => sum + row.mahasiswa, 0);

const graduateLevels = ["Sarjana", "Magister", "Doktor"];
const graduateYears = [...new Set((graduatesRaw as any[]).map((row) => row.tahun))].sort((a, b) => a - b);
const graduates: any[] = graduateYears.map((year) => {
  const row: Record<string, any> = { year };
  graduateLevels.forEach((level) => {
    row[level.toLowerCase()] = (graduatesRaw as any[]).find((item) => item.tahun === year && item.jenjang === level)?.lulusan ?? 0;
  });
  return row;
});
const graduateSeries = [
  { key: "sarjana", label: "Sarjana", color: ACCENT.navy, pattern: "solid" },
  { key: "magister", label: "Magister", color: ACCENT.teal, pattern: "dots" },
