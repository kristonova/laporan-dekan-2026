---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
import snapshotRaw from "../data/derived/snapshot.json";
import tckRaw from "../data/derived/tck_2026_joined.json";
import partnershipCoverageRaw from "../data/derived/partnership_coverage.json";
import tracerSummaryRaw from "../data/derived/tracer_summary.json";
import hpuYearlyRaw from "../data/derived/hpu_posbindu_tahunan.json";
import origins from "../data/derived/students_origins.json";
import studentSummaryRaw from "../data/derived/students_summary.json";
import studentAccessRaw from "../data/derived/students_access.json";
import studentBackgroundRaw from "../data/derived/students_background.json";
import institutionRaw from "../data/derived/institution_snapshot.json";
import lecturerPositionsRaw from "../data/derived/lecturers_positions.json";

const snapshot = snapshotRaw as { label: string; p2m: string; lentera: string };
const tck = tckRaw as any[];
const flagged = tck.filter((row) => row.anomali);
const partnershipCoverage = partnershipCoverageRaw as { total: number; terpetakan: number; internasional: number; lokasi_kosong: number };
const tracerSummary = tracerSummaryRaw as { responden: number; tahun: number[] };
const hpuYear = hpuYearlyRaw as { lapisan: { kunci: string; kunjungan: number }[]; tahun: number[] };
const students = studentSummaryRaw as any;
const studentAccess = studentAccessRaw as any;
const studentBackground = studentBackgroundRaw as any;
const institution = institutionRaw as any;
const professorTotal = (lecturerPositionsRaw as any[])
  .filter((row) => row.position === "Guru Besar")
  .reduce((total, row) => total + row.n, 0);
const number = (value: number, digits = 0) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);

const datasets = [
  { file: "students_origins.json", label: "Asal pendidikan S1, S2, S3, dan non-gelar", coverage: `${number(origins.total)} rekaman · angkatan 2021–2026 · ${origins.tanggal}`, source: origins.sumber, scenes: "6.1, 6.6" },
  { file: "students_origins_cohorts.json", label: "Cakupan per jenjang dan angkatan", coverage: "Angkatan × S1/S2/S3/non-gelar", source: origins.sumber, scenes: "6.1" },
  { file: "students_origins_programmes.json", label: "Program studi semua jenjang", coverage: "Angkatan × jenjang × program studi", source: origins.sumber, scenes: "6.1" },
  { file: "students_programme_trends.json", label: "Tren komposisi program studi S1, S2, S3, dan non-gelar", coverage: "Angkatan 2021–2026 menurut jenjang dan program studi; kelas reguler dan IUP digabung per prodi", source: "S1/non-gelar: pangkalan data mahasiswa; S2/S3: Data Asal Sekolah dan Perguruan Tinggi FMIPA 2021–2026", scenes: "6.1" },
  { file: "students_programme_trends_meta.json", label: "Cakupan dan penyebut proporsi program studi", coverage: "Total per angkatan dan jenjang, sumber data, serta kaidah konsolidasi", source: "Pangkalan data mahasiswa dan basis data asal pendidikan lintas jenjang", scenes: "6.1" },
  { file: "students_origins_institutions.json", label: "Sekolah dan universitas asal", coverage: "Jenjang, riwayat pendidikan sebelumnya, angkatan, dan institusi asal; kode angkatan 0 mewakili agregat gabungan tanpa penghitungan ulang", source: origins.sumber, scenes: "6.6" },
  { file: "students_ipk_distribution.json", label: "Ringkasan IPK S1 per program studi", coverage: "Angkatan 2021–2025 · jumlah mahasiswa, median, P25, P75, serta rentang whisker 1,5 IQR", source: "Pangkalan data mahasiswa S1 FMIPA UGM", scenes: "6.7" },
  { file: "tck_2026_joined.json", label: "Indikator TCK 2026", coverage: "42 indikator · target TW1–TW4 · capaian TW1–TW3", source: "TCK 2026 (berkas resmi XLSX)", scenes: "1.2, 2.6, 3.6, 4.3–4.5, 5.1–5.2, 7.1" },
  { file: "citations_by_year.json", label: "Sitasi per tahun", coverage: "1987–2025 · 70.905 sitasi sepanjang riwayat", source: "Basis data historis FMIPA UGM", scenes: "0.0, 2.1" },
  { file: "publications_by_year_dept.json", label: "Publikasi per departemen", coverage: "2020–2026 · 3.069 publikasi · 2026 tahun berjalan", source: "SciVal / Scopus", scenes: "2.2" },
  { file: "research_quality.json", label: "Mutu sitasi per bidang ilmu", coverage: "27 bidang ASJC · FWCI, sitasi, dan jumlah peneliti", source: "SciVal / Scopus", scenes: "2.2p" },
  { file: "topics.json", label: "Klaster topik riset", coverage: "541 klaster SciVal · dilengkapi persentil prominensi", source: "SciVal", scenes: "2.3" },
  { file: "collab_countries.json", label: "Kolaborasi negara", coverage: "62 negara mitra internasional", source: "SciVal / Scopus", scenes: "2.4" },
  { file: "collab_share.json", label: "Porsi kolaborasi internasional", coverage: "2020–2026 · publikasi dengan sedikitnya satu mitra luar negeri", source: "SciVal / Scopus", scenes: "2.4" },
  { file: "open_access.json", label: "Jalur akses terbuka", coverage: "2020–2026 · gold, hybrid gold, bronze, green, dan tertutup", source: "SciVal / Scopus", scenes: "2.4p" },
  { file: "world-countries.geojson", label: "Batas negara dunia", coverage: "177 negara/teritori · Natural Earth 1:110m · WGS 84", source: "Natural Earth · domain publik", scenes: "2.4" },
  { file: "lecturers_positions.json", label: "Jabatan fungsional dosen", coverage: `${number(institution.lecturers)} dosen terverifikasi`, source: "TCK 2026 (SIMASTER) dan basis data kepegawaian", scenes: "2.5, 5.1" },
  { file: "sinta_by_dept.json", label: "Skor SINTA per departemen", coverage: "Pemutakhiran per 3 Desember 2025", source: "SINTA Kemendikbudristek", scenes: "2.6" },
  { file: "funding_by_year.json", label: "Dana riset per tahun", coverage: "2019–2025", source: "Pangkalan data riset FMIPA UGM", scenes: "3.1" },
  { file: "outreach_points.json", label: "Jangkauan pengabdian", coverage: "2021–2026 · sebaran lokasi teragregasi", source: "Surat Tugas / SIMPEL / Hibah", scenes: "3.2" },
  { file: "indonesia-provinces.geojson", label: "Batas provinsi Indonesia", coverage: "38 provinsi · geometri teroptimasi untuk web", source: "Peta Nusa / Laravel Nusa · Lisensi MIT", scenes: "3.2" },
  { file: "sdg_matrix.json", label: "Matriks SDG", coverage: "17 tujuan · taksonomi SDG (2025)", source: "Pangkalan data riset + SciVal", scenes: "3.3" },
  { file: "journals.json", label: "Jurnal terbitan FMIPA", coverage: "462 rekaman · 461 terklasifikasi", source: "Pangkalan data jurnal internal", scenes: "3.4" },
  { file: "value_model.json", label: "Model nilai FMIPA", coverage: "Agregat 2021–2025", source: "Analisis sintesis lintas data", scenes: "1.3" },
  { file: "snapshot.json", label: "Tanggal penarikan data", coverage: "Label tanggal rujukan tunggal untuk seluruh halaman", source: "Konstanta pemrosesan data", scenes: "seluruh halaman" },
  { file: "tck_2026_by_dept.json", label: "TCK per departemen", coverage: "30 indikator dengan rincian DIKE/DF/DM/DK", source: "TCK 2026 (berkas resmi XLSX)", scenes: "1.2" },
  { file: "partnerships_by_year.json", label: "Kerja sama per tahun", coverage: "2021–2026 · kemitraan nasional dan internasional", source: "LENTERA UGM", scenes: "3.5" },
  { file: "partnership_partners.json", label: "Profil mitra kerja sama", coverage: "Negara asal dan kategori instansi mitra", source: "LENTERA UGM", scenes: "3.5" },
  { file: "partnership_points.json", label: "Sebaran provinsi mitra", coverage: "Agregat mitra per provinsi dan tahun", source: "LENTERA UGM", scenes: "3.5" },
  { file: "admissions_by_year.json", label: "Penerimaan mahasiswa baru", coverage: "2022–2026 · peminat, diterima, dan registrasi ulang", source: "Pangkalan data akademik FMIPA UGM", scenes: "4.6" },
  { file: "active_students.json", label: "Mahasiswa sarjana aktif", coverage: "Per prodi dan angkatan 2017–2025", source: "Pangkalan data akademik FMIPA UGM", scenes: "1.1" },
  { file: "graduates_profile.json", label: "Profil lulusan", coverage: "Sarjana, Magister, Doktor · IPK dan masa studi", source: "Pangkalan data akademik FMIPA UGM", scenes: "4.7" },
  { file: "student_achievements.json", label: "Prestasi mahasiswa", coverage: "2022–2026 · departemen × tingkat prestasi", source: "Pangkalan data kemahasiswaan FMIPA UGM", scenes: "4.7" },
  { file: "scholarships.json", label: "Penerima beasiswa", coverage: "Agregat per program studi dan skema beasiswa", source: "Pangkalan data akademik FMIPA UGM", scenes: "4.6" },
  { file: "accreditation.json", label: "Status akreditasi prodi", coverage: "18 prodi nasional · 15 akreditasi/sertifikasi internasional", source: "Pangkalan data akademik FMIPA UGM", scenes: "1.1" },
  { file: "tracer_sectors.json", label: "Sektor karier lulusan", coverage: "Agregat sektor lapangan kerja dari survei pelacakan lulusan", source: "Tracer study FMIPA UGM", scenes: "4.1" },
  { file: "tracer_waiting_time.json", label: "Masa tunggu kerja", coverage: "Distribusi kategori masa tunggu per program studi", source: "Tracer study FMIPA UGM", scenes: "4.2" },
  { file: "exchange_students.json", label: "Mobilitas mahasiswa internasional", coverage: "64 mahasiswa · 33 universitas mitra tujuan", source: "Pangkalan data mobilitas FMIPA UGM", scenes: "4.4" },
  { file: "graduates_by_programme.json", label: "Lulusan per program studi", coverage: "Rincian jenjang, prodi, dan tahun kelulusan", source: "Pangkalan data akademik FMIPA UGM", scenes: "4.7" },
  { file: "partnership_coverage.json", label: "Cakupan data kerja sama", coverage: "Ringkasan pemetaan wilayah instansi mitra", source: "LENTERA UGM", scenes: "3.5, 7.1" },
  { file: "tracer_summary.json", label: "Ringkasan tracer study", coverage: "Median, rata-rata, dan tingkat keterserapan kerja dalam 6 bulan", source: "Tracer study FMIPA UGM", scenes: "4.1, 4.2" },
  { file: "hpu_posbindu.json", label: "Health Promoting University", coverage: "Agregat anonim dosen dan tendik pada 5 sesi Posbindu 2026", source: "Posbindu Melati FMIPA UGM", scenes: "5.3" },
  { file: "hpu_posbindu_tahunan.json", label: "Health Promoting University 2022–2026", coverage: `Agregat anonim tahunan dari ${number(hpuYear.lapisan[1]?.kunjungan ?? 0)} kunjungan lima tahun`, source: "Digitalisasi arsip fisik, registri Posbindu, dan rekapitulasi 2026", scenes: "5.3" },
  { file: "students_summary.json", label: "Profil S1 dan non-gelar (basis data awal)", coverage: `${number(students.total)} mahasiswa · angkatan ${students.tahun_awal}–${students.tahun_akhir}`, source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.1–6.7" },
  { file: "students_by_programme.json", label: "Mahasiswa per program studi", coverage: "Angkatan × jenjang × departemen × prodi, beserta komposisi gender", source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.1, 6.3" },
  { file: "students_by_province.json", label: "Provinsi asal mahasiswa", coverage: `Angkatan × provinsi berstandar BPS · ${number(studentAccess.kabupaten_unik)} kabupaten/kota tercatat`, source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.2" },
  { file: "students_by_pathway.json", label: "Jalur masuk mahasiswa", coverage: "Angkatan dan jalur masuk; nomenklatur SNMPTN/SBMPTN diselaraskan ke SNBP/SNBT", source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.4" },
  { file: "students_background.json", label: "Latar belakang keluarga dan sekolah", coverage: `Pekerjaan orang tua/wali (11 kelompok), agama, dan ${number(studentBackground.sekolah_unik)} sekolah asal (2023–2026)`, source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.5, 6.6" },
  { file: "students_cohort_outcome.json", label: "Status kelulusan per angkatan", coverage: "Proporsi lulus, aktif, mengundurkan diri, dan non-aktif per angkatan", source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.7" },
  { file: "students_ipk.json", label: "Sebaran IPK sarjana per angkatan", coverage: "Distribusi IPK teranonimkan per prodi dan angkatan (2021–2025), dilengkapi rata-rata, median, kuartil, serta agregat keseluruhan", source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.7" },
  { file: "students_access.json", label: "Pemerataan dan keterjangkauan akses", coverage: "Sebaran asal Jawa vs luar Jawa, representasi provinsi, serta mahasiswa asal daerah 3T", source: "Pangkalan data mahasiswa FMIPA UGM", scenes: "6.2" },
];

const gaps = [
  { priority: "P0", item: "Penyebut indikator persentase #5b dan #8b1–8b3", reason: "Kolom capaian TW3 hanya memuat jumlah mahasiswa tanpa angka penyebut populasi, sehingga persentase capaian TW3 belum dapat dihitung secara valid", owner: "Bagian Perencanaan FMIPA" },
  { priority: "P0", item: "Klarifikasi indikator #32", reason: "Indeks kenaikan nilai bangunan hijau tercatat negatif pada dokumen sumber dan memerlukan konfirmasi teknis", owner: "Bagian Perencanaan / Direktorat Aset" },
  { priority: "P1", item: "Digitalisasi arsip Posbindu September–Desember", reason: "Buku registrasi mencatat adanya sesi pemeriksaan pada September–Desember kurun 2023–2025, namun lembar fisiknya belum didigitalisasi sehingga riwayat pada rentang tersebut baru terekam pada tingkat agregat bulanan", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P1", item: "Kategori peserta Posbindu 2026", reason: "Sebanyak 257 dari 391 kunjungan pada 2026 tidak mencantumkan status kepesertaan, sehingga penghitungan baru dapat dilakukan pada agregat populasi umum", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P2", item: "Informasi gender peserta Posbindu 2022–2024", reason: "Berkas digital belum memuat kolom jenis kelamin. Karena ambang batas medis untuk lingkar perut dan asam urat berbeda antara pria dan wanita, sebagian kunjungan tercatat sebagai data terukur namun belum dapat diklasifikasikan status risikonya", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P2", item: "Tindak lanjut dan rujukan Posbindu", reason: "Informasi rujukan medis baru tercatat pada 34 dari 391 kunjungan 2026, sehingga kesinambungan dari temuan berisiko menuju rujukan klinis belum dapat dievaluasi menyeluruh", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P1", item: "Data K3L dan pencegahan kekerasan seksual", reason: "Meskipun kegiatan edukasi dan penanganan telah berjalan aktif bersama Satgas PPKS dan Tim K3L, pencatatan rekam jejaknya belum dihimpun dalam format data terstruktur", owner: "Satgas PPKS / Tim K3L FMIPA" },
  { priority: "P1", item: "Kelengkapan wilayah mitra kerja sama", reason: "Sebagian berkas naskah kerja sama di LENTERA belum melengkapi atribut wilayah (kabupaten/kota dan provinsi) instansi mitra", owner: "Unit Kerja Sama FMIPA" },
  { priority: "P2", item: "Tracer study per angkatan dan wilayah kerja", reason: "Survei penelusuran yang tersedia mencakup lulusan 2024–2025, namun belum mengintegrasikan variabel sebaran geografis tempat kerja", owner: "DPKM / CDC UGM" },
  { priority: "P2", item: "Rekam jejak paparan media 2021–2022", reason: "Pencatatan metrik eksposur media baru dimulai secara terstruktur sejak 2023", owner: "Humas FMIPA" },
  { priority: "P2", item: "Wilayah sekolah dan perguruan tinggi asal", reason: "Pangkalan data per 2 September telah memuat nama sekolah asal mahasiswa S1 (angkatan 2021–2026), namun belum mencantumkan provinsi asal sekolah maupun perguruan tinggi jenjang sebelumnya. Guna menjaga validitas, wilayah tidak diasumsikan semata-mata dari penamaan institusi.", owner: "Bagian Akademik FMIPA / DAA UGM" },
  { priority: "P2", item: "Status beasiswa per mahasiswa", reason: "Atribut beasiswa/kerja sama pada berkas induk mahasiswa belum terisi, sehingga penerima beasiswa belum dapat dipadankan langsung ke profil per angkatan", owner: "Bagian Kemahasiswaan FMIPA" },
];

const conflictRow = (no: string) => {
  const row = tck.find((item) => String(item.no) === no);
  return row ? number(row.capaian_dinilai, row.satuan === "Miliar Rupiah" ? 2 : 0) : "—";
};
const conflicts = [
  { metric: "Cakupan mahasiswa pada dua sumber", tck: `${number(origins.total)} rekaman (asal pendidikan)`, historical: `${number(students.total)} rekaman (pangkalan data mahasiswa)`, explanation: `Basis data per ${origins.tanggal} mencakup ${number(origins.per_jenjang.S1)} mahasiswa S1, ${number(origins.per_jenjang.S2)} S2, ${number(origins.per_jenjang.S3)} S3, dan ${number(origins.per_jenjang.NONDEGREE)} program non-gelar. Sementara itu, pangkalan data mahasiswa awal mencatat ${number(students.sarjana)} mahasiswa S1 beserta non-gelar. Kedua sumber dikelola terpisah dan tidak dipadankan pada tingkat individu. Untuk visualisasi tren program studi, data S1 dan non-gelar bersumber murni dari pangkalan data mahasiswa, sedangkan jenjang S2 dan S3 bersumber dari basis data asal pendidikan terpadu, sehingga tidak terjadi penghitungan ganda. Angka ini mencerminkan rekaman per angkatan saat masuk, bukan jumlah mahasiswa aktif terdaftar saat ini maupun individu unik lintas jenjang.` },
  { metric: "Guru Besar", tck: conflictRow("30"), historical: `${number(professorTotal)} (setelah rekonsiliasi)`, explanation: "Sebelumnya, pangkalan data kepegawaian fakultas mencatat 42 Guru Besar karena riwayat jabatan fungsional belum dimutakhirkan kembali sejak Januari 2026. Rincian nama pada indikator TCK #30 kini dijadikan rujukan utama, lalu diselaraskan ke basis data kepegawaian melalui NIDN dan NIP sehingga jumlahnya kini sinkron. Satu orang Guru Besar yang sebelumnya ada di data fakultas kini telah purna tugas dan tidak lagi terdaftar aktif di SIMASTER." },
  { metric: "Dosen berkualifikasi S3", tck: conflictRow("24"), historical: `${number(institution.lecturer_doctoral)} dari ${number(institution.lecturers)} dosen`, explanation: `Indikator TCK #24 mencatat 160 dosen berpendidikan doktor (S3). Dari jumlah tersebut, sebanyak ${number(institution.lecturer_doctoral)} dosen telah teridentifikasi dan cocok dengan basis data kepegawaian fakultas. Adapun sisanya belum terdata dalam catatan internal fakultas sehingga jabatan fungsionalnya belum dapat dipastikan. Demi menjaga akurasi profil, nama-nama yang belum terverifikasi tidak dimasukkan ke dalam diagram sebaran jabatan. Oleh karena itu, jumlah ${number(institution.lecturers)} dosen pada grafik merupakan angka minimum terverifikasi, bukan hasil sensus kepegawaian menyeluruh.` },
  { metric: "Sitasi", tck: conflictRow("15"), historical: "12.629 (2024)", explanation: "Indikator TCK menghitung perolehan sitasi pada tahun anggaran berjalan, sedangkan basis data Scopus menghitung seluruh sitasi yang diterima pada tahun tersebut atas seluruh publikasi ilmiah yang pernah dihasilkan FMIPA UGM." },
  { metric: "Publikasi terindeks", tck: conflictRow("16"), historical: "539 (2025)", explanation: "Perbedaan timbul akibat waktu penarikan data (cut-off) dan cakupan jenis dokumen. Jumlah publikasi tahun 2025 disesuaikan dari 481 menjadi 539 setelah pemutakhiran data SciVal per 30 Agustus 2026 melengkapi indeksasi karya ilmiah pada periode tersebut." },
  { metric: "Publikasi 2020–2025 pada dua sumber", tck: "3.069 (SciVal, 2020–2026)", historical: "2.726 (arsip P2M, 2020–2025)", explanation: "Ekstraksi data SciVal per 30 Agustus 2026 mencakup 457 publikasi baru yang belum tercatat pada basis data P2M (368 di antaranya terbit pada 2026). Di saat bersamaan, 113 publikasi kurun 2020–2025 tidak lagi masuk ke dalam perimeter entitas FMIPA UGM menurut pemutakhiran SciVal (108 di antaranya sebelumnya memang belum terpetakan ke departemen). Laporan ini menetapkan SciVal sebagai rujukan utama indeksasi internasional, sehingga data publikasi 2020–2024 sedikit disesuaikan dibandingkan laporan terdahulu." },
  { metric: "Program studi terakreditasi Unggul/A", tck: conflictRow("3"), historical: "15 dari 18 prodi", explanation: "Kedua sistem mencatat data yang konsisten, yakni 15 dari 18 program studi sarjana dan pascasarjana telah meraih peringkat akreditasi nasional Unggul atau A." },
  { metric: "Registrasi mahasiswa baru 2025", tck: "808 (PROFIL MABA)", historical: "812 (pangkalan data mahasiswa)", explanation: "Kedua sistem mencatat jumlah yang identik pada angkatan 2022, 2023, 2024, dan 2026. Selisih empat mahasiswa pada 2025 murni disebabkan oleh perbedaan waktu pemutakhiran (cut-off) data registrasi akhir." },
  { metric: "Sesi Posbindu Januari 2026", tck: "Lembar “Jan 26”", historical: "Salinan lembar “Juli 26”", explanation: "Lembar laporan bulanan berlabel Januari ternyata berisi salinan identik dari data pemeriksaan 3 Juli 2026. Hasil pemeriksaan sesi 30 Januari yang autentik tersimpan pada lembar rekapitulasi terpadu dan dipulihkan dari sana, sedangkan salinan ganda disisihkan agar tidak menambah jumlah sesi secara keliru." },
  { metric: "Pemeriksaan 3 Juli 2026", tck: "Lembar rekapitulasi terpadu", historical: "Lembar bulanan “Juli 26”", explanation: "Pada berkas rekapitulasi terpadu, ketiadaan kolom interpretasi asam urat menyebabkan data pada 68 dari 70 baris bergeser satu kolom ke kiri. Data yang valid dipulihkan menggunakan lembar bulanan yang lengkap. Sementara itu, data untuk sesi Februari, Mei, dan Agustus terverifikasi cocok 100% pada kedua sumber." },
  { metric: "Rekap pemeriksaan 2024", tck: "Rekap_Pemeriksaan_Kesehatan_2024", historical: "Rekap_Digitasi_2022_2024", explanation: "Kedua berkas digital memuat 240 catatan yang identik tanpa selisih nilai apa pun. Oleh karena itu, salah satu berkas diposisikan sebagai arsip cadangan agar riwayat pemeriksaan tahun 2024 tidak terhitung ganda." },
  { metric: "Kerja sama aktif", tck: conflictRow("1a"), historical: `${number(partnershipCoverage.total)} dokumen (2021–2026)`, explanation: "Indikator TCK SIMASTER mencatat dokumen kemitraan yang aktif berjalan pada tahun anggaran 2026, sedangkan sistem LENTERA UGM merekam seluruh naskah kerja sama yang terjalin sepanjang periode 2021–2026." },
];
const homeUrl = withBase("/");
const tckCsvUrl = withBase("/data/tck_2026_indikator.csv");
const datasetUrl = (file: string) => withBase(`/data/${file}`);
const motifStyle = `background-image: url(${JSON.stringify(withBase("/brand/supergraphic-lines.png"))})`;
---

<BaseLayout
  title="Data & Metodologi — Lima Tahun FMIPA"
  description="Sumber data resmi, definisi operasional metrik, harmonisasi perbedaan angka, serta prosedur validasi data Laporan Dekan FMIPA UGM 2021–2026."
  canonicalPath="/data"
>
  <main id="konten-utama">
    <header class="data-hero">
      <div class="data-hero__motif" aria-hidden="true" style={motifStyle}></div>
      <div class="data-hero__inner">
        <p class="data-hero__eyebrow">Transparansi &amp; Akuntabilitas</p>
        <h1>Data &amp; Metodologi</h1>
        <p>Setiap angka dan visualisasi dalam laporan ini dapat ditelusuri langsung ke sumber data resmi, definisi operasional, serta metodologi pengolahannya. Penyelarasan angka antarsistem institusi disajikan secara transparan, objektif, dan bertanggung jawab.</p>
        <a href={homeUrl}>← Kembali ke laporan utama</a>
      </div>
    </header>

    <nav class="data-nav" aria-label="Bagian halaman data">
      <a href="#aturan-sumber">Prinsip Sumber</a>
      <a href="#dataset">Dataset Terbuka</a>
      <a href="#definisi">Definisi Metrik</a>
      <a href="#konflik">Harmonisasi Data</a>
      <a href="#kualitas">Validasi Data</a>
      <a href="#anomali">Catatan Kualitas Data</a>
      <a href="#gap">Agenda Penguatan Data</a>
    </nav>

    <section class="data-section" id="aturan-sumber">
      <div class="data-section__intro">
        <p class="eyebrow">Prinsip Integritas Data</p>
        <h2>Pemisahan Sumber Berdasarkan Konteks</h2>
        <p>Data capaian kinerja tahunan (TCK SIMASTER) dan data rekam jejak tridharma historis memiliki cakupan serta metodologi penghitungan yang berbeda. Pemisahan penyajian ini menjaga ketepatan evaluasi dan mencegah kerancuan interpretasi tren institusi.</p>
      </div>
      <div class="source-split">
        <article>
          <p class="source-split__label">Bagian I · Capaian Kinerja 2026</p>
          <h3>TCK 2026 — SIMASTER UGM</h3>
          <strong>{tck.length} indikator</strong>
          <p>Target kumulatif TW1–TW4 dan realisasi capaian berjalan TW1–TW3 yang dibaca langsung dari berkas resmi <code>TCK 2026.xlsx</code> per {snapshot.label}.</p>
          <a href={tckCsvUrl} download>Unduh CSV Indikator</a>
        </article>
        <div class="source-split__divider" aria-label="Tidak dicampur"><span>≠</span><small>terpisah</small></div>
        <article>
          <p class="source-split__label">Bagian II · Rekam Jejak 2021–2026</p>
          <h3>Data Historis FMIPA UGM</h3>
          <strong>25 berkas sumber</strong>
          <p>Publikasi Scopus, sitasi, perolehan dana riset, kegiatan Pengabdian kepada Masyarakat (PkM), SDM, dan luaran institusi per {snapshot.p2m}.</p>
          <a href="#dataset">Lihat dataset turunan</a>
        </article>
        <div class="source-split__divider" aria-label="Ditambahkan"><span>+</span><small>baru</small></div>
        <article>
          <p class="source-split__label">Bagian II · Sumber Baru 2026</p>
          <h3>Kerja Sama, Akademik, dan Kesehatan</h3>
          <strong>{number(partnershipCoverage.total)} dokumen kerja sama</strong>
          <p>Data kemitraan LENTERA UGM per {snapshot.lentera}, survei penelusuran lulusan (tracer study) terhadap {number(tracerSummary.responden)} responden angkatan {tracerSummary.tahun.join(" dan ")}, serta {number(hpuYear.lapisan.find((row) => row.kunci === "staf")?.kunjungan ?? 0)} pemeriksaan kesehatan Posbindu HPU untuk dosen dan tenaga kependidikan sepanjang {hpuYear.tahun[0]}–{hpuYear.tahun[hpuYear.tahun.length - 1]}—seluruhnya disajikan dalam bentuk agregat anonim.</p>
          <a href="#dataset">Lihat dataset turunan</a>
        </article>
      </div>
    </section>

    <section class="data-section data-section--paper" id="dataset">
      <div class="data-section__intro">
        <p class="eyebrow">Dataset Terbuka</p>
        <h2>Dataset Agregat Siap Pakai</h2>
        <p>Seluruh data yang disajikan merupakan hasil agregasi resmi tingkat fakultas dan departemen. Data privasi individu (NIP/NIM/Nama) dianonimkan sesuai prinsip perlindungan data pribadi.</p>
      </div>
      <div class="dataset-list">
        {datasets.map((dataset) => (
          <article class="dataset-row">
            <div>
              <h3>{dataset.label}</h3>
              <code>{dataset.file}</code>
            </div>
            <p>{dataset.coverage}</p>
            <p><span>Sumber data</span>{dataset.source}</p>
            <p><span>Bagian/Scene</span>{dataset.scenes}</p>
            <a href={datasetUrl(dataset.file)} download aria-label={`Unduh ${dataset.label}`}>{dataset.file.endsWith(".geojson") ? "GeoJSON ↓" : "JSON ↓"}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="data-section" id="definisi">
      <div class="data-section__intro">
        <p class="eyebrow">Glosarium &amp; Kamus Indikator</p>
        <h2>Definisi Operasional Metrik</h2>
        <p>Penjelasan rinci mengenai satuan, batasan waktu, dan kaidah perhitungan tiap indikator agar interpretasi data konsisten dan akurat.</p>
      </div>
      <dl class="definition-grid">
        <div><dt>Sitasi</dt><dd>Jumlah sitasi tahunan yang tercatat pada pangkalan data Scopus untuk seluruh artikel berafiliasi FMIPA UGM pada tahun bersangkutan.</dd></div>
        <div><dt>Publikasi Ilmiah</dt><dd>Seluruh artikel ilmiah terindeks Scopus/SciVal berafiliasi FMIPA UGM untuk semua jenis dokumen akademik.</dd></div>
        <div><dt>Dana Riset</dt><dd>Akumulasi nilai pendanaan riset (<code>total_funding</code>) berdasarkan tahun disetujuinya proposal dari berbagai skema hibah kompetitif dan kerja sama riset.</dd></div>
        <div><dt>Pengabdian (PkM)</dt><dd>Jumlah kegiatan pengabdian resmi yang terlaksana berdasarkan Surat Tugas, sistem SIMPEL, atau hibah fakultas/universitas.</dd></div>
        <div><dt>Capaian TCK</dt><dd>Realisasi kinerja kumulatif yang dicapai sejak awal tahun anggaran hingga tanggal penarikan data berjalan.</dd></div>
        <div><dt>Target TCK</dt><dd>Target kinerja kumulatif triwulanan. Target Triwulan IV mencerminkan target tahunan fakultas secara utuh.</dd></div>
        <div><dt>Status Tercapai</dt><dd>Kondisi ketika realisasi capaian memenuhi atau melampaui target triwulan berjalan sesuai arah indikator kinerja.</dd></div>
        <div><dt>Data Berjalan</dt><dd>Data tahun 2025 yang masih dalam proses pemutakhiran berkala di pangkalan data global (Scopus) dan akan terus bertambah seiring waktu.</dd></div>
        <div><dt>Kategori Status Capaian</dt><dd>Rasio capaian terhadap target triwulan dikelompokkan ke dalam empat status: <strong>≥100% Tercapai</strong>, <strong>≥85% Mendekati Target</strong>, <strong>≥50% Perlu Akselerasi</strong>, dan <strong>&lt;50% Belum Tercapai</strong>. Khusus indikator bertipe efisiensi (target nilai yang semakin menurun semakin baik), evaluasi dibalik sehingga capaian yang lebih rendah merefleksikan kinerja lebih optimal.</dd></div>
        <div><dt>Triwulan Evaluasi Valid</dt><dd>Triwulan evaluasi kinerja merujuk pada triwulan terakhir yang memiliki kelengkapan data capaian dan target secara metodologis. Sebanyak empat indikator bertipe persentase dievaluasi berdasarkan Triwulan II karena pelaporan Triwulan III baru mencatat jumlah orang tanpa menyertakan angka penyebut populasi.</dd></div>
        <div><dt>Penyelarasan Jabatan Fungsional Dosen</dt><dd>Komposisi jabatan fungsional disusun melalui rekonsiliasi dua pangkalan data. Jenjang Guru Besar dan Tenaga Pengajar mengacu pada rincian indikator TCK 2026 (SIMASTER) per 31 Agustus 2026 sebagai sumber paling mutakhir. Jenjang Asisten Ahli, Lektor, dan Lektor Kepala merujuk pada catatan kepegawaian fakultas per 27 Januari 2026. Pemadanan dilakukan bertingkat berbasis NIDN, NIP, serta normalisasi nama dosen. Seluruh Guru Besar terverifikasi padan, sementara dosen yang tidak lagi aktif di SIMASTER diklasifikasikan purna tugas.</dd></div>
        <div><dt>Jumlah Minimum Dosen Terverifikasi</dt><dd>Angka {number(institution.lecturers)} dosen merupakan jumlah minimum yang terverifikasi lengkap, bukan hasil sensus kepegawaian menyeluruh. Beberapa dosen yang tercantum dalam capaian TCK #24 belum terlacak pada pangkalan data internal fakultas sehingga jabatan fungsionalnya belum dapat dipastikan. Untuk menjaga validitas visualisasi, data yang belum lengkap tidak diikutsertakan dalam diagram komposisi jabatan, dan selisihnya diuraikan terbuka pada tabel harmonisasi.</dd></div>
        <div><dt>Cakupan Data Tenaga Kependidikan</dt><dd>Jumlah tenaga kependidikan merujuk pada basis data kepegawaian internal fakultas. Terdapat perbedaan dengan Laporan Dekan 2025 yang mencatat 129 orang per 1 Agustus 2025, yang diperkirakan timbul akibat perbedaan perlakuan terhadap pegawai kontrak dan non-ASN. Angka disajikan sesuai catatan resmi yang ada.</dd></div>
        <div><dt>Masa Tunggu Kerja</dt><dd>Rentang waktu (dalam bulan) antara tanggal resmi kelulusan dan tanggal mulai bekerja berdasarkan survei penelusuran lulusan (tracer study). Nilai negatif menunjukkan bahwa responden telah diterima bekerja sebelum resmi diwisuda.</dd></div>
        <div><dt>Pita Risiko Kesehatan</dt><dd>Hasil pemeriksaan kesehatan dikelompokkan ke dalam tiga pita risiko medis—Normal, Waspada, dan Berisiko—merujuk pedoman klinis terstandar demi memudahkan interpretasi kesehatan sivitas tanpa menghilangkan rincian data aslinya.</dd></div>
        <div><dt>Standardisasi Ambang Klinis Retrospektif</dt><dd>Arsip data pemeriksaan 2022–2025 merekam nilai numerik hasil tes laboratorium, sedangkan dokumen 2026 memuat nilai numerik beserta kategori interpretasi klinisnya. Ambang batas klinis dari data 2026 dibaca dan diterapkan secara terstandar ke seluruh data tahun-tahun sebelumnya, sehingga evaluasi tren kesehatan lima tahun dapat dibandingkan secara setara dan konsisten.</dd></div>
        <div><dt>Kategori Terukur dan Terinterpretasi</dt><dd>Parameter lingkar perut dan asam urat memiliki ambang batas biologis yang berbeda untuk pria dan wanita. Kunjungan dengan catatan hasil uji fisik namun tanpa informasi jenis kelamin tetap dihitung sebagai data <em>terukur</em>, namun tidak dimasukkan ke dalam persentase klasifikasi risiko demi menjaga ketepatan medis.</dd></div>
        <div><dt>Presisi Waktu Data Posbindu</dt><dd>Data periode 2022–2024 memiliki tanggal pelaksanaan sesi pemeriksaan yang presisi, sedangkan data 2025 dicatat berdasarkan periode bulanan. Visualisasi menandai data dengan presisi bulanan secara khusus untuk membedakannya dari tanggal sesi harian, dengan rekonsiliasi data bulanan untuk mencegah penghitungan ganda.</dd></div>
        <div><dt>Cakupan Peserta Posbindu</dt><dd>Grafik kesehatan merangkum kunjungan dosen dan tenaga kependidikan tetap. Kunjungan di luar kategori tersebut disajikan terpisah dan dicantumkan pada catatan visualisasi.</dd></div>
        <div><dt>Perlindungan Kerahasiaan Medis</dt><dd>Data Posbindu disajikan dalam bentuk agregat statistik. Identitas pribadi (nama, tanggal lahir, dan rekam medis perorangan) disaring dan dianonimkan sebelum data dipublikasikan.</dd></div>
      </dl>
    </section>

    <section class="data-section data-section--navy" id="konflik">
      <div class="data-section__intro">
        <p class="eyebrow">Harmonisasi Data</p>
        <h2>Penyelarasan Selisih Angka Antarsumber</h2>
        <p>Perbedaan angka antarsistem data bukan anomali yang ditutupi, melainkan konsekuensi logis dari perbedaan tanggal penarikan data (cut-off date), dasar penetapan surat keputusan (SK), serta ruang lingkup kewenangan basis data masing-masing pengelola.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <caption>Harmonisasi angka antara TCK 2026 dan berkas historis institusi</caption>
          <thead><tr><th>Metrik</th><th>TCK 2026 (SIMASTER)</th><th>Data Historis</th><th>Penjelasan Metodologis</th></tr></thead>
          <tbody>{conflicts.map((row) => <tr><th scope="row">{row.metric}</th><td>{row.tck}</td><td>{row.historical}</td><td>{row.explanation}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="data-section" id="kualitas">
      <div class="data-section__intro">
        <p class="eyebrow">Validasi Data</p>
        <h2>Prosedur Pengolahan dan Standardisasi Data</h2>
      </div>
      <ol class="quality-list">
        <li><span>01</span><div><h3>Standardisasi Lokasi Pengabdian</h3><p>Penamaan wilayah dan provinsi dinormalisasi menggunakan kode wilayah standar BPS. Sebanyak 619 kegiatan tanpa koordinat spesifik (kegiatan daring atau lintas provinsi) tetap dicatat secara transparan.</p></div></li>
        <li><span>02</span><div><h3>Pemetaan Afiliasi Departemen</h3><p>Klasifikasi departemen dilakukan melalui verifikasi dua tingkat. Tingkat pertama mengacu pada hasil kurasi internal unit P2M fakultas untuk publikasi yang terindeks di SciVal. Tingkat kedua, bagi karya ilmiah baru yang belum ada di catatan P2M, penentuan departemen didasarkan pada departemen mayoritas dari afiliasi Scopus para penulis FMIPA. Apabila sebaran afiliasi penulis berimbang atau belum teridentifikasi dosen aktif, publikasi dikelompokkan sebagai belum terpetakan dan diverifikasi lebih lanjut.</p></div></li>
        <li><span>03</span><div><h3>Penggabungan Berkas Multi-bagian</h3><p>Data sitasi dihimpun secara terprogram, disaring dari duplikasi berdasarkan ID dokumen unik, serta diperiksa integritas barisnya. Metadata eksternal dan catatan hak cipta dari berkas mentah SciVal dibersihkan, serta tanda strip (&ldquo;-&rdquo;) yang menunjukkan data kosong distandardisasi menjadi nilai nihil agar tidak terinterpretasi sebagai kategori.</p></div></li>
        <li><span>04</span><div><h3>Penandaan Periode Tahun Berjalan</h3><p>Periode tahun berjalan disesuaikan dengan siklus pemutakhiran masing-masing sumber. Data publikasi, klaster topik, jejaring kolaborasi, dan jalur akses terbuka bersumber dari SciVal per 30 Agustus 2026 sehingga tahun 2025 telah terekam penuh dan tahun <strong>2026</strong> diposisikan sebagai tahun berjalan. Sebaliknya, data sitasi tahunan bersumber dari pangkalan data P2M yang dimutakhirkan hingga akhir 2025, sehingga tahun <strong>2025</strong> menjadi batas akhir pencatatan. Perbedaan rentang ini disajikan transparan sesuai ketersediaan data primer.</p></div></li>
        <li><span>05</span><div><h3>Perlindungan Privasi dan Data Pribadi</h3><p>Seluruh informasi identitas pribadi (seperti NIP, NIM, alamat rumah, nomor kontak, serta rekam medis kesehatan individu) disaring dan dianonimkan dari pipeline publikasi.</p></div></li>
        <li><span>06</span><div><h3>Normalisasi Satuan Indikator Kinerja</h3><p>Satuan ukuran kinerja diselaraskan agar mudah diperbandingkan: indikator perolehan dana (<em>creative funding</em>) dikonversikan ke satuan miliar rupiah, sedangkan indikator bertipe persentase yang hanya memuat jumlah orang dikembalikan evaluasinya ke triwulan yang memiliki angka penyebut lengkap.</p></div></li>
        <li><span>07</span><div><h3>Deduplikasi dan Rekonsiliasi Sesi Posbindu</h3><p>Data sesi pemeriksaan Posbindu dideduplikasi berdasarkan tanggal dan identitas anonim peserta untuk mencegah penghitungan ganda, dengan pemulihan data sesi awal tahun dari lembar rekapitulasi terpadu.</p></div></li>
        <li><span>08</span><div><h3>Agregasi dan Penyamaran Data Mahasiswa</h3><p>Data mahasiswa diagregasi ke dalam bentuk tabulasi silang statistik tanpa menyertakan identitas perorangan. Sel dengan frekuensi sangat kecil (satu atau dua mahasiswa) disamarkan demi mencegah identifikasi ulang individu.</p></div></li>
        <li><span>09</span><div><h3>Harmonisasi Asal Pendidikan Lintas Jenjang</h3><p>Pada pemutakhiran basis data per {origins.tanggal}, variabel yang diekstraksi difokuskan pada program studi, jenjang, tahun angkatan, nama SMA, serta perguruan tinggi jenjang sebelumnya (S1 dan S2). Nomor identitas dan nomor peserta tidak disimpan guna melindungi privasi. Baris data dengan kemiripan atribut tetap diperhitungkan karena merepresentasikan mahasiswa yang berbeda. Agregasi dihitung independen untuk tiap angkatan dan total gabungan tanpa penghitungan ulang ganda.</p></div></li>
        <li><span>10</span><div><h3>Distribusi Sebaran Titik (Beeswarm) IPK Sarjana</h3><p>Setiap titik merepresentasikan nilai IPK seorang mahasiswa S1, dengan pembeda warna untuk masing-masing angkatan. Sumbu horizontal menunjukkan capaian IPK sesungguhnya pada skala 0–4,00, sedangkan susunan vertikal murni berfungsi mengurai sebaran agar titik tidak bertumpuk tanpa mewakili variabel lain. Seluruh data nilai disertakan secara utuh tanpa penyampelan. Data dikelompokkan per program studi dan angkatan tanpa mengaitkan nama, NIM, maupun identitas pribadi. Kelompok dengan jumlah kurang dari tiga tidak ditampilkan demi kerahasiaan. Median gabungan dihitung dari seluruh populasi nilai secara langsung, bukan rata-rata dari median per angkatan. Statistik pendamping berupa kuartil (P25, P75) dan rentang whisker 1,5 IQR disertakan untuk memperkuat keterbacaan sebaran. Rujukan konsep: <a href="https://observablehq.com/plot/transforms/dodge">Observable: beeswarm/dodge</a>.</p></div></li>
      </ol>
    </section>

    <section class="data-section" id="anomali">
      <div class="data-section__intro">
        <p class="eyebrow">Transparansi Data</p>
        <h2>Catatan Kualitas Data pada Berkas Sumber</h2>
        <p>Setiap catatan teknis dan ketidaksesuaian administratif pada dokumen resmi disajikan secara terbuka dan apa adanya. Penjelasan metodologis dilampirkan secara transparan untuk mendampingi setiap visualisasi data.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <caption>{flagged.length} dari {tck.length} indikator TCK 2026 disertai catatan teknis dan metodologis</caption>
          <thead><tr><th>No.</th><th>Indikator</th><th>Triwulan Evaluasi</th><th>Catatan Metodologis</th></tr></thead>
          <tbody>{flagged.map((row) => <tr><th scope="row">{row.no}</th><td>{row.indikator}</td><td>{String(row.kuartal_dinilai).toUpperCase()}</td><td>{row.anomali}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="data-section data-section--paper" id="gap">
      <div class="data-section__intro">
        <p class="eyebrow">Agenda Penguatan Data</p>
        <h2>Rencana Integrasi Data Berkelanjutan</h2>
        <p>Aspek yang membutuhkan pengayaan data disajikan sebagai agenda strategis ke depan, lengkap dengan unit penanggung jawab pengelolaannya.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <thead><tr><th>Prioritas</th><th>Kebutuhan Data</th><th>Urgensi &amp; Manfaat</th><th>Unit Pengelola Data</th></tr></thead>
          <tbody>{gaps.map((gap) => <tr><td><span class={`priority priority--${gap.priority.toLowerCase()}`}>{gap.priority}</span></td><th scope="row">{gap.item}</th><td>{gap.reason}</td><td>{gap.owner}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="method-cta">
      <div>
        <p class="eyebrow">Keterbukaan &amp; Keterulangan Data (Reproducibility)</p>
        <h2>Empat Tahapan Pemrosesan Data</h2>
      </div>
      <ol><li><strong>00</strong> Ekstraksi &amp; Konsolidasi</li><li><strong>01</strong> Pembersihan &amp; Normalisasi</li><li><strong>02</strong> Agregasi Berbasis Metrik</li><li><strong>03</strong> Validasi &amp; Penjaminan Mutu</li></ol>
      <p>Seluruh skrip otomasi pemrosesan data tersimpan dalam direktori <code>pipeline/</code> dan dapat dijalankan ulang secara mandiri untuk menghasilkan dataset turunan yang konsisten.</p>
      <a href={homeUrl}>Kembali ke laporan utama →</a>
    </section>
  </main>
</BaseLayout>

<style>
  .data-hero { position: relative; overflow: hidden; padding: clamp(72px, 10vw, 132px) var(--page-gutter); background: var(--ugm-blue-deep); color: #fff; }
  .data-hero__inner { position: relative; z-index: 1; width: min(100%, var(--content-max)); margin-inline: auto; }
  .data-hero__eyebrow, .data-section .eyebrow, .method-cta .eyebrow { margin: 0 0 18px; color: var(--ugm-gold); font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .data-hero h1 { color: #fff; font-family: var(--font-display); font-size: clamp(52px, 8vw, 100px); line-height: .95; }
  .data-hero p:not(.data-hero__eyebrow) { max-width: 700px; margin: 26px 0 0; color: var(--text-on-dark-secondary); font-size: clamp(18px, 2vw, 23px); }
  .data-hero a { display: inline-block; margin-block-start: 34px; color: #fff; font-weight: 700; }
  .data-hero__motif { position: absolute; inset: -30% -10% auto auto; width: min(65vw, 820px); aspect-ratio: 1; opacity: .1; filter: brightness(0) invert(1); background-position: center; background-size: contain; background-repeat: no-repeat; }
  .data-nav { position: sticky; z-index: 20; top: 72px; padding: 12px var(--page-gutter); border-bottom: 1px solid var(--border-subtle); background: var(--surface-page); display: flex; justify-content: center; gap: 20px; overflow-x: auto; }
  .data-nav a { flex: none; color: var(--text-secondary); font-size: 12px; font-weight: 700; text-decoration: none; }
  .data-section { padding: clamp(76px, 9vw, 124px) var(--page-gutter); scroll-margin-top: 120px; }
  .data-section--paper { background: var(--surface-subtle); }
  .data-section--navy { background: var(--ugm-blue-deep); color: #fff; }
  .data-section > * { width: min(100%, 1100px); margin-inline: auto; }
  .data-section__intro { max-width: 760px; margin-inline: auto; }
  .data-section__intro h2 { color: inherit; font-family: var(--font-display); font-size: clamp(38px, 5vw, 64px); line-height: 1.03; }
  .data-section__intro > p:last-child { margin: 22px 0 0; color: var(--text-secondary); font-size: 19px; line-height: 1.55; }
  .data-section--navy .data-section__intro > p:last-child { color: var(--text-on-dark-secondary); }
  .source-split { margin-block-start: var(--flow-block); display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 26px; align-items: stretch; }
  .source-split article { min-height: 330px; padding: clamp(28px, 4vw, 44px); border: 1px solid var(--border-default); border-top: 4px solid var(--ugm-blue); background: var(--surface-card); }
