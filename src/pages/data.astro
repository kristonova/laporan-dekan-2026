---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
import snapshotRaw from "../data/derived/snapshot.json";
import tckRaw from "../data/derived/tck_2026_joined.json";
import partnershipCoverageRaw from "../data/derived/partnership_coverage.json";
import tracerSummaryRaw from "../data/derived/tracer_summary.json";
import hpuYearlyRaw from "../data/derived/hpu_posbindu_tahunan.json";
import origins from "../data/derived/students_origins.json";
import studentSummaryRaw from "../data/derived/students_summary.json";
import studentAccessRaw from "../data/derived/students_access.json";
import studentBackgroundRaw from "../data/derived/students_background.json";

const snapshot = snapshotRaw as { label: string; p2m: string; lentera: string };
const tck = tckRaw as any[];
const flagged = tck.filter((row) => row.anomali);
const partnershipCoverage = partnershipCoverageRaw as { total: number; terpetakan: number; internasional: number; lokasi_kosong: number };
const tracerSummary = tracerSummaryRaw as { responden: number; tahun: number[] };
const hpuYear = hpuYearlyRaw as { lapisan: { kunci: string; kunjungan: number }[]; tahun: number[] };
const students = studentSummaryRaw as any;
const studentAccess = studentAccessRaw as any;
const studentBackground = studentBackgroundRaw as any;
const number = (value: number, digits = 0) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);

const datasets = [
  { file: "students_origins.json", label: "Asal pendidikan S1, S2, S3, dan non-gelar", coverage: `${number(origins.total)} rekaman · angkatan 2021–2026 · ${origins.tanggal}`, source: origins.sumber, scenes: "6.1, 6.6" },
  { file: "students_origins_cohorts.json", label: "Cakupan per jenjang dan angkatan", coverage: "Angkatan × S1/S2/S3/non-gelar", source: origins.sumber, scenes: "6.1" },
  { file: "students_origins_programmes.json", label: "Program studi semua jenjang", coverage: "Angkatan × jenjang × program studi", source: origins.sumber, scenes: "6.1" },
  { file: "students_programme_trends.json", label: "Tren komposisi program studi S1, S2, S3, dan non-gelar", coverage: "Angkatan 2021–2026 × jenjang × prodi; reguler dan IUP digabung per prodi", source: "S1/non-gelar: daftar mahasiswa; S2/S3: Data Asal Sekolah dan Asal Univ Fak MIPA 2021–2026", scenes: "6.1" },
  { file: "students_programme_trends_meta.json", label: "Cakupan dan penyebut proporsi program studi", coverage: "Total per angkatan dan jenjang, sumber, serta aturan penggabungan", source: "Daftar mahasiswa dan workbook asal pendidikan, pada jenjang yang berbeda", scenes: "6.1" },
  { file: "students_origins_institutions.json", label: "Sekolah dan universitas asal", coverage: "Jenjang × pendidikan sebelumnya × angkatan × institusi; angkatan 0 = gabungan, tidak dijumlahkan kembali", source: origins.sumber, scenes: "6.6" },
  { file: "students_ipk_distribution.json", label: "Ringkasan IPK S1 per program studi", coverage: "Angkatan 2021–2025 · jumlah, median, P25, P75, whisker 1,5 IQR", source: "Daftar mahasiswa S1 FMIPA UGM", scenes: "6.7" },
  { file: "tck_2026_joined.json", label: "Indikator TCK 2026", coverage: "42 indikator · target TW1–TW4 · capaian TW1–TW3", source: "TCK 2026 (XLSX resmi)", scenes: "1.2, 2.6, 3.6, 4.3–4.5, 5.1–5.2, 7.1" },
  { file: "citations_by_year.json", label: "Sitasi per tahun", coverage: "1987–2025 · 70.905 seluruh arsip", source: "CSV historis FMIPA", scenes: "0.0, 2.1" },
  { file: "publications_by_year_dept.json", label: "Publikasi per departemen", coverage: "2020–2026 · 3.069 publikasi · 2026 tahun berjalan", source: "SciVal / Scopus", scenes: "2.2" },
  { file: "research_quality.json", label: "Mutu sitasi per bidang ilmu", coverage: "27 bidang ASJC · FWCI, sitasi, dan jumlah peneliti", source: "SciVal / Scopus", scenes: "2.2p" },
  { file: "topics.json", label: "Klaster topik", coverage: "541 klaster SciVal · dengan persentil prominensi", source: "SciVal", scenes: "2.3" },
  { file: "collab_countries.json", label: "Kolaborasi negara", coverage: "62 negara mitra internasional", source: "SciVal / Scopus", scenes: "2.4" },
  { file: "collab_share.json", label: "Porsi kolaborasi internasional", coverage: "2020–2026 · publikasi dengan minimal satu mitra luar negeri", source: "SciVal / Scopus", scenes: "2.4" },
  { file: "open_access.json", label: "Jalur akses terbuka", coverage: "2020–2026 · gold, hybrid gold, bronze, green, tertutup", source: "SciVal / Scopus", scenes: "2.4p" },
  { file: "world-countries.geojson", label: "Batas negara dunia", coverage: "177 negara/teritori · Natural Earth 1:110m · WGS 84", source: "Natural Earth · public domain", scenes: "2.4" },
  { file: "lecturers_positions.json", label: "Jabatan fungsional dosen", coverage: "203 dosen", source: "Data kepegawaian", scenes: "2.5, 5.1" },
  { file: "sinta_by_dept.json", label: "Skor SINTA per departemen", coverage: "Snapshot 3 Desember 2025", source: "SINTA", scenes: "2.6" },
  { file: "funding_by_year.json", label: "Dana riset per tahun", coverage: "2019–2025", source: "Data riset FMIPA", scenes: "3.1" },
  { file: "outreach_points.json", label: "Jangkauan pengabdian", coverage: "2021–2026 · lokasi teragregasi", source: "Surat Tugas / SIMPEL / Hibah", scenes: "3.2" },
  { file: "indonesia-provinces.geojson", label: "Batas provinsi Indonesia", coverage: "38 provinsi · geometri dioptimalkan untuk web", source: "Peta Nusa / Laravel Nusa · MIT", scenes: "3.2" },
  { file: "sdg_matrix.json", label: "Matriks SDG", coverage: "17 tujuan · taksonomi SDG (2025)", source: "Data riset + SciVal", scenes: "3.3" },
  { file: "journals.json", label: "Jurnal terbitan FMIPA", coverage: "462 rekaman · 461 terklasifikasi", source: "Data jurnal internal", scenes: "3.4" },
  { file: "value_model.json", label: "Model nilai FMIPA", coverage: "Agregat 2021–2025", source: "Turunan lintas tabel", scenes: "1.3" },
  { file: "snapshot.json", label: "Tanggal penarikan data", coverage: "Label tanggal tunggal untuk seluruh halaman", source: "Konstanta pipeline", scenes: "seluruh halaman" },
  { file: "tck_2026_by_dept.json", label: "TCK per departemen", coverage: "30 indikator dengan rincian DIKE/DF/DM/DK", source: "TCK 2026 (XLSX resmi)", scenes: "1.2" },
  { file: "partnerships_by_year.json", label: "Kerja sama per tahun", coverage: "2021–2026 · domestik dan internasional", source: "LENTERA UGM", scenes: "3.5" },
  { file: "partnership_partners.json", label: "Profil mitra kerja sama", coverage: "Negara dan jenis mitra", source: "LENTERA UGM", scenes: "3.5" },
  { file: "partnership_points.json", label: "Sebaran provinsi mitra", coverage: "Agregat provinsi per tahun", source: "LENTERA UGM", scenes: "3.5" },
  { file: "admissions_by_year.json", label: "Penerimaan mahasiswa baru", coverage: "2022–2026 · peminat, diterima, registrasi", source: "Data akademik FMIPA", scenes: "4.6" },
  { file: "active_students.json", label: "Mahasiswa sarjana aktif", coverage: "Per prodi dan angkatan 2017–2025", source: "Data akademik FMIPA", scenes: "1.1" },
  { file: "graduates_profile.json", label: "Profil lulusan", coverage: "Sarjana, Magister, Doktor · IPK dan lama studi", source: "Data akademik FMIPA", scenes: "4.7" },
  { file: "student_achievements.json", label: "Prestasi mahasiswa", coverage: "2022–2026 · departemen × tingkat", source: "Data kemahasiswaan FMIPA", scenes: "4.7" },
  { file: "scholarships.json", label: "Penerima beasiswa", coverage: "Agregat per prodi dan skema", source: "Data akademik FMIPA", scenes: "4.6" },
  { file: "accreditation.json", label: "Status akreditasi prodi", coverage: "18 prodi nasional · 15 sertifikat internasional", source: "Data akademik FMIPA", scenes: "1.1" },
  { file: "tracer_sectors.json", label: "Sektor karier lulusan", coverage: "Agregat sektor dari tracer study", source: "Tracer study FMIPA", scenes: "4.1" },
  { file: "tracer_waiting_time.json", label: "Masa tunggu kerja", coverage: "Distribusi kategori per prodi", source: "Tracer study FMIPA", scenes: "4.2" },
  { file: "exchange_students.json", label: "Mobilitas mahasiswa keluar", coverage: "64 mahasiswa · 33 universitas tujuan", source: "Data mobilitas FMIPA", scenes: "4.4" },
  { file: "graduates_by_programme.json", label: "Lulusan per program studi", coverage: "Rincian jenjang × prodi × tahun", source: "Data akademik FMIPA", scenes: "4.7" },
  { file: "partnership_coverage.json", label: "Cakupan data kerja sama", coverage: "Ringkasan keterpetaan lokasi mitra", source: "LENTERA UGM", scenes: "3.5, 7.1" },
  { file: "tracer_summary.json", label: "Ringkasan tracer study", coverage: "Median, rerata, dan serapan enam bulan", source: "Tracer study FMIPA", scenes: "4.1, 4.2" },
  { file: "hpu_posbindu.json", label: "Health Promoting University", coverage: "Agregat anonim dosen dan tendik, 5 sesi Posbindu 2026", source: "Posbindu Melati FMIPA", scenes: "5.3" },
  { file: "hpu_posbindu_tahunan.json", label: "Health Promoting University 2022–2026", coverage: `Agregat anonim per tahun, dua lapisan peserta, ${number(hpuYear.lapisan[1]?.kunjungan ?? 0)} kunjungan lima tahun`, source: "Digitasi arsip analog, registri Posbindu, dan rekap 2026", scenes: "5.3" },
  { file: "students_summary.json", label: "Profil S1 dan non-gelar (sumber lama)", coverage: `${number(students.total)} mahasiswa · angkatan ${students.tahun_awal}–${students.tahun_akhir}`, source: "Daftar mahasiswa FMIPA UGM", scenes: "6.1–6.7" },
  { file: "students_by_programme.json", label: "Mahasiswa per program studi", coverage: "Angkatan × jenjang × departemen × prodi, dengan pilahan gender", source: "Daftar mahasiswa FMIPA UGM", scenes: "6.1, 6.3" },
  { file: "students_by_province.json", label: "Provinsi asal mahasiswa", coverage: `Angkatan × provinsi ber-kode BPS · ${number(studentAccess.kabupaten_unik)} kabupaten/kota tercatat`, source: "Daftar mahasiswa FMIPA UGM", scenes: "6.2" },
  { file: "students_by_pathway.json", label: "Jalur masuk mahasiswa", coverage: "Angkatan × jalur, rezim SNMPTN/SBMPTN disatukan dengan SNBP/SNBT", source: "Daftar mahasiswa FMIPA UGM", scenes: "6.4" },
  { file: "students_background.json", label: "Latar keluarga dan sekolah asal", coverage: `Pekerjaan wali (11 kelompok), agama, dan ${number(studentBackground.sekolah_unik)} sekolah asal 2023–2026`, source: "Daftar mahasiswa FMIPA UGM", scenes: "6.5, 6.6" },
  { file: "students_cohort_outcome.json", label: "Status akhir per angkatan", coverage: "Lulus, aktif, mengundurkan diri, dan tidak aktif per angkatan", source: "Daftar mahasiswa FMIPA UGM", scenes: "6.7" },
  { file: "students_ipk.json", label: "Beeswarm IPK per angkatan", coverage: "IPK tanpa identitas per prodi/angkatan 2021–2025; rerata, median, kuartil dan ringkasan gabungan", source: "Daftar mahasiswa FMIPA UGM", scenes: "6.7" },
  { file: "students_access.json", label: "Jangkauan dan pemerataan akses", coverage: "Jawa vs luar Jawa, provinsi terwakili, dan mahasiswa asal daerah 3T", source: "Daftar mahasiswa FMIPA UGM", scenes: "6.2" },
];

const gaps = [
  { priority: "P0", item: "Penyebut indikator persentase #5b dan #8b1–8b3", reason: "Kolom capaian TW3 memuat cacah mahasiswa tanpa penyebut, sehingga persentase TW3 tidak dapat dihitung", owner: "Bagian Perencanaan FMIPA" },
  { priority: "P0", item: "Klarifikasi indikator #32", reason: "Indeks kenaikan nilai hijau bangunan tercatat negatif pada berkas sumber", owner: "Bagian Perencanaan / Direktorat Aset" },
  { priority: "P1", item: "Digitasi arsip Posbindu September–Desember", reason: "Registri mencatat sesi pemeriksaan pada September–Desember 2023, 2024, dan 2025 yang lembar analognya belum pernah didigitasi, sehingga tahun-tahun itu hanya terbaca pada presisi bulan", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P1", item: "Kriteria peserta Posbindu 2026", reason: "257 dari 391 kunjungan 2026 tidak mencantumkan kategori peserta, sehingga hanya dapat dihitung pada lapisan seluruh peserta", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P2", item: "Gender peserta Posbindu 2022–2024", reason: "Lembar digitasi tidak memuat kolom jenis kelamin; lingkar perut dan asam urat memakai ambang berbeda per gender sehingga sebagian kunjungan terukur tetapi tidak dapat dinilai", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P2", item: "Tindak lanjut dan rujukan Posbindu", reason: "Kolom rujukan terisi pada 34 dari 391 kunjungan 2026, sehingga konversi temuan berisiko menjadi tindak lanjut klinis belum dapat diukur", owner: "Tim Posbindu Melati FMIPA" },
  { priority: "P1", item: "Data K3L dan penanganan kekerasan seksual", reason: "Program berjalan bersama Satgas PPKS dan Tim K3L, tetapi belum tersedia sebagai data terstruktur", owner: "Satgas PPKS / Tim K3L FMIPA" },
  { priority: "P1", item: "Alamat provinsi mitra kerja sama", reason: "Sebagian dokumen LENTERA belum memuat kabupaten/provinsi mitra", owner: "Unit Kerja Sama FMIPA" },
  { priority: "P2", item: "Tracer study per angkatan dan wilayah kerja", reason: "Data yang tersedia mencakup angkatan 2024–2025 tanpa dimensi wilayah", owner: "DPKM / CDC UGM" },
  { priority: "P2", item: "Paparan media 2021–2022", reason: "Data yang ada baru mulai 2023", owner: "Humas FMIPA" },
  { priority: "P2", item: "Wilayah sekolah dan universitas asal", reason: "Workbook 2 September telah melengkapi nama sekolah S1 pada 2021–2026, tetapi tidak memuat provinsi sekolah/universitas. Wilayah tidak ditebak dari nama institusi.", owner: "Bagian Akademik FMIPA / DAA UGM" },
  { priority: "P2", item: "Status beasiswa per mahasiswa", reason: "Kolom Beasiswa/Kerjasama pada keenam berkas daftar mahasiswa kosong 100%, sehingga penerima bantuan tidak dapat ditautkan ke profil angkatan", owner: "Bagian Kemahasiswaan FMIPA" },
];

const conflictRow = (no: string) => {
  const row = tck.find((item) => String(item.no) === no);
  return row ? number(row.capaian_dinilai, row.satuan === "Miliar Rupiah" ? 2 : 0) : "—";
};
const conflicts = [
  { metric: "Cakupan mahasiswa pada dua sumber", tck: `${number(origins.total)} rekaman (asal pendidikan)`, historical: `${number(students.total)} rekaman (daftar mahasiswa)`, explanation: `Workbook ${origins.tanggal} mencakup ${number(origins.per_jenjang.S1)} S1, ${number(origins.per_jenjang.S2)} S2, ${number(origins.per_jenjang.S3)} S3, dan ${number(origins.per_jenjang.NONDEGREE)} non-gelar. Daftar lama mencakup ${number(students.sarjana)} S1 serta non-gelar. Kedua sumber tidak ditautkan atau didedup pada individu. Untuk grafik komposisi prodi, S1/non-gelar diambil hanya dari daftar mahasiswa, sedangkan S2/S3 hanya dari workbook baru, sehingga jenjang yang sama tidak dihitung ulang antar-sumber. Angka adalah rekaman angkatan, bukan stok mahasiswa aktif atau orang unik lintas jenjang.` },
  { metric: "Guru Besar", tck: conflictRow("30"), historical: "42", explanation: "Data TCK mencatat SK pengangkatan Guru Besar terbaru pada sistem universitas, sedangkan data kepegawaian internal mencerminkan snapshot dosen aktif pada saat penarikan data." },
  { metric: "Dosen berkualifikasi S3", tck: conflictRow("24"), historical: "138", explanation: "Data TCK merujuk pada basis data SIMASTER universitas; data kepegawaian internal mendeteksi 138 dosen bergelar doktor dari total 203 dosen aktif." },
  { metric: "Sitasi", tck: conflictRow("15"), historical: "12.629 (2024)", explanation: "Data TCK menghitung periode pelaporan kinerja berjalan; berkas CSV sitasi menghitung akumulasi seluruh sitasi yang terindeks pada tahun bersangkutan." },
  { metric: "Publikasi terindeks", tck: conflictRow("16"), historical: "539 (2025)", explanation: "Terdapat perbedaan rentang waktu penarikan data serta cakupan jenis dokumen indeksasi. Angka 2025 naik dari 481 menjadi 539 setelah ekspor SciVal 30 Agustus 2026 melengkapi indeksasi tahun tersebut." },
  { metric: "Publikasi 2020–2025 pada dua sumber", tck: "3.069 (SciVal, 2020–2026)", historical: "2.726 (salinan P2M, 2020–2025)", explanation: "Ekspor SciVal 30 Agustus 2026 memuat 457 publikasi yang belum ada pada salinan P2M — 368 di antaranya terbit 2026 — sekaligus tidak lagi memuat 113 publikasi 2020–2025 yang sebelumnya tercatat (2020: 14, 2021: 15, 2022: 19, 2023: 15, 2024: 28, 2025: 22). Ke-113 publikasi itu keluar dari definisi entitas FMIPA di SciVal; 108 di antaranya memang belum terpetakan ke departemen mana pun. Laporan mengikuti SciVal sebagai sumber otoritatif, sehingga angka 2020–2024 sedikit lebih rendah daripada versi laporan sebelumnya." },
  { metric: "Program studi terakreditasi Unggul/A", tck: conflictRow("3"), historical: "15 dari 18 prodi", explanation: "Kedua sumber konsisten; data akademik merinci 15 program studi berpredikat Unggul/A dari 18 prodi nasional." },
  { metric: "Registrasi mahasiswa baru 2025", tck: "808 (PROFIL MABA)", historical: "812 (daftar mahasiswa)", explanation: "Kedua sistem mencatat angka yang identik pada 2022, 2023, 2024, dan 2026; selisih empat mahasiswa pada 2025 terjadi karena perbedaan waktu pemutakhiran berkas daftar mahasiswa." },
  { metric: "Sesi Posbindu Januari 2026", tck: "Lembar “Jan 26”", historical: "Salinan lembar “Juli 26”", explanation: "Lembar bulanan berlabel Januari memuat data 3 Juli 2026 secara identik. Sesi 30 Januari yang sesungguhnya hanya tercatat pada lembar rekapitulasi terpadu dan diambil dari sana; salinan gandanya dibuang agar tidak menambah sesi keenam." },
  { metric: "Pemeriksaan 3 Juli 2026", tck: "Lembar rekapitulasi terpadu", historical: "Lembar bulanan “Juli 26”", explanation: "Pada lembar terpadu, kolom interpretasi asam urat hilang untuk sesi ini sehingga 68 dari 70 baris bergeser satu kolom ke kiri. Nilai diambil dari lembar bulanan yang utuh; sesi Februari, Mei, dan Agustus cocok 100% pada kedua lembar." },
  { metric: "Rekap pemeriksaan 2024", tck: "Rekap_Pemeriksaan_Kesehatan_2024", historical: "Rekap_Digitasi_2022_2024", explanation: "Kedua berkas memuat 240 catatan yang sama persis: seluruh ID Record berpasangan dan tidak ada satu pun selisih nilai numerik. Berkas 2024 karenanya tidak dipakai terpisah agar tahun 2024 tidak terhitung dua kali." },
  { metric: "Kerja sama aktif", tck: conflictRow("1a"), historical: `${number(partnershipCoverage.total)} dokumen (2021–2026)`, explanation: "Data TCK menghitung dokumen kerja sama aktif pada tahun anggaran berjalan; data LENTERA UGM mencatat seluruh dokumen naskah kerja sama selama enam tahun." },
];
const homeUrl = withBase("/");
const tckCsvUrl = withBase("/data/tck_2026_indikator.csv");
const datasetUrl = (file: string) => withBase(`/data/${file}`);
const motifStyle = `background-image: url(${JSON.stringify(withBase("/brand/supergraphic-lines.png"))})`;
---

<BaseLayout
  title="Data & Metodologi — Lima Tahun FMIPA"
  description="Sumber data resmi, definisi operasional metrik, harmonisasi perbedaan angka, serta prosedur validasi data Laporan Dekan FMIPA UGM 2021–2026."
  canonicalPath="/data"
>
  <main id="konten-utama">
    <header class="data-hero">
      <div class="data-hero__motif" aria-hidden="true" style={motifStyle}></div>
      <div class="data-hero__inner">
        <p class="data-hero__eyebrow">Transparansi &amp; Akuntabilitas</p>
        <h1>Data &amp; Metodologi</h1>
        <p>Setiap angka dan visualisasi dalam laporan ini dapat ditelusuri langsung ke sumber data resmi, definisi operasional, serta metodologi pengolahannya. Penyelarasan angka antarsistem institusi disajikan secara transparan, objektif, dan bertanggung jawab.</p>
        <a href={homeUrl}>← Kembali ke laporan utama</a>
      </div>
    </header>

    <nav class="data-nav" aria-label="Bagian halaman data">
      <a href="#aturan-sumber">Prinsip Sumber</a>
      <a href="#dataset">Dataset Terbuka</a>
      <a href="#definisi">Definisi Metrik</a>
      <a href="#konflik">Harmonisasi Data</a>
      <a href="#kualitas">Validasi Data</a>
      <a href="#anomali">Catatan Kualitas Data</a>
      <a href="#gap">Agenda Penguatan Data</a>
    </nav>

    <section class="data-section" id="aturan-sumber">
      <div class="data-section__intro">
        <p class="eyebrow">Prinsip Integritas Data</p>
        <h2>Pemisahan Sumber Berdasarkan Konteks</h2>
        <p>Data capaian kinerja tahunan (TCK SIMASTER) dan data rekam jejak tridharma historis memiliki cakupan serta metodologi penghitungan yang berbeda. Pemisahan penyajian ini menjaga ketepatan evaluasi dan mencegah kerancuan interpretasi tren institusi.</p>
      </div>
      <div class="source-split">
        <article>
          <p class="source-split__label">Bagian I · Capaian Kinerja 2026</p>
          <h3>TCK 2026 — SIMASTER UGM</h3>
          <strong>{tck.length} indikator</strong>
          <p>Target kumulatif TW1–TW4 dan realisasi capaian berjalan TW1–TW3 yang dibaca langsung dari berkas resmi <code>TCK 2026.xlsx</code> per {snapshot.label}.</p>
          <a href={tckCsvUrl} download>Unduh CSV Indikator</a>
        </article>
        <div class="source-split__divider" aria-label="Tidak dicampur"><span>≠</span><small>terpisah</small></div>
        <article>
          <p class="source-split__label">Bagian II · Rekam Jejak 2021–2026</p>
          <h3>Data Historis FMIPA UGM</h3>
          <strong>25 berkas sumber</strong>
          <p>Publikasi Scopus, sitasi, perolehan dana riset, kegiatan Pengabdian kepada Masyarakat (PkM), SDM, dan luaran institusi per {snapshot.p2m}.</p>
          <a href="#dataset">Lihat dataset turunan</a>
        </article>
        <div class="source-split__divider" aria-label="Ditambahkan"><span>+</span><small>baru</small></div>
        <article>
          <p class="source-split__label">Bagian II · Sumber Baru 2026</p>
          <h3>Kerja Sama, Akademik, dan Kesehatan</h3>
          <strong>{number(partnershipCoverage.total)} dokumen kerja sama</strong>
          <p>Data kemitraan LENTERA UGM per {snapshot.lentera}, survei penelusuran lulusan (tracer study) terhadap {number(tracerSummary.responden)} responden angkatan {tracerSummary.tahun.join(" dan ")}, serta {number(hpuYear.lapisan.find((row) => row.kunci === "staf")?.kunjungan ?? 0)} pemeriksaan kesehatan Posbindu HPU untuk dosen dan tenaga kependidikan sepanjang {hpuYear.tahun[0]}–{hpuYear.tahun[hpuYear.tahun.length - 1]}—seluruhnya disajikan dalam bentuk agregat anonim.</p>
          <a href="#dataset">Lihat dataset turunan</a>
        </article>
      </div>
    </section>

    <section class="data-section data-section--paper" id="dataset">
      <div class="data-section__intro">
        <p class="eyebrow">Dataset Terbuka</p>
        <h2>Dataset Agregat Siap Pakai</h2>
        <p>Seluruh data yang disajikan merupakan hasil agregasi resmi tingkat fakultas dan departemen. Data privasi individu (NIP/NIM/Nama) dianonimkan sesuai prinsip perlindungan data pribadi.</p>
      </div>
      <div class="dataset-list">
        {datasets.map((dataset) => (
          <article class="dataset-row">
            <div>
              <h3>{dataset.label}</h3>
              <code>{dataset.file}</code>
            </div>
            <p>{dataset.coverage}</p>
            <p><span>Sumber data</span>{dataset.source}</p>
            <p><span>Bagian/Scene</span>{dataset.scenes}</p>
            <a href={datasetUrl(dataset.file)} download aria-label={`Unduh ${dataset.label}`}>{dataset.file.endsWith(".geojson") ? "GeoJSON ↓" : "JSON ↓"}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="data-section" id="definisi">
      <div class="data-section__intro">
        <p class="eyebrow">Glosarium &amp; Kamus Indikator</p>
        <h2>Definisi Operasional Metrik</h2>
        <p>Penjelasan rinci mengenai satuan, batasan waktu, dan kaidah perhitungan tiap indikator agar interpretasi data konsisten dan akurat.</p>
      </div>
      <dl class="definition-grid">
        <div><dt>Sitasi</dt><dd>Jumlah sitasi tahunan yang tercatat pada pangkalan data Scopus untuk seluruh artikel berafiliasi FMIPA UGM pada tahun bersangkutan.</dd></div>
        <div><dt>Publikasi Ilmiah</dt><dd>Seluruh artikel ilmiah terindeks Scopus/SciVal berafiliasi FMIPA UGM untuk semua jenis dokumen akademik.</dd></div>
        <div><dt>Dana Riset</dt><dd>Akumulasi nilai pendanaan riset (<code>total_funding</code>) berdasarkan tahun disetujuinya proposal dari berbagai skema hibah kompetitif dan kerja sama riset.</dd></div>
        <div><dt>Pengabdian (PkM)</dt><dd>Jumlah kegiatan pengabdian resmi yang terlaksana berdasarkan Surat Tugas, sistem SIMPEL, atau hibah fakultas/universitas.</dd></div>
        <div><dt>Capaian TCK</dt><dd>Realisasi kinerja kumulatif yang dicapai sejak awal tahun anggaran hingga tanggal penarikan data berjalan.</dd></div>
        <div><dt>Target TCK</dt><dd>Target kinerja kumulatif triwulanan. Target Triwulan IV mencerminkan target tahunan fakultas secara utuh.</dd></div>
        <div><dt>Status Tercapai</dt><dd>Kondisi ketika realisasi capaian memenuhi atau melampaui target triwulan berjalan sesuai arah indikator kinerja.</dd></div>
        <div><dt>Data Berjalan</dt><dd>Data tahun 2025 yang masih dalam proses pemutakhiran berkala di pangkalan data global (Scopus) dan akan terus bertambah seiring waktu.</dd></div>
        <div><dt>Kategori Status Capaian</dt><dd>Rasio capaian terhadap target triwulan dikelompokkan ke dalam empat status: <strong>≥100% Tercapai</strong>, <strong>≥85% Mendekati Target</strong>, <strong>≥50% Perlu Akselerasi</strong>, dan <strong>&lt;50% Belum Tercapai</strong>. Untuk indikator bertipe efisiensi (target nilai menurun), rasio dihitung terbalik sehingga capaian yang lebih rendah dinilai lebih unggul.</dd></div>
        <div><dt>Triwulan Evaluasi Sahih</dt><dd>Triwulan evaluasi kinerja merujuk pada triwulan terakhir dengan ketersediaan data capaian dan target yang lengkap secara metodologis. Empat indikator persentase dievaluasi pada Triwulan II karena pelaporan Triwulan III baru memuat jumlah orang tanpa angka penyebut populasi.</dd></div>
        <div><dt>Masa Tunggu Kerja</dt><dd>Rentang waktu (dalam bulan) antara tanggal resmi kelulusan dan tanggal mulai bekerja berdasarkan survei penelusuran lulusan (tracer study). Nilai negatif menunjukkan bahwa responden telah diterima bekerja sebelum resmi diwisuda.</dd></div>
        <div><dt>Pita Risiko Kesehatan</dt><dd>Hasil pemeriksaan kesehatan dikelompokkan ke dalam tiga pita risiko medis—Normal, Waspada, dan Berisiko—merujuk pedoman klinis terstandar demi memudahkan interpretasi kesehatan sivitas tanpa menghilangkan rincian data aslinya.</dd></div>
        <div><dt>Standardisasi Ambang Klinis Retrospektif</dt><dd>Arsip data pemeriksaan 2022–2025 merekam nilai numerik hasil tes laboratorium, sedangkan dokumen 2026 memuat nilai numerik beserta kategori interpretasi klinisnya. Ambang batas klinis dari data 2026 dibaca dan diterapkan secara terstandar ke seluruh data tahun-tahun sebelumnya, sehingga evaluasi tren kesehatan lima tahun dapat dibandingkan secara setara dan konsisten.</dd></div>
        <div><dt>Kategori Terukur dan Terinterpretasi</dt><dd>Parameter lingkar perut dan asam urat memiliki ambang batas biologis yang berbeda untuk pria dan wanita. Kunjungan dengan catatan hasil uji fisik namun tanpa informasi jenis kelamin tetap dihitung sebagai data <em>terukur</em>, namun tidak dimasukkan ke dalam persentase klasifikasi risiko demi menjaga ketepatan medis.</dd></div>
        <div><dt>Presisi Waktu Data Posbindu</dt><dd>Data periode 2022–2024 memiliki tanggal pelaksanaan sesi pemeriksaan yang presisi, sedangkan data 2025 dicatat berdasarkan periode bulanan. Visualisasi menandai data dengan presisi bulanan secara khusus untuk membedakannya dari tanggal sesi harian, dengan rekonsiliasi data bulanan untuk mencegah penghitungan ganda.</dd></div>
        <div><dt>Cakupan Peserta Posbindu</dt><dd>Grafik kesehatan merangkum kunjungan dosen dan tenaga kependidikan tetap. Kunjungan di luar kategori tersebut disajikan terpisah dan dicantumkan pada catatan visualisasi.</dd></div>
        <div><dt>Perlindungan Kerahasiaan Medis</dt><dd>Data Posbindu disajikan dalam bentuk agregat statistik. Identitas pribadi (nama, tanggal lahir, dan rekam medis perorangan) disaring dan dianonimkan sebelum data dipublikasikan.</dd></div>
      </dl>
    </section>

    <section class="data-section data-section--navy" id="konflik">
      <div class="data-section__intro">
        <p class="eyebrow">Harmonisasi Data</p>
        <h2>Penyelarasan Selisih Angka Antarsumber</h2>
        <p>Perbedaan angka antarsistem data bukan anomali yang ditutupi, melainkan konsekuensi logis dari perbedaan tanggal penarikan data (cut-off date), dasar penetapan surat keputusan (SK), serta ruang lingkup kewenangan basis data masing-masing pengelola.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <caption>Harmonisasi angka antara TCK 2026 dan berkas historis institusi</caption>
          <thead><tr><th>Metrik</th><th>TCK 2026 (SIMASTER)</th><th>Data Historis</th><th>Penjelasan Metodologis</th></tr></thead>
          <tbody>{conflicts.map((row) => <tr><th scope="row">{row.metric}</th><td>{row.tck}</td><td>{row.historical}</td><td>{row.explanation}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="data-section" id="kualitas">
      <div class="data-section__intro">
        <p class="eyebrow">Validasi Data</p>
        <h2>Prosedur Pengolahan dan Standardisasi Data</h2>
      </div>
      <ol class="quality-list">
        <li><span>01</span><div><h3>Standardisasi Lokasi Pengabdian</h3><p>Penamaan wilayah dan provinsi dinormalisasi menggunakan kode wilayah standar BPS. Sebanyak 619 kegiatan tanpa koordinat spesifik (kegiatan daring atau lintas provinsi) tetap dicatat secara transparan.</p></div></li>
        <li><span>02</span><div><h3>Pemetaan Afiliasi Departemen</h3><p>Pemetaan berjalan dua lapis. Lapis pertama memakai penetapan departemen hasil kurasi fakultas pada basis data P2M, yang dipertahankan untuk setiap publikasi yang masih tercatat pada ekspor SciVal terbaru. Lapis kedua, untuk publikasi yang belum pernah tercatat pada basis data P2M, memakai departemen mayoritas dari ID Scopus para penulis; jika mayoritasnya seri atau tidak ada penulis yang terdaftar sebagai dosen aktif, publikasi tetap dicatat sebagai belum terpetakan dan ditelusuri secara berkelanjutan.</p></div></li>
        <li><span>03</span><div><h3>Penggabungan Berkas Multi-bagian</h3><p>Berkas data sitasi digabungkan secara otomatis, dideduplikasi berbasis ID dokumen unik, serta divalidasi integritas jumlah baris datanya. Publikasi dibaca dari satu ekspor SciVal utuh; baris metadata dan baris hak cipta bawaan berkas dibuang, dan tanda “-” yang dipakai SciVal untuk nilai kosong dikembalikan menjadi nilai kosong agar tidak terbaca sebagai kategori.</p></div></li>
        <li><span>04</span><div><h3>Penandaan Data Tahun Berjalan</h3><p>Kedua seri memakai tahun berjalan yang berbeda karena sumbernya berbeda. Publikasi, topik, kolaborasi, dan akses terbuka bersumber dari SciVal per 30 Agustus 2026, sehingga 2025 sudah lengkap dan <strong>2026</strong> yang ditandai sebagai tahun berjalan. Sitasi per tahun bersumber dari berkas P2M yang berhenti pada 2025, sehingga <strong>2025</strong> yang ditandai berjalan dan seri itu belum menjangkau 2026. Karena itu rentang tahun antarbagian laporan tidak seragam, dan perbedaan itu sengaja ditampilkan apa adanya.</p></div></li>
        <li><span>05</span><div><h3>Perlindungan Privasi dan Data Pribadi</h3><p>Seluruh informasi identitas pribadi (seperti NIP, NIM, alamat rumah, nomor kontak, serta rekam medis kesehatan individu) disaring dan dianonimkan dari pipeline publikasi.</p></div></li>
        <li><span>06</span><div><h3>Normalisasi Satuan Indikator Kinerja</h3><p>Satuan indikator pada berkas TCK diselaraskan: perolehan <em>creative funding</em> dinormalisasi ke satuan miliar rupiah, dan indikator persentase yang memuat cacah orang dikembalikan evaluasinya ke triwulan yang lengkap persentasenya.</p></div></li>
        <li><span>07</span><div><h3>Deduplikasi dan Rekonsiliasi Sesi Posbindu</h3><p>Data sesi pemeriksaan Posbindu dideduplikasi berdasarkan tanggal dan identitas anonim peserta untuk mencegah penghitungan ganda, dengan pemulihan data sesi awal tahun dari lembar rekapitulasi terpadu.</p></div></li>
        <li><span>08</span><div><h3>Agregasi dan Penyamaran Data Mahasiswa</h3><p>Data mahasiswa diagregasi ke dalam bentuk tabulasi silang statistik tanpa menyertakan identitas perorangan. Sel dengan frekuensi sangat kecil (satu atau dua mahasiswa) disamarkan demi mencegah identifikasi ulang individu.</p></div></li>
        <li><span>09</span><div><h3>Pembaruan Asal Pendidikan Semua Jenjang</h3><p>Workbook per {origins.tanggal} hanya diambil kolom program studi, jenjang, angkatan, SMA, universitas S1, dan universitas S2. Nomor peserta serta NIU pengganti tidak disimpan. Baris dengan atribut anonim yang sama tetap dihitung karena dapat mewakili orang berbeda. Agregat dihitung langsung untuk setiap angkatan dan gabungan; angka gabungan tidak dijumlahkan kembali dengan per-angkatan.</p></div></li>
        <li><span>10</span><div><h3>Beeswarm IPK dan Pilihan Angkatan</h3><p>Satu titik mewakili satu IPK mahasiswa S1 yang tercatat, dengan warna tetap untuk setiap angkatan. Posisi horizontal mempertahankan nilai IPK asli pada skala 0–4; susunan vertikal hanya mencegah titik bertumpuk dan tidak mengukur variabel lain. Semua nilai numerik 0–4, termasuk nol dan nilai ekstrem, disertakan tanpa pengambilan sampel. Nilai diurutkan per prodi/angkatan tanpa nama, NIM, urutan sumber, atau kaitan ke atribut pribadi lain. Kelompok prodi/angkatan kurang dari tiga tidak diterbitkan. Median gabungan dihitung dari seluruh pengamatan, bukan rata-rata median angkatan. Tabel mengikuti filter; CSV tetap memuat ringkasan semua angkatan, termasuk kuartil dengan interpolasi linear dan whisker 1,5 IQR sebagai statistik pendamping. Rujukan konsep: <a href="https://observablehq.com/plot/transforms/dodge">Observable: beeswarm/dodge</a>.</p></div></li>
      </ol>
    </section>

    <section class="data-section" id="anomali">
      <div class="data-section__intro">
        <p class="eyebrow">Transparansi Data</p>
        <h2>Catatan Kualitas Data pada Berkas Sumber</h2>
        <p>Setiap catatan teknis dan ketidaksesuaian administratif pada dokumen resmi disajikan secara terbuka dan apa adanya. Penjelasan metodologis dilampirkan secara transparan untuk mendampingi setiap visualisasi data.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <caption>{flagged.length} dari {tck.length} indikator TCK 2026 disertai catatan teknis dan metodologis</caption>
          <thead><tr><th>No.</th><th>Indikator</th><th>Triwulan Evaluasi</th><th>Catatan Metodologis</th></tr></thead>
          <tbody>{flagged.map((row) => <tr><th scope="row">{row.no}</th><td>{row.indikator}</td><td>{String(row.kuartal_dinilai).toUpperCase()}</td><td>{row.anomali}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="data-section data-section--paper" id="gap">
      <div class="data-section__intro">
        <p class="eyebrow">Agenda Penguatan Data</p>
        <h2>Rencana Integrasi Data Berkelanjutan</h2>
        <p>Aspek yang membutuhkan pengayaan data disajikan sebagai agenda strategis ke depan, lengkap dengan unit penanggung jawab pengelolaannya.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <thead><tr><th>Prioritas</th><th>Kebutuhan Data</th><th>Urgensi &amp; Manfaat</th><th>Unit Pengelola Data</th></tr></thead>
          <tbody>{gaps.map((gap) => <tr><td><span class={`priority priority--${gap.priority.toLowerCase()}`}>{gap.priority}</span></td><th scope="row">{gap.item}</th><td>{gap.reason}</td><td>{gap.owner}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="method-cta">
      <div>
        <p class="eyebrow">Keterbukaan &amp; Keterulangan Data (Reproducibility)</p>
        <h2>Empat Tahapan Pemrosesan Data</h2>
      </div>
      <ol><li><strong>00</strong> Ekstraksi &amp; Konsolidasi</li><li><strong>01</strong> Pembersihan &amp; Normalisasi</li><li><strong>02</strong> Agregasi Berbasis Metrik</li><li><strong>03</strong> Validasi &amp; Penjaminan Mutu</li></ol>
      <p>Seluruh skrip otomasi pemrosesan data tersimpan dalam direktori <code>pipeline/</code> dan dapat dijalankan ulang secara mandiri untuk menghasilkan dataset turunan yang konsisten.</p>
      <a href={homeUrl}>Kembali ke laporan utama →</a>
    </section>
  </main>
</BaseLayout>

