---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const datasets = [
  { file: "tck_2026_joined.json", label: "Indikator TCK 2026", coverage: "42 indikator · target TW1–TW4 · capaian TW1–TW3", source: "SIMASTER", scenes: "1.2, 2.6, 3.5, 4.3–4.5, 5.1–5.2, 6.1" },
  { file: "citations_by_year.json", label: "Sitasi per tahun", coverage: "1987–2025 · 70.905 seluruh arsip", source: "CSV historis FMIPA", scenes: "0.0, 2.1" },
  { file: "publications_by_year_dept.json", label: "Publikasi per departemen", coverage: "2020–2025", source: "SciVal / Scopus", scenes: "2.2" },
  { file: "topics.json", label: "Klaster topik", coverage: "528 klaster SciVal", source: "SciVal", scenes: "2.3" },
  { file: "collab_countries.json", label: "Kolaborasi negara", coverage: "61 negara mitra internasional", source: "SciVal / Scopus", scenes: "2.4" },
  { file: "world-countries.geojson", label: "Batas negara dunia", coverage: "177 negara/teritori · Natural Earth 1:110m · WGS 84", source: "Natural Earth · public domain", scenes: "2.4" },
  { file: "lecturers_positions.json", label: "Jabatan fungsional dosen", coverage: "203 dosen", source: "Data kepegawaian", scenes: "2.5, 5.1" },
  { file: "sinta_by_dept.json", label: "Skor SINTA per departemen", coverage: "Snapshot 3 Desember 2025", source: "SINTA", scenes: "2.6" },
  { file: "funding_by_year.json", label: "Dana riset per tahun", coverage: "2019–2025", source: "Data riset FMIPA", scenes: "3.1" },
  { file: "outreach_points.json", label: "Jangkauan pengabdian", coverage: "2021–2026 · lokasi teragregasi", source: "Surat Tugas / SIMPEL / Hibah", scenes: "3.2" },
  { file: "indonesia-provinces.geojson", label: "Batas provinsi Indonesia", coverage: "38 provinsi · geometri dioptimalkan untuk web", source: "Peta Nusa / Laravel Nusa · MIT", scenes: "3.2" },
  { file: "sdg_matrix.json", label: "Matriks SDG", coverage: "17 tujuan", source: "Data riset + SciVal", scenes: "3.3" },
  { file: "journals.json", label: "Jurnal terbitan FMIPA", coverage: "462 rekaman · 461 terklasifikasi", source: "Data jurnal internal", scenes: "3.4" },
  { file: "value_model.json", label: "Model nilai FMIPA", coverage: "Agregat 2021–2025", source: "Turunan lintas tabel", scenes: "1.3" },
];

const gaps = [
  { priority: "P0", item: "Ekspor CSV/Excel resmi TCK 2026", reason: "Pembanding transkripsi dari tangkapan layar", owner: "Bagian Perencanaan FMIPA" },
  { priority: "P0", item: "Klarifikasi indikator #32", reason: "Nilai hijau bangunan turun 25,55 → 0", owner: "Bagian Perencanaan / Direktorat Aset" },
  { priority: "P0", item: "Jumlah lulusan per prodi dan jenjang", reason: "TCK hanya memuat persentase kelulusan", owner: "Bagian Akademik FMIPA" },
  { priority: "P1", item: "Tracer study rinci", reason: "Sektor, wilayah, dan masa tunggu lulusan", owner: "DPKM / CDC UGM" },
  { priority: "P1", item: "Data K3, kekerasan, dan kesehatan", reason: "Tidak lagi tercakup pada TCK 2026", owner: "Satgas PPKS / HSE" },
  { priority: "P2", item: "Paparan media 2021–2022", reason: "Data yang ada baru mulai 2023", owner: "Humas FMIPA" },
];

const conflicts = [
  { metric: "Guru Besar", tck: "54", historical: "42", explanation: "SIMASTER memuat jendela/SK terbaru; ekspor kepegawaian adalah snapshot berbeda." },
  { metric: "Dosen berkualifikasi S3", tck: "160", historical: "138", explanation: "TCK memakai populasi SIMASTER; snapshot historis mendeteksi gelar doktor pada 138 dari 203 rekaman dosen." },
  { metric: "Sitasi", tck: "3.923", historical: "12.629 (2024)", explanation: "TCK menghitung jendela pelaporan berjalan; CSV menghitung seluruh sitasi yang tercatat pada tahun tersebut." },
  { metric: "Publikasi terindeks", tck: "252", historical: "481 (2025)", explanation: "Periode pelaporan dan basis indeks berbeda." },
];
const homeUrl = withBase("/");
const tckCsvUrl = withBase("/data/tck_2026_indikator.csv");
const datasetUrl = (file: string) => withBase(`/data/${file}`);
const motifStyle = `background-image: url(${JSON.stringify(withBase("/brand/supergraphic-lines.png"))})`;
---

<BaseLayout
  title="Data & Metodologi — Lima Tahun FMIPA"
  description="Sumber, definisi, batasan, dan data turunan di balik Laporan Dekan FMIPA UGM 2026."
  canonicalPath="/data"
>
  <main id="konten-utama">
    <header class="data-hero">
      <div class="data-hero__motif" aria-hidden="true" style={motifStyle}></div>
      <div class="data-hero__inner">
        <p class="data-hero__eyebrow">Lapisan verifikasi</p>
        <h1>Data &amp; Metodologi</h1>
        <p>Setiap angka dalam cerita dapat ditelusuri ke sumber, definisi, dan batasannya. Perbedaan antarsumber dijelaskan—tidak diratakan.</p>
        <a href={homeUrl}>← Kembali ke cerita utama</a>
      </div>
    </header>

    <nav class="data-nav" aria-label="Bagian halaman data">
      <a href="#aturan-sumber">Aturan sumber</a>
      <a href="#dataset">Dataset</a>
      <a href="#definisi">Definisi metrik</a>
      <a href="#konflik">Konflik angka</a>
      <a href="#kualitas">Kualitas data</a>
      <a href="#gap">Data yang dibutuhkan</a>
    </nav>

    <section class="data-section" id="aturan-sumber">
      <div class="data-section__intro">
        <p class="eyebrow">Aturan paling penting</p>
        <h2>Satu Grafik, Satu Keluarga Sumber</h2>
        <p>Data TCK dan data historis menghitung hal yang berbeda. Menggabungkannya dalam satu grafik akan menciptakan tren yang terlihat sah, tetapi secara metodologis salah.</p>
      </div>
      <div class="source-split">
        <article>
          <p class="source-split__label">Babak I · posisi hari ini</p>
          <h3>TCK 2026 — SIMASTER</h3>
          <strong>42 indikator</strong>
          <p>Target kumulatif TW1–TW4 dan capaian kumulatif TW1–TW3, sinkronisasi 19 Agustus 2026 pukul 20.00 WIB.</p>
          <a href={tckCsvUrl} download>Unduh transkripsi CSV</a>
        </article>
        <div class="source-split__divider" aria-label="Tidak dicampur"><span>≠</span><small>tidak dicampur</small></div>
        <article>
          <p class="source-split__label">Babak II · perjalanan lima tahun</p>
          <h3>CSV Historis FMIPA</h3>
          <strong>25 berkas sumber</strong>
          <p>Publikasi, sitasi, riset, pengabdian, SDM, dan luaran institusional dari sistem sumber yang berbeda.</p>
          <a href="#dataset">Lihat data turunannya</a>
        </article>
      </div>
    </section>

    <section class="data-section data-section--paper" id="dataset">
      <div class="data-section__intro">
        <p class="eyebrow">Berkas siap pakai</p>
        <h2>Dataset Turunan</h2>
        <p>Browser hanya menerima data yang sudah teragregasi. Nama, identitas, dan tabel gabungan tingkat individu tidak ikut dipublikasikan.</p>
      </div>
      <div class="dataset-list">
        {datasets.map((dataset) => (
          <article class="dataset-row">
            <div>
              <h3>{dataset.label}</h3>
              <code>{dataset.file}</code>
            </div>
            <p>{dataset.coverage}</p>
            <p><span>Sumber</span>{dataset.source}</p>
            <p><span>Scene</span>{dataset.scenes}</p>
            <a href={datasetUrl(dataset.file)} download aria-label={`Unduh ${dataset.label}`}>{dataset.file.endsWith(".geojson") ? "GeoJSON ↓" : "JSON ↓"}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="data-section" id="definisi">
      <div class="data-section__intro">
        <p class="eyebrow">Kamus metrik</p>
        <h2>Apa yang Sebenarnya Dihitung?</h2>
        <p>Definisi ditempelkan pada angka agar pembaca tidak perlu menebak unit, periode, atau pembandingnya.</p>
      </div>
      <dl class="definition-grid">
        <div><dt>Sitasi</dt><dd>Jumlah sitasi yang tercatat pada tahun tersebut terhadap publikasi FMIPA mana pun, bukan sitasi kumulatif.</dd></div>
        <div><dt>Publikasi</dt><dd>Rekaman Scopus/SciVal berafiliasi FMIPA UGM, seluruh tipe dokumen.</dd></div>
        <div><dt>Dana riset</dt><dd>Jumlah <code>total_funding</code> berdasarkan tahun proposal, seluruh sumber; bukan realisasi anggaran fakultas.</dd></div>
        <div><dt>Kegiatan pengabdian</dt><dd>Satu baris kegiatan dari Surat Tugas, SIMPEL, atau hibah. Lokasi tidak selalu terisi.</dd></div>
        <div><dt>Capaian TCK</dt><dd>Angka kumulatif sejak awal tahun hingga tanggal sinkronisasi, bukan capaian triwulan yang berdiri sendiri.</dd></div>
        <div><dt>Target TCK</dt><dd>Target kumulatif hingga akhir triwulan. Target TW4 adalah target satu tahun penuh.</dd></div>
        <div><dt>Tercapai</dt><dd>Capaian memenuhi atau melampaui target triwulan berjalan dengan memperhitungkan arah indikator.</dd></div>
        <div><dt>Tahun berjalan</dt><dd>Data yang belum selesai terindeks. Segmen ini selalu diberi arsiran dan tidak dibaca sebagai penurunan final.</dd></div>
      </dl>
    </section>

    <section class="data-section data-section--navy" id="konflik">
      <div class="data-section__intro">
        <p class="eyebrow">Transparansi definisi</p>
        <h2>Empat Angka yang Sengaja Tidak Disamakan</h2>
        <p>Selisih ini bukan otomatis berarti ada data yang salah. Setiap sumber memiliki jendela waktu dan populasi yang berbeda.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <caption>Konflik angka yang diketahui antara TCK 2026 dan CSV historis</caption>
          <thead><tr><th>Metrik</th><th>TCK 2026</th><th>CSV historis</th><th>Penjelasan</th></tr></thead>
          <tbody>{conflicts.map((row) => <tr><th scope="row">{row.metric}</th><td>{row.tck}</td><td>{row.historical}</td><td>{row.explanation}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="data-section" id="kualitas">
      <div class="data-section__intro">
        <p class="eyebrow">Catatan pembersihan</p>
        <h2>Yang Diperbaiki dan yang Tetap Terlihat</h2>
      </div>
      <ol class="quality-list">
        <li><span>01</span><div><h3>Lokasi pengabdian</h3><p>Varian provinsi dinormalisasi dengan tabel pemetaan eksplisit. Sebanyak 619 dari 1.610 rekaman tanpa lokasi tetap dihitung sebagai “lokasi tidak tercatat”.</p></div></li>
        <li><span>02</span><div><h3>Departemen publikasi</h3><p>Publikasi tanpa departemen ditampilkan sebagai kategori tersendiri. Tidak ada pemetaan yang ditebak dari judul atau topik.</p></div></li>
        <li><span>03</span><div><h3>File multi-part</h3><p>Lima bagian sitasi dan dua bagian publikasi selalu dibaca dengan glob, dideduplikasi memakai <code>Id</code>, lalu diuji jumlah barisnya.</p></div></li>
        <li><span>04</span><div><h3>Tahun berjalan</h3><p>Publikasi dan sitasi 2025 diberi status indeksasi berjalan agar jeda Scopus tidak dibaca sebagai penurunan kinerja.</p></div></li>
        <li><span>05</span><div><h3>Privasi</h3><p>Nama, NIP/NIKA/NIM, ID Scopus per orang, dan tabel gabungan tingkat individu dibuang sebelum data masuk ke situs.</p></div></li>
      </ol>
    </section>

    <section class="data-section data-section--paper" id="gap">
      <div class="data-section__intro">
        <p class="eyebrow">Daftar belanja data</p>
        <h2>Yang Masih Dibutuhkan</h2>
        <p>Scene yang belum memiliki data tetap hadir sebagai pertanyaan terbuka. Tabel ini menunjukkan siapa yang dapat menjawabnya.</p>
      </div>
      <div class="table-wrap" tabindex="0">
        <table>
          <thead><tr><th>Prioritas</th><th>Data</th><th>Mengapa dibutuhkan</th><th>Pemilik</th></tr></thead>
          <tbody>{gaps.map((gap) => <tr><td><span class={`priority priority--${gap.priority.toLowerCase()}`}>{gap.priority}</span></td><th scope="row">{gap.item}</th><td>{gap.reason}</td><td>{gap.owner}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="method-cta">
      <div>
        <p class="eyebrow">Dapat direproduksi</p>
        <h2>Empat Langkah dari CSV ke Cerita</h2>
      </div>
      <ol><li><strong>00</strong> Muat dan gabungkan</li><li><strong>01</strong> Bersihkan dan minimalkan</li><li><strong>02</strong> Agregasikan</li><li><strong>03</strong> Validasi</li></ol>
      <p>Pipeline berada di folder <code>pipeline/</code>. Satu perintah membangun ulang seluruh data turunan tanpa perhitungan di browser.</p>
      <a href={homeUrl}>Baca kembali cerita utama →</a>
    </section>
  </main>
</BaseLayout>

<style>
  .data-hero { position: relative; overflow: hidden; padding: clamp(72px, 10vw, 132px) var(--page-gutter); background: var(--ugm-blue-deep); color: #fff; }
  .data-hero__inner { position: relative; z-index: 1; width: min(100%, var(--content-max)); margin-inline: auto; }
  .data-hero__eyebrow, .data-section .eyebrow, .method-cta .eyebrow { margin: 0 0 18px; color: var(--ugm-gold); font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .data-hero h1 { color: #fff; font-family: var(--font-display); font-size: clamp(52px, 8vw, 100px); line-height: .95; }
  .data-hero p:not(.data-hero__eyebrow) { max-width: 700px; margin: 26px 0 0; color: rgba(255,255,255,.76); font-size: clamp(18px, 2vw, 23px); }
  .data-hero a { display: inline-block; margin-block-start: 34px; color: #fff; font-weight: 700; }
  .data-hero__motif { position: absolute; inset: -30% -10% auto auto; width: min(65vw, 820px); aspect-ratio: 1; opacity: .1; filter: brightness(0) invert(1); background-position: center; background-size: contain; background-repeat: no-repeat; }
  .data-nav { position: sticky; z-index: 20; top: 72px; padding: 12px var(--page-gutter); border-bottom: 1px solid var(--border-subtle); background: var(--surface-page); display: flex; justify-content: center; gap: 20px; overflow-x: auto; }
  .data-nav a { flex: none; color: var(--text-secondary); font-size: 12px; font-weight: 700; text-decoration: none; }
  .data-section { padding: clamp(76px, 9vw, 124px) var(--page-gutter); scroll-margin-top: 120px; }
  .data-section--paper { background: var(--surface-subtle); }
  .data-section--navy { background: var(--ugm-blue-deep); color: #fff; }
  .data-section > * { width: min(100%, 1100px); margin-inline: auto; }
  .data-section__intro { max-width: 760px; margin-inline: auto; }
  .data-section__intro h2 { color: inherit; font-family: var(--font-display); font-size: clamp(38px, 5vw, 64px); line-height: 1.03; }
  .data-section__intro > p:last-child { margin: 22px 0 0; color: var(--text-secondary); font-size: 19px; line-height: 1.55; }
  .data-section--navy .data-section__intro > p:last-child { color: rgba(255,255,255,.72); }
  .source-split { margin-block-start: 56px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 26px; align-items: stretch; }
  .source-split article { min-height: 330px; padding: clamp(28px, 4vw, 44px); border: 1px solid var(--border-default); border-top: 4px solid var(--ugm-blue); background: var(--surface-card); }
  .source-split__label { margin: 0 0 18px; color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .source-split h3 { color: var(--text-primary); font-size: 25px; }
  .source-split strong { display: block; margin-block-start: 28px; color: var(--ugm-blue); font-size: 40px; font-weight: 300; }
  .source-split article > p:not(.source-split__label) { margin: 14px 0 26px; color: var(--text-secondary); }
  .source-split__divider { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--status-missed); }
  .source-split__divider span { font-size: 40px; }.source-split__divider small { writing-mode: vertical-rl; margin-block-start: 8px; color: var(--text-muted); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  .dataset-list { margin-block-start: 52px; border-block-start: 1px solid var(--border-default); }
  .dataset-row { display: grid; grid-template-columns: 1.5fr 1fr 1fr .75fr auto; gap: 20px; align-items: center; padding-block: 22px; border-block-end: 1px solid var(--border-default); }
  .dataset-row h3 { color: var(--text-primary); font-family: var(--font-ui); font-size: 16px; }.dataset-row code { color: var(--text-muted); font-size: 11px; }.dataset-row p { color: var(--text-secondary); font-size: 13px; }.dataset-row p span { display: block; margin-block-end: 4px; color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }.dataset-row > a { min-height: 44px; padding: 10px 12px; border: 1px solid var(--ugm-blue); border-radius: 4px; font-size: 12px; font-weight: 700; text-decoration: none; }
  .definition-grid { margin-block-start: 52px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 48px; border-block-start: 1px solid var(--border-subtle); }
  .definition-grid > div { padding-block: 26px; border-block-end: 1px solid var(--border-subtle); }.definition-grid dt { color: var(--ugm-blue); font-size: 18px; font-weight: 700; }.definition-grid dd { margin: 9px 0 0; color: var(--text-secondary); font-size: 14px; }
  .table-wrap { margin-block-start: 48px; overflow-x: auto; }.table-wrap table { min-width: 760px; }.data-section--navy table { color: #fff; }.data-section--navy th { color: var(--ugm-gold); }.data-section--navy th,.data-section--navy td { border-color: rgba(255,255,255,.2); }.table-wrap td,.table-wrap th { padding-block: 16px; font-size: 14px; }
  .quality-list { margin-block-start: 52px; padding: 0; list-style: none; border-block-start: 1px solid var(--border-subtle); }.quality-list li { display: grid; grid-template-columns: 70px 1fr; gap: 24px; padding-block: 28px; border-block-end: 1px solid var(--border-subtle); }.quality-list > li > span { color: var(--ugm-gold); -webkit-text-stroke: 1px var(--ugm-blue); font-size: 32px; font-weight: 700; }.quality-list h3 { color: var(--text-primary); font-family: var(--font-ui); font-size: 19px; }.quality-list p { max-width: 76ch; margin: 8px 0 0; color: var(--text-secondary); }
  .priority { display: inline-block; min-width: 42px; padding: 4px 7px; border: 1px solid currentColor; border-radius: 4px; font-size: 11px; font-weight: 700; text-align: center; }.priority--p0 { color: var(--status-missed); }.priority--p1 { color: var(--status-lagging); }.priority--p2 { color: var(--status-approaching); }
  .method-cta { padding: clamp(76px, 9vw, 124px) var(--page-gutter); background: var(--ugm-blue); color: #fff; }.method-cta > * { width: min(100%, 1000px); margin-inline: auto; }.method-cta h2 { color: #fff; font-size: clamp(38px, 5vw, 64px); }.method-cta ol { margin-block: 44px 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid rgba(255,255,255,.24); }.method-cta li { min-height: 150px; padding: 24px; display: flex; flex-direction: column; gap: 14px; }.method-cta li + li { border-inline-start: 1px solid rgba(255,255,255,.24); }.method-cta li strong { color: var(--ugm-gold); font-size: 28px; }.method-cta > p { color: rgba(255,255,255,.76); }.method-cta > a { display: block; margin-block-start: 28px; color: #fff; font-weight: 700; }
  @media(max-width:900px){.dataset-row{grid-template-columns:1fr 1fr}.dataset-row>div{grid-column:1/-1}.dataset-row>a{justify-self:start}.method-cta ol{grid-template-columns:repeat(2,1fr)}.method-cta li:nth-child(3){border-inline-start:0;border-block-start:1px solid rgba(255,255,255,.24)}.method-cta li:nth-child(4){border-block-start:1px solid rgba(255,255,255,.24)}}
  @media(max-width:700px){.data-nav{justify-content:flex-start;top:64px}.source-split{grid-template-columns:1fr}.source-split__divider small{writing-mode:horizontal-tb}.definition-grid{grid-template-columns:1fr}.dataset-row{grid-template-columns:1fr}.method-cta ol{grid-template-columns:1fr}.method-cta li+li{border-inline-start:0;border-block-start:1px solid rgba(255,255,255,.24)}}
</style>
