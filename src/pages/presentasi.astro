---
/**
 * Bahan tayang Rapat Senat Terbuka — Laporan Dekan FMIPA UGM 2021–2026.
 *
 * Aturan pokok halaman ini: bahan tayang TIDAK PERNAH menggambar ulang datanya
 * sendiri. Setiap grafik di sini adalah komponen yang sama persis dengan yang
 * dipakai halaman laporan, dengan berkas turunan dan properti yang sama, hanya
 * dengan naskah yang dipadatkan untuk dibaca dari kursi belakang. Karena itu
 * angka di layar rapat mustahil berselisih dengan angka di web data story yang
 * dipindai penonton lewat QR.
 *
 * Delapan belas slide, lima pilar - taksonomi yang sama dengan halaman laporan,
 * supaya penonton yang berpindah dari layar ke ponselnya menemukan pembagian
 * yang sama. Slide pemisah pilar sengaja dihitung sebagai slide penuh: ia hanya
 * menahan tiga detik, dan itulah yang memberi jeda antar-babak.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PresentationSlide from "../components/PresentationSlide.astro";
import LineAreaChart from "../components/charts/LineAreaChart.astro";
import StackedBarChart from "../components/charts/StackedBarChart.astro";
import HorizontalBarChart from "../components/charts/HorizontalBarChart.astro";
import TrendRows from "../components/charts/TrendRows.astro";
import DotMatrix from "../components/charts/DotMatrix.astro";
import WorldMap from "../components/charts/WorldMap.astro";
import PointMap from "../components/charts/PointMap.astro";
import ChoroplethMap from "../components/charts/ChoroplethMap.astro";
import { ACCENT, DEPT, SEQ, UGM_BLUE } from "../lib/palette";
import { centroidForProvince } from "../lib/province-centroids";
import { countryNameId } from "../lib/country-centroids";
import { withBase } from "../lib/paths";
import "../styles/presentation.css";
import "../styles/deck-motion.css";

import citationsRaw from "../data/derived/citations_by_year.json";
import countriesRaw from "../data/derived/collab_countries.json";
import fundingRaw from "../data/derived/funding_by_year.json";
import outreachRaw from "../data/derived/outreach_by_year.json";
import outreachPointsRaw from "../data/derived/outreach_points.json";
import partnershipsRaw from "../data/derived/partnerships_by_year.json";
import partnershipRevenueRaw from "../data/derived/partnership_revenue.json";
import publicationsRaw from "../data/derived/publications_by_year_dept.json";
import professorTenureRaw from "../data/derived/professor_tenure.json";
import institutionRaw from "../data/derived/institution_snapshot.json";
import accreditationRaw from "../data/derived/accreditation.json";
import lecturersRaw from "../data/derived/lecturers_positions.json";
import activeStudentsRaw from "../data/derived/active_students.json";
import tracerSectorsRaw from "../data/derived/tracer_sectors.json";
import tracerSummaryRaw from "../data/derived/tracer_summary.json";
import tckRaw from "../data/derived/tck_2026_joined.json";
import snapshotRaw from "../data/derived/snapshot.json";
import studentAccessRaw from "../data/derived/students_access.json";
import studentSummaryRaw from "../data/derived/students_summary.json";
import studentProvinceRaw from "../data/derived/students_by_province.json";

const format = (value: number, digits = 0) =>
  new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);
const snapshot = snapshotRaw as { label: string; p2m: string; lentera: string; scival: string };
const homeUrl = withBase("/");
const BILLION = 1_000_000_000;

/* --- Sitasi -------------------------------------------------------------- */
/* Rentangnya berhenti di 2025 dan itu disengaja: berkas sitasi P2M memang
   berakhir di sana, sementara ekspor SciVal (publikasi, kolaborasi) berjalan
   sampai 2026. Menyamakan keduanya justru akan salah. */
const citationRows = citationsRaw as any[];
const citations: any[] = citationRows.filter((row) => row.year >= 2019 && row.year <= 2025);
const citationTotal = citationRows.reduce((sum, row) => sum + row.citations, 0);
const citationPeriod = citationRows
  .filter((row) => row.year >= 2021 && row.year <= 2025)
  .reduce((sum, row) => sum + row.citations, 0);
const citationShare = (citationPeriod / citationTotal) * 100;
const citationPeak = citationRows.find((row) => row.year === 2024)?.citations ?? 0;
const citationFirst = citationRows.find((row) => row.year === 2021)?.citations ?? 0;

/* --- Publikasi per departemen -------------------------------------------- */
const departmentKey: Record<string, string> = {
  Fisika: "fisika",
  "Ilmu Komputer dan Elektronika": "ike",
  Kimia: "kimia",
  Matematika: "matematika",
  "Belum terpetakan": "unmapped",
};
const publicationYears = [...new Set((publicationsRaw as any[]).map((row) => row.year))].sort((a, b) => a - b);
const publications: any[] = publicationYears.map((year) => {
  const row: Record<string, any> = { year };
  Object.values(departmentKey).forEach((key) => { row[key] = 0; });
  (publicationsRaw as any[])
    .filter((item) => item.year === year)
    .forEach((item) => { row[departmentKey[item.department] ?? "unmapped"] += item.count; });
  return row;
});
const publicationSeries = [
  { key: "fisika", label: "Fisika", color: DEPT.fisika, pattern: "solid" },
  { key: "ike", label: "Ilmu Komputer & Elektronika", color: DEPT.ike, pattern: "diagonal" },
  { key: "kimia", label: "Kimia", color: DEPT.kimia, pattern: "dots" },
  { key: "matematika", label: "Matematika", color: DEPT.matematika, pattern: "cross" },
  { key: "unmapped", label: "Belum terpetakan", color: DEPT.unmapped, pattern: "diagonal" },
] as any;
const publicationTotal = (publicationsRaw as any[]).reduce((sum, row) => sum + row.count, 0);
const publicationUnmapped = (publicationsRaw as any[])
  .filter((row) => row.department === "Belum terpetakan")
  .reduce((sum, row) => sum + row.count, 0);
const publicationMappedShare = ((publicationTotal - publicationUnmapped) / publicationTotal) * 100;

/* --- Kolaborasi internasional -------------------------------------------- */
const collabCountries: any[] = (countriesRaw as any[]).slice(0, 12).map((row) => ({
  name: countryNameId(row.country),
  value: row.n,
  iso3: row.iso3,
}));
const collabTop = collabCountries[0];

/* --- Dana riset ----------------------------------------------------------- */
const funding: any[] = (fundingRaw as any[])
  .filter((row) => row.type === "Total" && row.year >= 2019 && row.year <= 2025)
  .map((row) => ({ year: row.year, amount: row.amount / BILLION }));
const fundingByYear = new Map(funding.map((row) => [row.year, row.amount]));
const funding2021 = fundingByYear.get(2021) ?? 0;
const funding2024 = fundingByYear.get(2024) ?? 0;
const fundingMultiple = funding2021 > 0 ? funding2024 / funding2021 : 0;

/* --- Pengabdian ----------------------------------------------------------- */
/* Titik peta disusun persis seperti di halaman laporan: kegiatan yang provinsinya
   tercatat dipetakan ke centroid provinsi, sisanya dilaporkan sebagai satu
   kelompok "belum dapat dipetakan" - dilaporkan, bukan dibuang diam-diam. */
const outreachMap = new Map<string, any>();
const outreachUnmapped = new Map<number, number>();
for (const row of outreachPointsRaw as any[]) {
  if (!row.year || row.year < 2021 || row.year > 2025) continue;
  const centroid = centroidForProvince(row.province);
  if (!centroid || row.location_status !== "recorded") {
    outreachUnmapped.set(row.year, (outreachUnmapped.get(row.year) ?? 0) + row.n);
    continue;
  }
  const key = `${row.year}|${row.province}`;
  const current = outreachMap.get(key) ?? {
    year: row.year, label: row.province, lat: centroid[0], lng: centroid[1],
    value: 0, detail: "Centroid provinsi pada batas GeoJSON",
  };
  current.value += row.n;
  outreachMap.set(key, current);
}
const outreachPoints: any[] = [
  ...outreachMap.values(),
  ...[...outreachUnmapped].map(([year, value]) => ({
    year, label: "Lokasi belum dapat dipetakan", lat: Number.NaN, lng: Number.NaN, value,
    detail: "Kegiatan daring, lintas wilayah provinsi, atau di luar negeri",
  })),
];
const outreachByYear = new Map((outreachRaw as any[]).map((row) => [row.year, row.n]));
const outreach2021 = outreachByYear.get(2021) ?? 0;
const outreach2025 = outreachByYear.get(2025) ?? 0;
const outreachProvinces = new Set([...outreachMap.values()].map((row) => row.label)).size;

/* --- Kerja sama ----------------------------------------------------------- */
const partnershipByYear = new Map<number, number>();
(partnershipsRaw as any[]).forEach((row) => {
  partnershipByYear.set(row.tahun, (partnershipByYear.get(row.tahun) ?? 0) + row.n);
});
const revenue = partnershipRevenueRaw as any;

/* --- Lintasan lima tahun --------------------------------------------------
   Slide pengganti "linimasa peristiwa". Empat lintasan kuantitatif ini
   menyampaikan tren kinerja secara akuntabel dan berbasis data terverifikasi. */
const journeyYears = [2021, 2022, 2023, 2024, 2025];
const journeyRows: any[] = [
  {
    label: "Sitasi Karya Ilmiah",
    color: ACCENT.navy,
    values: journeyYears.map((year) => citationRows.find((row) => row.year === year)?.citations ?? null),
  },
  {
    label: "Perolehan Dana Riset (Rp M)",
    color: ACCENT.orange,
    values: journeyYears.map((year) => fundingByYear.get(year) ?? null),
  },
  {
    label: "Kegiatan Pengabdian Masyarakat",
    color: ACCENT.teal,
    values: journeyYears.map((year) => outreachByYear.get(year) ?? null),
  },
  {
    label: "Dokumen Kerja Sama & Kemitraan",
    color: ACCENT.amber,
    values: journeyYears.map((year) => partnershipByYear.get(year) ?? null),
  },
];

/* --- Potret institusi ------------------------------------------------------ */
const accreditation = accreditationRaw as any;
const activeStudents = (activeStudentsRaw as any[]).reduce((sum, row) => sum + row.mahasiswa, 0);
const activePeriod = [...new Set((activeStudentsRaw as any[]).map((row) => row.tahun_ajaran))][0];
const positionCounts = new Map<string, number>();
(lecturersRaw as any[]).forEach((row) => positionCounts.set(row.position, (positionCounts.get(row.position) ?? 0) + row.n));
const professorCount = positionCounts.get("Guru Besar") ?? 0;
const seniorCount = professorCount + (positionCounts.get("Lektor Kepala") ?? 0) + (positionCounts.get("Lektor") ?? 0);
const seniorShare = (seniorCount / institutionRaw.lecturers) * 100;
const doctoralShare = (institutionRaw.lecturer_doctoral / institutionRaw.lecturers) * 100;
const portraitCards = [
  { label: "Dosen Aktif", value: format(institutionRaw.lecturers), description: `${format(institutionRaw.lecturer_doctoral)} berpendidikan Doktor (${format(doctoralShare, 1)}%)` },
  { label: "Tenaga Kependidikan", value: format(institutionRaw.academic_staff), description: "Mendukung layanan tridarma (SIMASTER 2026)" },
  { label: "Program Studi", value: format(institutionRaw.study_programmes), description: `100% terakreditasi Unggul · ${format(accreditation.prodi_internasional)} terakreditasi internasional` },
  { label: "Laboratorium", value: format(institutionRaw.laboratories), description: "Fasilitas riset dan pembelajaran di 4 departemen" },
  { label: "Mahasiswa Aktif", value: format(activeStudents), description: `Jenjang Sarjana & Pascasarjana (Gasal ${activePeriod})` },
  { label: "Guru Besar Aktif", value: format(professorCount), description: `${format(seniorShare, 1)}% dosen mengemban jabatan Lektor ke atas` },
];

/* --- Employability -------------------------------------------------------- */
const tracerSummary = tracerSummaryRaw as any;
const tracerRamp = [SEQ[700], SEQ[550], SEQ[400], SEQ[250], SEQ[100]];
const tracerNonSector = (tracerSectorsRaw as any[])
  .filter((row) => row.sektor === "Belum bekerja" || row.sektor === "Lainnya")
  .reduce((sum, row) => sum + row.n, 0);
const tracerRanked = (tracerSectorsRaw as any[])
  .filter((row) => row.sektor !== "Belum bekerja" && row.sektor !== "Lainnya")
  .sort((a, b) => b.n - a.n);
const tracerSectors: any[] = tracerRanked.map((row, index) => ({
  label: row.sektor,
  value: row.n,
  color: tracerRamp[Math.min(tracerRamp.length - 1, Math.floor((index / Math.max(1, tracerRanked.length - 1)) * tracerRamp.length))],
}));
const tracerRealSectors = tracerRanked.length;

/* --- Mahasiswa & akses ----------------------------------------------------- */
const students = studentSummaryRaw as any;
const studentAccess = studentAccessRaw as any;
const studentYears = students.tahun as number[];
const isProvinceCode = (code: unknown) => /^\d+$/.test(String(code ?? ""));
const provinceMap = (studentAccess.provinsi_total as any[])
  .filter((row) => isProvinceCode(row.provinsi_kode))
  .map((row) => ({ code: row.provinsi_kode, name: row.provinsi, value: row.n, withheld: Boolean(row.disamarkan) }));
const provincePanels = studentYears.map((year) => ({
  label: String(year),
  data: (studentProvinceRaw as any[])
    .filter((row) => row.angkatan === year && isProvinceCode(row.provinsi_kode))
    .map((row) => ({ code: row.provinsi_kode, name: row.provinsi, value: row.n, withheld: Boolean(row.disamarkan) })),
}));

/* --- Kesejahteraan --------------------------------------------------------- */
const tenure = professorTenureRaw as any;
const tenureGroups: any[] = [
  {
    label: "Pengukuhan 2021–2026",
    count: tenure.periode_ini,
    color: DEPT.fisika,
    description: `${format((tenure.periode_ini / tenure.total) * 100, 1)}% dari total Guru Besar aktif saat ini`,
  },
  {
    label: "Pengukuhan Sebelum 2021",
    count: tenure.sebelumnya,
    color: SEQ[250],
    description: "Pengukuhan pada periode kepemimpinan sebelumnya",
  },
];

/* --- Capaian kinerja -------------------------------------------------------- */
const tck = tckRaw as any[];
const tckAchieved = tck.filter((row) => row.status_kuartal === "tercapai").length;
const tckNear = tck.filter((row) => row.status_kuartal === "mendekati").length;
const tckBehind = tck.length - tckAchieved - tckNear;
const tckBehindByPillar = ["Reputasi", "Kontribusi", "Employability", "Kesejahteraan"]
  .map((pilar) => ({
    pilar,
    n: tck.filter((row) => row.pilar === pilar && row.status_kuartal !== "tercapai" && row.status_kuartal !== "mendekati").length,
  }))
  .filter((row) => row.n > 0)
  .sort((a, b) => b.n - a.n);
---

<BaseLayout
  title="Bahan Tayang Rapat Senat Terbuka — Laporan Dekan FMIPA UGM 2021–2026"
  description="Bahan tayang resmi Rapat Senat Terbuka Pidato Laporan Pertanggungjawaban Dekan FMIPA UGM Periode 2021–2026."
  canonicalPath="/presentasi"
  chrome={false}
  bodyClass="presentation-page presentation-mode"
>
  <main id="konten-utama" class="deck" data-deck>
    <!-- 01 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="01"
      layout="title"
      kicker="Rapat Senat Terbuka · Pidato Pertanggungjawaban Dekan"
      title="Meneguhkan Sains Berdampak"
      takeaway="Pertanggungjawaban lima tahun masa bakti FMIPA UGM (2021–2026) disajikan secara transparan dan akuntabel, berbasis data sahih yang dapat ditelusuri hingga ke pangkalan data sumbernya."
      presenter="Prof. Dr. Eng. Kuwat Triyana, M.Si."
      presenterRole="Dekan FMIPA Universitas Gadjah Mada"
      period="Masa jabatan 2021–2026"
      note="Awali dengan kilas balik awal masa bakti tahun 2021 di tengah puncak pandemi: pembatasan aktivitas riset di laboratorium serta adaptasi darurat ke pembelajaran daring. Tegaskan komitmen keterbukaan dan integritas akademik: memaparkan seluruh capaian kinerja secara apa adanya, baik target yang telah terlampaui maupun agenda yang masih terus berproses sebagaimana tersaji pada data story digital fakultas."
    />

    <!-- 02 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="02"
      kicker="Kilas Balik Kinerja"
      title="Dinamika dan Akselerasi Kinerja Lima Tahun"
      takeaway="Tiga pilar kinerja mengalami akselerasi serentak pascapandemi mulai tahun 2022: perolehan dana riset, pengabdian kepada masyarakat, dan kemitraan strategis. Sementara itu, sitasi karya ilmiah menunjukkan tren pertumbuhan yang konsisten dan berkelanjutan sepanjang lima tahun."
      stat={`${format(fundingMultiple, 0)}×`}
      statLabel={`kenaikan perolehan dana riset fakultas (dari Rp${format(funding2021, 1)} M pada 2021 menjadi Rp${format(funding2024, 1)} M pada 2024)`}
      statNote="Skala grafik dinormalisasi secara mandiri sesuai satuan ukur masing-masing indikator. Data sitasi tahun 2025 masih dalam proses indeksasi berjalan."
      source="Sitasi P2M · dana riset FMIPA · Surat Tugas dan SIMPEL · LENTERA UGM"
      note="Ajak hadirin mencermati titik tolak tahun 2021 dan momentum kebangkitan yang pesat sejak 2022. Tekankan bahwa paparan ini menyajikan jejak kinerja kuantitatif yang terukur dan dapat diverifikasi, melengkapi dokumentasi kualitatif pada buku laporan resmi."
    >
      <TrendRows
        data={journeyRows}
        periods={journeyYears}
        scale="row"
        width={660}
        rowHeight={78}
        title="Tren Lintasan Kinerja Utama FMIPA 2021–2025"
        hideHeader
        axisLabel="Skala grafik dinormalisasi per baris indikator"
        valueFormatter={(value: number) => format(value, 1)}
      />
    </PresentationSlide>

    <!-- 03 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="03"
      layout="cards"
      kicker="Profil Sumber Daya"
      title="Potret Sumber Daya dan Kapasitas Akademik FMIPA"
      takeaway={`Didukung 18 program studi yang seluruhnya terakreditasi Unggul nasional, keunggulan FMIPA digerakkan oleh ${format(institutionRaw.lecturers)} dosen berdedikasi dan ${format(institutionRaw.academic_staff)} tenaga kependidikan profesional.`}
      items={portraitCards}
      source={`Roster SIMASTER ${institutionRaw.lecturer_source.split(", ")[1]} · registrasi mahasiswa ${activePeriod} · akreditasi prodi 2026`}
      note="Garis bawahi profil keunggulan SDM dan mutu akademik fakultas saat ini. Bila terdapat pertanyaan mengenai pemutakhiran data dosen dan tenaga kependidikan, sampaikan bahwa angka merujuk pada pangkalan data kepegawaian SIMASTER per September 2026 yang menggambarkan status aktif terkini."
    />

    <!-- 04 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="I"
      layout="divider"
      accent="blue"
      kicker="Pilar I"
      title="Reputasi Akademik & Keunggulan Riset"
      takeaway="Rekognisi internasional melalui lompatan sitasi global, produktivitas publikasi terindeks, dan kemitraan riset lintas negara."
      note="Beri jeda sejenak. Tegaskan bahwa reputasi akademik merupakan tolok ukur rekognisi global sekaligus penopang utama pemeringkatan universitas di kancah internasional."
    />

    <!-- 05 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="05"
      kicker="Pilar I · Reputasi Akademik"
      title="Mayoritas Sitasi Ilmiah FMIPA Diraih pada Kurun Waktu 2021–2025"
      takeaway={`Dari total ${format(citationTotal)} sitasi yang dicatatkan sejak 1987, sebanyak ${format(citationShare, 1)}% berhasil diraih hanya dalam periode 2021–2025—membuktikan lonjakan mutu dan keterbacaan riset sivitas di tingkat dunia.`}
      stat={format(citationPeriod)}
      statLabel="total sitasi ilmiah dihimpun pada periode 2021–2025"
      statNote="Catatan: Data tahun 2025 masih terus bertambah seiring pemutakhiran berkala pangkalan data sitasi Scopus dan P2M."
      source="Berkas sitasi P2M FMIPA UGM"
      note={`Soroti capaian puncak pada tahun 2024 dengan ${format(citationPeak)} sitasi (hampir dua kali lipat dibanding capaian 2021 sebesar ${format(citationFirst)}). Sampaikan secara proaktif bahwa kurva tahun 2025 masih terus bergerak naik mengikuti proses indeksasi berjalan (indexing lag), bukan penurunan produktivitas.`}
    >
      <LineAreaChart
        data={citations}
        xKey="year"
        series={[{ key: "citations", label: "Sitasi", color: UGM_BLUE }]}
        width={640}
        height={400}
        title="Dinamika Sitasi Karya Ilmiah per Tahun"
        hideHeader
        area
        yLabel="Jumlah sitasi per tahun"
        showMarkers
        provisionalX={2025}
        provisionalLabel="Indeksasi berjalan"
        valueFormatter={(value: number) => format(value)}
      />
    </PresentationSlide>

    <!-- 06 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="06"
      kicker="Pilar I · Reputasi Akademik"
      title="Produktivitas Publikasi Ilmiah Tumbuh Merata di Seluruh Departemen"
      takeaway="Meskipun Departemen Kimia mencatatkan volume publikasi terbesar, seluruh departemen di lingkungan FMIPA menunjukkan tren peningkatan produktivitas riset yang seirama dan solid."
      stat={format(publicationTotal)}
      statLabel="total publikasi terindeks Scopus (2020–2026)"
      statNote={`Sebanyak ${format(publicationMappedShare, 1)}% artikel telah terverifikasi per departemen pengampu; data tahun berjalan 2026 terus dimutakhirkan sesuai proses pengindeksan Scopus.`}
      source={`SciVal / Scopus · pemutakhiran ${snapshot.scival}`}
      note="Jelaskan bahwa publikasi bersumber dari basis data SciVal/Scopus teranyar. Apabila anggota senat menanyakan perbedaan rentang waktu dengan data sitasi sebelumnya, jelaskan bahwa data publikasi memuat rekaman artikel hingga awal 2026, sedangkan data sitasi P2M berbasis tutup buku tahunan 2025."
    >
      <StackedBarChart
        data={publications}
        xKey="year"
        series={publicationSeries}
        width={680}
        height={440}
        title="Komposisi Publikasi Terindeks Scopus per Departemen"
        hideHeader
        yLabel="Jumlah publikasi terindeks"
        provisionalX={2026}
        provisionalLabel="Indeksasi berjalan"
        valueFormatter={(value: number) => format(value)}
      />
    </PresentationSlide>

    <!-- 07 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="07"
      kicker="Pilar I · Reputasi Akademik"
      title="Jejaring Publikasi Kolaboratif Menjangkau Puluhan Negara"
      takeaway={`Karya publikasi kolaboratif FMIPA UGM terwujud bersama peneliti dari ${format((countriesRaw as any[]).length)} negara mitra, dengan kemitraan terkuat bersama institusi di ${collabTop?.name}, disusul jejaring luas di kawasan Asia Timur dan Eropa.`}
      source={`SciVal / Scopus · batas Natural Earth 1:110m · pemutakhiran ${snapshot.scival}`}
      note="Tegaskan bahwa internasionalisasi riset FMIPA tidak sebatas penandatanganan naskah kerja sama formal, melainkan termanifestasi nyata dalam publikasi riset bersama (joint publication) berbobot tinggi. Arahkan perhatian hadirin pada daftar negara mitra utama di sisi visual."
    >
      <WorldMap
        data={collabCountries}
        arcs
        title="Peta Jejaring Kolaborasi Publikasi Internasional"
        hideHeader
        valueLabel="karya publikasi bersama"
        topCount={8}
        valueFormatter={(value: number) => format(value)}
      />
    </PresentationSlide>

    <!-- 08 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="II"
      layout="divider"
      accent="orange"
      kicker="Pilar II"
      title="Kontribusi Nyata bagi Kemaslahatan Bangsa"
      takeaway="Diversifikasi sumber pendanaan riset kompetitif dan ekspansi kegiatan pengabdian kepada masyarakat di pelosok nusantara."
      note="Beri jeda sejenak. Sampaikan bahwa pilar ini menandai lompatan terbesar dalam kemandirian pendanaan serta perluasan hilirisasi sains bagi kemaslahatan masyarakat luas."
    />

    <!-- 09 ---------------------------------------------------------------- -->
    <PresentationSlide
      number="09"
      kicker="Pilar II · Kontribusi bagi Bangsa"
      title="Peningkatan Eksponensial Perolehan Dana Riset Fakultas"
