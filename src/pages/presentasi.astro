  <nav class="deck-bar" aria-label="Kontrol navigasi presentasi">
    <a href={homeUrl} title="Kembali ke laporan utama">Laporan utama</a>
    <button type="button" data-deck-prev aria-label="Slide sebelumnya">←</button>
    <span data-deck-counter aria-live="polite">1 / 18</span>
    <button type="button" data-deck-next aria-label="Slide berikutnya">→</button>
    <button type="button" data-deck-notes-toggle aria-pressed="false" title="Catatan presenter (N)">Catatan</button>
    <button type="button" data-deck-full title="Layar penuh (F)">Layar penuh</button>
  </nav>
  <div class="deck-progress" aria-hidden="true"><i data-deck-progress></i></div>
  <p class="deck-hint">← → berpindah slide · N catatan presenter · F layar penuh</p>

  <script>
    /* Lapisan interaksi grafik yang sama dengan halaman laporan: tooltip,
       tombol angkatan pada peta titik, dan tab angkatan pada peta koroplet.
       Tanpa ini tombol-tombol itu terender tetapi tidak melakukan apa pun,
       dan presenter yang menekannya di depan senat akan mendapati grafik yang
       diam. */
    import "../scripts/charts";

    /* ---------------------------------------------------------------------
       Mesin deck. Tugasnya tiga: memindah slide, melepas satu kelas gerak,
       dan menyetel jeda pada tanda-tanda di dalam grafik. Ia tidak
       menganimasikan apa pun sendiri — seluruh gerak adalah transisi CSS di
       src/styles/deck-motion.css.
       --------------------------------------------------------------------- */
    const deck = document.querySelector<HTMLElement>("[data-deck]");
    const slides = [...document.querySelectorAll<HTMLElement>("[data-deck-slide]")];
    const counter = document.querySelector<HTMLElement>("[data-deck-counter]");
    const progress = document.querySelector<HTMLElement>("[data-deck-progress]");
    const prev = document.querySelector<HTMLButtonElement>("[data-deck-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-deck-next]");
    const notesToggle = document.querySelector<HTMLButtonElement>("[data-deck-notes-toggle]");
    const fullscreen = document.querySelector<HTMLButtonElement>("[data-deck-full]");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* --- Jeda antar-tanda di dalam grafik -------------------------------
       Dipasang sekali saat boot, bukan setiap kali slide dibuka: selama
       presentasi berjalan JS tidak boleh menyentuh style sama sekali.

       Jeda dibatasi ATAP. Tanpa itu, grafik dengan tujuh puluh titik peta
       punya ekor lebih dari empat detik dan presenter yang mengklik cepat
       mendahului animasinya sendiri. */
    const MULAI = 260;
    const ATAP = 900;

    const KELUARGA = [
      { pilih: ".stack .segment", langkah: 55 },
      { pilih: ".bar-row", langkah: 48 },
      { pilih: ".bullet-row", langkah: 48 },
      { pilih: ".trend-row", langkah: 90 },
      { pilih: ".dot-group", langkah: 130 },
      { pilih: ".panel", langkah: 80 },
      { pilih: "path.line", langkah: 140 },
      { pilih: ".world-map__markers > circle", langkah: 40 },
      { pilih: ".map-point > .point", langkah: 12 },
      { pilih: ".world-map__land, .provinces, .basemap", langkah: 0 },
    ];

    function siapkanGrafik(): void {
      for (const panggung of document.querySelectorAll<HTMLElement>("[data-deck-chart]")) {
        for (const { pilih, langkah } of KELUARGA) {
          const tanda = panggung.querySelectorAll<HTMLElement>(pilih);
          tanda.forEach((el, index) => {
            const tunda = Math.min(ATAP, MULAI + index * langkah);
            el.style.setProperty("--tunda", `${tunda}ms`);
          });
        }

        /* Garis tren menggambar dirinya. Panjang lintasan hanya terukur
           setelah elemen berada di dokumen; slide non-aktif memakai
           visibility, bukan display:none, jadi geometrinya tetap terhitung —
           itu syarat yang membuat pengukuran ini bekerja. */
        for (const path of panggung.querySelectorAll<SVGPathElement>("path.line")) {
          if (path.hasAttribute("stroke-dasharray")) continue;
          let panjang = 0;
          try { panjang = path.getTotalLength(); } catch { continue; }
          if (!panjang) continue;
          path.style.strokeDasharray = String(panjang);
          path.style.strokeDashoffset = reduceMotion.matches ? "0" : String(panjang);
          path.dataset.panjang = String(panjang);
        }
      }
    }

    /* --- Angka yang menghitung naik --------------------------------------
       Hanya untuk angka utama, dan hanya sekali per slide. Teks akhir selalu
       dituliskan persis seperti yang dirender di server, jadi pembulatan dan
       pemisah ribuan tidak pernah bergeser sedikit pun dari halaman laporan. */
    function hitungNaik(slide: HTMLElement): void {
      if (reduceMotion.matches) return;
      for (const el of slide.querySelectorAll<HTMLElement>("[data-deck-count]")) {
        const akhir = el.dataset.akhir ?? el.textContent ?? "";
        el.dataset.akhir = akhir;
        const cocok = akhir.match(/[\d.,]+/);
        if (!cocok) continue;
        const target = Number(cocok[0].replace(/\./g, "").replace(",", "."));
        if (!Number.isFinite(target) || target < 10) continue;
        const desimal = (cocok[0].split(",")[1] ?? "").length;
        const angka = new Intl.NumberFormat("id-ID", {
          minimumFractionDigits: desimal,
          maximumFractionDigits: desimal,
        });
        const mulai = performance.now();
        const durasi = 700;
        const frame = (kini: number) => {
          const maju = Math.min(1, (kini - mulai) / durasi);
          if (maju >= 1) { el.textContent = akhir; return; }
          const halus = 1 - (1 - maju) ** 3;
          el.textContent = akhir.replace(cocok[0], angka.format(target * halus));
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
        /* Jaring pengaman: kalau frame loop dicekik oleh tab yang tidak
           aktif, yang tertinggal di layar tetap angka yang benar. */
        window.setTimeout(() => { el.textContent = akhir; }, durasi + 400);
      }
    }

    let index = 0;

    function nyalakan(i: number): void {
      /* Slide yang ditinggalkan dikembalikan ke keadaan awal supaya
         koreografinya terputar ulang ketika presenter mundur — perilaku yang
         tepat saat satu slide dijelaskan dua kali. */
      slides.forEach((slide, k) => {
        if (k === i || !slide.classList.contains("anim-nyala")) return;
        slide.classList.remove("anim-nyala");
        slide.querySelectorAll<SVGPathElement>("path.line").forEach((path) => {
          if (path.dataset.panjang) path.style.strokeDashoffset = path.dataset.panjang;
        });
      });

      const aktif = slides[i];
      if (!aktif) return;
      /* Reflow paksa. Tanpa baris ini peramban menggabungkan pelepasan dan
         pemasangan kelas dalam satu kalkulasi gaya, dan transisinya tidak
         pernah berjalan sama sekali. */
      if (!reduceMotion.matches) void aktif.offsetWidth;
      aktif.classList.add("anim-nyala");
      aktif.querySelectorAll<SVGPathElement>("path.line").forEach((path) => {
        path.style.strokeDashoffset = "0";
      });
      hitungNaik(aktif);
    }

    function buka(diminta: number): void {
      index = Math.max(0, Math.min(slides.length - 1, diminta));
      slides.forEach((slide, i) => {
        const aktif = i === index;
        slide.toggleAttribute("data-active", aktif);
        slide.setAttribute("aria-hidden", String(!aktif));
      });
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      if (progress) progress.style.inlineSize = `${((index + 1) / slides.length) * 100}%`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      history.replaceState(null, "", `#slide-${index + 1}`);
      nyalakan(index);
    }

    document.body.classList.add("deck-live");
    siapkanGrafik();
    buka(Number(location.hash.replace("#slide-", "")) - 1 || 0);

    prev?.addEventListener("click", () => buka(index - 1));
    next?.addEventListener("click", () => buka(index + 1));
    notesToggle?.addEventListener("click", () => {
      const tampil = document.body.dataset.deckNotesOpen !== "true";
      document.body.dataset.deckNotesOpen = String(tampil);
      notesToggle.setAttribute("aria-pressed", String(tampil));
    });
    fullscreen?.addEventListener("click", () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else document.documentElement.requestFullscreen();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("input, textarea, select")) return;
      if (["ArrowRight", "PageDown", " "].includes(event.key)) { event.preventDefault(); buka(index + 1); }
      else if (["ArrowLeft", "PageUp"].includes(event.key)) { event.preventDefault(); buka(index - 1); }
      else if (event.key === "Home") { event.preventDefault(); buka(0); }
      else if (event.key === "End") { event.preventDefault(); buka(slides.length - 1); }
      else if (event.key.toLowerCase() === "n") { event.preventDefault(); notesToggle?.click(); }
      else if (event.key.toLowerCase() === "f") { event.preventDefault(); fullscreen?.click(); }
    });

    /* Klik di paruh kanan maju, di paruh kiri mundur — kebiasaan yang sudah
       dikenal presenter. Kontrol interaktif di dalam slide dikecualikan supaya
       tombol angkatan pada peta tetap dapat ditekan. */
    deck?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("a, button, aside, [data-map-controls], [data-choropleth] button, details")) return;
      buka(index + ((event as MouseEvent).clientX > window.innerWidth / 2 ? 1 : -1));
    });
  </script>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------------
     Panggung deck. Sebelum skrip berjalan, slide tersusun sebagai halaman
     panjang yang bisa digulir — itu yang membuat halaman tetap terbaca kalau
     JS gagal dimuat, dan juga yang membuat cetak ke PDF bekerja apa adanya.
     Kelas .deck-live baru menumpuknya menjadi satu panggung.
     --------------------------------------------------------------------- */
  :global(body.presentation-page) { overflow: auto; background: #0b1f2e; }
  :global(body.deck-live) { overflow: hidden; }

  :global(body.deck-live [data-deck]) {
    position: relative;
    inline-size: 100%;
    block-size: 100dvh;
    overflow: hidden;
  }

  :global(body.deck-live [data-deck-slide]) {
    position: absolute;
    inset: 0;
    z-index: 1;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms cubic-bezier(.4, 0, .2, 1), visibility 0s linear 420ms;
  }

  :global(body.deck-live [data-deck-slide][data-active]) {
    z-index: 2;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 420ms cubic-bezier(.4, 0, .2, 1), visibility 0s linear 0s;
  }

  /* --- Kendali ---------------------------------------------------------- */

  .deck-bar {
    position: fixed;
    z-index: 100;
    inset: 14px auto auto 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px;
    border: 1px solid rgb(255 255 255 / 24%);
    background: rgb(11 31 46 / 94%);
    color: #fff;
    box-shadow: 0 6px 22px rgb(0 0 0 / 24%);
    opacity: .32;
    transition: opacity 200ms ease;
  }
  .deck-bar:hover, .deck-bar:focus-within { opacity: 1; }
  .deck-bar a, .deck-bar button {
    min-block-size: 38px;
    padding: 6px 10px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 4px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .deck-bar a:hover, .deck-bar button:hover:not(:disabled) { background: rgb(255 255 255 / 12%); }
  .deck-bar button[aria-pressed="true"] { background: var(--ugm-gold); color: #0b1f2e; }
  .deck-bar button:disabled { opacity: .3; cursor: default; }
  .deck-bar span { min-inline-size: 62px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }

  .deck-progress {
    position: fixed;
    z-index: 99;
    inset: auto 0 0;
    block-size: 10px;
    background: rgb(255 255 255 / 14%);
  }
  .deck-progress i {
    display: block;
    inline-size: 0;
    block-size: 100%;
    background: var(--ugm-gold);
    transition: inline-size 420ms cubic-bezier(.4, 0, .2, 1);
  }
  :global(body:not(.deck-live)) .deck-progress { display: none; }

  .deck-hint {
    position: fixed;
    z-index: 90;
    inset: auto auto 20px 50%;
    transform: translateX(-50%);
    margin: 0;
    color: rgb(255 255 255 / 46%);
    font-size: 10px;
    letter-spacing: .06em;
    pointer-events: none;
  }

  @media (hover: none) { .deck-bar { opacity: 1; } }

