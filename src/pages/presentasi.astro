---
import BaseLayout from "../layouts/BaseLayout.astro";
import PresentationSlide from "../components/PresentationSlide.astro";
import { withBase } from "../lib/paths";
import "../styles/presentation.css";
import citationsRaw from "../data/derived/citations_by_year.json";
import countriesRaw from "../data/derived/collab_countries.json";
import fundingRaw from "../data/derived/funding_by_year.json";
import institutionRaw from "../data/derived/institution_snapshot.json";
import journalsRaw from "../data/derived/journals.json";
import lecturersRaw from "../data/derived/lecturers_positions.json";
import outreachRaw from "../data/derived/outreach_by_year.json";
import outreachPointsRaw from "../data/derived/outreach_points.json";
import publicationsRaw from "../data/derived/publications_by_year_dept.json";
import sdgRaw from "../data/derived/sdg_matrix.json";
import sintaRaw from "../data/derived/sinta_by_dept.json";
import studentResearchRaw from "../data/derived/student_research_by_year.json";
import tckRaw from "../data/derived/tck_2026_joined.json";
import topicsRaw from "../data/derived/topics.json";
import valueModelRaw from "../data/derived/value_model.json";
import snapshotRaw from "../data/derived/snapshot.json";
import partnershipsRaw from "../data/derived/partnerships_by_year.json";
import partnershipCoverageRaw from "../data/derived/partnership_coverage.json";
import admissionsRaw from "../data/derived/admissions_by_year.json";
import graduatesRaw from "../data/derived/graduates_profile.json";
import achievementsRaw from "../data/derived/student_achievements.json";
import tracerSectorsRaw from "../data/derived/tracer_sectors.json";
import tracerSummaryRaw from "../data/derived/tracer_summary.json";
import hpuRaw from "../data/derived/hpu_posbindu.json";

const format = (value: number, digits = 2) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: digits }).format(value);
const tone = (status: string) => ({ tercapai: "good", mendekati: "near", tertinggal: "behind", meleset: "missed" }[status] ?? "neutral");
const tckByNo = new Map(tckRaw.map((row) => [String(row.no), row]));
const tck = (no: string) => {
  const row = tckByNo.get(no);
  if (!row) throw new Error(`Indikator TCK ${no} tidak ditemukan`);
  return row;
};
const statusItem = (no: string, label: string, target: "target_dinilai" | "target_tw4" = "target_dinilai") => {
  const row = tck(no);
  return { label, value: row.capaian_dinilai, max: row[target], display: `${format(row.capaian_dinilai)} / ${format(row[target])}`, status: tone(row.status_kuartal) };
};
const snapshot = snapshotRaw as { label: string; p2m: string; lentera: string };

const citationTotal = citationsRaw.reduce((sum, row) => sum + row.citations, 0);
const citationRecent = citationsRaw.filter((row) => row.year >= 2021 && row.year <= 2025).reduce((sum, row) => sum + row.citations, 0);
const citationByYear = new Map(citationsRaw.map((row) => [row.year, row.citations]));
const citationStart = Math.min(...citationsRaw.map((row) => row.year));
const tckAchieved = tckRaw.filter((row) => row.status_kuartal === "tercapai").length;
const tckAnnual = tckRaw.filter((row) => row.status_thd_tahunan === "tercapai").length;
const tckNear = tckRaw.filter((row) => row.status_kuartal === "mendekati").length;
const tckBehind = tckRaw.length - tckAchieved - tckNear;
const publicationTotals = new Map<string, number>();
publicationsRaw.forEach((row) => publicationTotals.set(row.department, (publicationTotals.get(row.department) ?? 0) + row.count));
const publicationItems = [
  ["Kimia", "Kimia", "good"],
  ["Fisika", "Fisika", undefined],
  ["Ilmu Komputer dan Elektronika", "Ilmu Komputer & Elektronika", undefined],
  ["Matematika", "Matematika", undefined],
  ["Belum terpetakan", "Belum terpetakan", "behind"],
].map(([key, label, status]) => ({ label, value: publicationTotals.get(key ?? "") ?? 0, display: format(publicationTotals.get(key ?? "") ?? 0), status }));
const countryNames: Record<string, string> = { Japan: "Jepang", "South Korea": "Korea Selatan", Germany: "Jerman" };
const countryItems = countriesRaw.slice(0, 5).map((row) => ({ label: countryNames[row.country] ?? row.country, value: row.n, display: format(row.n) }));
const positionTotals = new Map<string, number>();
lecturersRaw.forEach((row) => positionTotals.set(row.position, (positionTotals.get(row.position) ?? 0) + row.n));
const sintaByDepartment = new Map(sintaRaw.map((row) => [row.department, row]));
const fundingByYear = new Map(fundingRaw.filter((row) => row.type === "Total").map((row) => [row.year, row.amount / 1_000_000_000]));
const outreachByYear = new Map(outreachRaw.map((row) => [row.year, row.n]));
const outreachArchiveMissing = outreachPointsRaw.filter((row) => row.location_status === "missing").reduce((sum, row) => sum + row.n, 0);
const sdgByNumber = new Map(sdgRaw.map((row) => [row.sdg, row]));
const journalTotals = new Map<string, number>();
journalsRaw.forEach((row) => journalTotals.set(row.journal, (journalTotals.get(row.journal) ?? 0) + row.n));
const journalLabels: Record<string, string> = {
  "Indonesian Journal of Chemistry (IJC)": "Indonesian Journal of Chemistry",
  "Indonesian Journal of Computing and Cybernetics Systems (IJCCS)": "IJCCS",
  "Indonesian Journal of Electronics and Instrumentation Systems (IJEIS)": "IJEIS",
  "Jurnal Matematika Thales (JMT)": "Jurnal Matematika Thales",
};
const journalItems = [...journalTotals]
  .filter(([name]) => name !== "Belum terklasifikasi")
  .map(([name, value]) => ({ label: journalLabels[name] ?? name, value, display: format(value) }));
const journalClassified = journalItems.reduce((sum, item) => sum + item.value, 0);
const studentResearchTotal = studentResearchRaw.reduce((sum, row) => sum + row.n, 0);
const pillarSummary = [
  ["Reputasi", "Reputasi akademik", "good"],
  ["Kontribusi", "Kontribusi terhadap bangsa", "missed"],
  ["Employability", "Employability", "near"],
  ["Kesejahteraan", "Kesejahteraan", "good"],
].map(([key, label, status]) => {
  const rows = tckRaw.filter((row) => row.pilar === key);
  return { label, display: `${rows.filter((row) => row.status_kuartal === "tercapai").length} / ${rows.length}`, status };
});
const tckFlagged = tckRaw.filter((row) => row.anomali).length;
const behindRows = tckRaw
  .filter((row) => row.status_kuartal === "tertinggal" || row.status_kuartal === "meleset")
  .sort((a, b) => (a.rasio_kuartal ?? 0) - (b.rasio_kuartal ?? 0));
const contributionBehind = behindRows.filter((row) => row.pilar === "Kontribusi").slice(0, 3);
const partnershipTotals = new Map<number, number>();
partnershipsRaw.forEach((row) => partnershipTotals.set(row.tahun, (partnershipTotals.get(row.tahun) ?? 0) + row.n));
const partnershipYears = [...partnershipTotals.keys()].sort((a, b) => a - b);
const admissionTotals = new Map<number, { peminat: number; diterima: number; registrasi: number }>();
admissionsRaw.forEach((row) => {
  const current = admissionTotals.get(row.tahun) ?? { peminat: 0, diterima: 0, registrasi: 0 };
  admissionTotals.set(row.tahun, { peminat: current.peminat + row.peminat, diterima: current.diterima + row.diterima, registrasi: current.registrasi + row.registrasi });
});
const admissionRatio = (year: number) => {
  const row = admissionTotals.get(year);
  return row && row.diterima > 0 ? row.peminat / row.diterima : 0;
};
const admissionYield = (year: number) => {
  const row = admissionTotals.get(year);
  return row && row.diterima > 0 ? (row.registrasi / row.diterima) * 100 : 0;
};
const admissionYears = [...admissionTotals.keys()].sort((a, b) => a - b);
const graduateYears = [...new Set(graduatesRaw.map((row) => row.tahun))].sort((a, b) => a - b);
const achievementYears = [...new Set(achievementsRaw.map((row) => row.tahun))].sort((a, b) => a - b);
const achievementTotal = achievementsRaw.reduce((sum, row) => sum + row.prestasi, 0);
const tracerSummary = tracerSummaryRaw as { responden: number; median_bulan: number; dalam_6_bulan: number; bekerja_sebelum_lulus: number };
const hpu = hpuRaw as any;
const fundingChange = ((fundingByYear.get(2025) ?? 0) / (fundingByYear.get(2024) ?? 1) - 1) * 100;
const homeUrl = withBase("/");

const slides: any[] = [
  { number: "0.0", kicker: "Pembuka", title: "Lompatan Sitasi dalam Lima Tahun", takeaway: `Sebagian besar sitasi publikasi ilmiah dalam seluruh arsip sejarah FMIPA tercipta pada kurun waktu kepemimpinan 2021–2026.`, mode: "stat", stat: format(citationTotal), statLabel: `total sitasi seluruh arsip · ${format((citationRecent / citationTotal) * 100, 1)}% tercipta pada 2021–2025`, dark: true, source: `Data sitasi FMIPA, ${citationStart}–2025`, note: `Jeda sejenak setelah menyebut angka ${format(citationTotal)}. Tekankan bahwa ${format(citationRecent)} sitasi tercipta hanya dalam lima tahun terakhir sebagai bukti lompatan mutu riset.` },
  { number: "1.1", kicker: "Bagian I · Potret Hari Ini", title: "Komposisi dan Struktur FMIPA", takeaway: "FMIPA UGM merupakan ekosistem akademik yang kokoh, ditopang oleh dosen berkualifikasi tinggi, tenaga kependidikan profesional, dan laboratorium terpadu.", mode: "cards", items: [{ label: "Dosen", display: format(institutionRaw.lecturers) }, { label: "Tenaga kependidikan", display: format(institutionRaw.academic_staff) }, { label: "Program studi", display: format(institutionRaw.study_programmes) }, { label: "Laboratorium", display: format(institutionRaw.laboratories) }], source: "Data kepegawaian dan unit FMIPA", note: `Empat departemen menaungi ${institutionRaw.study_programmes} program studi: 8 Sarjana, 5 Magister, dan 4 Doktor.` },
  { number: "1.2", kicker: "Bagian I · Akuntabilitas Kinerja", title: `Ketercapaian ${tckRaw.length} Indikator Kinerja`, takeaway: "Capaian kinerja yang melampaui target dan indikator yang perlu diakselerasi disajikan secara berimbang dan transparan.", mode: "status", items: [{ label: "Memenuhi target triwulan", value: tckAchieved, max: tckRaw.length, display: format(tckAchieved), status: "good" }, { label: "Melampaui target tahunan", value: tckAnnual, max: tckRaw.length, display: format(tckAnnual), status: "good" }, { label: "Mendekati target", value: tckNear, max: tckRaw.length, display: format(tckNear), status: "near" }, { label: "Perlu akselerasi", value: tckBehind, max: tckRaw.length, display: format(tckBehind), status: "missed" }], source: `TCK 2026 FMIPA UGM, ${snapshot.label}`, note: `Sampaikan bahwa evaluasi ini berbasis berkas resmi TCK per ${snapshot.label}, menuju penutupan Triwulan III pada akhir September. Sebutkan ${tckFlagged} indikator membawa catatan kualitas data.` },
  { number: "1.3", kicker: "Bagian I · Model Transformasi Nilai", title: "Dari Sumber Daya Menuju Dampak", takeaway: "Ikhtiar lima tahun tergambar dalam alur yang berkesinambungan: perolehan dana dan dedikasi tridharma bertransformasi menjadi riset, publikasi bereputasi, dan dampak luas.", mode: "flow", items: [{ label: "dana riset", display: `Rp${format(valueModelRaw.metrics.funding_rp / 1_000_000_000)} M` }, { label: "riset & PkM", display: format(valueModelRaw.metrics.research_n + valueModelRaw.metrics.outreach_n) }, { label: "publikasi", display: format(valueModelRaw.metrics.publications_n) }, { label: "sitasi", display: format(valueModelRaw.metrics.citations_n) }], source: "Agregat data historis 2021–2025", note: "Nilai pendanaan mencerminkan total perolehan proposal riset multi-sumber." },
  { number: "2.1", kicker: "Pilar 1 · Reputasi Akademik", title: "Akselerasi Sitasi dan Pengakuan Global", takeaway: "Jumlah sitasi tahunan melonjak lebih dari tiga kali lipat dalam enam tahun pengamatan yang terstandarisasi.", mode: "bars", items: [2019, 2021, 2023, 2024, 2025].map((year) => ({ label: year === 2025 ? "2025 · indeksasi berjalan" : String(year), value: citationByYear.get(year) ?? 0, display: format(citationByYear.get(year) ?? 0), status: year === 2025 ? "near" : undefined })), source: "Data sitasi FMIPA UGM", note: "Tegaskan bahwa data sitasi 2025 masih terus bertambah seiring pemutakhiran berkala pangkalan data Scopus." },
  { number: "2.2", kicker: "Pilar 1 · Reputasi Akademik", title: "Sinergi Empat Departemen dalam Riset", takeaway: "Sebanyak 94,2% artikel periode 2020–2025 berhasil terpetakan ke departemen berbasis ID Scopus penulis aktif.", mode: "bars", items: publicationItems, source: "SciVal / Scopus, 2020–2025", note: "Sebanyak 157 publikasi yang belum terpetakan tetap dicatat secara terbuka sebagai proses penelusuran berkelanjutan." },
  { number: "2.3", kicker: "Pilar 1 · Reputasi Akademik", title: `${format(topicsRaw.length)} Klaster Topik Riset Unggulan`, takeaway: "Sains material, energi terbarukan, kecerdasan artifisial, biosains, dan sensor membentuk ekosistem riset interdisipliner yang kuat.", mode: "cards", items: ["Adsorpsi ion logam", "Pirolisis & bio-oil", "Segmentasi citra & DNN", "Fotokatalisis TiO₂"].map((label, index) => ({ label, display: format(topicsRaw[index]?.n ?? 0) })), source: "Klaster topik SciVal", note: "Empat klaster ini merupakan contoh bidang dengan aktivitas riset terbesar di fakultas." },
  { number: "2.4", kicker: "Pilar 1 · Reputasi Akademik", title: `Jejaring Kemitraan ${countriesRaw.length} Negara`, takeaway: "Proporsi publikasi kolaborasi internasional meningkat dari 18,4% menjadi 27,7% dalam lima tahun.", mode: "bars", items: countryItems, source: "SciVal / Scopus", note: "Tekankan peningkatan proporsi publikasi multinegara sebagai bukti penguatan rekognisi internasional." },
  { number: "2.5", kicker: "Pilar 1 · Reputasi Akademik", title: "Komposisi dan Kepakaran Dosen", takeaway: "Satu dari lima dosen tetap aktif di FMIPA UGM telah mengemban jabatan fungsional Guru Besar.", mode: "bars", items: ["Asisten Ahli", "Lektor", "Lektor Kepala", "Guru Besar", "Belum terisi"].map((label) => ({ label, value: positionTotals.get(label) ?? 0, display: format(positionTotals.get(label) ?? 0), status: label === "Guru Besar" ? "good" : label === "Belum terisi" ? "behind" : undefined })), source: "Data kepegawaian FMIPA, snapshot 2025", note: `Sistem SIMASTER mencatat ${format(tck("30").capaian_dinilai)} Guru Besar berdasarkan SK pengangkatan terbaru.` },
  { number: "2.6", kicker: "Pilar 1 · Agenda Akselerasi", title: "Pemerataan Produktivitas Publikasi", takeaway: "Reputasi akademik meningkat pesat; percepatan publikasi mahasiswa doktor dan kemitraan riset global terus didorong.", mode: "cards", items: [{ label: "Publikasi mahasiswa doktor", display: `${format(tck("11").capaian_dinilai)} / ${format(tck("11").target_dinilai)}`, status: tone(tck("11").status_kuartal), description: "Target TW3" }, { label: "Mitra riset internasional", display: `${format(tck("18").capaian_dinilai)} / ${format(tck("18").target_dinilai)}`, status: tone(tck("18").status_kuartal), description: "Target TW3" }, { label: "Median SINTA Kimia", display: format(sintaByDepartment.get("Kimia")?.median ?? 0) }, { label: "Median SINTA Matematika", display: format(sintaByDepartment.get("Matematika")?.median ?? 0), status: "missed" }], source: "TCK 2026 + data SINTA Kemendikbudristek", note: "Median dihitung dari skor SINTA dosen aktif di masing-masing departemen." },
  { number: "3.1", kicker: "Pilar 2 · Kontribusi terhadap Bangsa", title: "Lompatan Perolehan Dana Riset", takeaway: `Skala pendanaan melonjak drastis dari Rp${format(fundingByYear.get(2021) ?? 0)} miliar pada 2021 menjadi Rp${format(fundingByYear.get(2024) ?? 0)} miliar pada 2024.`, mode: "bars", items: [2019, 2021, 2022, 2023, 2024, 2025].map((year) => ({ label: String(year), value: fundingByYear.get(year) ?? 0, display: `Rp${format(fundingByYear.get(year) ?? 0)} M`, status: year === 2024 ? "good" : year === 2025 ? "near" : undefined })), source: "Data riset FMIPA UGM", note: "Perolehan 2025 tetap berada jauh di atas skala awal periode, menegaskan stabilitas pendanaan riset fakultas." },
  { number: "3.2", kicker: "Pilar 2 · Kontribusi terhadap Bangsa", title: `Dari ${format(outreachByYear.get(2021) ?? 0)} Menjadi ${format(outreachByYear.get(2025) ?? 0)} Kegiatan PkM`, takeaway: `${format(valueModelRaw.metrics.mappable_outreach_n)} kegiatan pengabdian masyarakat periode 2021–2025 telah terpetakan sebarannya di nusantara.`, mode: "bars", items: [2021, 2022, 2023, 2024, 2025].map((year) => ({ label: String(year), value: outreachByYear.get(year) ?? 0, display: format(outreachByYear.get(year) ?? 0), status: year === 2025 ? "good" : undefined })), source: "Data pengabdian FMIPA UGM", note: `Sebaran mencakup seluruh provinsi di Indonesia berdasarkan dokumen penugasan resmi.` },
  { number: "3.3", kicker: "Pilar 2 · Kontribusi terhadap Bangsa", title: "Kontribusi terhadap Agenda SDGs", takeaway: "Fokus tridharma terdistribusi kuat pada pilar industri & inovasi, kesehatan, konsumsi bertanggung jawab, dan air bersih.", mode: "cards", items: [[9, "SDG 9 · Industri & inovasi"], [3, "SDG 3 · Kesehatan"], [12, "SDG 12 · Konsumsi bertanggung jawab"], [6, "SDG 6 · Air bersih"]].map(([number, label]) => ({ label, display: format(sdgByNumber.get(Number(number))?.research_n ?? 0), status: Number(number) === 9 ? "good" : undefined })), source: "Data riset FMIPA + SciVal", note: "Penguatan pencatatan pada pilar SDGs lainnya terus diintegrasikan ke sistem fakultas." },
  { number: "3.4", kicker: "Pilar 2 · Diseminasi Ilmu", title: "Diseminasi Melalui Jurnal Ilmiah Berkala", takeaway: `Empat jurnal ilmiah terbitan FMIPA mempublikasikan ${format(journalClassified)} artikel terindeks bereputasi.`, mode: "bars", items: journalItems, source: "Data jurnal internal FMIPA", note: `Publikasi ilmiah dikelola melalui empat jurnal berkala terakreditasi nasional dan internasional.` },
  { number: "3.5", kicker: "Pilar 2 · Jejaring Kemitraan", title: `${format(partnershipCoverageRaw.total)} Dokumen Kerja Sama dalam Enam Tahun`, takeaway: `Kemitraan tumbuh konsisten dan menjangkau ${format(partnershipCoverageRaw.internasional)} dokumen bersama mitra luar negeri.`, mode: "bars", items: partnershipYears.map((year) => ({ label: String(year), value: partnershipTotals.get(year) ?? 0, display: format(partnershipTotals.get(year) ?? 0), status: year === partnershipYears[partnershipYears.length - 1] ? "good" : undefined })), source: `LENTERA UGM, ${snapshot.lentera}`, note: `Sebanyak ${format(partnershipCoverageRaw.terpetakan)} dokumen tercatat lokasi provinsinya dan ${format(partnershipCoverageRaw.lokasi_kosong)} belum memiliki data alamat mitra.` },
  { number: "3.6", kicker: "Pilar 2 · Agenda Akselerasi", title: "Akselerasi Hilirisasi dan Luaran Tridharma", takeaway: `Creative funding telah menembus Rp${format(tck("1c").capaian_dinilai)} miliar; fokus berikutnya adalah penyaluran luaran tridharma ke mitra eksternal.`, mode: "cards", items: [...contributionBehind.map((row) => ({ label: row.indikator.length > 40 ? `${row.indikator.slice(0, 38)}…` : row.indikator, display: `${format(row.capaian_dinilai)} / ${format(row.target_dinilai)}`, status: tone(row.status_kuartal) })), { label: "Lokasi PkM belum terpetakan", display: format(outreachArchiveMissing), status: "behind" }], source: "TCK 2026 + Data pengabdian", note: "Sampaikan secara objektif: kapasitas produksi riset sangat tinggi, dan penyaluran ke mitra eksternal terus dipacu." },
  { number: "4.1", kicker: "Pilar 3 · Kesiapan & Daya Serap Lulusan", title: "Sebaran Sektor Karier Lulusan", takeaway: `Tracer study atas ${format(tracerSummary.responden)} responden menunjukkan lulusan sains dasar terserap luas melintasi industri.`, mode: "bars", items: tracerSectorsRaw.slice(0, 6).map((row) => ({ label: row.sektor, value: row.n, display: format(row.n), status: row.sektor === tracerSectorsRaw[0].sektor ? "good" : undefined })), source: "Tracer study FMIPA UGM", note: "Sebaran ini menggantikan celah data tracer study yang sebelumnya belum tersedia di tingkat fakultas." },
  { number: "4.2", kicker: "Pilar 3 · Kesiapan & Daya Serap Lulusan", title: `Median Masa Tunggu ${format(tracerSummary.median_bulan)} Bulan`, takeaway: `${format(tracerSummary.dalam_6_bulan)} dari ${format(tracerSummary.responden)} responden memperoleh pekerjaan dalam enam bulan setelah lulus.`, mode: "stat", stat: format(tracerSummary.median_bulan), statLabel: `bulan median masa tunggu · ${format(tracerSummary.bekerja_sebelum_lulus)} responden telah bekerja sebelum lulus`, source: "Tracer study FMIPA UGM", note: "Nilai negatif pada data sumber menandakan lulusan yang sudah bekerja sebelum tanggal kelulusan." },
  { number: "4.3", kicker: "Pilar 3 · Kesiapan Karier Mahasiswa", title: "Partisipasi MBKM Melampaui Target", takeaway: "Partisipasi mahasiswa dalam program MBKM berhasil melampaui target tahunan yang ditetapkan.", mode: "status", items: [statusItem("8a", "MBKM ≥10 SKS", "target_tw4"), statusItem("9", "Mahasiswa berprestasi", "target_tw4"), statusItem("10", "Fast track / RPL / PMDSU", "target_tw4"), statusItem("5b", "Aktif di LinkedIn", "target_tw4")], source: "SIMASTER UGM", note: "Status warna dihitung terhadap target kuartal yang dinilai; angka pembanding adalah target tahunan. Indikator LinkedIn dinilai pada TW2." },
  { number: "4.4", kicker: "Pilar 3 · Internasionalisasi", title: "Mobilitas Mahasiswa Asing", takeaway: "Aktivitas mahasiswa asing program kredit dan non-kredit terus dipacu menuju pemenuhan target akhir tahun.", mode: "status", items: [statusItem("4a", "Program kredit"), statusItem("4b", "Non-kredit")], source: "TCK 2026 #4a–4b", note: `Target tahunan: ${format(tck("4a").target_tw4)} program kredit dan ${format(tck("4b").target_tw4)} non-kredit.` },
  { number: "4.5", kicker: "Pilar 3 · Kelulusan Tepat Waktu", title: "Kelulusan Tepat Waktu Ketiga Jenjang", takeaway: "Persentase kelulusan tepat waktu melampaui target triwulan pada Sarjana, Magister, maupun Doktor.", mode: "bars", items: [["8b1", "Sarjana"], ["8b2", "Magister"], ["8b3", "Doktor"]].map(([no, label]) => ({ label: `${label} · TW2`, value: tck(no).capaian_dinilai, max: tck(no).target_dinilai, display: `${format(tck(no).capaian_dinilai)}% dari target ${format(tck(no).target_dinilai)}%`, status: tone(tck(no).status_kuartal) })), source: "TCK 2026 #8b1–8b3", note: "Kolom TW3 pada berkas sumber memuat cacah mahasiswa tanpa penyebut, sehingga persentase terakhir yang sahih berasal dari TW2. Sampaikan hal ini bila ditanya." },
  { number: "4.3′", kicker: "Pilar 3 · Keterlibatan Riset", title: `${format(studentResearchTotal)} Judul Riset Melibatkan Mahasiswa`, takeaway: "Keterlibatan aktif mahasiswa Sarjana dalam riset dosen meningkat pesat pada kurun waktu 2023–2024.", mode: "bars", items: studentResearchRaw.map((row) => ({ label: String(row.year), value: row.n, display: format(row.n), status: row.year === 2024 ? "good" : undefined })), source: "Data riset FMIPA UGM", note: "Mencakup judul riset dosen yang tercatat secara resmi melibatkan asisten mahasiswa." },
  { number: "4.6", kicker: "Pilar 3 · Selektivitas Penerimaan", title: "Keketatan Seleksi Melonggar", takeaway: `Peminat menyusut dari ${format(admissionTotals.get(admissionYears[0])?.peminat ?? 0)} pada ${admissionYears[0]} menjadi ${format(admissionTotals.get(admissionYears[admissionYears.length - 1])?.peminat ?? 0)} pada ${admissionYears[admissionYears.length - 1]}, sementara daya tampung bertambah—keketatan turun dari 1 : ${format(admissionRatio(admissionYears[0]), 1)} menjadi 1 : ${format(admissionRatio(admissionYears[admissionYears.length - 1]), 1)}.`, mode: "bars", items: admissionYears.map((year) => ({ label: String(year), value: admissionTotals.get(year)?.peminat ?? 0, display: format(admissionTotals.get(year)?.peminat ?? 0) })), source: "Data akademik FMIPA UGM", note: `Sisi yang menguat: ${format(admissionYield(admissionYears[admissionYears.length - 1]), 1)}% dari yang diterima melakukan registrasi, naik dari ${format(admissionYield(admissionYears[0]), 1)}%.` },
  { number: "4.7", kicker: "Pilar 3 · Lulusan & Prestasi", title: `${format(achievementTotal)} Prestasi Mahasiswa Sejak 2022`, takeaway: "Jumlah lulusan dan prestasi kompetisi tumbuh bersama, dengan porsi tingkat internasional yang terus naik.", mode: "bars", items: achievementYears.map((year) => { const total = achievementsRaw.filter((row) => row.tahun === year).reduce((sum, row) => sum + row.prestasi, 0); return { label: String(year), value: total, display: format(total), status: year === achievementYears[achievementYears.length - 1] ? "good" : undefined }; }), source: "Data kemahasiswaan FMIPA UGM", note: `Lulusan sarjana pada tahun akademik terakhir mencapai ${format(graduatesRaw.filter((row) => row.jenjang === "Sarjana" && row.tahun === graduateYears[graduateYears.length - 1])[0]?.lulusan ?? 0)} orang.` },
  { number: "5.1", kicker: "Pilar 4 · Tata Kelola & Kesejahteraan", title: "Pengembangan Karier dan Kualifikasi SDM", takeaway: `Sebanyak ${pillarSummary[3].display} indikator pilar kesejahteraan memenuhi target triwulan, didorong oleh kenaikan jabatan dan rekognisi internasional.`, mode: "cards", items: [{ label: "Dosen S3", display: format(tck("24").capaian_dinilai), status: tone(tck("24").status_kuartal) }, { label: "Guru Besar", display: `${format(tck("30").capaian_dinilai)} / ${format(tck("30").target_dinilai)}`, status: tone(tck("30").status_kuartal) }, { label: "Sertifikat kompetensi", display: `${format(tck("25").capaian_dinilai)} / ${format(tck("25").target_dinilai)}`, status: tone(tck("25").status_kuartal) }, { label: "Rekognisi internasional", display: format(tck("23").capaian_dinilai), status: tone(tck("23").status_kuartal) }], source: "TCK 2026 FMIPA UGM", note: "Kenaikan sertifikasi pendidik mencerminkan selesainya siklus sertifikasi dosen pada periode berjalan." },
  { number: "5.2", kicker: "Pilar 4 · Inklusivitas Kampus", title: `${format(tck("31").capaian_dinilai)} Fasilitas Ramah Disabilitas`, takeaway: `Penyediaan fasilitas ramah disabilitas telah melampaui target tahunan sebesar ${format(tck("31").target_tw4)} unit.`, mode: "stat", stat: format(tck("31").capaian_dinilai), statLabel: `unit fasilitas disabilitas · target tahunan ${format(tck("31").target_tw4)} unit`, source: "TCK 2026 #31", note: `Indeks gedung hijau tercatat ${format(tck("32").capaian_dinilai)}% pada berkas sumber dan masih disinkronkan bersama Direktorat Aset UGM.` },
  { number: "5.3", kicker: "Pilar 4 · Kesehatan Sivitas", title: `${format(hpu.kunjungan)} Kunjungan Pemeriksaan Dosen dan Tendik`, takeaway: `Enam parameter diperiksa pada ${format(hpu.sesi.length)} sesi Posbindu sepanjang 2026; ${hpu.profil_risiko[0]?.indikator} menjadi temuan terbanyak dengan ${format(Math.round((hpu.profil_risiko[0]?.porsi_berisiko ?? 0) * 100))}% peserta pada ambang berisiko.`, mode: "bars", items: hpu.profil_risiko.map((row: any) => ({ label: row.indikator, value: Math.round(row.porsi_berisiko * 100), display: `${format(Math.round(row.porsi_berisiko * 100))}%` })), source: "Posbindu Melati FMIPA · agregat anonim", note: "Porsi dihitung terhadap peserta yang diperiksa pada tiap parameter. Angka mencakup dosen dan tenaga kependidikan; nama dan nilai pemeriksaan per orang tidak pernah diekspor. Pemantauan K3L dan Satgas PPKS berjalan terpadu namun belum tersedia sebagai data terstruktur." },
  { number: "6.1", kicker: "Bagian III · Catatan Estafet", title: "Agenda Akselerasi dan Tindak Lanjut", takeaway: "Laporan pertanggungjawaban ini menyerahkan agenda yang terukur dan berbasis data untuk ditindaklanjuti secara berkesinambungan.", mode: "cards", items: [{ label: "Indikator perlu akselerasi", display: `${format(tckBehind)} / ${format(tckRaw.length)}`, status: "missed" }, { label: "Catatan kualitas data", display: `${format(tckFlagged)} indikator`, status: "behind" }, { label: "Alamat mitra belum lengkap", display: `${format(partnershipCoverageRaw.lokasi_kosong)} dokumen`, status: "behind" }, { label: "Dinamika dana riset 2025", display: `${fundingChange < 0 ? "−" : "+"}${format(Math.abs(fundingChange), 1)}%`, status: "near" }], source: "TCK 2026 + Data historis", note: "Indikator yang perlu diakselerasi dipetakan secara jujur dan berimbang sebagai bahan evaluasi konstruktif." },
  { number: "6.2", kicker: "Bagian III · Fondasi Data", title: "Pijakan Data untuk Kepemimpinan Berikutnya", takeaway: "Empat pilar utama kini memiliki basis data yang transparan, terdokumentasi, dan siap diuji sebagai pijakan pengembangan fakultas.", mode: "cards", items: pillarSummary, source: `TCK 2026 FMIPA UGM, ${snapshot.label}`, note: "Gunakan halaman Data & Metodologi sebagai titik awal pembaruan data berkelanjutan untuk kepengurusan selanjutnya." },
];
---

<BaseLayout
  title="Bahan Tayang Rapat Senat — Lima Tahun FMIPA"
  description="Bahan tayang interaktif untuk Rapat Senat Terbuka Laporan Dekan FMIPA UGM 2021–2026."
  canonicalPath="/presentasi"
  chrome={false}
  bodyClass="presentation-page"
>
  <main id="konten-utama" class="presentation-deck" data-presentation-deck>
    {slides.map((slide) => <PresentationSlide {...slide} />)}
  </main>
  <nav class="deck-controls" aria-label="Kontrol navigasi presentasi">
    <a href={homeUrl} title="Kembali ke laporan utama">Laporan utama</a>
    <button type="button" data-deck-prev aria-label="Slide sebelumnya">←</button>
    <span data-deck-counter aria-live="polite">1 / {slides.length}</span>
    <button type="button" data-deck-next aria-label="Slide berikutnya">→</button>
    <button type="button" data-deck-notes aria-pressed="false" title="Tampilkan catatan presenter (P)">Catatan presenter</button>
    <button type="button" data-deck-fullscreen title="Layar penuh (F)">Layar penuh</button>
  </nav>
  <p class="deck-help">Gunakan tombol ← → untuk berpindah slide · P untuk catatan · F untuk layar penuh</p>

  <script>
    const deck = document.querySelector<HTMLElement>("[data-presentation-deck]");
    const slides = [...document.querySelectorAll<HTMLElement>("[data-presentation-slide]")];
    const counter = document.querySelector<HTMLElement>("[data-deck-counter]");
    const prev = document.querySelector<HTMLButtonElement>("[data-deck-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-deck-next]");
    const notes = document.querySelector<HTMLButtonElement>("[data-deck-notes]");
    const fullscreen = document.querySelector<HTMLButtonElement>("[data-deck-fullscreen]");
    let index = Math.max(0, Math.min(slides.length - 1, Number(location.hash.replace("#scene-", "")) - 1 || 0));

    const activate = (requested: number) => {
      index = Math.max(0, Math.min(slides.length - 1, requested));
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.toggleAttribute("data-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      history.replaceState(null, "", `#scene-${index + 1}`);
    };

    document.body.classList.add("presentation-enhanced");
    activate(index);
    prev?.addEventListener("click", () => activate(index - 1));
    next?.addEventListener("click", () => activate(index + 1));
    notes?.addEventListener("click", () => {
      const visible = document.body.dataset.notesVisible !== "true";
      document.body.dataset.notesVisible = String(visible);
      notes.setAttribute("aria-pressed", String(visible));
    });
    fullscreen?.addEventListener("click", () => document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen());
    document.addEventListener("keydown", (event) => {
      if (["ArrowRight", "PageDown", " "].includes(event.key)) { event.preventDefault(); activate(index + 1); }
      if (["ArrowLeft", "PageUp"].includes(event.key)) { event.preventDefault(); activate(index - 1); }
      if (event.key === "Home") { event.preventDefault(); activate(0); }
      if (event.key === "End") { event.preventDefault(); activate(slides.length - 1); }
      if (event.key.toLowerCase() === "p") { event.preventDefault(); notes?.click(); }
      if (event.key.toLowerCase() === "f") { event.preventDefault(); fullscreen?.click(); }
    });
    deck?.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a,button,aside")) return;
      const x = (event as MouseEvent).clientX;
      activate(index + (x > window.innerWidth / 2 ? 1 : -1));
    });
  </script>
</BaseLayout>

<style>
  :global(body.presentation-page) { overflow: auto; background: #0B1F2E; }
  :global(body.presentation-page.presentation-enhanced) { overflow: hidden; }
  :global(body.presentation-page.presentation-enhanced [data-presentation-deck]) {
    position: relative;
    inline-size: 100%;
    block-size: 100vh;
    block-size: 100dvh;
    overflow: hidden;
  }
  :global(body.presentation-page.presentation-enhanced [data-presentation-slide]) {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    inline-size: 100%;
    block-size: 100%;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
    transition: opacity 500ms cubic-bezier(.4, 0, .2, 1), visibility 0s linear 500ms;
  }
  :global(body.presentation-page.presentation-enhanced [data-presentation-slide][data-active]) {
    z-index: 2;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 500ms cubic-bezier(.4, 0, .2, 1), visibility 0s linear 0s;
  }
  .deck-controls { position: fixed; z-index: 100; inset: 14px auto auto 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 5px; padding: 5px; border: 1px solid rgba(255,255,255,.25); background: rgb(11 31 46 / 94%); color: #fff; box-shadow: 0 5px 20px rgb(0 0 0 / 22%); opacity: .78; transition: opacity 180ms ease; }
  .deck-controls:hover, .deck-controls:focus-within { opacity: 1; }
  .deck-controls a, .deck-controls button { min-height: 40px; padding: 7px 10px; border: 1px solid rgba(255,255,255,.24); border-radius: 4px; background: transparent; color: #fff; font: inherit; font-size: 12px; font-weight: 700; text-decoration: none; }
  .deck-controls button:hover, .deck-controls a:hover { background: rgba(255,255,255,.1); }.deck-controls button[aria-pressed="true"] { background: var(--ugm-gold); color: #0B1F2E; }.deck-controls button:disabled { opacity: .35; }
  .deck-controls span { min-width: 64px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }
  .deck-help { position: fixed; z-index: 90; inset: auto auto 18px 50%; transform: translateX(-50%); margin: 0; color: rgba(255,255,255,.58); font-size: 10px; pointer-events: none; }
  @media (hover: none) { .deck-controls { opacity: 1; } }
  @media(max-width:1200px){.deck-controls [data-deck-notes],.deck-controls [data-deck-fullscreen]{inline-size:40px;padding-inline:0;font-size:0}.deck-controls [data-deck-notes]::before{content:"P";font-size:12px}.deck-controls [data-deck-fullscreen]::before{content:"⛶";font-size:18px;line-height:1}}
  @media(max-width:760px){.deck-controls{inset:8px 8px auto;transform:none;justify-content:center}.deck-controls a,.deck-controls button{padding-inline:9px}.deck-controls [data-deck-fullscreen],.deck-controls [data-deck-notes]{display:none}.deck-help{display:none}}
  @media (prefers-reduced-motion: reduce) {
    :global(body.presentation-page.presentation-enhanced [data-presentation-slide]) { transition: none; }
  }
  @media print { .deck-controls,.deck-help{display:none!important}:global(body.presentation-page){overflow:visible!important}:global(body.presentation-page [data-presentation-slide]){display:block!important;visibility:visible!important;opacity:1!important;break-after:page;transition:none!important} }
</style>
